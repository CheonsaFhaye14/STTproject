@using Microsoft.AspNetCore.Components.Routing
@using STTproject.Services

@inherits LayoutComponentBase

@inject IUserContextService userContext

@inject NavigationManager Navigation

<div class="layout-container">
        <nav class="@sidebarClass">
        <div class="sidebar-header">
            <h5 class="sidebar-label">Admin</h5>
        </div>

        <ul class="sidebar-menu">
            @if (IsBoss)
            {
            <li>
                <NavLink class="sidebar-link" href="/admin" Match="NavLinkMatch.All">
                    <span class="nav-icon"><span class="ti ti-layout-dashboard" aria-hidden="true"></span></span>
                    <span class="nav-label">Dashboard</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>
            }
            <li>
                <NavLink class="sidebar-link" href="/admin/customer">
                    <span class="nav-icon"><span class="ti ti-users" aria-hidden="true"></span></span>
                    <span class="nav-label">Customers</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="/admin/companyitem">
                    <span class="nav-icon"><span class="ti ti-box" aria-hidden="true"></span></span>
                    <span class="nav-label">Company Items</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="/admin/mapitem">
                    <span class="nav-icon"><span class="ti ti-map-pin" aria-hidden="true"></span></span>
                    <span class="nav-label">Map Items</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>

            @if (IsBoss)
            {
                <li>
                    <NavLink class="sidebar-link" href="/admin/users">
                        <span class="nav-icon"><span class="ti ti-user-shield" aria-hidden="true"></span></span>
                        <span class="nav-label">Users</span>
                        <span aria-hidden="true"></span>
                    </NavLink>
                </li>
            <li>
                <NavLink class="sidebar-link" href="/admin/salesinvoice">
                    <span class="nav-icon"><span class="ti ti-file-invoice" aria-hidden="true"></span></span>
                    <span class="nav-label">Sales Invoices</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>
            <li>
                <NavLink class="sidebar-link" href="/admin/subditem">
                    <span class="nav-icon"><span class="ti ti-package" aria-hidden="true"></span></span>
                    <span class="nav-label">SubDistributors Items</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>
                        <li>
                <NavLink class="sidebar-link" href="/admin/subdistributor">
                    <span class="nav-icon"><span class="ti ti-building-store" aria-hidden="true"></span></span>
                    <span class="nav-label">SubDistributors</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>
            }
            <li>
                <NavLink class="sidebar-link" href="/admin/priceincrease">
                    <span class="nav-icon"><span class="ti ti-history" aria-hidden="true"></span></span>
                    <span class="nav-label">Price Changes</span>
                    <span aria-hidden="true"></span>
                </NavLink>
            </li>
        </ul>
        </nav>

    <div class="right-column">
        <AdminTopBar OnHamburgerClick="ToggleSidebar" />

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool sidebarOpen = true;
    private List<string> BossUsernames = new List<string> { "angelfhaye14", "Manilyn" };
    private bool IsBoss =>
        userContext.Username is not null &&
        BossUsernames.Contains(userContext.Username);
    private string sidebarClass => sidebarOpen ? "sidebar sidebar-open" : "sidebar sidebar-closed";

    private Task ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
