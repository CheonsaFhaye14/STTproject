@using STTproject.Shared.Components.Modals
@inject NavigationManager Navigation

<header class="user-topbar">
    <div class="topbar-left">
        <button class="menu-btn" type="button" @onclick="() => OnHamburgerClick.InvokeAsync()">
            <span class="hamburger-icon" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>

        <img src="/images/WebsiteLogo.png" alt="Logo" class="site-logo" />
        <span class="site-name">Entriél</span>
    </div>

    <div class="topbar-right">
        <a class="logout-btn" @onclick="() => showLogoutConfirmModal = true">
            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
            <span class="logout-label">Logout</span>
        </a>
    </div>

    <ConfirmModal @ref="logoutConfirmModal" Show="showLogoutConfirmModal"
                  Title="Confirm Logout"
                  Message="Are you sure you want to log out?"
                  OnYes="ConfirmLogout" OnNo="CancelLogout" />
</header>

@code {
    [Parameter]
    public EventCallback OnHamburgerClick { get; set; }
    private bool showLogoutConfirmModal;

    private ConfirmModal? logoutConfirmModal;
    private void ConfirmLogout()
    {
        showLogoutConfirmModal = false;
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
    private void CancelLogout()
    {
        showLogoutConfirmModal = false;
    }
}
