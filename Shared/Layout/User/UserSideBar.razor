@inherits LayoutComponentBase
@inject IUserContextService userContext
@inject NavigationManager Navigation

<div class="layout-container">

    <!-- Sidebar (full height, left) -->
    <nav class="@sidebarClass">

        <!-- Sidebar Header: Encoder -->
        <div class="sidebar-header">
            <h5 class="sidebar-label">Encoder</h5>
        </div>

        <ul class="sidebar-menu">

            <li>
                <NavLink class="sidebar-link" href="home" Match="NavLinkMatch.All">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3 4 9v11h6v-5h4v5h6V9l-8-6Z"/></svg>
                    </span>
                    <span class="sidebar-label">Home</span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="mapitem">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M20 10c0-4.42-3.58-8-8-8S4 5.58 4 10c0 3.13 1.8 5.87 4.47 7.2L12 22l3.53-4.8A8.01 8.01 0 0 0 20 10Zm-8 2.5A4.5 4.5 0 1 1 16.5 8 4.5 4.5 0 0 1 12 12.5Z"/></svg>
                    </span>
                    <span class="sidebar-label">Map Items</span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="customer">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M16 11a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 16 11Zm-8 0a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 8 11Zm0 2c-2.67 0-8 1.34-8 4v2h10v-2c0-1.34-1.07-2.47-2.56-3.12A5.56 5.56 0 0 0 8 13Zm8 0c-.9 0-1.74.16-2.5.44A5.57 5.57 0 0 1 16 15v2h8v-2c0-2.66-5.33-4-8-4Z"/></svg>
                    </span>
                    <span class="sidebar-label">Customers</span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="profile">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-3.33 0-6 1.67-6 4v2h12v-2c0-2.33-2.67-4-6-4Z"/></svg>
                    </span>
                    <span class="sidebar-label">Profile</span>
                </NavLink>
            </li>

            <li>
                <NavLink class="sidebar-link" href="help">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 16a1.25 1.25 0 1 1 1.25-1.25A1.25 1.25 0 0 1 12 18Zm1.5-5.8c-.4.4-.8.7-.8 1.8H11c0-1.7.6-2.4 1.2-3l.3-.3a1.6 1.6 0 0 0-1.1-2.8 1.6 1.6 0 0 0-1.6 1.4H8.8A3.2 3.2 0 0 1 12 5.8a3.2 3.2 0 0 1 2.2 5.4Z"/></svg>
                    </span>
                    <span class="sidebar-label">Help</span>
                </NavLink>
            </li>

            @* <li>
                <NavLink class="sidebar-link" href="settings">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M19.14 12.94a7.32 7.32 0 0 0 .05-.94 7.32 7.32 0 0 0-.05-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.26 7.26 0 0 0-1.63-.94L14.4 2.5a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.35 2.56a7.26 7.26 0 0 0-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.7 10.72a.5.5 0 0 0 .12.64l2.03 1.58a7.32 7.32 0 0 0-.05.94 7.32 7.32 0 0 0 .05.94L2.82 14.5a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96a7.26 7.26 0 0 0 1.63.94l.35 2.56a.5.5 0 0 0 .5.42h3.84a.5.5 0 0 0 .5-.42l.35-2.56a7.26 7.26 0 0 0 1.63-.94l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64ZM12 15.5A3.5 3.5 0 1 1 15.5 12 3.5 3.5 0 0 1 12 15.5Z"/></svg>
                    </span>
                    <span class="sidebar-label">Settings</span>
                </NavLink>
            </li> *@

        </ul>

    </nav>

    <!-- Right Column: TopBar + Content -->
    <div class="right-column">

        <UserTopBar OnHamburgerClick="ToggleSidebar" />

        <main class="main-content">
            @Body
        </main>

    </div>

</div>

@code {
    private bool sidebarOpen = true;

    private string sidebarClass => sidebarOpen ? "sidebar sidebar-open" : "sidebar sidebar-closed";

    private Task ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
