@typeparam TItem
@using System.Reflection
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th class="row-num"></th>
                @foreach (var column in Columns)
                {
                    <th>@(ColumnLabels.TryGetValue(column, out var label) ? label : column)</th>
                }
                @if (RemoveButtonVisible || RowActionsTemplate is not null)
                {
                    <th class="action-col"></th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Items.Count; i++)
            {
                var idx = i;
                var item = Items[idx];
                var isGroupStart = string.IsNullOrEmpty(GroupColumn)
                    || idx == 0
                    || GetPropertyValue(Items[idx - 1], GroupColumn) != GetPropertyValue(item, GroupColumn);
                <tr class="@(string.IsNullOrEmpty(GroupColumn) ? "" : (isGroupStart ? "group-start" : "group-continuation"))">
                    <td class="row-num">@(idx + 1)</td>
                    @foreach (var column in Columns)
                    {
                        var col = column;
                        var editable = !ViewMode && EditableColumns.Contains(col)
                            && (IsCellEditableOverride?.Invoke(item, col) ?? true);
                        var isSuppressedGroupCell = !string.IsNullOrEmpty(GroupColumn) && col == GroupColumn && !isGroupStart;
                        <td>
                            @if (isSuppressedGroupCell)
                            {
                                <span class="group-empty"></span>
                            }
                            else if (editable)
                            {
                                <input value="@GetEditableValue(item, col)"
                                       type="@(ColumnInputTypes.TryGetValue(col, out var it) ? it : "text")"
                                       placeholder="@GetPlaceholder(item, col)"
                                       size="@GetInputSize(item, col)"
                                       disabled="@Disabled"
                                       @oninput="e => SetPropertyValue(item, col, e.Value?.ToString())"
                                       @onchange="async e =>
                                       {
                                           SetPropertyValue(item, col, e.Value?.ToString());
                                           await OnCellChanged.InvokeAsync((item, col));
                                       }" />
                            }
                            else
                            {
                                <input value="@GetPropertyValue(item, col)" size="@GetInputSize(item, col)" disabled />
                            }
                        </td>
                    }
                    @if (RemoveButtonVisible || RowActionsTemplate is not null)
                    {
                        <td class="action-col">
                            @if (RowActionsTemplate is not null)
                            {
                                @RowActionsTemplate(item)
                            }
                            else if (Items.Count > MinItems)
                            {
                                <button type="button" class="remove-btn" aria-label="Remove"
                                        disabled="@RemoveButtonDisabled"
                                        @onclick="() => RemoveRow(idx)">
                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                </button>
                            }
                        </td>
                    }
                </tr>
                @if (ShowError && ErrorSelector?.Invoke(idx) is { Length: > 0 } rowError)
                {
                    <tr class="error-row">
                        <td></td>
                        <td colspan="@(Columns.Count + ((RemoveButtonVisible || RowActionsTemplate is not null) ? 1 : 0))">
                            <span class="error-text">@rowError</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (AddButtonVisible)
    {
        <div class="table-footer">
            <button type="button" class="add-btn" @onclick="() => OnAdd.InvokeAsync()" disabled="@AddButtonDisabled">
                @AddTableButtonText
            </button>
        </div>
    }
</div>
@if (ShowError && !string.IsNullOrWhiteSpace(GeneralErrorText))
{
    <span class="error-text">@GeneralErrorText</span>
}

@code
{
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public Dictionary<string, string> ColumnLabels { get; set; } = new();
    [Parameter] public List<string> EditableColumns { get; set; } = new();
    [Parameter] public Dictionary<string, string> ColumnPlaceholders { get; set; } = new();
    [Parameter] public bool ViewMode { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MinItems { get; set; } = 0;

    [Parameter] public bool AddButtonVisible { get; set; }
    [Parameter] public bool AddButtonDisabled { get; set; }
    [Parameter] public string AddTableButtonText { get; set; } = "Add";
    [Parameter] public EventCallback OnAdd { get; set; }

    [Parameter] public bool RemoveButtonVisible { get; set; }
    [Parameter] public bool RemoveButtonDisabled { get; set; }
    [Parameter] public EventCallback<int> OnRemove { get; set; }

    [Parameter] public bool ShowError { get; set; }
    [Parameter] public Func<int, string?>? ErrorSelector { get; set; }
    [Parameter] public string? GeneralErrorText { get; set; }
    [Parameter] public Func<TItem, string, string?>? DisplayValueSelector { get; set; }
    [Parameter] public string? GroupColumn { get; set; }
    [Parameter] public Func<TItem, string, bool>? IsCellEditableOverride { get; set; }
    [Parameter] public EventCallback<(TItem Item, string Column)> OnCellChanged { get; set; }
    [Parameter] public RenderFragment<TItem>? RowActionsTemplate { get; set; }
    [Parameter] public Dictionary<string, string> ColumnInputTypes { get; set; } = new();

    // Lets a numeric/editable cell show its own raw value (not the formatted
    // display string, which may be non-numeric text like "Enter manually" and
    // would be silently rejected by <input type="number">), plus an optional
    // per-row placeholder hint shown when that value is empty.
    [Parameter] public Func<TItem, string, string?>? EditableValueSelector { get; set; }
    [Parameter] public Func<TItem, string, string?>? PlaceholderSelector { get; set; }

    private static readonly Dictionary<string, PropertyInfo?> PropertyCache = new();

    private PropertyInfo? GetProperty(string column)
    {
        if (!PropertyCache.TryGetValue(column, out var prop))
        {
            prop = typeof(TItem).GetProperty(column, BindingFlags.Public | BindingFlags.Instance);
            PropertyCache[column] = prop;
        }
        return prop;
    }

    // Drives column auto-sizing: the browser's table-layout:auto pass takes the
    // widest `size` across all cells in a column, so this doesn't need to be exact —
    // it just needs to reflect roughly how much room this cell's content wants.
    private int GetInputSize(TItem item, string column)
    {
        var value = GetPropertyValue(item, column) ?? string.Empty;
        var placeholder = GetPlaceholder(item, column);
        var label = ColumnLabels.TryGetValue(column, out var lbl) ? lbl : column;
        var longest = new[] { value.Length, placeholder.Length, label.Length }.Max();
        return Math.Clamp(longest + 2, 4, 60);
    }

    private string GetEditableValue(TItem item, string column)
    {
        if (EditableValueSelector is not null)
        {
            var custom = EditableValueSelector(item, column);
            if (custom is not null) return custom;
        }

        var prop = GetProperty(column);
        if (prop is null) return string.Empty;
        return prop.GetValue(item)?.ToString() ?? string.Empty;
    }

    private string GetPlaceholder(TItem item, string column)
    {
        if (PlaceholderSelector is not null)
        {
            var custom = PlaceholderSelector(item, column);
            if (custom is not null) return custom;
        }

        return ColumnPlaceholders.TryGetValue(column, out var ph) ? ph : string.Empty;
    }

    private string GetPropertyValue(TItem item, string column)
    {
        if (item is null) return string.Empty;

        if (DisplayValueSelector is not null)
        {
            var custom = DisplayValueSelector(item, column);
            if (custom is not null) return custom;
        }

        var prop = GetProperty(column);
        if (prop is null) return string.Empty;
        return prop.GetValue(item)?.ToString() ?? string.Empty;
    }

    private void SetPropertyValue(TItem item, string column, string? value)
    {
        var prop = GetProperty(column);
        if (prop is null || item is null || !prop.CanWrite) return;

        var underlying = Nullable.GetUnderlyingType(prop.PropertyType);
        var targetType = underlying ?? prop.PropertyType;

        if (targetType == typeof(string))
        {
            prop.SetValue(item, value);
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            if (underlying is not null) prop.SetValue(item, null);
            return;
        }

        if (targetType == typeof(decimal) && decimal.TryParse(value, out var d)) prop.SetValue(item, d);
        else if (targetType == typeof(int) && int.TryParse(value, out var n)) prop.SetValue(item, n);
        else if (targetType == typeof(bool) && bool.TryParse(value, out var b)) prop.SetValue(item, b);
    }

    private async Task RemoveRow(int idx)
    {
        if (idx >= 0 && idx < Items.Count && Items.Count > MinItems)
        {
            Items.RemoveAt(idx);
        }
        await OnRemove.InvokeAsync(idx);
    }
}
