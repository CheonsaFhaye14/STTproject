@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<span class="btn-tooltip-wrap" @onmousemove="OnMouseMove" @onmouseenter="OnMouseEnter" @onmouseleave="OnMouseLeave">
    <button class="btn @VariantClass" @onclick="OnClick" disabled="@Disabled" type="@Type">
        @if (IconContent != null)
        {
            <span class="btn-icon" aria-hidden="true">@IconContent</span>
        }
        else if (Icon != null)
        {
            <i class="@Icon"></i>
        }
        @if (Title != null)
        {
            <span>@Title</span>
        }
    </button>
    @if (!string.IsNullOrWhiteSpace(Tooltip) && (isHovering || isFocused))
    {
        <span class="btn-tooltip-bubble" role="tooltip"
              style="left:@(mouseX + 14)px; top:@(mouseY + 18)px;">
            @Tooltip
        </span>
    }
</span>

<style>
    .btn
    {
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .btn-primary
    {
        background-color: var(--app-accent-strong) !important;
        color: var(--app-dark-deep) !important;
        border-radius: 10px;
        border: none !important;
        box-shadow: 0 2px 6px rgba(33, 26, 16, 0.16) !important;
    }

    .btn-primary:hover
    {
        background-color: var(--app-accent) !important;
        color: var(--app-dark-deep) !important;
        transform: translateY(-1px);
    }

    .btn-secondary
    {
        background-color: var(--app-surface) !important;
        color: var(--app-accent-dark) !important;
        border-radius: 10px;
        border: 1px solid var(--app-border) !important;
        box-shadow: 0 2px 6px rgba(33, 26, 16, 0.08) !important;
    }

    .btn-secondary:hover
    {
        background-color: var(--app-accent) !important;
        color: var(--app-dark-deep) !important;
        border-color: var(--app-accent-strong) !important;
    }

    .btn-Cancel
    {
        background-color: var(--app-surface) !important;
        color: var(--app-accent-dark) !important;
        border-radius: 10px;
        border: 1px solid var(--app-border) !important;
        box-shadow: 0 2px 6px rgba(33, 26, 16, 0.08) !important;
    }
    .btn-Cancel:hover
    {
        background-color: var(--app-accent) !important;
        color: var(--app-dark-deep) !important;
        border-color: var(--app-accent-strong) !important;
    }

    .btn:disabled
    {
        background: #d8cbb0;
        color: #ffffff;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }

    /* Stays applied as long as the button has focus — including right
       after a click, since clicking also focuses the button. */
    .btn:focus,
    .btn:active,
    .btn:active:focus
    {
        outline: 2px solid var(--app-accent-strong);
        box-shadow: 0 2px 6px rgba(33, 26, 16, 0.16);
    }

    .btn-icon
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .btn-icon ::deep svg
    {
        width: 100%;
        height: 100%;
        fill: currentColor;
    }

    /* ── Icon-only action button ── */
    .icon-action-btn
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid #E5E3DD;
        border-radius: 8px;
        background: #FFFFFF;
        color: #5F5E5A;
        gap: 0;
    }

        .icon-action-btn:hover:not(:disabled)
        {
            background: #F7F6F4;
            color: #1B1B1F;
            border-color: #B08D57;
        }

        .icon-action-btn:disabled
        {
            background: #F7F6F4;
            color: #B8B6B2;
            opacity: 0.5;
            cursor: not-allowed;
        }

        .icon-action-btn i,
        .icon-action-btn .btn-icon
        {
            width: 16px;
            height: 16px;
            font-size: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .icon-action-btn .btn-icon ::deep svg
        {
            fill: currentColor;
        }

    .edit-btn:hover:not(:disabled)
    {
        color: #8A6A34;
    }

    .delete-btn:hover:not(:disabled)
    {
        color: #A33A3A;
    }

    /* ── Tooltip ── */
    .btn-tooltip-wrap
    {
        position: relative;
        display: inline-flex;
    }

    .btn-tooltip-bubble
    {
        position: fixed;
        background: var(--app-dark-deep, #211a10);
        color: #fff;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
        padding: 6px 10px;
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
        pointer-events: none;
        z-index: 2147483647;
    }
</style>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Tooltip { get; set; }

    private bool isHovering;
    private bool isFocused;
    private double mouseX;
    private double mouseY;

    private void OnMouseEnter(MouseEventArgs e)
    {
        isHovering = true;
        mouseX = e.ClientX;
        mouseY = e.ClientY;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        mouseX = e.ClientX;
        mouseY = e.ClientY;
    }

    private void OnMouseLeave(MouseEventArgs e)
    {
        isHovering = false;
    }

    private string VariantClass => Variant switch
    {
        ButtonVariant.Primary => "btn-primary",
        ButtonVariant.Cancel => "btn-Cancel",
        ButtonVariant.IconAction => "icon-action-btn",
        ButtonVariant.IconActionEdit => "icon-action-btn edit-btn",
        ButtonVariant.IconActionDelete => "icon-action-btn delete-btn",
        _ => "btn-secondary"
    };
}