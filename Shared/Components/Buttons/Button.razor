@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<button class="btn @VariantClass" @onclick="OnClick" disabled="@Disabled" type="@Type">
    @if (Icon != null)
    {
        <i class="@Icon"></i>
    }
    @Title
</button>

<style>
    .btn
    {
        border: none;
        border-radius: 7px;
        padding: 9px 18px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
    }
    .btn-secondary
    {
        background: #f0eee9;
        color: #4a4a4a;
    }
    .btn-secondary:hover
    {
        background: #e5e2dc;
    }
    .btn-primary
    {
        background: #a27332;
        color: white;
    }
    .btn-primary:hover
    {
        background: #a97f45;
    }
    .btn:disabled
    {
        background: #d8cbb0;
        color: #ffffff;
        cursor: not-allowed;
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Button";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public string Type { get; set; } = "button";

    private string VariantClass => Variant == ButtonVariant.Primary ? "btn-primary" : "btn-secondary";
}
