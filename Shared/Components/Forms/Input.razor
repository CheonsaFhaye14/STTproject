@using System.Globalization
@typeparam TValue
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@if (!string.IsNullOrWhiteSpace(Label))
{
    <label class="form-label">
        @Label
        @if (Required)
        {
            <span class="required-asterisk">*</span>
        }
    </label>
}
<input type="@InputType"
       placeholder="@Placeholder"
       disabled="@Disabled"
       value="@DisplayValue"
       step="@Step"
       @oninput="OnInputChanged"
       @ref="InputElement" />
@if (ShowError && !string.IsNullOrWhiteSpace(ErrorText))
{
    <span class="error-text">@ErrorText</span>
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool ShowError { get; set; } = true;
    [Parameter] public string? Step { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    private ElementReference InputElement;
    public ElementReference GetInputRef() => InputElement;

    private static readonly Type UnderlyingType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private string InputType => UnderlyingType == typeof(string) ? "text" : "number";

    private string DisplayValue => Value switch
    {
        null => string.Empty,
        decimal d => d.ToString(CultureInfo.InvariantCulture),
        double d => d.ToString(CultureInfo.InvariantCulture),
        _ => Value.ToString() ?? string.Empty
    };

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (UnderlyingType == typeof(string))
        {
            Value = (TValue?)(object?)raw;
            await ValueChanged.InvokeAsync(Value);
            return;
        }

        if (string.IsNullOrWhiteSpace(raw))
        {
            Value = default;
            await ValueChanged.InvokeAsync(Value);
            return;
        }

        object? parsed = null;
        bool ok = false;

        if (UnderlyingType == typeof(int))
        {
            ok = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var iv);
            parsed = iv;
        }
        else if (UnderlyingType == typeof(decimal))
        {
            ok = decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var dv);
            parsed = dv;
        }
        else if (UnderlyingType == typeof(double))
        {
            ok = double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var dv2);
            parsed = dv2;
        }

        if (ok)
        {
            Value = (TValue?)parsed;
            await ValueChanged.InvokeAsync(Value);
        }
    }
}