@using Microsoft.JSInterop
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

@if (!string.IsNullOrWhiteSpace(Label))
{
    <label class="form-label">
        @Label
        @if (Required)
        {
            <span class="required">*</span>
        }
    </label>
}

<div class="autocomplete-wrapper" @onfocusout="HandleFocusOut">
    <input type="text"
           class="form-control"
           placeholder="@(Placeholder ?? "-- Search --")"
           disabled="@Disabled"
           value="@SearchText"
           @ref="InputElement"
           @oninput="OnInputChanged"
           @onfocus="OnFocus"
           @onkeydown="OnKeyDown"
           autocomplete="off" />

    @if (ShowSuggestions && FilteredItems.Any())
    {
        <ul class="autocomplete-list">
            @for (int i = 0; i < FilteredItems.Count; i++)
            {
                var item = FilteredItems[i];
                var index = i;
                <li class="autocomplete-item @(index == HighlightedIndex ? "active" : "")"
                    @onmousedown:preventDefault="true"
                    @onmousedown="() => SelectItem(item)"
                    @onmouseover="() => HighlightedIndex = index">
                    @GetText(item)
                </li>
            }
        </ul>
    }
    else if (ShowSuggestions && !FilteredItems.Any() && !string.IsNullOrEmpty(SearchText))
    {
        <ul class="autocomplete-list">
            <li class="autocomplete-item disabled">@NoResultsText</li>
        </ul>
    }
</div>
@if (ShowError && !string.IsNullOrWhiteSpace(ErrorText))
{
    <span class="error-text">@ErrorText</span>
}


<style>
.autocomplete-wrapper {
    position: relative;
}

.required {
    color: #dc3545;
    margin-left: 2px;
}

.autocomplete-list {
    position: absolute;
    z-index: 1000;
    top: 100%;
    left: 0;
    right: 0;
    max-height: 220px;
    overflow-y: auto;
    margin: 2px 0 0 0;
    padding: 4px 0;
    list-style: none;
    background: #fff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.autocomplete-item {
    padding: 6px 12px;
    cursor: pointer;
}

.autocomplete-item:hover,
.autocomplete-item.active {
    background-color: #e9ecef;
}

.autocomplete-item.disabled {
    color: #6c757d;
    cursor: default;
}

.autocomplete-item.disabled:hover {
    background-color: transparent;
}
</style>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }

    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter] public Func<TItem, string>? ValueSelector { get; set; }
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }

    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string> SelectedValueChanged { get; set; }

    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }

    [Parameter] public EventCallback OnConfirmed { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MinSearchLength { get; set; } = 0;
    [Parameter] public string NoResultsText { get; set; } = "No results found";

    [Parameter] public bool ShowAllOnOpen { get; set; } = false;

    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool ShowError { get; set; } = true;
    [Parameter] public bool AllowCustomValue { get; set; } = false;

    private string SearchText { get; set; } = string.Empty;
    private bool ShowSuggestions { get; set; }
    private int HighlightedIndex { get; set; } = -1;
    private bool ShowingAll { get; set; }
    private bool HasSelectedItem { get; set; }
    private List<TItem> FilteredItems { get; set; } = new();

    private ElementReference InputElement;

    private string GetValue(TItem item) => ValueSelector is not null
        ? ValueSelector(item)
        : item?.ToString() ?? string.Empty;

    private string GetText(TItem item) => TextSelector is not null
        ? TextSelector(item)
        : item?.ToString() ?? string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(SelectedValue) && string.IsNullOrEmpty(SearchText))
        {
            var match = Items.FirstOrDefault(i =>
                GetValue(i) == SelectedValue || GetText(i) == SelectedValue);

            if (match is not null)
            {
                SearchText = GetText(match);
            }
            else if (AllowCustomValue)
            {
                SearchText = SelectedValue;
            }
        }
    }

    private void RefreshFilteredItems()
    {
        FilteredItems = ShowingAll
            ? Items.ToList()
            : (SearchText.Length >= MinSearchLength
                ? Items.Where(i => GetText(i).Contains(SearchText, StringComparison.OrdinalIgnoreCase)).ToList()
                : new List<TItem>());
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        HighlightedIndex = -1;
        HasSelectedItem = false;
        ShowingAll = false;
        ShowSuggestions = SearchText.Length >= MinSearchLength;
        RefreshFilteredItems();

        if (SelectedValue is not null)
        {
            var current = Items.FirstOrDefault(i =>
                GetValue(i) == SelectedValue || GetText(i) == SelectedValue);

            if (current is not null && GetText(current) != SearchText)
            {
                 _ = AcceptCustomValueAsync();
            }
            if (current is null)
            {
                _ = ClearSelectionAsync();
            }
        }
    }

    private void OnFocus()
    {
        ShowingAll = ShowAllOnOpen;
        ShowSuggestions = true;
        RefreshFilteredItems();
        HighlightedIndex = FilteredItems.Any() ? 0 : -1;
    }

    private void HandleFocusOut()
    {
        if (AllowCustomValue && !HasSelectedItem && !string.IsNullOrWhiteSpace(SearchText))
        {
            var match = Items.FirstOrDefault(i => GetText(i).Equals(SearchText, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                _ = SelectItem(match);
            }
            else
            {
                _ = AcceptCustomValueAsync();
            }
        }

        ShowSuggestions = false;
        HighlightedIndex = -1;
    }

    // NEW: two-stage Enter (like doc2) + OnConfirmed
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (!ShowSuggestions)
                {
                    ShowingAll = ShowAllOnOpen;
                    ShowSuggestions = true;
                    RefreshFilteredItems();
                }
                if (FilteredItems.Any())
                    HighlightedIndex = Math.Min(HighlightedIndex + 1, FilteredItems.Count - 1);
                break;

            case "ArrowUp":
                if (FilteredItems.Any())
                    HighlightedIndex = Math.Max(HighlightedIndex - 1, 0);
                break;

            case "Enter":
                if (!ShowSuggestions && !HasSelectedItem)
                {
                    ShowingAll = ShowAllOnOpen;
                    ShowSuggestions = true;
                    RefreshFilteredItems();
                    HighlightedIndex = FilteredItems.Any() ? 0 : -1;
                    return;
                }

                if (ShowSuggestions)
                {
                    var toSelect = HighlightedIndex >= 0 && HighlightedIndex < FilteredItems.Count
                        ? FilteredItems[HighlightedIndex]
                        : FilteredItems.FirstOrDefault();

                    if (toSelect is not null)
                    {
                        await SelectItem(toSelect);
                    }
                    else if (AllowCustomValue && !string.IsNullOrWhiteSpace(SearchText))
                    {
                        await AcceptCustomValueAsync();
                    }
                    else
                    {
                        ShowSuggestions = false;
                    }

                    await OnConfirmed.InvokeAsync();
                    return;
                }

                if (HasSelectedItem)
                {
                    await OnConfirmed.InvokeAsync();
                }
                break;

            case "Escape":
                ShowSuggestions = false;
                HighlightedIndex = -1;
                ShowingAll = false;
                break;
        }
    }

    private async Task SelectItem(TItem item)
    {
        SearchText = GetText(item);
        SelectedValue = GetValue(item);
        ShowSuggestions = false;
        HighlightedIndex = -1;
        HasSelectedItem = true;
        ShowingAll = false;

        await SelectedValueChanged.InvokeAsync(SelectedValue);
        await SelectedItemChanged.InvokeAsync(item);
    }
    private async Task AcceptCustomValueAsync()
    {
        SelectedValue = SearchText;
        ShowSuggestions = false;
        HighlightedIndex = -1;
        HasSelectedItem = true;
        ShowingAll = false;

        await SelectedValueChanged.InvokeAsync(SelectedValue);
        await SelectedItemChanged.InvokeAsync(default); 
    }

    private async Task ClearSelectionAsync()
    {
        SelectedValue = null;
        HasSelectedItem = false;
        await SelectedValueChanged.InvokeAsync(SelectedValue);
        await SelectedItemChanged.InvokeAsync(default);
    }

    public async Task OpenPopupAsync()
    {
        ShowingAll = ShowAllOnOpen;
        ShowSuggestions = true;
        RefreshFilteredItems();
        HighlightedIndex = FilteredItems.Any() ? 0 : -1;
        StateHasChanged();
        await InputElement.FocusAsync();
    }

    public ElementReference GetInputRef() => InputElement;
}