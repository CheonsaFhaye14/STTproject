@using Microsoft.JSInterop
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

@if (!string.IsNullOrWhiteSpace(Label))
{
    <label class="form-label">
        @Label
        @if (Required)
        {
            <span class="required-asterisk">*</span>
        }
        @if (AddOptionalText)
        {
            <span class="optional-text">@OptionalText</span>
        }
    </label>
}

<select @onchange="OnSelectedValueChanged"
        class="form-select"
        disabled="@Disabled"
        @ref="SelectElement">

    <option value="" selected="@(string.IsNullOrEmpty(SelectedValue))">
        @(Placeholder ?? "-- Select an option --")
    </option>

    @foreach (var item in Items)
    {
        var itemValue = GetValue(item);
        <option value="@itemValue" selected="@(itemValue == SelectedValue)">
            @GetText(item)
        </option>
    }

    @if (ExtraOptions is not null)
    {
        @foreach (var extra in ExtraOptions)
        {
            <option value="@extra.Value" selected="@(extra.Value == SelectedValue)">
                @extra.Text
            </option>
        }
    }
</select>
@if (ShowError && !string.IsNullOrWhiteSpace(ErrorText))
{
    <span class="error-text">@ErrorText</span>
}

<style>
.required-asterisk {
    color: #dc3545;
    margin-left: 2px;
}
.Optional-text {
    font-size: 0.9em;
    color: #6c757d;
    margin-left: 5px;
}
</style>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool ShowError { get; set; } = true;
    [Parameter] public bool AddOptionalText { get; set; } = false;
    [Parameter] public string? OptionalText { get; set; } = "(Optional)";
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter] public Func<TItem, string>? ValueSelector { get; set; }
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }

    [Parameter] public IEnumerable<(string Value, string Text)>? ExtraOptions { get; set; }

    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string> SelectedValueChanged { get; set; }

    private ElementReference SelectElement;
    public ElementReference GetInputRef() => SelectElement;

    private string GetValue(TItem item) => ValueSelector is not null
        ? ValueSelector(item)
        : item?.ToString() ?? string.Empty;

    private string GetText(TItem item) => TextSelector is not null
        ? TextSelector(item)
        : item?.ToString() ?? string.Empty;

    private async Task OnSelectedValueChanged(ChangeEventArgs e)
    {
        SelectedValue = e.Value?.ToString() ?? string.Empty;
        await SelectedValueChanged.InvokeAsync(SelectedValue);
    }
}