
<div class="form-item">
    <div class="form-header" @onclick="ToggleExpand" style="cursor:@(Expandable ? "pointer" : "default")">
        <div class="form-header-left">
            <div class="form-icon"><i class="@Icon" aria-hidden="true"></i></div>
            <div>
                @if (Optional)
                {
                    <div class="form-title">@Title <span class="optional-tag">optional</span></div>
                }
                else
                {
                    <div class="form-title">@Title</div>
                }
                <div class="form-sub">@Summary</div>
            </div>
        </div>
        @if (Expandable)
        {
        <i class="ti ti-chevron-down form-chevron @(isOpen ? "open" : "")" aria-hidden="true">
        </i>        
        }
    </div>
    @if (!Expandable || isOpen)
    {
        <div class="form-body">
            @ChildContent
        </div>
    }
</div>
<style>
    
.form-item {
    position: relative;
    z-index: 1;
    border: 0.5px solid #9C968A;
    border-radius: 12px;
    background: #d6d2c9;
    margin-bottom: 10px;
    flex-shrink: 0;
    transition: box-shadow 0.15s, border-color 0.15s;
}

    .form-item:hover {
        border-color: #E1D9BC;
    }


    .form-item:focus-within {
        z-index: 50;
    }

    .form-item.expanded,
    .form-item.open {
        z-index: 50;
    }

.form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    cursor: pointer;
    user-select: none;
}

.form-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.form-icon {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: #C9A227;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1B1B1F;
    font-size: 14px;
    flex-shrink: 0;
}

.form-title {
    font-size: 13px;
    font-weight: 600;
    color: #1B1B1F;
}

.form-sub {
    font-size: 11px;
    color: #9C968A;
    margin-top: 1px;
}


.optional-tag {
    font-size: 10px;
    font-weight: 500;
    color: #8E897C;
    text-transform: lowercase;
}

.form-chevron {
    font-size: 15px;
    color: #9C968A;
    transition: transform 0.2s;
    flex-shrink: 0;
}

    .form-chevron.open {
        transform: rotate(180deg);
    }

.form-body {
    padding: 0.9rem 1rem;
    border-top: 0.5px solid #EBE7DC;
    background: #fff;
    overflow: visible;
}

</style>
@code
{
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Summary { get; set; }
    [Parameter] public bool Expandable { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Optional { get; set; } = false;

    private bool isOpen;
    private bool hasInitialized;

    protected override void OnParametersSet()
    {
        if (!hasInitialized)
        {
            isOpen = IsExpanded;
            hasInitialized = true;
        }
    }

    private void ToggleExpand()
    {
        if (Expandable)
        {
            isOpen = !isOpen;
        }
    }
}