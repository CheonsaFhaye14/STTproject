@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@if (Show)
{
    <div class="modal-overlay confirm-modal-overlay" @onclick="OnOverlayClick">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-header-left">
                    @if (!string.IsNullOrWhiteSpace(IconClass))
                    {
                        <div class="modal-icon-badge">
                            <i class="@IconClass" aria-hidden="true"></i>
                        </div>
                    }
                    <div class="modal-header-text">
                        <h4>@Title</h4>
                        @if (!string.IsNullOrWhiteSpace(Subtitle))
                        {
                            <span class="modal-subtitle">@Subtitle</span>
                        }
                    </div>
                </div>
                @if (ShowCloseButton)
                {
                    <button type="button" class="modal-close-btn" @onclick="OnCloseClick" aria-label="Close">
                        <i class="fas fa-xmark" aria-hidden="true"></i>
                    </button>
                }
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p class="modal-message">@Message</p>
                }
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="error-display">
                        <strong>Error: </strong>@ErrorMessage
                    </div>
                }
                @ChildContent
            </div>
            <div class="modal-footer">
                @if (ShowError)
                {
                    <button class="btn-primary" @ref="OkButtonRef" @onclick="OnErrorConfirm">@OkLabel</button>
                }
                else
                {
                    <button class="btn-secondary" @onclick="OnNo">@NoLabel</button>
                    <button class="btn-primary" @ref="YesButtonRef" @onclick="OnYes">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <span>@YesLabel</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference YesButtonRef;
    private ElementReference OkButtonRef;
    private bool previousShow = false;

    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm Action";

    [Parameter]
    public string? Subtitle { get; set; }

    // Font Awesome class for the header badge icon. Set to null/empty to hide the badge.
    [Parameter]
    public string? IconClass { get; set; } = "fas fa-upload";

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool ShowError { get; set; }

    [Parameter]
    public string YesLabel { get; set; } = "Yes";

    [Parameter]
    public string NoLabel { get; set; } = "No";

    [Parameter]
    public string OkLabel { get; set; } = "OK";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnYes { get; set; }

    [Parameter]
    public EventCallback OnNo { get; set; }

    [Parameter]
    public EventCallback OnErrorConfirm { get; set; }

    [Parameter]
    public EventCallback? OnClose { get; set; }

    [Parameter]
    public bool CloseOnOverlayClick { get; set; } = true;

    private Task OnOverlayClick()
    {
        if (CloseOnOverlayClick && !ShowError)
        {
            return OnNo.InvokeAsync();
        }
        return Task.CompletedTask;
    }

    private Task OnCloseClick()
    {
        if (OnClose.HasValue && OnClose.Value.HasDelegate)
        {
            return OnClose.Value.InvokeAsync();
        }
        return OnNo.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus Yes button when modal opens in confirmation mode
        if (Show && !previousShow && !ShowError)
        {
            try
            {
                await YesButtonRef.FocusAsync();
            }
            catch
            {
                // Ignore focus errors
            }
        }

        // Focus OK button when modal opens in error mode
        if (Show && !previousShow && ShowError)
        {
            try
            {
                await OkButtonRef.FocusAsync();
            }
            catch
            {
                // Ignore focus errors
            }
        }

        previousShow = Show;
        await base.OnAfterRenderAsync(firstRender);
    }
}
