@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="@GetModalBoxStyle()" @onclick:stopPropagation="true">
            <div class="modal-header">
                @if (Icon != null)
                {
                    <div class="modal-icon">
                        @Icon
                    </div>
                }
                else if (IconType != ModalIconType.None)
                {
                    <div class="modal-icon">
                        <i class="@GetIconClass()"></i>
                    </div>
                }
                <div class="modal-header-text">
                    <h4>@Title</h4>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p>@Subtitle</p>
                    }
                </div>
            </div>
            <div class="modal-body">
                @if (Details != null)
                {
                    <div class="modal-details">
                        <h5>Details:</h5>
                        <p>@Details</p>
                    </div>
                }
                @ChildContent
            </div>
            <div class="modal-footer">
                @FooterContent
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public string Title { get; set; } = "Modal Title";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public ModalIconType IconType { get; set; } = ModalIconType.None;
    [Parameter] public string? Details { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? MaxWidth { get; set; }
    [Parameter] public string? MaxHeight { get; set; }

    private string GetModalBoxStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrWhiteSpace(Width))
            styles.Add($"width:{Width}");
        if (!string.IsNullOrWhiteSpace(MaxWidth))
            styles.Add($"max-width:{MaxWidth}");
        if (!string.IsNullOrWhiteSpace(MaxHeight))
        {
            styles.Add($"max-height:{MaxHeight}");
            styles.Add("overflow-y:auto");
        }

        return string.Join(";", styles);
    }

    private static readonly Dictionary<ModalIconType, string> IconClassMap = new()
    {
        { ModalIconType.Warning,  "fa-solid fa-triangle-exclamation" },
        { ModalIconType.Upload,   "fa-solid fa-upload" },
        { ModalIconType.Success,  "fa-solid fa-check" },
        { ModalIconType.Error,    "fa-solid fa-xmark" },
        { ModalIconType.Info,     "fa-solid fa-info" },
        { ModalIconType.Question, "fa-solid fa-question" },
        { ModalIconType.UserPlus, "fa-solid fa-user-plus" },
        { ModalIconType.UserEdit, "fa-solid fa-user-pen" },
        { ModalIconType.UserView, "fa-solid fa-user" },
        { ModalIconType.Ruler,    "fa-solid fa-ruler-combined" },
        { ModalIconType.ItemView, "fa-solid fa-dolly" },
    };

    private string GetIconClass() =>
        IconClassMap.TryGetValue(IconType, out var cls) ? cls : "";
}