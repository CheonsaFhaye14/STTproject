@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@if (Show)
{
    <Modal ShowModal="true" Icon="@Icon" IconType="IconType" Title="@Title" Subtitle="Confirmation Required"
        OnClose="OnModalCloseHandler">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <h5>@Message</h5>
            }
            @if (!string.IsNullOrWhiteSpace(Details))
            {
                <div class="details">
                    <h6>Details:</h6>
                    <p>@Details</p>
                </div>
            }
            @if (ShowError && !string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-display">
                    <strong>Error: </strong>@ErrorMessage
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (ShowError)
            {
                <button class="btn-secondary" @ref="OkButtonRef" @onclick="OnErrorConfirmHandler">OK</button>
            }
            else
            {
                <button class="btn-primary" @ref="YesButtonRef" @onclick="OnYes">Yes</button>
                <button class="btn-secondary" @onclick="OnNo">No</button>
            }
        </FooterContent>
    </Modal>
}
<style>
    h5
    {
        margin: 0 0 12px;
        font-size: 15px;
        font-weight: 600;
        color: #212020;
        line-height: 1.4;
    }
     .details
    {   
        margin-top: 12px;     
        background-color: #f5f4f2;
        border: 1px solid #e5e3df;
        border-radius: 8px;
        padding: 14px 16px;
    }

    .details h6
    {
        margin: 0 0 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: #212020;
        text-transform: uppercase;
    }

    .details p
    {
        margin: 0;
        font-size: 12px;
        color: #575757;
        line-height: 1.4;
        white-space: pre-line;
    }
    .error-display
    {
        background-color: #fdecea;
        border: 1px solid #f5c6c0;
        border-radius: 8px;
        padding: 12px 14px;
        margin-top: 12px;
        color: #b3261e;
        font-size: 13px;
    }

</style>
@code {
    private ElementReference YesButtonRef;
    private ElementReference OkButtonRef;

    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public ModalIconType IconType { get; set; } = ModalIconType.Question;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Details { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool ShowError { get; set; }
    [Parameter] public EventCallback OnYes { get; set; }
    [Parameter] public EventCallback OnNo { get; set; }
    [Parameter] public EventCallback OnErrorConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    private bool previousShow = false;
    private bool previousShowError = false;

    private Task OnErrorConfirmHandler()
    {
        return OnErrorConfirm.HasDelegate ? OnErrorConfirm.InvokeAsync() : OnNo.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool justOpened = Show && !previousShow;
        bool modeChanged = Show && previousShow && (ShowError != previousShowError);

        if ((justOpened || modeChanged) && !ShowError)
        {
            try { await YesButtonRef.FocusAsync(); } catch { }
        }

        if ((justOpened || modeChanged) && ShowError)
        {
            try { await OkButtonRef.FocusAsync(); } catch { }
        }

        previousShow = Show;
        previousShowError = ShowError;
        await base.OnAfterRenderAsync(firstRender);
    }
    private Task OnModalCloseHandler()
    {
        return OnClose.HasDelegate ? OnClose.InvokeAsync() : OnNo.InvokeAsync();
    }

}