@using Microsoft.AspNetCore.Components.Web.Virtualization

<LoadingOverlay Show="isCommitting" Title="Committing selected company items..." IconClass="fa-solid fa-upload" />

@if (Show)
{
    <div class="modal-overlay import-company-items-overlay" id="import-company-items-overlay">
        <div class="modal-box">

            @* ── Modal header ── *@
            <div class="modal-header-ent">
                <div class="mh-left">
                    <div class="mh-icon">
                        <i class="ti ti-box" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="mh-title">Company Item Import results</div>
                        <div class="mh-sub">
                            @if (!string.IsNullOrWhiteSpace(ImportResult?.Principal))
                            {
                                <span>@ImportResult.Principal</span>
                            }
                        </div>
                    </div>
                </div>
                <Button Icon="ti ti-x" Variant="ButtonVariant.Secondary" OnClick="HandleClose"></Button>
            </div>

            @* ── Modal body ── *@
            <div class="modal-body-ent">
                @if (ImportResult == null)
                {
                    <p class="text-muted" style="font-size:13px;">No import result to display.</p>
                }
                else if (!ImportResult.Issues.Any() && !ImportResult.Rows.Any())
                {
                    <div class="global-alert">
                        <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                        <div>
                            <div class="global-alert-title">No rows to import</div>
                            <p class="hint-text" style="margin:0;">The import file did not contain any valid rows to process.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    var cards = GetCards();
                    var globalIssues = ImportResult.Issues;
                    var counts = GetCounts(cards);
                    var hasSuccessCards = counts.Valid > 0;
                    var hasWarningCards = counts.Warning > 0;
                    var hasErrorCards = counts.Error > 0;
                    // If the current tab has nothing left in it (e.g. after a commit), jump to one that does.
                    EnsureValidTab(hasSuccessCards, hasWarningCards, hasErrorCards);

                    var displayCards = GetFilteredAndSortedCards(cards);
                    var selectableCount = cards.Count(c => c.CanSelect && !c.IsWarningOnly);
                    var selectedCount = cards.Count(c => c.CanSelect && !c.IsWarningOnly && SelectedGroupKeys.Contains(c.Key));
                    var warningSelectableCount = cards.Count(c => c.CanSelect && c.IsWarningOnly);
                    var warningSelectedCount = cards.Count(c => c.CanSelect && c.IsWarningOnly &&
            SelectedGroupKeys.Contains(c.Key));

                    @if (!string.IsNullOrEmpty(commitError))
                    {
                        <div class="global-alert">
                            <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">⚠️ @commitError</div>
                            </div>
                        </div>
                    }

                    @if (hasCommitted)
                    {
                        if (commitFailedCount == 0)
                        {
                            <div class="success-banner">
                                <div class="success-banner-icon"><i class="ti ti-circle-check" aria-hidden="true"></i></div>
                                <div>
                                    <div class="success-banner-title">✅ Successfully committed @commitSavedCount company item(s).</div>
                                    @if (CommitSummary != null)
                                    {
                                        <div class="success-banner-sub">@SummaryText(CommitSummary)</div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="global-alert">
                                <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                                <div>
                                    <div class="global-alert-title">
                                        ⚠️ @commitSavedCount company item(s) committed. @commitFailedCount company item(s) could not be
                                        saved. Check the Errors tab for the reason.
                                    </div>
                                    @if (CommitSummary != null)
                                    {
                                        <p class="hint-text" style="margin:0;">@SummaryText(CommitSummary)</p>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="dup-warning-banner">
                        <i class="ti ti-info-circle" aria-hidden="true"></i>
                        The file decides what happens: new items are created, current prices are updated, past prices go to
                        price history, future prices are scheduled, and a missing Stock UOM is filled in.
                    </div>

                    @* ── Sticky header controls (stay in place while cards scroll) ── *@
                    <div class="sticky-controls">

                        @* ── Summary stat bar ── *@
                        <div class="stat-bar">
                            <div class="sc">
                                <div class="sc-label">Total rows</div>
                                <div class="sc-val">@ImportResult.Rows.Count</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">Company Items</div>
                                <div class="sc-val">@cards.Count</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">Valid</div>
                                <div class="sc-val sc-ok">@counts.Valid</div>
                            </div>
                            @foreach (var chip in GetActionChips())
                            {
                                <div class="sc">
                                    <div class="sc-label">@chip.Label</div>
                                    <div class="sc-val">@chip.Count</div>
                                </div>
                            }
                            <div class="sc">
                                <div class="sc-label">With warnings</div>
                                <div class="sc-val sc-warn">@counts.Warning</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">With errors</div>
                                <div class="sc-val @(hasErrorCards ? "sc-er" : "")">@counts.Error</div>
                            </div>
                        </div>

                        @if (cards.Count > 0)
                        {
                            @* ── Tabs ── *@
                            <div class="tabs">
                                @if (hasSuccessCards)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.SuccessOnly)"
                                            @onclick='() => SetTab(GroupFilter.SuccessOnly)'>
                                        <span class="dot dot-ok"></span>
                                        Valid (@counts.Valid)
                                    </button>
                                }
                                @if (hasWarningCards)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.WarningOnly)"
                                            @onclick='() => SetTab(GroupFilter.WarningOnly)'>
                                        <span class="dot dot-warn"></span>
                                        Warnings (@counts.Warning)
                                    </button>
                                }
                                @if (hasErrorCards)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.ErrorOnly)"
                                            @onclick='() => SetTab(GroupFilter.ErrorOnly)'>
                                        <span class="dot dot-er"></span>
                                        Errors (@counts.Error)
                                    </button>
                                }
                            </div>

                            @* ── Error filter bar (only on error tab) ── *@
                            @if (groupFilter == GroupFilter.ErrorOnly)
                            {
                                <div class="err-filter-bar">
                                    <span class="err-filter-label">
                                        <i class="ti ti-filter" aria-hidden="true"></i>
                                        Filter by error
                                    </span>
                                    <select @onchange="OnErrorFilterChanged" value="@(selectedErrorFilter ?? string.Empty)">
                                        <option value="">All error types</option>
                                        @foreach (var entry in GetDistinctErrorMessages(cards))
                                        {
                                            var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                            <option value="@entry.Message">@display (@entry.Count)</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedErrorFilter))
                                    {
                                        <button type="button" class="clear-filter-btn" @onclick="ClearErrorFilter">
                                            <i class="ti ti-x" aria-hidden="true"></i>
                                            Clear
                                        </button>
                                    }
                                    <button type="button" class="btn-download-errors" @onclick="HandleDownloadErrorReport">
                                        <i class="ti ti-download" aria-hidden="true"></i>
                                        Download Error Report
                                    </button>
                                </div>
                            }

                            @* ── Warning filter bar (only on warning tab) ── *@
                            @if (groupFilter == GroupFilter.WarningOnly && hasWarningCards)
                            {
                                <div class="err-filter-bar">
                                    <span class="err-filter-label">
                                        <i class="ti ti-filter" aria-hidden="true"></i>
                                        Filter warning by
                                    </span>
                                    <select @onchange="OnWarningFilterChanged" value="@(selectedWarningFilter ?? string.Empty)">
                                        <option value="">All warning types</option>
                                        @foreach (var entry in GetDistinctWarningMessages(cards))
                                        {
                                            var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                            <option value="@entry.Message">@display (@entry.Count)</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedWarningFilter))
                                    {
                                        <button type="button" class="clear-filter-btn" @onclick="ClearWarningFilter">
                                            <i class="ti ti-x" aria-hidden="true"></i>
                                            Clear
                                        </button>
                                    }
                                </div>
                            }

                            @* ── Select all (valid tab selects valid only, warnings tab selects warnings only) ── *@
                            @if (groupFilter == GroupFilter.SuccessOnly && selectableCount > 0)
                            {
                                <div class="sel-all-bar">
                                    <input type="checkbox" id="select-all-check" checked="@(selectedCount == selectableCount)"
                                           @onchange="(e) => ToggleSelectAll(e.Value)" />
                                    <label for="select-all-check">Select all valid (@selectedCount / @selectableCount ready)</label>
                                </div>
                            }
                            else if (groupFilter == GroupFilter.WarningOnly && warningSelectableCount > 0)
                            {
                                <div class="sel-all-bar">
                                    <input type="checkbox" id="select-all-warnings-check"
                                           checked="@(warningSelectedCount == warningSelectableCount)"
                                           @onchange="(e) => ToggleSelectAllWarnings(e.Value)" />
                                    <label for="select-all-warnings-check">
                                        Select all with warnings (@warningSelectedCount / @warningSelectableCount ready)
                                    </label>
                                </div>
                            }

                            @* ── Search + sort ── *@
                            <div class="search-sort-bar">
                                <div class="search-input-wrap">
                                    <i class="ti ti-search" aria-hidden="true"></i>
                                    <input type="text"
                                           placeholder="Search item code, name, principal, row or any value from the file…"
                                           value="@searchTerm" @oninput="OnSearchInput" />
                                </div>
                                <select @onchange="OnSortChanged" value="@sortMode">
                                    <option value="@ItemSortMode.RowAscending">Row order</option>
                                    <option value="@ItemSortMode.ItemCode">Item code</option>
                                    <option value="@ItemSortMode.ItemName">Item name</option>
                                </select>
                            </div>
                        }
                    </div>

                    @* ── Global file-level failure ── *@
                    @if (globalIssues.Any())
                    {
                        <div class="global-alert">
                            <i class="ti ti-shield-x global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">Import failed — file could not be processed</div>
                                <ul class="global-alert-list">
                                    @foreach (var issue in globalIssues)
                                    {
                                        <li>
                                            @if (issue.RowNumber > 0)
                                            {
                                                <span class="row-tag">Row @issue.RowNumber</span>
                                            }
                                            @issue.Message
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <p class="hint-text">Fix the issues in your file and re-upload to continue.</p>
                    }

                    @* ── Pure success (no cards, no global issues) ── *@
                    @if (cards.Count == 0 && !globalIssues.Any())
                    {
                        <div class="success-banner">
                            <div class="success-banner-icon">
                                <i class="ti ti-circle-check" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="success-banner-title">Import complete</div>
                                <div class="success-banner-sub">All rows have already been processed. Nothing left to commit.</div>
                            </div>
                        </div>
                    }

                    @* ── Cards (virtualized: only the visible ones are rendered) ── *@
                    @if (cards.Count > 0)
                    {
                        <div class="import-results">
                            @if (groupFilter != GroupFilter.ErrorOnly)
                            {
                                <Virtualize Items="displayCards" Context="card" ItemSize="72">
                                    @{
                                        var row = card.Row;
                                        var groupRows = card.Group.Rows;
                                        var groupKey = card.Key;
                                        var isExpanded = expandedCards.Contains(groupKey);
                                        var hasWarning = card.IsWarningOnly;
                                        var headerParts = BuildHeaderParts(card);
                                        var showStockCol = groupRows.Any(r => r.StockPrice.HasValue);
                                        var showRegionalCol = groupRows.Any(r => r.StockPriceRegional.HasValue);
                                        var showNationalCol = groupRows.Any(r => r.StockPriceNational.HasValue);
                                    }

                                    <div class="icard">
                                        <div class="ich @(hasWarning ? "ich-warn" : "ich-ok") @(isExpanded ? "open" : "")"
                                             @onclick="() => ToggleExpand(groupKey)">
                                            <div class="ich-left">
                                                <div class="iicon @(hasWarning ? "iicon-warn" : "iicon-ok")">
                                                    <i class="ti ti-box" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num @(hasWarning ? "inv-warn" : "inv-ok")">
                                                        @row?.CompanyItemCode - @row?.CompanyItemName
                                                    </div>
                                                    <div class="inv-sub @(hasWarning ? "inv-sub-warn" : "inv-sub-ok")">
                                                        @for (var pi = 0; pi < headerParts.Count; pi++)
                                                        {
                                                            if (pi > 0)
                                                            {
                                                                <span class="sep">·</span>
                                                            }
                                                            <span>@headerParts[pi]</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="ich-right">
                                                @if (card.Group.IsSaved)
                                                {
                                                    <span class="badge badge-saved">
                                                        <i class="ti ti-circle-check" aria-hidden="true"></i>
                                                        Saved
                                                    </span>
                                                }
                                                else
                                                {
                                                    @if (hasWarning)
                                                    {
                                                        <span class="badge badge-warn">
                                                            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                            Warning · @ActionLabel(card)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-ready">
                                                            <i class="ti ti-check" aria-hidden="true"></i>
                                                            @ActionLabel(card)
                                                        </span>
                                                    }
                                                    @if (card.Group.HasWork)
                                                    {
                                                        <div class="chk" @onclick:stopPropagation="true">
                                                            <input type="checkbox" checked="@card.Group.Selected"
                                                                   @onchange="(e) => ToggleGroupSelection(card.Group, e.Value)"
                                                                   id="chk-@groupKey" />
                                                            <label for="chk-@groupKey">Select</label>
                                                        </div>
                                                    }
                                                }
                                                <i class="ti ti-chevron-down chev @(isExpanded ? "open" : "")" aria-hidden="true"></i>
                                            </div>
                                        </div>

                                        @if (isExpanded && row != null)
                                        {
                                            <div class="icb">
                                                @foreach (var w in card.Warnings)
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                        @w
                                                    </div>
                                                }

                                                @if (!card.Group.HasWork)
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-circle-check" aria-hidden="true"></i>
                                                        <div>
                                                            <strong>Already up to date.</strong>
                                                            Everything in the file for this item is already saved, so committing would not
                                                            change anything.
                                                        </div>
                                                    </div>
                                                }

                                                @{
                                                    var changeOps = ChangeOps(card.Group);
                                                    var skipOps = SkipOps(card.Group);
                                                }

                                                @if (changeOps.Count > 0)
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-pencil" aria-hidden="true"></i>
                                                        <div>
                                                            <strong>
                                                                @(card.Group.IsNewItem
                                                                    ? "Committing will create this company item:"
                                                                    : "Committing will update this company item:")
                                                            </strong>
                                                            <ul style="margin:4px 0 0 16px; padding:0;">
                                                                @foreach (var op in changeOps)
                                                                {
                                                                    <li>@op.Description</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                }

                                                @if (skipOps.Count > 0)
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-player-skip-forward" aria-hidden="true"></i>
                                                        <div>
                                                            <strong>Already saved, will be skipped:</strong>
                                                            <ul style="margin:4px 0 0 16px; padding:0;">
                                                                @foreach (var op in skipOps)
                                                                {
                                                                    <li>@op.Description</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="cust-meta">
                                                    <div>
                                                        <span class="cust-meta-label">Principal</span>
                                                        <strong>@(row.Principal ?? "—")</strong>
                                                    </div>
                                                    <div>
                                                        <span class="cust-meta-label">Stock UOM</span>
                                                        <strong>@(string.IsNullOrWhiteSpace(row.StockUomName) ? "—" :
                                                                                                                                                                                                                            row.StockUomName)</strong>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(row.PPG))
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">PPG</span>
                                                                <strong>@row.PPG</strong>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(row.Category))
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Category</span>
                                                                <strong>@row.Category</strong>
                                                            </div>
                                                        }
                                                        @if (row.ExistingStockPrice.HasValue)
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Current Stock Price</span>
                                                                <strong>@row.ExistingStockPrice.Value.ToString("N2")</strong>
                                                            </div>
                                                        }
                                                        @if (row.ExistingStockPriceRegional.HasValue)
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Current Regional Price</span>
                                                                <strong>@row.ExistingStockPriceRegional.Value.ToString("N2")</strong>
                                                            </div>
                                                        }
                                                        @if (row.ExistingStockPriceNational.HasValue)
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Current National Price</span>
                                                                <strong>@row.ExistingStockPriceNational.Value.ToString("N2")</strong>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="itbl-wrap">
                                                        <table class="itbl">
                                                            <thead>
                                                                <tr>
                                                                    <th>Row</th>
                                                                    <th>Effectivity</th>
                                                                    @if (showStockCol)
                                                                    {
                                                                        <th class="r">Stock Price</th>
                                                                    }
                                                                    @if (showRegionalCol)
                                                                    {
                                                                        <th class="r">Regional</th>
                                                                    }
                                                                    @if (showNationalCol)
                                                                    {
                                                                        <th class="r">National</th>
                                                                    }
                                                                    <th>Result</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var hr in OrderedRows(groupRows))
                                                                {
                                                                    <tr>
                                                                        <td class="mono">@hr.RowNumber</td>
                                                                        <td>@(hr.PriceChangeEffectivityDate?.ToString("yyyy-MM-dd") ?? "Today")</td>
                                                                        @if (showStockCol)
                                                                        {
                                                                            <td class="r">@(hr.StockPrice?.ToString("N2") ?? "—")
                                                                            </td>
                                                                        }
                                                                        @if (showRegionalCol)
                                                                        {
                                                                            <td class="r">
                                                                                @(hr.StockPriceRegional?.ToString("N2") ?? "—")</td>
                                                                            }
                                                                            @if (showNationalCol)
                                                                            {
                                                                                <td class="r">
                                                                                    @(hr.StockPriceNational?.ToString("N2") ?? "—")</td>
                                                                                }
                                                                                <td>@RowResultText(card.Group, hr)</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </Virtualize>
                                        }
                                        else
                                        {
                                            <Virtualize Items="displayCards" Context="card" ItemSize="72">
                                                @{
                                                    var row = card.Row;
                                                    var groupRows = card.Group.Rows;

                                                    IEnumerable<CompanyItemImportIssue> visibleIssues = card.Group.Issues;
                                                    if (!string.IsNullOrWhiteSpace(selectedErrorFilter))
                                                    {
                                                        visibleIssues = visibleIssues.Where(i => NormalizeMessageType(i.Message) == selectedErrorFilter);
                                                    }
                                                    var grouped = visibleIssues
                                                        .GroupBy(i => i.Message?.Trim())
                                                        .Select(g => new
                                                        {
                                                            Message = g.Key,
                                                            RowNumbers = g.Select(x => x.RowNumber).Where(n => n > 0).Distinct().OrderBy(n => n).ToList()
                                                        })
                                                        .Where(m => !string.IsNullOrWhiteSpace(m.Message))
                                                        .ToList();
                                                }

                                                <div class="icard">
                                                    <div class="ich ich-er">
                                                        <div class="ich-left">
                                                            <div class="iicon iicon-er">
                                                                <i class="ti ti-box-off" aria-hidden="true"></i>
                                                            </div>
                                                            <div>
                                                                <div class="inv-num inv-er">
                                                                    @(string.IsNullOrWhiteSpace(row?.CompanyItemCode) ? "[Blank item code]" :
                                                    $"{row.CompanyItemCode} - {row.CompanyItemName}")
                                                                </div>
                                                                <div class="inv-sub inv-sub-er">
                                                                    @if (groupRows.Count == 1)
                                                                    {
                                                                        <span>Row @row?.RowNumber</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>@groupRows.Count row(s)</span>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(row?.Principal))
                                                                    {
                                                                        <span class="sep">·</span>
                                                                        <span>@row.Principal</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <span class="badge badge-err">
                                                            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                            @GetErrorBadgeText(card)
                                                        </span>
                                                    </div>

                                                    @if (grouped.Any())
                                                    {
                                                        <div class="icb-err-rows">
                                                            @foreach (var issueGroup in grouped)
                                                            {
                                                                <div class="err-msg-card">
                                                                    <div class="err-msg-hdr">
                                                                        <i class="ti ti-alert-circle err-msg-icon" aria-hidden="true"></i>
                                                                        <div>
                                                                            <div class="err-msg-text">@issueGroup.Message</div>
                                                                            @if (issueGroup.RowNumbers.Any())
                                                                            {
                                                                                <div class="err-rows-pill">
                                                                                    <i class="ti ti-row-insert-bottom" aria-hidden="true"></i>
                                                                                    Row: @string.Join(" & ", issueGroup.RowNumbers)
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </Virtualize>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        @* ── Modal footer ── *@
                        <div class="modal-footer-ent">
                            @if (ImportResult != null && GetSelectedCount() > 0)
                            {
                                <button type="button" class="btn-commit" @onclick="OpenCommitConfirmModal">
                                    <i class="ti ti-send" aria-hidden="true"></i>
                                    Commit selected (@GetSelectedCount())
                                </button>
                            }
                            <button type="button" class="btn-close-modal" @onclick="HandleClose">Close</button>
                        </div>

                    </div>
                </div>
            }

<ConfirmModal Show="showCommitConfirmModal" Title="Commit Selected Company Items"
              Message="@($"Commit {GetSelectedCount()} selected company item(s)?")" OnYes="ConfirmCommit" OnNo="CancelCommit"
              CloseOnOverlayClick="true" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public CompanyItemImportResult? ImportResult { get; set; }
    [Parameter] public CompanyItemCommitSummary? CommitSummary { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public HashSet<string> SelectedGroupKeys { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback OnDownloadErrorReport { get; set; }

    private bool isCommitting;
    private bool hasCommitted;
    private bool showCommitConfirmModal;
    private bool wasShown;
    private int commitSavedCount;
    private int commitFailedCount;
    private string? commitError;

    private GroupFilter groupFilter = GroupFilter.SuccessOnly;
    private string? selectedErrorFilter;
    private string? selectedWarningFilter;
    private string? selectedActionFilter;
    private HashSet<string> expandedCards = new(StringComparer.OrdinalIgnoreCase);
    private string searchTerm = string.Empty;
    private ItemSortMode sortMode = ItemSortMode.RowAscending;

    private enum GroupFilter { SuccessOnly, WarningOnly, ErrorOnly }
    private enum ItemSortMode { RowAscending, ItemCode, ItemName }

    private sealed record GroupCardViewModel(
        PreparedCompanyItemGroup Group,
        CompanyItemImportRowResult? Row,
        string Key,
        List<string> Warnings,
        string SearchBlob,
        int SortRow)
    {
        public bool HasErrors => Group.Issues.Count > 0;
        // Nothing in the file changes this item (everything already exists): informational, not a warning.
        public bool IsUpToDate => !HasErrors && !Group.HasWork;
        public bool IsWarningOnly => !HasErrors && Warnings.Count > 0;
        // Groups with nothing new to write (everything already exists) are shown but not selectable.
        public bool CanSelect => Row != null && !HasErrors && !Group.IsSaved && Group.HasWork;
    }

    // ── Caches ────────────────────────────────────────────────────────────
    // The card list is only rebuilt when ImportResult changes (or after a commit).
    // The filtered / searched / sorted list is only rebuilt when the tab, filters,
    // search text or sort mode change. Keeping the same list instance also stops
    // <Virtualize> from refreshing (and jumping) on every render.
    private CompanyItemImportResult? _cachedForResult;
    private bool _cacheReady;
    private List<GroupCardViewModel>? _cachedCards;
    private List<GroupCardViewModel>? _cachedFilteredCards;
    private string? _cachedFilterKey;
    private List<(string Message, int Count)>? _cachedErrorTypes;
    private List<(string Message, int Count)>? _cachedWarningTypes;
    private bool _countsReady;
    private readonly Dictionary<CompanyItemOperationKind, int> _opCounts = new();
    private int _createCount;
    private (int Valid, int Warning, int Error) _counts;
    private int _upToDateCount;
    private List<(string Label, int Count)>? _cachedActionTypes;
    private GroupFilter _cachedActionTypesFor;

    private void InvalidateCaches() => _cacheReady = false;

    private void EnsureCache()
    {
        if (_cacheReady && ReferenceEquals(_cachedForResult, ImportResult)) return;

        _cachedCards = null;
        _cachedFilteredCards = null;
        _cachedFilterKey = null;
        _cachedErrorTypes = null;
        _cachedWarningTypes = null;
        _cachedActionTypes = null;
        _countsReady = false;

        _cachedForResult = ImportResult;
        _cacheReady = true;
    }

    protected override void OnParametersSet()
    {
        if (Show && !wasShown)
        {
            wasShown = true;
            hasCommitted = false;
            commitError = null;
            selectedErrorFilter = null;
            selectedWarningFilter = null;
            selectedActionFilter = null;
            searchTerm = string.Empty;
            sortMode = ItemSortMode.RowAscending;
            expandedCards.Clear();
            InvalidateCaches();

            if (ImportResult != null)
            {
                // Nothing is selected when the modal opens; the user picks what to commit.
                SelectedGroupKeys.Clear();
                foreach (var g in ImportResult.PreparedGroups.Where(g => !g.IsSaved))
                    g.Selected = false;

                var anyValid = ImportResult.PreparedGroups.Any(g => g.Issues.Count == 0 && !g.Rows.Any(r => r.Warnings.Count > 0));
                var anyWarning = ImportResult.PreparedGroups.Any(g => g.Issues.Count == 0 && g.Rows.Any(r => r.Warnings.Count > 0));
                groupFilter = anyValid ? GroupFilter.SuccessOnly
                            : anyWarning ? GroupFilter.WarningOnly
                            : GroupFilter.ErrorOnly;
            }
        }
        else if (!Show) { wasShown = false; }
    }

    // Must stay identical to GroupKey in ImportCompanyItems.razor (row number of the group's first row).
    private static string GroupKey(PreparedCompanyItemGroup g) => (g.Rows.FirstOrDefault()?.RowNumber ?? 0).ToString();

    // Everything a user might type into the search box: the parsed fields, every raw value
    // from the Excel rows, and any warning / error text.
    private static string BuildSearchBlob(PreparedCompanyItemGroup g)
    {
        var parts = new List<string>();
        void Add(string? s)
        {
            if (!string.IsNullOrWhiteSpace(s)) parts.Add(s);
        }

        foreach (var r in g.Rows)
        {
            Add(r.CompanyItemCode);
            Add(r.CompanyItemName);
            Add(r.Principal);
            Add(r.PPG);
            Add(r.StockUomName);
            Add(r.Category);
            Add(r.RowNumber.ToString());
            Add(r.PriceChangeEffectivityDate?.ToString("yyyy-MM-dd"));
            Add(r.StockPrice?.ToString("N2"));
            Add(r.StockPriceRegional?.ToString("N2"));
            Add(r.StockPriceNational?.ToString("N2"));

            foreach (var v in r.RawValues.Values) Add(v);
            foreach (var w in r.Warnings) Add(w);
            foreach (var i in r.Issues) Add(i);
        }

        foreach (var issue in g.Issues) Add(issue.Message);
        foreach (var op in g.Operations) Add(op.Description);

        return string.Join("\n", parts);
    }

    private static GroupCardViewModel BuildCard(PreparedCompanyItemGroup g) =>
        new(g,
            g.Rows.FirstOrDefault(),
            GroupKey(g),
            g.Rows.SelectMany(r => r.Warnings).Distinct().ToList(),
            BuildSearchBlob(g),
            g.Rows.Count > 0 ? g.Rows.Min(r => r.RowNumber) : int.MaxValue);

    private List<GroupCardViewModel> GetCards()
    {
        EnsureCache();
        if (_cachedCards != null) return _cachedCards;

        _cachedCards = (ImportResult?.PreparedGroups ?? new List<PreparedCompanyItemGroup>())
            .Select(BuildCard)
            .OrderBy(c => c.SortRow)
            .ToList();

        return _cachedCards;
    }

    private (int Valid, int Warning, int Error) GetCounts(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        if (_countsReady) return _counts;

        int valid = 0, warning = 0, error = 0, upToDate = 0;
        _opCounts.Clear();
        _createCount = 0;

        foreach (var c in cards)
        {
            if (!c.HasErrors)
            {
                if (c.Group.IsNewItem) _createCount++;
                foreach (var op in c.Group.Operations)
                    _opCounts[op.Kind] = _opCounts.GetValueOrDefault(op.Kind) + 1;
            }

            if (c.HasErrors) error++;
            else if (c.IsWarningOnly) warning++;
            else
            {
                // Up-to-date items are valid too; they just have nothing to commit.
                valid++;
                if (c.IsUpToDate) upToDate++;
            }
        }

        _counts = (valid, warning, error);
        _upToDateCount = upToDate;
        _countsReady = true;
        return _counts;
    }

    // Tab + filter selection.
    private List<GroupCardViewModel> GetFilteredCards(List<GroupCardViewModel> cards) => groupFilter switch
    {
        GroupFilter.WarningOnly => cards.Where(c => c.IsWarningOnly
                && (string.IsNullOrWhiteSpace(selectedWarningFilter)
                    || c.Warnings.Any(w => NormalizeWarningMessageType(w) == selectedWarningFilter))).ToList(),
        GroupFilter.ErrorOnly => !string.IsNullOrWhiteSpace(selectedErrorFilter)
            ? cards.Where(c => c.HasErrors && c.Group.Issues.Any(i => NormalizeMessageType(i.Message) ==
selectedErrorFilter)).ToList()
            : cards.Where(c => c.HasErrors).ToList(),
        _ => cards.Where(c => !c.HasErrors && !c.IsWarningOnly).ToList()
    };

    // Tab filter + search + sort, cached until one of them changes.
    private List<GroupCardViewModel> GetFilteredAndSortedCards(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        var key = $"{groupFilter}|{selectedErrorFilter}|{selectedWarningFilter}|{selectedActionFilter}|{searchTerm}|{sortMode}";
        if (_cachedFilterKey == key && _cachedFilteredCards != null)
            return _cachedFilteredCards;

        var filtered = GetFilteredCards(cards);

        if (groupFilter != GroupFilter.ErrorOnly && !string.IsNullOrWhiteSpace(selectedActionFilter))
            filtered = filtered.Where(c => ActionLabel(c) == selectedActionFilter).ToList();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            filtered = filtered.Where(c => c.SearchBlob.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        _cachedFilteredCards = ApplySort(filtered);
        _cachedFilterKey = key;
        return _cachedFilteredCards;
    }

    private List<GroupCardViewModel> ApplySort(List<GroupCardViewModel> cards)
    {
        return sortMode switch
        {
            ItemSortMode.ItemCode => cards
                .OrderBy(c => c.Row?.CompanyItemCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(c => c.SortRow)
                .ToList(),
            ItemSortMode.ItemName => cards
                .OrderBy(c => c.Row?.CompanyItemName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(c => c.SortRow)
                .ToList(),
            _ => cards.OrderBy(c => c.SortRow).ToList()
        };
    }

    private void OnSearchInput(ChangeEventArgs e) => searchTerm = e.Value?.ToString() ?? string.Empty;

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ItemSortMode>(e.Value?.ToString(), out var mode))
            sortMode = mode;
    }

    private string GetTabClass(GroupFilter filter) => groupFilter == filter
        ? filter switch
        {
            GroupFilter.SuccessOnly => "tab act-ok",
            GroupFilter.WarningOnly => "tab act-warn",
            GroupFilter.ErrorOnly => "tab act-er",
            _ => "tab"
        }
        : "tab";

    private void SetTab(GroupFilter filter)
    {
        groupFilter = filter;
        selectedActionFilter = null;
        selectedErrorFilter = null;
        selectedWarningFilter = null;
    }

    // If the selected tab no longer has any items, move to one that does.
    private void EnsureValidTab(bool hasSuccess, bool hasWarning, bool hasError)
    {
        bool Has(GroupFilter f) => f switch
        {
            GroupFilter.SuccessOnly => hasSuccess,
            GroupFilter.WarningOnly => hasWarning,
            _ => hasError
        };

        if (Has(groupFilter)) return;

        foreach (var f in new[] { GroupFilter.SuccessOnly, GroupFilter.WarningOnly, GroupFilter.ErrorOnly })
        {
            if (Has(f))
            {
                SetTab(f);
                return;
            }
        }
    }

    private void ToggleExpand(string key)
    {
        if (!expandedCards.Remove(key))
            expandedCards.Add(key);
    }

    // ── Card text ─────────────────────────────────────────────────────────
    private List<string> BuildHeaderParts(GroupCardViewModel card)
    {
        var parts = new List<string>();
        var row = card.Row;
        if (row == null) return parts;

        if (!string.IsNullOrWhiteSpace(row.Principal)) parts.Add(row.Principal);
        if (!string.IsNullOrWhiteSpace(row.StockUomName)) parts.Add(row.StockUomName);

        var rows = card.Group.Rows;
        parts.Add(rows.Count == 1 ? $"Row {row.RowNumber}" : $"{rows.Count} rows");

        var dates = rows.Where(r => r.PriceChangeEffectivityDate.HasValue)
                        .Select(r => r.PriceChangeEffectivityDate!.Value.Date)
                        .ToList();
        if (dates.Count > 0)
        {
            var first = dates.Min();
            var last = dates.Max();
            parts.Add(first == last ? first.ToString("yyyy-MM-dd") : $"{first:yyyy-MM-dd} → {last:yyyy-MM-dd}");
        }

        return parts;
    }

    // Stat-bar chips: what committing will do, counted from the cards without errors.
    private List<(string Label, int Count)> GetActionChips()
    {
        int N(CompanyItemOperationKind k) => _opCounts.GetValueOrDefault(k);

        return new List<(string Label, int Count)>
        {
            ("New items", _createCount),
            ("Price updates", N(CompanyItemOperationKind.ApplyCurrentPrice)),
            ("History entries", N(CompanyItemOperationKind.AddPriceHistory)),
            ("Scheduled", N(CompanyItemOperationKind.SchedulePrice)),
            ("Stock UOM fixes", N(CompanyItemOperationKind.BackfillStockUom)),
            ("Skipped", N(CompanyItemOperationKind.SkipDuplicate)),
        }.Where(c => c.Count > 0).ToList();
    }

    private static string ActionLabel(GroupCardViewModel card)
    {
        var g = card.Group;
        if (!g.HasWork) return "Up to date";

        bool Has(CompanyItemOperationKind k) => g.Operations.Any(o => o.Kind == k);

        var parts = new List<string>();
        if (g.IsNewItem) parts.Add("Create");
        if (Has(CompanyItemOperationKind.ApplyCurrentPrice) && !g.IsNewItem) parts.Add("Update price");
        if (Has(CompanyItemOperationKind.AddPriceHistory)) parts.Add("History");
        if (Has(CompanyItemOperationKind.SchedulePrice)) parts.Add("Schedule");
        if (Has(CompanyItemOperationKind.BackfillStockUom)) parts.Add("Fill Stock UOM");

        return parts.Count == 0 ? "Ready" : string.Join(" + ", parts);
    }

    private static List<CompanyItemPlannedOperation> ChangeOps(PreparedCompanyItemGroup g) =>
        g.Operations.Where(o => o.Kind != CompanyItemOperationKind.SkipDuplicate).ToList();

    private static List<CompanyItemPlannedOperation> SkipOps(PreparedCompanyItemGroup g) =>
        g.Operations.Where(o => o.Kind == CompanyItemOperationKind.SkipDuplicate).ToList();

    // Kept out of the markup: Razor's parser mishandles lambdas with `??` inside a foreach header.
    private static List<CompanyItemImportRowResult> OrderedRows(List<CompanyItemImportRowResult> rows)
    {
        var today = DateTime.Today;
        return rows
            .OrderBy(r => r.PriceChangeEffectivityDate.HasValue ? r.PriceChangeEffectivityDate.Value : today)
            .ThenBy(r => r.RowNumber)
            .ToList();
    }

    private static string RowResultText(PreparedCompanyItemGroup group, CompanyItemImportRowResult row)
    {
        var labels = group.Operations
            .Where(o => o.RowNumber == row.RowNumber)
            .Select(o => o.Kind switch
            {
                CompanyItemOperationKind.CreateItem => "Create item",
                CompanyItemOperationKind.ApplyCurrentPrice => "Current price",
                CompanyItemOperationKind.AddPriceHistory => "History",
                CompanyItemOperationKind.SchedulePrice => "Scheduled",
                CompanyItemOperationKind.SkipDuplicate => "Skipped",
                _ => string.Empty
            })
            .Where(l => l.Length > 0)
            .Distinct()
            .ToList();

        return labels.Count == 0 ? "—" : string.Join(", ", labels);
    }

    private static string SummaryText(CompanyItemCommitSummary s)
    {
        var parts = new List<string>();
        if (s.ItemsCreated > 0) parts.Add($"{s.ItemsCreated} created");
        if (s.ItemsUpdated > 0) parts.Add($"{s.ItemsUpdated} updated");
        if (s.PricesApplied > 0) parts.Add($"{s.PricesApplied} price(s) applied");
        if (s.PricesScheduled > 0) parts.Add($"{s.PricesScheduled} price(s) scheduled");
        if (s.StockUomBackfilled > 0) parts.Add($"{s.StockUomBackfilled} Stock UOM(s) filled in");
        if (s.PricesSkipped > 0) parts.Add($"{s.PricesSkipped} duplicate(s) skipped");
        if (s.Failed > 0) parts.Add($"{s.Failed} failed");
        return parts.Count == 0 ? "No changes were made." : string.Join(" · ", parts) + ".";
    }

    // ── Selection ─────────────────────────────────────────────────────────
    private void SetSelected(GroupCardViewModel card, bool isChecked)
    {
        card.Group.Selected = isChecked;
        if (isChecked) SelectedGroupKeys.Add(card.Key); else SelectedGroupKeys.Remove(card.Key);
    }

    private void ToggleGroupSelection(PreparedCompanyItemGroup group, object? checkedValue)
    {
        if (checkedValue is not bool isChecked) return;

        var card = GetCards().FirstOrDefault(c => ReferenceEquals(c.Group, group));
        if (card == null) return;

        SetSelected(card, isChecked);
    }

    // "Select all valid" only ticks valid items, never the ones with warnings.
    private void ToggleSelectAll(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        foreach (var c in GetCards().Where(c => c.CanSelect && !c.IsWarningOnly))
            SetSelected(c, isChecked);
    }

    // "Select all with warnings" only ticks items that have warnings.
    private void ToggleSelectAllWarnings(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        foreach (var c in GetCards().Where(c => c.CanSelect && c.IsWarningOnly))
            SetSelected(c, isChecked);
    }

    private int GetSelectedCount() =>
        GetCards().Count(c => c.CanSelect && c.Group.Selected && SelectedGroupKeys.Contains(c.Key));

    // ── Errors and warnings ───────────────────────────────────────────────
    private string GetErrorBadgeText(GroupCardViewModel card)
    {
        int count = string.IsNullOrWhiteSpace(selectedErrorFilter)
            ? card.Group.Issues.Count
            : card.Group.Issues.Count(i => NormalizeMessageType(i.Message) == selectedErrorFilter);
        return count == 1 ? "1 error" : $"{count} errors";
    }

    private List<(string Message, int Count)> GetDistinctErrorMessages(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        if (_cachedErrorTypes != null) return _cachedErrorTypes;

        var all = cards.SelectMany(c => c.Group.Issues.Select(i => NormalizeMessageType(i.Message)));
        _cachedErrorTypes = all
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .GroupBy(m => m)
            .Select(g => (Message: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();

        return _cachedErrorTypes;
    }

    private static string NormalizeMessage(string? m) => (m ?? string.Empty).Trim();

    private static string NormalizeMessageType(string? m)
    {
        var msg = NormalizeMessage(m).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.StartsWith("on hold")) return "On Hold (Another Row Has An Error)";
        if (msg.StartsWith("nothing new to import")) return "Already Exists (Nothing New To Import)";
        if (msg.Contains("conflicting prices")) return "Conflicting Prices In File";
        if (msg.Contains("history already records")) return "Conflicts With Price History";
        if (msg.Contains("scheduled price change")) return "Pending Scheduled Change";
        if (msg.Contains("was not found")) return "Cannot Create Item (Missing Details)";
        if (msg.Contains("would be created as a new item")) return "New Item Has Inconsistent Rows";
        if (msg.Contains("needs at least one price effective today")) return "New Item Needs A Current Price";
        if (msg.Contains("effectivity date")) return "Effectivity Date";
        if (msg.Contains("belongs to principal") || msg.Contains("already belongs to principal")) return "Principal Mismatch";
        if (msg.Contains("a price is required")) return "Price Required";
        if (msg.Contains("kcpi")) return "KCPI Price Configuration";
        if (msg.Contains("not both")) return "Price And List Price Both Given";
        if (msg.Contains("sheet 1 price is only supported")) return "Sheet 1 Price Not Supported";
        if (msg.Contains("code") && msg.Contains("required")) return "CompanyItem Code Required";
        if (msg.Contains("price") && msg.Contains("valid")) return "Invalid Price";
        if (msg.Contains("save failed")) return "Save Failed";
        if (msg.Contains("stock uom could not be set")) return "Stock UOM Could Not Be Set";

        return NormalizeMessage(m);
    }

    private static string NormalizeWarningMessageType(string? m)
    {
        var msg = NormalizeMessage(m).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.Contains("is already in the price history")) return "Already In Price History (Skipped)";
        if (msg.Contains("already the current price")) return "Already The Current Price (Skipped)";
        if (msg.Contains("everything in the file for this item already exists")) return "Nothing New To Import";
        if (msg.Contains("repeated with the same price")) return "Repeated In File (Same Price)";
        if (msg.Contains("will not be changed")) return "Stock UOM Differs (Kept As Is)";
        if (msg.Contains("different names or ppgs")) return "Rows Have Different Names Or PPGs";

        return NormalizeMessage(m);
    }

    private List<(string Message, int Count)> GetDistinctWarningMessages(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        if (_cachedWarningTypes != null) return _cachedWarningTypes;

        var all = cards
            .Where(c => c.IsWarningOnly)
            .SelectMany(c => c.Warnings.Select(NormalizeWarningMessageType));

        _cachedWarningTypes = all
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .GroupBy(m => m)
            .Select(g => (Message: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();

        return _cachedWarningTypes;
    }

    private void OnErrorFilterChanged(ChangeEventArgs e) => selectedErrorFilter = e?.Value?.ToString();
    private void ClearErrorFilter() => selectedErrorFilter = null;
    private void OnWarningFilterChanged(ChangeEventArgs e) => selectedWarningFilter = e?.Value?.ToString();
    private void ClearWarningFilter() => selectedWarningFilter = null;

    // ── Commit ────────────────────────────────────────────────────────────
    private void OpenCommitConfirmModal() => showCommitConfirmModal = true;
    private void CancelCommit() => showCommitConfirmModal = false;

    private async Task ConfirmCommit()
    {
        showCommitConfirmModal = false;
        commitError = null;

        var toCommit = GetCards()
            .Where(c => c.CanSelect && c.Group.Selected && SelectedGroupKeys.Contains(c.Key))
            .Select(c => c.Group)
            .ToList();

        try
        {
            isCommitting = true;
            StateHasChanged();
            await Task.Yield(); // let the loading overlay paint before the commit starts

            if (OnCommit.HasDelegate) await OnCommit.InvokeAsync();

            // Anything that was not saved moves to the Errors tab with the real reason,
            // instead of staying green with no explanation.
            foreach (var g in toCommit.Where(g => !g.IsSaved))
            {
                var first = g.Rows.FirstOrDefault();
                var reasons = g.Rows
                    .SelectMany(r => r.Issues.Select(m => (r.RowNumber, r.CompanyItemCode, Message: m)))
                    .ToList();

                if (reasons.Count == 0)
                {
                    g.Issues.Add(new CompanyItemImportIssue(
                        first?.RowNumber ?? 0,
                        first?.CompanyItemCode ?? string.Empty,
                        "Save failed: this item was not processed by the commit."));
                }
                else
                {
                    foreach (var (rowNo, code, message) in reasons)
                    {
                        if (!g.Issues.Any(i => i.RowNumber == rowNo && i.Message == message))
                            g.Issues.Add(new CompanyItemImportIssue(rowNo, code, message));
                    }
                }
            }

            // Saved / failed status changed, so the cards, counts and lists must be rebuilt.
            InvalidateCaches();

            commitSavedCount = toCommit.Count(g => g.IsSaved);
            commitFailedCount = toCommit.Count - commitSavedCount;
            hasCommitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            commitError = $"Commit failed: {ex.Message}";
            InvalidateCaches();
        }
        finally
        {
            isCommitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleDownloadErrorReport()
    {
        if (OnDownloadErrorReport.HasDelegate) await OnDownloadErrorReport.InvokeAsync();
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
