@using STTproject.Services
@inject STTproject.Features.Admin.CompanyItem.Services.IAdminCompanyItemService AdminCompanyItemService
@inject STTproject.Features.Admin.CompanyItem.Services.ImportCompanyItemsService ImportCompanyItemsService
@inject IUserContextService UserContext
@inject IJSRuntime JS

<LoadingOverlay Show="isPreparing"
                Title="Checking your file…"
                Subtitle="Validating headers, rows, and data. This may take a moment."
                IconClass="fa-solid fa-file-arrow-up" />

@if (Show)
{
    <Modal ShowModal="Show"
           Title="CompanyItem Batch Data Import"
           Subtitle="Add or update company items by importing an Excel file. The file decides what happens."
           IconType="ModalIconType.Upload"
           Details="Excel should contain: Sku Code, Item Description, Stock UOM, Principal (required in the file only if not assigned below). Prices are optional. Add an Effectivity Date column to import price history instead; items that do not exist yet are created from the same rows, so they also need an Item Description, Stock UOM and Principal."
           OnClose="OnClose">
        <ChildContent>
            <AutoComplete
                Label="Assign a Principal (optional — leave blank to use each row's Principal column instead)"
                Items="Principals"
                SelectedValue="selectedPrincipal"
                SelectedValueChanged="OnPrincipalChanged" />
            <FileInput OnFileSelected="HandleFileSelected" />
        </ChildContent>
        <FooterContent>
            <Button Title="Cancel" OnClick="OnClose" Variant="ButtonVariant.Secondary" />
            <Button Title="Check File"
                    OnClick="OnPrepare"
                    Disabled="@(selectedFile == null || isPreparing)"
                    Icon="fa-solid fa-check"
                    Variant="ButtonVariant.Primary" />
        </FooterContent>
    </Modal>
}

<ImportCompanyItemsResult Show="showResults"
                          IsHistorical="resultIsHistorical"
                          ImportResult="importResult"
                          SelectedGroupKeys="selectedGroupKeys"
                          OnCommit="HandleCommitAsync"
                          OnClose="CloseResults"
                          OnDownloadErrorReport="HandleDownloadErrorReport" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }
    private List<String?> Principals { get; set; } = new();
    private string? selectedPrincipal;
    private IBrowserFile? selectedFile;
    private bool isPreparing;
    private bool showResults;

    // Set from the file once it has been checked.
    private bool resultIsHistorical;

    private STTproject.Features.Admin.CompanyItem.DTOs.CompanyItemImportResult? importResult;
    private HashSet<string> selectedGroupKeys = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Principals = (await AdminCompanyItemService.GetAllPrincipalsAsync()).ToList();
    }

    private void OnPrincipalChanged(string? value) => selectedPrincipal = value;

    private void HandleFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        importResult = null;
    }

    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    private async Task OnPrepare()
    {
        if (selectedFile == null)
            return;

        isPreparing = true;
        importResult = null;
        StateHasChanged();

        try
        {
            byte[] fileBytes;
            await using (var stream = selectedFile.OpenReadStream(MaxFileSizeBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                fileBytes = ms.ToArray();
            }

            Show = false;

            using var importStream = new MemoryStream(fileBytes);
            importStream.Position = 0;

            importResult = await ImportCompanyItemsService.PrepareAutoFromExcelAsync(importStream, selectedPrincipal);
            resultIsHistorical = importResult.Mode == STTproject.Features.Admin.CompanyItem.DTOs.CompanyItemImportMode.PriceHistory;

            // Nothing is selected when the results open; the user picks what to commit.
            selectedGroupKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            Show = false;
            importResult = new STTproject.Features.Admin.CompanyItem.DTOs.CompanyItemImportResult();
            importResult.AddError(0, string.Empty, $"Failed to open/import file: {ex.Message}.");
        }
        finally
        {
            isPreparing = false;
            showResults = importResult != null;
            StateHasChanged();
        }
    }

    private async Task HandleCommitAsync()
    {
        if (importResult == null) return;

        var userId = UserContext.UserId ?? 0;

        var selectedGroups = importResult.PreparedGroups
            .Where(g => g.Selected && !g.IsSaved && g.Issues.Count == 0 && selectedGroupKeys.Contains(GroupKey(g)))
            .ToList();

        var selectedRows = selectedGroups.SelectMany(g => g.Rows).ToList();

        // Nothing matched the selection. The results modal reports these groups as
        // "not processed" instead of failing silently.
        if (selectedRows.Count == 0) return;

        // The commit methods quietly return 0 when there is no user, so stop here
        // and give every selected row a reason instead of pretending it was saved.
        if (userId <= 0)
        {
            foreach (var row in selectedRows)
            {
                row.Issues.Add("Save failed: unable to identify the current user. Please sign in again.");
                row.IsSuccess = false;
            }
            StateHasChanged();
            return;
        }

        var committedCount = 0;
        try
        {
            committedCount = resultIsHistorical
                ? await ImportCompanyItemsService.CommitHistoricalRowsAsync(selectedRows, userId)
                : await ImportCompanyItemsService.CommitPreparedRowsAsync(selectedRows, selectedPrincipal, userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            foreach (var row in selectedRows.Where(r => r.Issues.Count == 0))
            {
                row.Issues.Add($"Save failed: {ex.Message}");
                row.IsSuccess = false;
            }
        }

        // A group only counts as saved when every row succeeded AND ended up with a company item id.
        foreach (var g in selectedGroups)
        {
            if (g.Rows.All(r => r.IsSuccess && r.Issues.Count == 0 && r.CompanyItemId.HasValue))
                g.IsSaved = true;
        }

        if (committedCount > 0)
            await OnImportCompleted.InvokeAsync();

        StateHasChanged();
    }

    private async Task HandleDownloadErrorReport()
    {
        if (importResult == null) return;

        var bytes = ImportCompanyItemsService.GenerateErrorReportExcel(importResult);
        var fileName = $"CompanyItem-Import-Errors-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx";

        await JS.InvokeVoidAsync(
            "downloadFileFromBytes",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task CloseResults()
    {
        showResults = false;
        importResult = null;
        selectedGroupKeys.Clear();
        await OnClose.InvokeAsync();
    }

    // Must stay identical to GroupKey in ImportCompanyItemsResult.razor (row number of the group's first row).
    private static string GroupKey(STTproject.Features.Admin.CompanyItem.DTOs.PreparedCompanyItemGroup g)
        => (g.Rows.FirstOrDefault()?.RowNumber ?? 0).ToString();
}
