@using STTproject.Shared.Components
@inject STTproject.Features.Admin.CompanyItem.Services.IAdminCompanyItemService AdminCompanyItemService
@inject STTproject.Services.IUserContextService UserContextService

<link rel="stylesheet" href="css/Table.css" asp-append-version="true" />

<div class="clt-page">
    <div class="clt-layout">

        <aside class="clt-sidebar">
            <div class="clt-sidebar-stats">
                <div class="clt-stat">
                    <span class="clt-stat-label">Total</span>
                    <span class="clt-stat-value">@totalCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Active</span>
                    <span class="clt-stat-value clt-stat-active">@activeCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Inactive</span>
                    <span class="clt-stat-value clt-stat-inactive">@inactiveCount</span>
                </div>
            </div>
            <div class="clt-divider"></div>

            @* Search *@
            <div class="clt-filter-group">
                <Input TValue="string" Label="Search"
                    Placeholder="Search..."
                    Value="@SearchTerm" ValueChanged="OnSearchChanged" />
            </div>

            @* Status *@
            <div class="clt-filter-group">
                <label class="clt-filter-label">Status</label>
                <div class="clt-radio-group">
                    <label class="clt-radio-option @(SelectedStatus == "" ? "selected" : "")">
                        <input type="radio" name="status" value=""
                            @onchange="() => OnFilterChanged(status: string.Empty)"
                            checked="@(SelectedStatus == "")" />
                        <span>All</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "active" ? "selected" : "")">
                        <input type="radio" name="status" value="active"
                            @onchange='() => OnFilterChanged(status: "active")'
                            checked="@(SelectedStatus == "active")" />
                        <span>Active</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "inactive" ? "selected" : "")">
                        <input type="radio" name="status" value="inactive"
                            @onchange='() => OnFilterChanged(status: "inactive")'
                            checked="@(SelectedStatus == "inactive")" />
                        <span>Inactive</span>
                    </label>
                </div>
            </div>

            @* Principal *@
            <div class="clt-filter-group">
                <AutoComplete @key="@($"principal-{filterResetKey}")"
                        Label="Principal"
                        Placeholder="All principals"
                        TItem="FilterOption"
                        Items="PrincipalOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@SelectedPrincipalId"
                        SelectedValueChanged="OnPrincipalSelected" />
            </div>

            @if (HasActiveFilters)
            {
                <button class="clt-clear-btn" @onclick="ClearFilters">Clear all filters</button>
            }
        </aside>

        <main class="clt-main">
            <div class="clt-table-card">
                <div class="clt-table-scroll">
                    <table class="clt-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SortBy("ItemCode")' style="cursor:pointer">Item Code @SortIndicator("ItemCode")</th>
                                <th @onclick='() => SortBy("ItemName")' style="cursor:pointer">Item Name @SortIndicator("ItemName")</th>
                                <th @onclick='() => SortBy("Principal")' style="cursor:pointer">Principal @SortIndicator("Principal")</th>
                                <th @onclick='() => SortBy("Category")' style="cursor:pointer">Category @SortIndicator("Category")</th>
                                <th @onclick='() => SortBy("CreatedDate")' style="cursor:pointer">Created @SortIndicator("CreatedDate")</th>
                                <th @onclick='() => SortBy("IsActive")' style="cursor:pointer">Status @SortIndicator("IsActive")</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="7" class="clt-empty"><div class="clt-empty-inner"><p>Loading…</p></div></td></tr>
                            }
                            else if (!PagedCompanyItems.Any())
                            {
                                <tr>
                                    <td colspan="7" class="clt-empty">
                                        <div class="clt-empty-inner">
                                            <p>@(HasActiveFilters ? "No company items match your filters" : "No company items found")</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var companyItem in PagedCompanyItems)
                                {
                                    <tr class="@(!companyItem.IsActive ? "clt-row-inactive" : "")">
                                        <td><span class="clt-code">@companyItem.ItemCode</span></td>
                                        <td class="clt-name">@companyItem.ItemName</td>
                                        <td class="clt-muted">@companyItem.Principal</td>
                                        <td><span class="clt-type-badge">@companyItem.Category</span></td>
                                        <td class="clt-muted">@companyItem.CreatedDate.ToString("MMM d, yyyy hh:mm tt")</td>
                                        <td>
                                            @if (companyItem.IsActive)
                                            {
                                                <span class="clt-status clt-status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="clt-status clt-status-inactive">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="clt-actions">
                                                <button class="clt-btn-edit"
                                                        @onclick="() => OnViewCompanyItem.InvokeAsync(companyItem.CompanyItemId)">
                                                    View
                                                </button>
                                                @if (companyItem.IsActive)
                                                {
                                                    <button class="clt-btn-toggle clt-btn-deactivate"
                                                            @onclick="() => SetActive(companyItem.CompanyItemId, false)">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="clt-btn-toggle clt-btn-activate"
                                                            @onclick="() => SetActive(companyItem.CompanyItemId, true)">
                                                        Activate
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="clt-footer">
                <span class="clt-footer-count">Showing @PagedCompanyItems.Count of @totalCount company items</span>
                @if (totalPages > 1)
                {
                    <div class="clt-pagination">
                        <button class="clt-page-btn" disabled="@(currentPage == 1)"
                                @onclick="() => GoToPage(currentPage - 1)">←</button>
                        <span>Page @currentPage of @totalPages</span>
                        <button class="clt-page-btn" disabled="@(currentPage >= totalPages)"
                                @onclick="() => GoToPage(currentPage + 1)">→</button>
                    </div>
                }
            </div>
        </main>
    </div>

    <ConfirmModal Show="showToggleConfirmModal" Title="Confirm Status Change"
                  Message="@toggleConfirmMessage" OnYes="ConfirmToggle" OnNo="CancelToggle" />
</div>

@code {
    [Parameter] public EventCallback OnLoaded { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public EventCallback<int> OnViewCompanyItem { get; set; }

    private record FilterOption(string Value, string Text);

    private List<CompanyItemListDto> PagedCompanyItems { get; set; } = new();
    private List<string> Principals { get; set; } = new();

    private List<FilterOption> PrincipalOptions =>
        Principals.Select(p => new FilterOption(p, p)).ToList();

    private string SelectedStatus { get; set; } = "";
    private string SelectedPrincipalId { get; set; } = "";
    private int filterResetKey;

    private string SortColumn { get; set; } = "CreatedDate";
    private bool SortAscending { get; set; } = true;

    private int currentPage = 1;
    private const int pageSize = 50;
    private int totalCount;
    private int activeCount;
    private int inactiveCount;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private bool isLoading = true;
    private System.Threading.Timer? _debounceTimer;

    private bool showToggleConfirmModal;
    private int pendingToggleId;
    private bool pendingToggleStatus;
    private string toggleConfirmMessage = "";

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    currentPage = 1;
                    await LoadPageAsync();
                });
            }, null, 400, Timeout.Infinite);
        }
    }
    private void OnSearchChanged(string? value) => SearchTerm = value ?? string.Empty;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrEmpty(SelectedStatus) ||
        !string.IsNullOrEmpty(SelectedPrincipalId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load principals once here, not on every LoadPageAsync call
            var allItems = await AdminCompanyItemService.GetAllAsync();
            Principals = allItems
                .Where(x => !string.IsNullOrWhiteSpace(x.Principal))
                .Select(x => x.Principal!)
                .Distinct()
                .OrderBy(x => x)
                .ToList();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading company items: {ex.Message}");
            isLoading = false;
        }
    }

    public async Task LoadPageAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (items, total) = await AdminCompanyItemService.GetPagedAsync(
                currentPage, pageSize, _searchTerm, SelectedStatus,
                SelectedPrincipalId,
                SortColumn, SortAscending);

            PagedCompanyItems = items.ToList();
            totalCount = total;

            var (_, activeTotal) = await AdminCompanyItemService.GetPagedAsync(
                1, 1, _searchTerm, "active", SelectedPrincipalId);
            var (_, inactiveTotal) = await AdminCompanyItemService.GetPagedAsync(
                1, 1, _searchTerm, "inactive", SelectedPrincipalId);
            activeCount = activeTotal;
            inactiveCount = inactiveTotal;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading company items: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            if (OnCountChanged.HasDelegate) await OnCountChanged.InvokeAsync(totalCount);
            if (OnLoaded.HasDelegate) await OnLoaded.InvokeAsync();
        }
    }

    private async Task OnFilterChanged(string? status = null)
    {
        if (status != null) SelectedStatus = status;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnPrincipalSelected(string? value)
    {
        SelectedPrincipalId = value ?? string.Empty;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        _debounceTimer?.Dispose();
        _searchTerm = "";
        SelectedStatus = "";
        SelectedPrincipalId = "";
        SortColumn = "CreatedDate";
        SortAscending = true;
        currentPage = 1;
        filterResetKey++;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPageAsync();
    }

    private void SetActive(int id, bool isActive)
    {
        pendingToggleId = id;
        pendingToggleStatus = isActive;
        toggleConfirmMessage = isActive
            ? "Are you sure you want to activate this company item?"
            : "Are you sure you want to deactivate this company item?";
        showToggleConfirmModal = true;
    }

    private async Task ConfirmToggle()
    {
        showToggleConfirmModal = false;
        await AdminCompanyItemService.ToggleCompanyItemStatusAsync(pendingToggleId, pendingToggleStatus, UserContextService.UserId);
        var companyItem = PagedCompanyItems.FirstOrDefault(x => x.CompanyItemId == pendingToggleId);
        if (companyItem != null) companyItem.IsActive = pendingToggleStatus;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelToggle() => showToggleConfirmModal = false;

    private async Task SortBy(string column)
    {
        if (SortColumn == column)
            SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }

    private string SortIndicator(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortAscending ? " ▲" : " ▼";
    }
}