@page "/admin"
@using STTproject.Features.Admin.Dashboard.Components
@using STTproject.Features.Admin.Dashboard.Components.Sections
@using STTproject.Features.Admin.Dashboard.DTOs
@using STTproject.Features.Admin.Dashboard.Services
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@using Microsoft.AspNetCore.Components
@using STTproject.Services
@using Microsoft.Extensions.Logging

<LoadingOverlay Show="isLoading" Title="Loading dashboard…" Subtitle="Fetching the latest figures."
                IconClass="fa-solid fa-chart-line" />

@if (!isLoading)
{
    <div class="dash">
        <h1>OVERVIEW</h1>

        @if (loadError is not null)
        {
            <div class="card load-error">
                <b>The dashboard couldn't load.</b>
                <span>@loadError</span>
                <button type="button" class="pbtn" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else
        {
            @* Click a card to show its details below *@
            <div class="kpis">
                <button type="button" class="card kpi @Sel("sales")" style="--accent:var(--gold)"
                        @onclick='() => panel = "sales"'>
                    <div class="kpi-label">Total sales · all time</div>
                    <div class="kpi-value">@DashFormat.PesoShort(allInvoice - allCredit)</div>
                    <div class="kpi-foot">
                        <span>Invoices @DashFormat.PesoShort(allInvoice) · Credits −@DashFormat.PesoShort(allCredit)</span>
                    </div>
                </button>

                <button type="button" class="card kpi @Sel("errors")" style="--accent:var(--red)"
                        @onclick='() => panel = "errors"'>
                    <div class="kpi-label">Pending import errors</div>
                    <div class="kpi-value @(errors.PendingCount > 0 ? "neg" : "")">@DashFormat.Number(errors.PendingCount)</div>
                    <div class="kpi-foot">
                        @if (errors.NewThisWeek > 0)
                        {
                            <span class="delta bad">▲ @errors.NewThisWeek</span>
                            <span>new this week · in @errors.Batches.Count batches</span>
                        }
                        else
                        {
                            <span>in @errors.Batches.Count batches</span>
                        }
                    </div>
                </button>

                <button type="button" class="card kpi @Sel("prices")" style="--accent:var(--slate)"
                        @onclick='() => panel = "prices"'>
                    <div class="kpi-label">Price increases pending</div>
                    <div class="kpi-value">@prices.Count</div>
                    <div class="kpi-foot">
                        @if (overdueCount > 0)
                        {
                            <span class="delta bad">@overdueCount overdue</span>
                        }
                        <span>@(nextIncrease is null ? "nothing upcoming" : "next on " +
                                                                                                                                                                                                                DashFormat.DateShort(nextIncrease.Value))</span>
                        </div>
                    </button>

                    <button type="button" class="card kpi @Sel("records")" style="--accent:var(--ink-2)"
                            @onclick='() => panel = "records"'>
                        <div class="kpi-label">Records</div>
                        <div class="kpi-value">@DashFormat.Number(records.SubdsActive + records.SubdsInactive) <small>sub
                            distributors</small></div>
                            <div class="kpi-foot">
                                <span>@DashFormat.Number(records.CustomersActive + records.CustomersInactive) customers ·
                                    @DashFormat.Number(records.CompanyItemsActive + records.CompanyItemsInactive) company items ·
                                    @DashFormat.Number(records.SubdItemsActive + records.SubdItemsInactive) mapped</span>
                                </div>
                            </button>
                        </div>

                        @* Panels stay mounted (only hidden) so each keeps its filters, sort and page. *@
                        <div class="detail">
                            <div class="panel-host @On("sales")">
                                <SalesPanel Data="sales" />
                            </div>
                            <div class="panel-host @On("errors")">
                                <ImportErrorsPanel Data="errors" />
                            </div>
                            <div class="panel-host @On("prices")">
                                <PriceIncreasesPanel Data="prices" />
                            </div>
                            <div class="panel-host @On("records")">
                                <RecordsPanel Data="records" />
                            </div>
                        </div>
                    }
                </div>
            }

@code {
    [Inject] private IUserContextService UserContext { get; set; } = default!;
    [Inject] private IHomeService HomeService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IAdminDashboardService DashboardService { get; set; } = default!;
    [Inject] private ILogger<Admin> Logger { get; set; } = default!;

    private bool isLoading = true;
    private string? loadError;
    private string panel = "sales";

    private SalesDashboardDto sales = new();
    private PendingErrorsSummaryDto errors = new();
    private List<PendingPriceIncreaseDto> prices = new();
    private RecordsDto records = new();

    // Card figures
    private decimal allInvoice;
    private decimal allCredit;
    private int overdueCount;
    private DateTime? nextIncrease;

    private string Sel(string key) => panel == key ? "sel" : "";
    private string On(string key) => panel == key ? "on" : "";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (!UserContext.UserId.HasValue)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        var user = await HomeService.GetUserAsync(UserContext.UserId.Value);
        if (user == null || !string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/home", forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            // Each service call uses its own DbContext, so these can run together.
            var salesTask = DashboardService.GetSalesAsync();
            var errorsTask = DashboardService.GetPendingErrorsAsync();
            var pricesTask = DashboardService.GetPendingPriceIncreasesAsync();
            var recordsTask = DashboardService.GetRecordsAsync();
            await Task.WhenAll(salesTask, errorsTask, pricesTask, recordsTask);

            sales = salesTask.Result;
            errors = errorsTask.Result;
            prices = pricesTask.Result;
            records = recordsTask.Result;

            allInvoice = sales.Months.Sum(m => m.InvoiceAmount);
            allCredit = sales.Months.Sum(m => m.CreditAmount);
            overdueCount = prices.Count(p => p.IsOverdue);
            nextIncrease = prices.Where(p => !p.IsOverdue).Select(p => (DateTime?)p.EffectivityDate).Min();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Admin dashboard failed to load");
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
