@page "/admin"
@using STTproject.Features.Admin.Dashboard.Components.Sections
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@using Microsoft.AspNetCore.Components
@using STTproject.Services

<LoadingOverlay Show="ShowOverlay"
                Title="Loading dashboard…"
                Subtitle="Fetching the latest figures."
                IconClass="fa-solid fa-chart-line" />

@if (!isCheckingAccess)
{
    <div class="admin-page" style="@(AllSectionsLoaded ? "" : "visibility:hidden; position:absolute; top:0; left:0;")">
        <h1>DASHBOARD</h1>
        <CustPerSubd OnLoaded="@(() => MarkLoaded("cust"))" />
        <TotalMonthlyAnnualPrice OnLoaded="@(() => MarkLoaded("price"))" />
        <SubdItemPerSubd OnLoaded="@(() => MarkLoaded("subditem"))" />
    </div>
}

@code {
    [Inject] private IUserContextService UserContext { get; set; } = default!;
    [Inject] private IHomeService HomeService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool isCheckingAccess = true;
    private readonly HashSet<string> loadedSections = new();
    private const int TotalSections = 3;

    private bool AllSectionsLoaded => loadedSections.Count >= TotalSections;
    private bool ShowOverlay => isCheckingAccess && !AllSectionsLoaded;

    protected override async Task OnParametersSetAsync()
    {
        isCheckingAccess = true;
        loadedSections.Clear();

        if (!UserContext.UserId.HasValue)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        var user = await HomeService.GetUserAsync(UserContext.UserId.Value);
        if (user == null || !string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/home", forceLoad: true);
            return;
        }

        isCheckingAccess = false;
    }

    private void MarkLoaded(string key)
    {
        loadedSections.Add(key);
        StateHasChanged();
    }
}