@using STTproject.Features.Admin.Dashboard.Components
@using STTproject.Features.Admin.Dashboard.DTOs
@inherits DashPanelBase

@{
    var rankRows = Sorted(rankBase, RankKeys, r => r.Subd.SubdName);
    var pageRows = PageOf(rankRows);
    var start = (CurrentPage - 1) * PageSize;
}

<section class="panel p-sales">
    @* ================= LEFT: totals + chart ================= *@
    <div class="card pcard">
        <div class="pcard-head">
            <div class="head-text">
                <h3 class="pcard-title">Sales · @(PeriodName + PeriodTag)</h3>
                <div class="pcard-sub">
                    @if (selectedSubd is null)
                    {
                        <text>All sub distributors · click one on the right to filter</text>
                    }
                    else
                    {
                        <span class="chip">@selectedSubd.SubdCode</span> @selectedSubd.SubdName
                        <text> · </text>
                        <button type="button" class="back" @onclick="ClearSubd">✕ Show all</button>
                    }
                </div>
            </div>
            <div class="ctrls">
                @if (month is not null)
                {
                    <button type="button" class="back" @onclick="() => SetMonth(null)">← Whole year</button>
                }
                <span class="ctl-select">
                    <Select TItem="int"
                            Items="years"
                            ValueSelector="@(y => y.ToString())"
                            TextSelector="@(y => y.ToString())"
                            ShowPlaceholder="true"
                            Placeholder="All years"
                            SelectedValue="@(year?.ToString() ?? string.Empty)"
                            SelectedValueChanged="OnYearChanged" />
                </span>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="l">Total amount</div><div class="v">@DashFormat.Peso(totals.Net)</div></div>
            <div class="stat"><div class="l">Invoice amount</div><div class="v">@DashFormat.Peso(totals.Invoice)</div></div>
            <div class="stat"><div class="l">Credit memo amount</div><div class="v neg">−@DashFormat.Peso(totals.Credit)</div></div>
            <div class="stat"><div class="l">No. of invoices</div><div class="v">@DashFormat.Number(totals.Count)</div></div>
        </div>

        <div class="pcard-head chart-head">
            <div class="sec">@ChartTitle</div>
            <div class="legend">
                <span><i style="background:var(--gold)"></i>Total amount</span>
                <span class="muted">@(year is null ? "Click a year to open it" : "Click a month to see only that month")</span>
            </div>
        </div>

        <div class="body">
            <div class="bar-chart">
                <div class="plot">
                    @foreach (var t in ticks)
                    {
                        <div class="gl" style="bottom:@DashFormat.Css(Pct(t))%"><span>@(t == 0 ? "0" : DashFormat.PesoShort(t))</span></div>
                    }
                </div>
                <div class="bars">
                    @foreach (var b in bars)
                    {
                        var bar = b;
                        <div class="bar-col @(bar.Future ? "future" : "") @(bar.Selected ? "sel" : "")"
                             @onclick="() => OnBarClick(bar)">
                            <div class="bar-area">
                                @if (bar.Net > 0)
                                {
                                    <div class="bar" style="height:@DashFormat.Css(Pct(bar.Net))%">
                                        @if (bar.Selected || year is null)
                                        {
                                            <span class="bar-val">@DashFormat.PesoShort(bar.Net)</span>
                                        }
                                    </div>
                                }
                                @if (!bar.Future)
                                {
                                    <div class="bar-tip">
                                        <b>@bar.Title</b><br />
                                        Invoices @DashFormat.Peso(bar.Invoice)<br />
                                        Credits −@DashFormat.Peso(bar.Credit)<br />
                                        <b>Total @DashFormat.Peso(bar.Net)</b>
                                    </div>
                                }
                            </div>
                            <div class="bar-label">@bar.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ================= RIGHT: by sub distributor ================= *@
    <div class="card pcard">
        <div class="pcard-head">
            <div class="head-text">
                <h3 class="pcard-title">By sub distributor</h3>
                <div class="pcard-sub">Total amount · @(PeriodName + PeriodTag) · click a header to sort, a row to filter</div>
            </div>
        </div>
        <div class="body" @ref="rankBody">
            <table>
                <colgroup><col style="width:34px"><col><col style="width:110px"><col style="width:70px"></colgroup>
                <thead>
                    <tr>
                        <th>#</th>
                        <th class="@SortClass("name")" @onclick='() => ToggleSort("name")'>Sub distributor <i>@SortArrow("name")</i></th>
                        <th class="@SortClass("amount") num" @onclick='() => ToggleSort("amount", startDescending: true)'>Amount <i>@SortArrow("amount")</i></th>
                        <th>Share</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < pageRows.Count; i++)
                    {
                        var r = pageRows[i];
                        <tr class="click @(selectedSubdId == r.Subd.SubDistributorId ? "hl" : "") @(r.HasSales ? "" : "none")"
                            title="@r.Subd.SubdName"
                            @onclick="() => ToggleSubd(r.Subd.SubDistributorId)">
                            <td class="muted">@(start + i + 1)</td>
                            <td><span class="chip">@r.Subd.SubdCode</span> @r.Subd.SubdName</td>
                            <td class="num">
                                @if (r.HasSales)
                                {
                                    <b>@DashFormat.PesoShort(r.Net)</b>
                                }
                                else
                                {
                                    <span class="tag t-bad">No invoices</span>
                                }
                            </td>
                            <td>
                                @if (r.Net > 0 && maxRankNet > 0)
                                {
                                    <div class="share"><i style="width:@DashFormat.Css(Math.Max(3, (double)(r.Net / maxRankNet) * 100))%"></i></div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <DashPager Page="CurrentPage" Pages="TotalPages(rankRows.Count)" Shown="pageRows.Count" Total="rankRows.Count"
                   Label="sub distributors" PageChanged="GoToPage" />
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SalesDashboardDto Data { get; set; } = new();

    // Filters: year null = all years; month null = whole year; subd null = all.
    private int? year = DateTime.Today.Year;
    private int? month;
    private int? selectedSubdId;

    private ElementReference rankBody;

    // Derived (rebuilt by Recalculate)
    private List<int> years = new();
    private (decimal Invoice, decimal Credit, decimal Net, int Count) totals;
    private List<Bar> bars = new();
    private decimal chartMax = 1;
    private decimal[] ticks = Array.Empty<decimal>();
    private List<RankRow> rankBase = new();
    private decimal maxRankNet;
    private SubdLookupDto? selectedSubd;

    private record Bar(string Label, string Title, int? Year, int? Month, decimal Invoice, decimal Credit, bool Selected, bool Future)
    {
        public decimal Net => Invoice - Credit;
    }

    private record RankRow(SubdLookupDto Subd, decimal Invoice, decimal Credit)
    {
        public decimal Net => Invoice - Credit;
        public bool HasSales => Invoice != 0 || Credit != 0;
    }

    private static int ThisYear => DateTime.Today.Year;
    private static int ThisMonth => DateTime.Today.Month;

    protected override void OnInitialized()
    {
        SortKey = "amount";
        SortAsc = false;
    }

    protected override void OnParametersSet()
    {
        years = Data.Months.Select(m => m.Year).Append(ThisYear).Distinct().OrderByDescending(y => y).ToList();
        Recalculate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await WatchRowsAsync(rankBody, rowHeight: 40);
    }

    // ---------- Labels ----------
    private string PeriodName => year is null
        ? (years.Count > 0 ? $"All years ({years.Min()}–{years.Max()})" : "All years")
        : month is null ? $"{year}" : $"{DashFormat.MonthName(month.Value)} {year}";

    private string PeriodTag => year == ThisYear
        ? month is null ? " (year to date)" : month == ThisMonth ? " (month to date)" : ""
        : "";

    private string ChartTitle => (year is null ? "Yearly totals" : $"Monthly totals · {year}")
        + (selectedSubd is null ? "" : $" · {selectedSubd.SubdCode}");

    // ---------- Filter actions ----------
    private void OnYearChanged(string value)
    {
        year = int.TryParse(value, out var y) ? y : null;
        month = null;
        CurrentPage = 1;
        Recalculate();
    }

    private void SetMonth(int? m)
    {
        month = m;
        CurrentPage = 1;
        Recalculate();
    }

    private void OnBarClick(Bar bar)
    {
        if (bar.Future) return;
        if (bar.Year is not null && year is null) { year = bar.Year; month = null; } // all years → open that year
        else month = month == bar.Month ? null : bar.Month;                           // month toggles
        CurrentPage = 1;
        Recalculate();
    }

    private void ToggleSubd(int id)
    {
        selectedSubdId = selectedSubdId == id ? null : id;
        Recalculate();
    }

    private void ClearSubd()
    {
        selectedSubdId = null;
        Recalculate();
    }

    // ---------- Calculations (all in memory) ----------
    private IEnumerable<SalesMonthDto> InPeriod(IEnumerable<SalesMonthDto> rows) => rows.Where(m =>
        (year is null || m.Year == year) && (month is null || m.Month == month));

    private void Recalculate()
    {
        selectedSubd = Data.SubDistributors.FirstOrDefault(s => s.SubDistributorId == selectedSubdId);

        // Totals for the period + selected sub distributor
        var scoped = InPeriod(Data.Months).Where(m => selectedSubdId is null || m.SubDistributorId == selectedSubdId).ToList();
        totals = (scoped.Sum(m => m.InvoiceAmount), scoped.Sum(m => m.CreditAmount), scoped.Sum(m => m.NetAmount), scoped.Sum(m => m.InvoiceCount));

        // Chart: one bar per year (all years) or per month (one year)
        var forSubd = Data.Months.Where(m => selectedSubdId is null || m.SubDistributorId == selectedSubdId).ToList();
        if (year is null)
        {
            bars = years.OrderBy(y => y).Select(y =>
            {
                var rows = forSubd.Where(m => m.Year == y).ToList();
                return new Bar(y.ToString(), y == ThisYear ? $"{y} (YTD)" : $"{y}", y, null,
                               rows.Sum(m => m.InvoiceAmount), rows.Sum(m => m.CreditAmount), false, false);
            }).ToList();
        }
        else
        {
            bars = Enumerable.Range(1, 12).Select(mo =>
            {
                var rows = forSubd.Where(m => m.Year == year && m.Month == mo).ToList();
                var future = year == ThisYear && mo > ThisMonth;
                var title = $"{DashFormat.MonthName(mo)} {year}" + (year == ThisYear && mo == ThisMonth ? " (MTD)" : "");
                return new Bar(DashFormat.MonthAbbr(mo), title, null, mo,
                               rows.Sum(m => m.InvoiceAmount), rows.Sum(m => m.CreditAmount), month == mo, future);
            }).ToList();
        }

        var max = Math.Max(bars.Select(b => b.Net).DefaultIfEmpty(0).Max(), 1);
        var step = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)max)));
        chartMax = Math.Ceiling(max / step) * step;
        ticks = new[] { 0m, chartMax * 0.25m, chartMax * 0.5m, chartMax * 0.75m, chartMax };

        // Ranking: every sub distributor, including ones with no invoices in the period
        var periodBySubd = InPeriod(Data.Months)
            .GroupBy(m => m.SubDistributorId)
            .ToDictionary(g => g.Key, g => (Inv: g.Sum(x => x.InvoiceAmount), Cred: g.Sum(x => x.CreditAmount)));

        var rowsAll = Data.SubDistributors.Select(s =>
        {
            periodBySubd.TryGetValue(s.SubDistributorId, out var v);
            return new RankRow(s, v.Inv, v.Cred);
        });

        rankBase = rowsAll.ToList();
        maxRankNet = rankBase.Select(r => r.Net).DefaultIfEmpty(0).Max();
    }

    private static readonly Dictionary<string, Func<RankRow, IComparable>> RankKeys = new()
    {
        ["name"] = r => r.Subd.SubdName,
        ["amount"] = r => r.Net
    };

    private double Pct(decimal value) => chartMax == 0 ? 0 : Math.Clamp((double)(value / chartMax) * 100, 0, 100);
}
