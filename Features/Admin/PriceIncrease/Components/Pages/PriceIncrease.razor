@page "/admin/priceincrease"
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@using STTproject.Features.Admin.PriceIncrease.Components.Modals
@using STTproject.Features.Admin.PriceIncrease.Components.Sections
@using STTproject.Shared.Components.Loadings

<LoadingOverlay Show="isLoading"
                      Title="Loading price changes…"
                      Subtitle="Please wait while we fetch the latest data."
                      IconClass="fa-solid fa-money-bill-trend-up" />

<div style="@(isLoading ? "display:none;" : "")">
    <div class="clt-page">
        @* ------------- Header ----------------- *@
        <div class="clt-page-header">
            <div>
                <h1 class="clt-page-title">Price Changes</h1>
                <p class="clt-page-sub">@totalCount total price changes</p>
            </div>
            <button class="clt-add-btn" @onclick="OpenAddPriceIncreaseModal">
                <span class="clt-add-icon">+</span> Add price change
            </button>
        </div>

        @* ------------- Price List Table ----------------- *@
        <PriceIncreaseTable @ref="priceIncreaseTable" OnLoaded="OnTableLoaded" OnCountChanged="OnCountChanged"
                            OnEditPriceIncrease="OpenEditModal"
                             />
        <ConfirmModal @ref="confirmAddModal" Show="showConfirmAddModal"
                    Title="@(editPriceIncreaseId.HasValue ? "Confirm Update of Price Change" : "Confirm Creation of Price Change")"
                    Message="@(showConfirmError ? null : (editPriceIncreaseId.HasValue ? "Are you sure you want to save changes to this price change?" : "Are you sure you want to create this price change?"))"
                    ErrorMessage="@confirmErrorMessage"
                    ShowError="showConfirmError"
                    OnYes="ConfirmAddPriceIncrease"
                    OnNo="CancelConfirm"
                    OnErrorConfirm="DismissConfirmError" />

        @if (showAddModal)
        {
            <AddPriceIncrease @ref="addPriceIncreaseModal" PriceIncreaseId="editPriceIncreaseId" onCancel="CancelAddPriceIncrease"
                            OnRequestConfirm="OpenConfirmModal" />
        }
       

    </div>
</div>


@code {
    private ConfirmModal? confirmAddModal;
    private bool showConfirmAddModal;
    private bool showAddModal;
    private bool isLoading = true;
    private int totalCount = 0;
    private PriceIncreaseTable? priceIncreaseTable;
    private AddPriceIncrease? addPriceIncreaseModal;

    private async Task OnTableLoaded()
    {
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }
    private int? editPriceIncreaseId;

    private void OpenAddPriceIncreaseModal()
    {
        editPriceIncreaseId = null; 
        showAddModal = true;
    }
    private void OpenEditModal(int id)
    {
        editPriceIncreaseId = id;
        showAddModal = true;
    }
    private bool showConfirmError;
    private string? confirmErrorMessage;

    private void OpenConfirmModal()
    {
        showConfirmError = false;
        confirmErrorMessage = null;
        showConfirmAddModal = true;
    }

    private async Task ConfirmAddPriceIncrease()
    {
        if (addPriceIncreaseModal == null) return;

        var (success, error) = await addPriceIncreaseModal.SubmitAsync();

        if (success)
        {
            showConfirmAddModal = false;
            showAddModal = false;
            if (priceIncreaseTable != null)
                await priceIncreaseTable.LoadPageAsync();
        }
        else
        {
            confirmErrorMessage = error ?? "An unexpected error occurred. Please try again.";
            showConfirmError = true;
        }
    }

    private void DismissConfirmError()
    {
        showConfirmError = false;
        confirmErrorMessage = null;
        showConfirmAddModal = false;
    }
    private void OnCountChanged(int count) => totalCount = count;

    private void CancelConfirm() => showConfirmAddModal = false;

    private void CancelAddPriceIncrease() => showAddModal = false;

}