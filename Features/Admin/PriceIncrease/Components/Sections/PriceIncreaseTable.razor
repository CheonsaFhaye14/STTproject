
@inject STTproject.Features.Admin.PriceIncrease.Services.IAdminPriceIncreaseService AdminPriceIncreaseService

<link rel="stylesheet" href="css/Table.css" asp-append-version="true" />

<div class="clt-page">
    <div class="clt-layout">

        <aside class="clt-sidebar">
            <div class="clt-sidebar-stats">
                <div class="clt-stat">
                    <span class="clt-stat-label">Total</span>
                    <span class="clt-stat-value">@totalCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Pending</span>
                    <span class="clt-stat-value clt-stat-pending">@pendingCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Overdue</span>
                    <span class="clt-stat-value clt-stat-overdue">@overdueCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Applied</span>
                    <span class="clt-stat-value clt-stat-applied">@appliedCount</span>
                </div>
            </div>
            <div class="clt-divider"></div>

            @* Search *@
            <div class="clt-filter-group">
                <Input TValue="string" Label="Search"
                    Placeholder="Search..."
                    Value="@SearchTerm" ValueChanged="OnSearchChanged" />
            </div>

            @* Status *@
            <div class="clt-filter-group">
                <label class="clt-filter-label">Status</label>
                <div class="clt-radio-group">
                    <label class="clt-radio-option @(SelectedStatus == "" ? "selected" : "")">
                        <input type="radio" name="status" value=""
                            @onchange="() => OnFilterChanged(status: string.Empty)"
                           checked="@(SelectedStatus == "")" />
                        <span>All</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "pending" ? "selected" : "")">
                        <input type="radio" name="status" value="pending"
                            @onchange='() => OnFilterChanged(status: "pending")'
                            checked="@(SelectedStatus == "pending")" />
                        <span>Pending</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "overdue" ? "selected" : "")">
                        <input type="radio" name="status" value="overdue"
                            @onchange='() => OnFilterChanged(status: "overdue")'
                            checked="@(SelectedStatus == "overdue")" />
                        <span>Overdue</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "applied" ? "selected" : "")">
                        <input type="radio" name="status" value="applied"
                            @onchange='() => OnFilterChanged(status: "applied")'
                            checked="@(SelectedStatus == "applied")" />
                        <span>Applied</span>
                    </label>
                </div>
            </div>

            @* Principal *@
            <div class="clt-filter-group">
                <AutoComplete @key="@($"principal-{filterResetKey}")"
                        Label="Principal"
                        Placeholder="All principals"
                        TItem="FilterOption"
                        Items="PrincipalOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@SelectedPrincipalId"
                        SelectedValueChanged="OnPrincipalSelected" />
            </div>

            @if (HasActiveFilters)
            {
                <button class="clt-clear-btn" @onclick="ClearFilters">Clear all filters</button>
            }
        </aside>

        <main class="clt-main">
            <div class="clt-table-card">
                <div class="clt-table-scroll">
@if (groupByItem)
{
<table class="clt-table">
    <thead>
        <tr>
            <th @onclick='() => SortBy("CompanyItemCode")'>Company Item @SortIndicator("CompanyItemCode")</th>
            <th>Stock UOM</th>
            <th>Current Price</th>
            <th @onclick='() => SortBy("EffectivityDate")'>Next / Last Change @SortIndicator("EffectivityDate")</th>
            <th @onclick='() => SortBy("Status")'>Changes @SortIndicator("Status")</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (isLoading)
        {
            <tr><td colspan="6" class="clt-empty"><div class="clt-empty-inner"><p>Loading…</p></div></td></tr>
        }
        else if (!ItemSummaries.Any())
        {
            <tr><td colspan="7" class="clt-empty"><div class="clt-empty-inner"><p>@(HasActiveFilters ? "No company items match your filters" : "No price changes found")</p></div></td></tr>
        }
        else
        {
            @foreach (var it in ItemSummaries)
            {
                <tr>
                    <td><div class="clt-name">@it.CompanyItemCode - @it.CompanyItemName</div></td>
                    <td>@(it.StockUomName ?? "-")</td>
                    <td>
                        @if (it.StockPriceRegional.HasValue || it.StockPriceNational.HasValue)
                        {
                            <div class="clt-schedule-row"><strong>Regional:</strong> @(it.StockPriceRegional?.ToString("N2") ?? "-")</div>
                            <div class="clt-schedule-row"><strong>National:</strong> @(it.StockPriceNational?.ToString("N2") ?? "-")</div>
                        }
                        else
                        {
                            <div>@(it.StockPrice?.ToString("N2") ?? "-")</div>
                        }
                    </td>
                    <td>
                        @if (it.NextEffectivityDate.HasValue)
                        {
                            <div><span class="clt-status clt-status-pending">Next</span> @it.NextEffectivityDate.Value.ToString("MMM d, yyyy")</div>
                        }
                        <div class="clt-muted">Last: @(it.LastEffectivityDate?.ToString("MMM d, yyyy") ?? "-")</div>
                    </td>
                    <td>
                        <div>@it.ChangeCount</div>
                        @if (it.PendingCount > 0)
                        {
                            <div class="clt-muted">@it.PendingCount pending</div>
                        }
                    </td>
                    <td>
                        <div class="clt-actions">
                            <button class="clt-btn-edit" @onclick="() => OpenHistoryAsync(it)">View</button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
}
else
{


<table class="clt-table">
    <thead>
        <tr>
            <th @onclick='() => SortBy("CompanyItemCode")'>
                Company Item @SortIndicator("CompanyItemCode")
            </th>

            <th>Stock UOM</th>

            <th @onclick='() => SortBy("EffectivityDate")'>
                Effective Date @SortIndicator("EffectivityDate")
            </th>

            <th @onclick='() => SortBy("PriceIncreaseAmount")'>
                Amount @SortIndicator("PriceIncreaseAmount")
            </th>

            <th @onclick='() => SortBy("Status")'>
                Status @SortIndicator("Status")
            </th>

            <th @onclick='() => SortBy("CreatedDate")'>
                Created @SortIndicator("CreatedDate")
            </th>

            <th>Actions</th>
        </tr>
    </thead>


<tbody>
    @if (isLoading)
    {
        <tr>
            <td colspan="7" class="clt-empty">
                <div class="clt-empty-inner">
                    <p>Loading…</p>
                </div>
            </td>
        </tr>
    }
    else if (!PagedPriceIncrease.Any())
    {
        <tr>
            <td colspan="7" class="clt-empty">
                <div class="clt-empty-inner">
                    <p>
                        @(HasActiveFilters
                            ? "No price changes match your filters"
                            : "No price changes found")
                    </p>
                </div>
            </td>
        </tr>
    }
    else
    {
        @foreach (var item in PagedPriceIncrease)
        {
            var schedules = item.Schedules
                .Where(x => x != null)
                .ToList();

            var sameDate = schedules.Count > 1 &&
                schedules.Select(x => x.EffectivityDate?.Date)
                    .Distinct()
                    .Count() == 1;

            var sameAmount = schedules.Count > 1 &&
                schedules.Select(x => x.PriceIncreaseAmount)
                    .Distinct()
                    .Count() == 1;

            var sameStatus = schedules.Count > 1 &&
                schedules.Select(x => x.Status)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Count() == 1;

            <tr>
                @* Company Item *@
                <td>
                    <div class="clt-name">
                        @item.CompanyItemCode - @item.CompanyItemName
                    </div>
                </td>

                @* Stock UOM *@
                <td>@(item.Schedules.FirstOrDefault()?.StockUomName ?? "-")</td>

                @* Effective Date *@
                <td>
                    @if (schedules.Count <= 1 || sameDate)
                    {
                        var schedule = schedules.FirstOrDefault();

                        <div>
                            @(schedule?.EffectivityDate?.ToString("MMM d, yyyy") ?? "-")
                        </div>
                    }
                    else
                    {
                        @foreach (var schedule in schedules)
                        {
                            <div class="clt-schedule-row">
                                <strong>@schedule.PriceListType:</strong>
                                @(schedule.EffectivityDate?.ToString("MMM d, yyyy") ?? "-")
                            </div>
                        }
                    }
                </td>

                @* Amount *@
                <td>
                    @if (schedules.Count <= 1 || sameAmount)
                    {
                        var schedule = schedules.FirstOrDefault();

                        <div>
                            @(schedule?.PriceIncreaseAmount?.ToString("N2") ?? "-")
                        </div>

                        @if (schedules.Count > 1)
                        {
                            <div class="clt-muted">
                                National / Regional
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var schedule in schedules)
                        {
                            <div class="clt-schedule-row">
                                <strong>@schedule.PriceListType:</strong>
                                @(schedule.PriceIncreaseAmount?.ToString("N2") ?? "-")
                            </div>
                        }
                    }
                </td>

                @* Status *@
                <td>
                    @if (schedules.Count <= 1 || sameStatus)
                    {
                        var schedule = schedules.FirstOrDefault();

                        @if (schedule != null)
                        {
                            <span class="clt-status clt-status-@(schedule.Status?.ToLowerInvariant())">
                                @schedule.Status
                            </span>
                        }
                    }
                    else
                    {
                        @foreach (var schedule in schedules)
                        {
                            <div class="clt-schedule-row">
                                <strong>@schedule.PriceListType:</strong>
                                <span class="clt-status clt-status-@(schedule.Status?.ToLowerInvariant())">
                                    @schedule.Status
                                </span>
                            </div>
                        }
                    }
                </td>

                @* Created *@
                <td class="clt-muted">
                    @item.CreatedDate.ToString("MMM d, yyyy hh:mm tt")
                </td>

                @* Actions *@
                <td>
                    @foreach (var schedule in schedules)
                    {
                        <div class="clt-actions">
                            @if (schedules.Count > 1)
                            {
                                <span class="clt-muted">@schedule.PriceListType</span>
                            }
                            @* Same buttons as the Subdistributors table (css/Table.css) *@
                            <button class="clt-btn-edit"
                                    @onclick="() => OnEditPriceIncrease.InvokeAsync(schedule.CompanyItemPriceHistoryId)">
                                Edit
                            </button>
                            <button class="clt-btn-toggle clt-btn-deactivate"
                                    @onclick="() => RequestDelete(schedule)">
                                Delete
                            </button>
                        </div>
                    }
                </td>
            </tr>
        }
    }
</tbody>

</table>
}


                </div>
            </div>

            <div class="clt-footer">
                <span class="clt-footer-count">
                    @(groupByItem
                        ? $"Showing {ItemSummaries.Count} of {itemTotal} company items"
                        : $"Showing {PagedPriceIncrease.Count} of {totalCount} price changes")
                </span>                
                @if (CurrentTotalPages > 1)
                {
                    <div class="clt-pagination">
                        <button class="clt-page-btn" disabled="@(currentPage == 1)"
                                @onclick="() => GoToPage(currentPage - 1)">←</button>
                        <span>Page @currentPage of @CurrentTotalPages</span>
                        <button class="clt-page-btn" disabled="@(currentPage >= CurrentTotalPages)"
                                @onclick="() => GoToPage(currentPage + 1)">→</button>
                    </div>
                }
            </div>
        </main>
    </div>

    @if (historyItem is not null)
    {
        <Modal ShowModal="true" Width="860px" MaxWidth="100%" MaxHeight="88vh" Title="Price history"
               Subtitle="@($"{historyItem.CompanyItemCode} - {historyItem.CompanyItemName}")"
               IconType="ModalIconType.ItemView" OnClose="CloseHistory">
            <ChildContent>
                <div class="pi-hist-facts">
                    <span class="pi-fact"><small>Stock UOM</small><b>@(historyItem.StockUomName ?? "-")</b></span>
                    @if (historyItem.StockPriceRegional.HasValue || historyItem.StockPriceNational.HasValue)
                    {
                        <span class="pi-fact"><small>Regional</small><b>@(historyItem.StockPriceRegional?.ToString("N2") ?? "-")</b></span>
                        <span class="pi-fact"><small>National</small><b>@(historyItem.StockPriceNational?.ToString("N2") ?? "-")</b></span>
                    }
                    else
                    {
                        <span class="pi-fact"><small>Stock price</small><b>@(historyItem.StockPrice?.ToString("N2") ?? "-")</b></span>
                    }
                    <span class="pi-fact"><small>Changes</small><b>@historyRows.Count</b></span>
                </div>

                @if (historyLoading)
                {
                    <p class="clt-muted">Loading…</p>
                }
                else
                {
                    <div class="clt-table-card">
                        <table class="clt-table">
                            <thead>
                                <tr>
                                    <th>Effective Date</th>
                                    <th>Price List</th>
                                    <th>Old Price</th>
                                    <th>Amount</th>
                                    <th>New Price</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in historyRows)
                                {
                                    <tr>
                                        <td>@(h.EffectivityDate?.ToString("MMM d, yyyy") ?? "-")</td>
                                        <td>@(h.PriceListType ?? "Stock")</td>
                                        <td>@(h.OldPrice?.ToString("N2") ?? "-")</td>
                                        <td>@(h.PriceIncreaseAmount is decimal a ? (a >= 0 ? "+" : "") + a.ToString("N2") : "-")</td>
                                        <td><strong>@(h.NewPrice?.ToString("N2") ?? "-")</strong></td>
                                        <td><span class="clt-status clt-status-@(h.Status?.ToLowerInvariant())">@h.Status</span></td>
                                        <td>
                                            <div class="clt-actions">
                                                <button class="clt-btn-edit"
                                                        @onclick="() => OnEditPriceIncrease.InvokeAsync(h.CompanyItemPriceHistoryId)">
                                                    Edit
                                                </button>
                                                <button class="clt-btn-toggle clt-btn-deactivate" @onclick="() => RequestDelete(h)">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
            <FooterContent>
                <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="CloseHistory" />
            </FooterContent>
        </Modal>
    }

    <ConfirmModal Show="showToggleConfirmModal" Title="Delete price change"
                  Message="@toggleConfirmMessage" OnYes="ConfirmToggle" OnNo="CancelToggle" />

    <ConfirmModal Show="showDeleteError" Title="Price change not deleted" ShowError="true"
                  ErrorMessage="@deleteError" OnErrorConfirm="DismissDeleteError" />
</div>

@code {
    [Parameter] public EventCallback OnLoaded { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public EventCallback<int> OnEditPriceIncrease { get; set; }

    private record FilterOption(string Value, string Text);

    private List<GroupedPriceIncreaseDto> PagedPriceIncrease { get; set; } = new();

    /// <summary>"By company item" view, switched from the page header.</summary>
    [Parameter] public bool GroupByItem { get; set; }
    private bool groupByItem;
    private bool viewInitialized;

    protected override async Task OnParametersSetAsync()
    {
        if (!viewInitialized) { groupByItem = GroupByItem; viewInitialized = true; return; }
        if (GroupByItem != groupByItem) await SetViewAsync(GroupByItem);
    }
    private List<CompanyItemPriceSummaryDto> ItemSummaries { get; set; } = new();
    private int itemTotal;
    private int CurrentTotalPages => (int)Math.Ceiling((groupByItem ? itemTotal : totalCount) / (double)pageSize);

    private async Task SetViewAsync(bool byItem)
    {
        if (groupByItem == byItem) return;
        groupByItem = byItem;
        currentPage = 1;
        await LoadPageAsync();
    }

    // Price history of one item (opened with View)
    private CompanyItemPriceSummaryDto? historyItem;
    private List<PriceIncreaseTableListDto> historyRows = new();
    private bool historyLoading;

    private async Task OpenHistoryAsync(CompanyItemPriceSummaryDto item)
    {
        historyItem = item;
        await ReloadHistoryAsync();
    }

    private async Task ReloadHistoryAsync()
    {
        if (historyItem is null) return;
        historyLoading = true;
        await InvokeAsync(StateHasChanged);
        historyRows = (await AdminPriceIncreaseService.GetCompanyItemHistoryAsync(historyItem.CompanyItemId)).ToList();
        historyLoading = false;
    }

    private void CloseHistory()
    {
        historyItem = null;
        historyRows = new();
    }
    private List<string> Principals { get; set; } = new();

    private List<FilterOption> PrincipalOptions =>
        Principals.Select(p => new FilterOption(p, p)).ToList();

    private string SelectedStatus { get; set; } = "";
    private string SelectedPrincipalId { get; set; } = "";
    private int filterResetKey;

    private string SortColumn { get; set; } = "CreatedDate";
    private bool SortAscending { get; set; } = true;

    private int currentPage = 1;
    private const int pageSize = 50;
    private int totalCount;
    private int pendingCount;
    private int overdueCount;
    private int appliedCount;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private bool isLoading = true;
    private System.Threading.Timer? _debounceTimer;

    private bool showToggleConfirmModal;
    private int pendingToggleId;
    private string toggleConfirmMessage = "";

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    currentPage = 1;
                    await LoadPageAsync();
                });
            }, null, 400, Timeout.Infinite);
        }
    }
    private void OnSearchChanged(string? value) => SearchTerm = value ?? string.Empty;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrEmpty(SelectedStatus) ||
        !string.IsNullOrEmpty(SelectedPrincipalId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Principals = (await AdminPriceIncreaseService.GetAllPrincipalsAsync())
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p!)
                .ToList();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading price changes: {ex.Message}");
            isLoading = false;
        }
    }

    public async Task LoadPageAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (groupByItem)
            {
                var (summaries, sumTotal) = await AdminPriceIncreaseService.GetCompanyItemSummaryPagedAsync(
                    currentPage, pageSize, _searchTerm, SelectedStatus, SelectedPrincipalId, SortColumn, SortAscending);
                ItemSummaries = summaries.ToList();
                itemTotal = sumTotal;

                // Keep the open history (and its item's prices) in step after an edit or delete.
                if (historyItem is not null)
                {
                    historyItem = ItemSummaries.FirstOrDefault(x => x.CompanyItemId == historyItem.CompanyItemId) ?? historyItem;
                    historyRows = (await AdminPriceIncreaseService.GetCompanyItemHistoryAsync(historyItem.CompanyItemId)).ToList();
                }
            }

            if (!groupByItem)
            {
                var (items, total) =
                    await AdminPriceIncreaseService.GetGroupedPagedAsync(
                        currentPage,
                        pageSize,
                        _searchTerm,
                        SelectedStatus,
                        SelectedPrincipalId,
                        SortColumn,
                        SortAscending);

                PagedPriceIncrease = items.ToList();
                totalCount = total;
            }
            else
            {
                // Total changes for the stats: a 1-row page is enough.
                var (_, allTotal) = await AdminPriceIncreaseService.GetPagedAsync(1, 1, _searchTerm, SelectedStatus, SelectedPrincipalId);
                totalCount = allTotal;
            }

            var (_, pendingTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "pending", SelectedPrincipalId);
            var (_, overdueTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "overdue", SelectedPrincipalId);
            var (_, appliedTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "applied", SelectedPrincipalId);
            pendingCount = pendingTotal;
            overdueCount = overdueTotal;
            appliedCount = appliedTotal;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading price changes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            if (OnCountChanged.HasDelegate) await OnCountChanged.InvokeAsync(totalCount);
            if (OnLoaded.HasDelegate) await OnLoaded.InvokeAsync();
        }
    }

    private async Task OnFilterChanged(string? status = null)
    {
        if (status != null) SelectedStatus = status;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnPrincipalSelected(string? value)
    {
        SelectedPrincipalId = value ?? string.Empty;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        _debounceTimer?.Dispose();
        _searchTerm = "";
        SelectedStatus = "";
        SelectedPrincipalId = "";
        SortColumn = "CreatedDate";
        SortAscending = true;
        currentPage = 1;
        filterResetKey++;
        await LoadPageAsync();
    }
    private RenderFragment PriceScheduleCell(
        PriceIncreaseTableListDto schedule) => @<div class="price-schedule-cell">
        <div>
            <strong>Increase:</strong>
            @(schedule.PriceIncreaseAmount?.ToString("N2") ?? "-")
        </div>

        <div>
            <strong>Effective:</strong>
            @(schedule.EffectivityDate?.ToString("MMM d, yyyy") ?? "-")
        </div>

        <span class="clt-status clt-status-@(schedule.Status?.ToLowerInvariant())">
            @schedule.Status
        </span>

        <div class="clt-actions">
            <Button Variant="ButtonVariant.Primary"
                    Title="Edit"
                    OnClick="@(() => OnEditPriceIncrease.InvokeAsync(
                        schedule.CompanyItemPriceHistoryId))" />

            @if (schedule.Status != "Applied")
            {
                <Button Variant="ButtonVariant.Secondary"
                        Title="Delete"
                        OnClick="@(() => RequestDelete(schedule))" />
            }
        </div>
    </div>;
    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPageAsync();
    }

    private bool showDeleteError;
    private string? deleteError;

    private void DismissDeleteError()
    {
        showDeleteError = false;
        deleteError = null;
    }

    private async Task RequestDelete(PriceIncreaseTableListDto schedule)
    {
        pendingToggleId = schedule.CompanyItemPriceHistoryId;
        var list = schedule.PriceListType is { } pl ? $" {pl}" : string.Empty;

        if (string.Equals(schedule.Status, "Applied", StringComparison.OrdinalIgnoreCase))
        {
            var lines = await AdminPriceIncreaseService.CountInvoiceLinesUsingAsync(schedule.CompanyItemPriceHistoryId);
            toggleConfirmMessage =
                $"This{list} change is already applied. Deleting it rebuilds the item's price history and sets its current price back." +
                (lines > 0
                    ? $" {lines} invoice line{(lines == 1 ? " was" : "s were")} priced with it and keep their amounts until the invoices are recalculated."
                    : string.Empty) +
                " Delete it?";
        }
        else
        {
            toggleConfirmMessage = $"Delete this pending{list} price change?";
        }

        showToggleConfirmModal = true;
    }

    private async Task ConfirmToggle()
    {
        showToggleConfirmModal = false;
        var (success, error) = await AdminPriceIncreaseService.DeletePriceChangeAsync(pendingToggleId);
        if (!success)
        {
            deleteError = error ?? "The price change could not be deleted.";
            showDeleteError = true;
        }
        await LoadPageAsync();
    }

    private void CancelToggle() => showToggleConfirmModal = false;

    private async Task SortBy(string column)
    {
        if (SortColumn == column)
            SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }

    private string SortIndicator(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortAscending ? " ▲" : " ▼";
    }

    
    private RenderFragment RenderScheduleActions(
        PriceIncreaseTableListDto schedule) => @<div class="clt-actions">
        <Button Variant="ButtonVariant.Primary"
                Title="Edit"
                OnClick="@(() => OnEditPriceIncrease.InvokeAsync(
                    schedule.CompanyItemPriceHistoryId))" />

        @if (schedule.Status != "Applied")
        {
            <Button Variant="ButtonVariant.Secondary"
                    Title="Delete"
                    OnClick="@(() => RequestDelete(schedule))" />
        }
    </div>;

}