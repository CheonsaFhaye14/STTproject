@using STTproject.Features.Admin.PriceIncrease.DTOs
@using STTproject.Shared.Components
@using STTproject.Shared.Components.Buttons
@inject STTproject.Features.Admin.PriceIncrease.Services.IAdminPriceIncreaseService AdminPriceIncreaseService
<link rel="stylesheet" href="css/Table.css" asp-append-version="true" />

<div class="clt-page">
    <div class="clt-layout">

        <aside class="clt-sidebar">
            <div class="clt-sidebar-stats">
                <div class="clt-stat">
                    <span class="clt-stat-label">Total</span>
                    <span class="clt-stat-value">@totalCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Pending</span>
                    <span class="clt-stat-value clt-stat-pending">@pendingCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Overdue</span>
                    <span class="clt-stat-value clt-stat-overdue">@overdueCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Applied</span>
                    <span class="clt-stat-value clt-stat-applied">@appliedCount</span>
                </div>
            </div>
            <div class="clt-divider"></div>

            @* Search *@
            <div class="clt-filter-group">
                <Input TValue="string" Label="Search"
                    Placeholder="Search..."
                    Value="@SearchTerm" ValueChanged="OnSearchChanged" />
            </div>

            @* Status *@
            <div class="clt-filter-group">
                <label class="clt-filter-label">Status</label>
                <div class="clt-radio-group">
                    <label class="clt-radio-option @(SelectedStatus == "" ? "selected" : "")">
                        <input type="radio" name="status" value=""
                            @onchange="() => OnFilterChanged(status: string.Empty)"
                            checked="@(SelectedStatus == "")" />
                        <span>All</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "pending" ? "selected" : "")">
                        <input type="radio" name="status" value="pending"
                            @onchange='() => OnFilterChanged(status: "pending")'
                            checked="@(SelectedStatus == "pending")" />
                        <span>Pending</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "overdue" ? "selected" : "")">
                        <input type="radio" name="status" value="overdue"
                            @onchange='() => OnFilterChanged(status: "overdue")'
                            checked="@(SelectedStatus == "overdue")" />
                        <span>Overdue</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "applied" ? "selected" : "")">
                        <input type="radio" name="status" value="applied"
                            @onchange='() => OnFilterChanged(status: "applied")'
                            checked="@(SelectedStatus == "applied")" />
                        <span>Applied</span>
                    </label>
                </div>
            </div>

            @* Principal *@
            <div class="clt-filter-group">
                <AutoComplete @key="@($"principal-{filterResetKey}")"
                        Label="Principal"
                        Placeholder="All principals"
                        TItem="FilterOption"
                        Items="PrincipalOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@SelectedPrincipalId"
                        SelectedValueChanged="OnPrincipalSelected" />
            </div>

            @if (HasActiveFilters)
            {
                <button class="clt-clear-btn" @onclick="ClearFilters">Clear all filters</button>
            }
        </aside>

        <main class="clt-main">
            <div class="clt-table-card">
                <div class="clt-table-scroll">
                    <table class="clt-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SortBy("CompanyItemCode")' style="cursor:pointer">Company Item Code @SortIndicator("CompanyItemCode")</th>
                                <th @onclick='() => SortBy("CompanyItemName")' style="cursor:pointer">Company Item Name @SortIndicator("CompanyItemName")</th>
                                <th @onclick='() => SortBy("PriceIncreaseAmount")' style="cursor:pointer">Price Change Amount @SortIndicator("PriceIncreaseAmount")</th>
                                <th @onclick='() => SortBy("EffectivityDate")' style="cursor:pointer">Effectivity Date @SortIndicator("EffectivityDate")</th>
                                <th @onclick='() => SortBy("CreatedDate")' style="cursor:pointer">Created @SortIndicator("CreatedDate")</th>
                                <th @onclick='() => SortBy("Status")' style="cursor:pointer">Status @SortIndicator("Status")</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="7" class="clt-empty"><div class="clt-empty-inner"><p>Loading…</p></div></td></tr>
                            }
                            else if (!PagedPriceIncrease.Any())
                            {
                                <tr>
                                    <td colspan="7" class="clt-empty">
                                        <div class="clt-empty-inner">
                                            <p>@(HasActiveFilters ? "No price changes match your filters" : "No price changes found")</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var priceIncrease in PagedPriceIncrease)
                                {
                                    <tr>
                                        <td><span class="clt-code">@priceIncrease.CompanyItemCode</span></td>
                                        <td class="clt-name">@priceIncrease.CompanyItemName</td>
                                        <td class="clt-muted">@(priceIncrease.PriceIncreaseAmount?.ToString("N2") ?? "-")</td>
                                        <td class="clt-muted">@(priceIncrease.EffectivityDate?.ToString("MMM d, yyyy") ?? "-")</td>
                                        <td class="clt-muted">@priceIncrease.CreatedDate.ToString("MMM d, yyyy hh:mm tt")</td>
                                        <td>
                                            <span class="clt-status clt-status-@(priceIncrease.Status?.ToLowerInvariant())">
                                                @priceIncrease.Status
                                            </span>
                                        </td>
                                        <td>
                                            <div class="clt-actions">
                                                <Button Variant="ButtonVariant.Primary" Title="View"
                                                        OnClick="@(() => OnEditPriceIncrease.InvokeAsync(priceIncrease.CompanyItemPriceHistoryId))" />
                                                @if (priceIncrease.Status != "Applied")
                                                {
                                                    <Button Variant="ButtonVariant.Secondary" Title="Cancel"
                                                            OnClick="@(() => RequestCancel(priceIncrease.CompanyItemPriceHistoryId))" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="clt-footer">
                <span class="clt-footer-count">Showing @PagedPriceIncrease.Count of @totalCount price changes</span>
                @if (totalPages > 1)
                {
                    <div class="clt-pagination">
                        <button class="clt-page-btn" disabled="@(currentPage == 1)"
                                @onclick="() => GoToPage(currentPage - 1)">←</button>
                        <span>Page @currentPage of @totalPages</span>
                        <button class="clt-page-btn" disabled="@(currentPage >= totalPages)"
                                @onclick="() => GoToPage(currentPage + 1)">→</button>
                    </div>
                }
            </div>
        </main>
    </div>

    <ConfirmModal Show="showToggleConfirmModal" Title="Confirm Cancellation of price change"
                  Message="@toggleConfirmMessage" OnYes="ConfirmToggle" OnNo="CancelToggle" />
</div>

@code {
    [Parameter] public EventCallback OnLoaded { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public EventCallback<int> OnEditPriceIncrease { get; set; }

    private record FilterOption(string Value, string Text);

    private List<PriceIncreaseTableListDto> PagedPriceIncrease { get; set; } = new();
    private List<string> Principals { get; set; } = new();

    private List<FilterOption> PrincipalOptions =>
        Principals.Select(p => new FilterOption(p, p)).ToList();

    private string SelectedStatus { get; set; } = "";
    private string SelectedPrincipalId { get; set; } = "";
    private int filterResetKey;

    private string SortColumn { get; set; } = "CreatedDate";
    private bool SortAscending { get; set; } = true;

    private int currentPage = 1;
    private const int pageSize = 50;
    private int totalCount;
    private int pendingCount;
    private int overdueCount;
    private int appliedCount;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private bool isLoading = true;
    private System.Threading.Timer? _debounceTimer;

    private bool showToggleConfirmModal;
    private int pendingToggleId;
    private string toggleConfirmMessage = "";

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    currentPage = 1;
                    await LoadPageAsync();
                });
            }, null, 400, Timeout.Infinite);
        }
    }
    private void OnSearchChanged(string? value) => SearchTerm = value ?? string.Empty;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrEmpty(SelectedStatus) ||
        !string.IsNullOrEmpty(SelectedPrincipalId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Principals = (await AdminPriceIncreaseService.GetAllPrincipalsAsync())
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p!)
                .ToList();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading price changes: {ex.Message}");
            isLoading = false;
        }
    }

    public async Task LoadPageAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (items, total) = await AdminPriceIncreaseService.GetPagedAsync(
                currentPage, pageSize, _searchTerm, SelectedStatus,
                SelectedPrincipalId,
                SortColumn, SortAscending);

            PagedPriceIncrease = items.ToList();
            totalCount = total;

            var (_, pendingTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "pending", SelectedPrincipalId);
            var (_, overdueTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "overdue", SelectedPrincipalId);
            var (_, appliedTotal) = await AdminPriceIncreaseService.GetPagedAsync(
                1, 1, _searchTerm, "applied", SelectedPrincipalId);
            pendingCount = pendingTotal;
            overdueCount = overdueTotal;
            appliedCount = appliedTotal;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading price changes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            if (OnCountChanged.HasDelegate) await OnCountChanged.InvokeAsync(totalCount);
            if (OnLoaded.HasDelegate) await OnLoaded.InvokeAsync();
        }
    }

    private async Task OnFilterChanged(string? status = null)
    {
        if (status != null) SelectedStatus = status;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnPrincipalSelected(string? value)
    {
        SelectedPrincipalId = value ?? string.Empty;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        _debounceTimer?.Dispose();
        _searchTerm = "";
        SelectedStatus = "";
        SelectedPrincipalId = "";
        SortColumn = "CreatedDate";
        SortAscending = true;
        currentPage = 1;
        filterResetKey++;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPageAsync();
    }

    private void RequestCancel(int companyItemPriceHistoryId)
    {
        pendingToggleId = companyItemPriceHistoryId;
        toggleConfirmMessage = "Are you sure you want to cancel this price change?";
        showToggleConfirmModal = true;
    }

    private async Task ConfirmToggle()
    {
        showToggleConfirmModal = false;
        await AdminPriceIncreaseService.CancelPendingIncreaseAsync(companyItemPriceHistoryId: pendingToggleId);
        await LoadPageAsync();
    }

    private void CancelToggle() => showToggleConfirmModal = false;

    private async Task SortBy(string column)
    {
        if (SortColumn == column)
            SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }

    private string SortIndicator(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortAscending ? " ▲" : " ▼";
    }
}