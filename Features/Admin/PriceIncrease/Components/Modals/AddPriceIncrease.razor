@using STTproject.Features.Admin.PriceIncrease.DTOs
@using STTproject.Features.Admin.PriceIncrease.Validators
@using STTproject.Shared.Components.Buttons
@using STTproject.Shared.Components.Forms
@using STTproject.Shared.Components.Modals
@using STTproject.Shared.Components.Tables

@inject STTproject.Features.Admin.PriceIncrease.Services.IAdminPriceIncreaseService AdminPriceIncreaseService
@inject STTproject.Services.IUserContextService UserContextService

<Modal ShowModal="true" Width="900px" MaxWidth="100%" MaxHeight="88vh"
       Title="@(isEdit ? (isReadOnly ? "View Price Change" : "Edit Price Change") : "Schedule Price Change")"
       IconType="@(isEdit ? (isReadOnly ? ModalIconType.UserView : ModalIconType.UserEdit) : ModalIconType.UserPlus)"
       OnClose="Cancel">
    <ChildContent>
        <FormSection Icon="ti ti-circle-plus" Title="Price Change Details" IsExpanded="true" Expandable="true">
            <ChildContent>
                @if (!isEdit)
                {
                    <div class="form-group">
                        <AutoComplete Label="Principal" Placeholder="Select a principal" Items="Principals"
                                    SelectedValue="Principal" SelectedValueChanged="OnPrincipalChanged" />
                    </div>

                    <div class="form-group">
                        <AutoComplete Label="Company Item" Required="true" Placeholder="Search company item..."
                                    TItem="CompanyItemDropdownItem"
                                    Items="FilteredCompanyItems"
                                    ValueSelector="@(x => x.CompanyItemId.ToString())"
                                    TextSelector="@(x => $"{x.CompanyItemCode} - {x.CompanyItemName}")"
                                    SelectedValue="@(SelectedCompanyItemId?.ToString())"
                                    SelectedItemChanged="OnCompanyItemSelected"
                                    ShowError="@ShowValidationErrors"
                                    ErrorText="@GetFieldError(PriceIncreaseValidations.AddPriceIncrease.CompanyItem.Key)" />
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <Input Label="Company Item" Value="@($"{ViewCompanyItemCode} - {ViewCompanyItemName}")" Disabled="true" />
                    </div>
                }

                @if (SelectedStockPrice.HasValue)
                {
                    <div class="form-group">
                        <Input Label="Stock Price" Value="@SelectedStockPrice.Value.ToString("N2")" Disabled="true" />
                    </div>
                }

                <div class="form-group">
                    <Input Label="@PriceIncreaseValidations.Label(PriceIncreaseValidations.AddPriceIncrease.PriceIncreaseAmount)"
                           @bind-Value="PriceIncreaseAmount" Step="0.01" Disabled="@isReadOnly"
                           ShowError="@ShowValidationErrors"
                           ErrorText="@GetFieldError(PriceIncreaseValidations.AddPriceIncrease.PriceIncreaseAmount.Key)" />
                </div>

                <div class="form-group">
                    <DateInput Label="@PriceIncreaseValidations.Label(PriceIncreaseValidations.AddPriceIncrease.EffectivityDate)"
                               @bind-Value="EffectivityDate" Disabled="@isReadOnly"
                               ShowError="@ShowValidationErrors"
                               ErrorText="@GetFieldError(PriceIncreaseValidations.AddPriceIncrease.EffectivityDate.Key)" />
                </div>

                @if (isEdit)
                {
                    <div class="form-group">
                        <Input Label="Status" Value="@ViewStatus" Disabled="true" />
                    </div>
                }

                @if (ShowValidationErrors && GetFieldError("general") is { Length: > 0 } generalError)
                {
                    <span class="error-text">@generalError</span>
                }
            </ChildContent>
        </FormSection>

        @if (PreviewUomPrices.Any())
        {
            <FormSection Icon="ti ti-list-check" Title="Sub-Item / UOM Prices" IsExpanded="true" Expandable="true">
                <ChildContent>
                    @if (!isEdit && PreviewUomPrices.Any(RequiresManualPrice))
                    {
                        <p class="hint-text">
                            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                            Some UOMs have no conversion or current price set, so their new price
                            can't be calculated automatically. Enter one manually, or mark them to skip.
                        </p>
                    }
                    <AddTable TItem="CompanyItemUomPriceDto"
                            Items="PreviewUomPrices"
                            Columns="@(new List<string> { "SubdItem", "UomName", "OldPrice", "NewPrice" })"
                            ColumnLabels="@(new Dictionary<string, string> {
                                ["SubdItem"] = "Sub-Item",
                                ["UomName"] = "UOM",
                                ["OldPrice"] = "Old Price",
                                ["NewPrice"] = "New Price"
                            })"
                            EditableColumns="@(new List<string> { "NewPrice" })"
                            ColumnInputTypes="@(new Dictionary<string, string> { ["NewPrice"] = "number" })"
                            IsCellEditableOverride="IsUomPriceCellEditable"
                            DisplayValueSelector="FormatUomPriceColumn"
                            EditableValueSelector="GetEditableUomValue"
                            PlaceholderSelector="GetUomPlaceholder"
                            OnCellChanged="HandleUomPriceCellChangedAsync"
                            GroupColumn="SubdItem"
                            ViewMode="@isEdit"
                            Disabled="@isEdit"
                            RemoveButtonVisible="false"
                            AddButtonVisible="false">
                        <RowActionsTemplate Context="row">
                            @if (!isEdit && RequiresManualPrice(row))
                            {
                                <label class="skip-price-toggle">
                                    <input type="checkbox"
                                        checked="@SkippedUomIds.Contains(row.ItemsUomId)"
                                        @onchange="(e) => ToggleSkipPrice(row.ItemsUomId, e.Value)" />
                                    Don't change price
                                </label>
                            }
                        </RowActionsTemplate>
                    </AddTable>
                </ChildContent>
            </FormSection>
        }
        else if (SelectedCompanyItem != null || isEdit)
        {
            <FormSection Icon="ti ti-list-check" Title="Sub-Item / UOM Prices" IsExpanded="true" Expandable="true">
                <ChildContent>
                    <p><em>No active UOMs found for this item.</em></p>
                </ChildContent>
            </FormSection>
        }
    </ChildContent>
    <FooterContent>
        @if (isReadOnly)
        {
            <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="Cancel"></Button>
        }
        else
        {
            <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting"></Button>
            <Button Title="@(isSubmitting ? (isEdit ? "Saving..." : "Scheduling...") : (isEdit ? "Save Changes" : "Schedule Increase"))"
                    Variant="ButtonVariant.Primary" OnClick="RequestConfirm" Disabled="@isSubmitting"></Button>
        }
    </FooterContent>
</Modal>

@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    [Parameter] public int? PriceIncreaseId { get; set; }

    private bool isEdit => PriceIncreaseId.HasValue;
    private bool isReadOnly;
    private int? CurrentUserId => UserContextService.UserId;

    private IReadOnlyList<CompanyItemUomPriceDto> UomPrices { get; set; } = new List<CompanyItemUomPriceDto>();

    private CompanyItemDropdownItem? SelectedCompanyItem { get; set; }
    private int? SelectedCompanyItemId { get; set; }
    private IReadOnlyList<CompanyItemDropdownItem> CompanyItems { get; set; } = new List<CompanyItemDropdownItem>();
    private IEnumerable<CompanyItemDropdownItem> FilteredCompanyItems =>
        string.IsNullOrWhiteSpace(Principal)
            ? CompanyItems
            : CompanyItems.Where(c => c.Principal == Principal);

    private string? Principal { get; set; }
    private IReadOnlyList<string?> Principals { get; set; } = new List<string>();
    private decimal? SelectedStockPrice { get; set; }
    private decimal? PriceIncreaseAmount { get; set; }
    private DateTime? EffectivityDate { get; set; }

    // View/edit-mode display fields
    private string? ViewCompanyItemCode { get; set; }
    private string? ViewCompanyItemName { get; set; }
    private string? ViewStatus { get; set; }
    private DateTime CreatedDate { get; set; }
    private string? CreatedByName { get; set; }

    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; }
    private bool isSubmitting;

    private AddPriceIncreaseDto? PendingScheduleDto;
    private (decimal Amount, DateTime EffectivityDate)? PendingEditData;

    private string GetFieldError(string key) =>
        Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    private async Task OnCompanyItemSelected(CompanyItemDropdownItem? item)
    {
        SelectedCompanyItem = item;

        if (item == null)
        {
            SelectedCompanyItemId = null;
            SelectedStockPrice = null;
            UomPrices = new List<CompanyItemUomPriceDto>();
            return;
        }

        SelectedCompanyItemId = item.CompanyItemId;
        SelectedStockPrice = item.StockPrice;
        Principal = item.Principal;
        UomPrices = await AdminPriceIncreaseService.GetUomPricesByCompanyItemIdAsync(item.CompanyItemId);
    }

    private void OnPrincipalChanged(string? value)
    {
        Principal = value;

        if (SelectedCompanyItem != null)
        {
            var stillValid = CompanyItems.Any(c =>
                c.CompanyItemId == SelectedCompanyItem.CompanyItemId &&
                (string.IsNullOrWhiteSpace(Principal) || c.Principal == Principal));

            if (!stillValid)
            {
                SelectedCompanyItem = null;
                SelectedCompanyItemId = null;
                SelectedStockPrice = null;
                UomPrices = new List<CompanyItemUomPriceDto>();
            }
        }
    }
        
    private static bool RequiresManualPrice(CompanyItemUomPriceDto item) =>
        !item.ConversionToBase.HasValue || item.ConversionToBase.Value <= 0 || !item.OldPrice.HasValue;

    private HashSet<int> SkippedUomIds { get; set; } = new();
    private Dictionary<int, string> ManualPriceInputs { get; set; } = new();

    private List<CompanyItemUomPriceDto> PreviewUomPrices
    {
        get
        {
            IEnumerable<CompanyItemUomPriceDto> items = isEdit
                ? UomPrices
                : UomPrices.Select(u =>
                {
                    decimal? newPrice;

                    if (RequiresManualPrice(u))
                    {
                        if (SkippedUomIds.Contains(u.ItemsUomId))
                        {
                            newPrice = null;
                        }
                        else if (ManualPriceInputs.TryGetValue(u.ItemsUomId, out var typed)
                            && decimal.TryParse(typed, out var manualValue))
                        {
                            newPrice = manualValue;
                        }
                        else
                        {
                            newPrice = null;
                        }
                    }
                    else
                    {
                        newPrice = PriceIncreaseAmount.HasValue
                            ? (u.OldPrice ?? 0) + PriceIncreaseAmount.Value * u.ConversionToBase!.Value
                            : null;
                    }

                    return new CompanyItemUomPriceDto
                    {
                        SubdItemId = u.SubdItemId,
                        SubdItemCode = u.SubdItemCode,
                        SubdItemName = u.SubdItemName,
                        ItemsUomId = u.ItemsUomId,
                        UomName = u.UomName,
                        ConversionToBase = u.ConversionToBase,
                        OldPrice = u.OldPrice,
                        NewPrice = newPrice
                    };
                });

            return items
                .OrderBy(x => x.SubdItemCode)
                .ThenBy(x => x.SubdItemId)
                .ThenBy(x => x.ConversionToBase ?? int.MinValue)
                .ThenBy(x => x.UomName)
                .ToList();
        }
    }

    private bool IsUomPriceCellEditable(CompanyItemUomPriceDto row, string column)
    {
        if (isEdit || column != "NewPrice") return false;
        if (!RequiresManualPrice(row)) return false;       
        return !SkippedUomIds.Contains(row.ItemsUomId);    
    }

    private Task HandleUomPriceCellChangedAsync((CompanyItemUomPriceDto Row, string Column) args)
    {
        if (args.Column == "NewPrice")
        {
            ManualPriceInputs[args.Row.ItemsUomId] = args.Row.NewPrice?.ToString() ?? string.Empty;
            SkippedUomIds.Remove(args.Row.ItemsUomId); 
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private void ToggleSkipPrice(int itemsUomId, object? checkedValue)
    {
        if (checkedValue is not bool isChecked) return;

        if (isChecked)
        {
            SkippedUomIds.Add(itemsUomId);
            ManualPriceInputs.Remove(itemsUomId);
        }
        else
        {
            SkippedUomIds.Remove(itemsUomId);
        }
    }

    private string? FormatUomPriceColumn(CompanyItemUomPriceDto item, string column) => column switch
    {
        "SubdItem" => $"{item.SubdItemCode} - {item.SubdItemName}",
        "OldPrice" => item.OldPrice?.ToString("N2") ?? "-",
        "NewPrice" => SkippedUomIds.Contains(item.ItemsUomId)
            ? "No change"
            : item.NewPrice?.ToString("N2")
                ?? (RequiresManualPrice(item) ? "Enter manually" : "-"),
        _ => null
    };
    protected override async Task OnInitializedAsync()
    {
        Principals = await AdminPriceIncreaseService.GetAllPrincipalsAsync();
        if (isEdit)
        {
            var history = await AdminPriceIncreaseService.GetPriceIncreaseByIdAsync(PriceIncreaseId!.Value);
            if (history != null)
            {
                ViewCompanyItemCode = history.CompanyItemCode;
                ViewCompanyItemName = history.CompanyItemName;
                SelectedCompanyItemId = history.CompanyItemId;
                SelectedStockPrice = history.StockPrice;
                PriceIncreaseAmount = history.PriceIncreaseAmount;
                EffectivityDate = history.EffectivityDate;
                ViewStatus = history.Status;
                CreatedDate = history.CreatedDate;
                CreatedByName = await AdminPriceIncreaseService.GetUserNameByIdAsync(history.CreatedBy);

                var details = await AdminPriceIncreaseService.GetCascadedUomDetailsAsync(PriceIncreaseId!.Value);
                UomPrices = details.Select(d => new CompanyItemUomPriceDto
                {
                    SubdItemId = d.SubdItemId,
                    SubdItemCode = d.SubdItemCode,
                    SubdItemName = d.SubdItemName,
                    UomName = d.UomName,
                    ConversionToBase = d.ConversionToBase,
                    OldPrice = d.OldPrice,
                    NewPrice = d.NewPrice
                }).ToList();

                if (string.Equals(history.Status, "Applied", StringComparison.OrdinalIgnoreCase))
                {
                    isReadOnly = true;
                }
            }
        }
        else
        {
            CompanyItems = await AdminPriceIncreaseService.GetCompanyItemsForDropdownAsync();
        }
    }

    private async Task RequestConfirm()
    {
        if (isEdit)
        {
            var dtoToValidate = new AddPriceIncreaseDto
            {
                PriceIncreaseAmount = PriceIncreaseAmount,
                EffectivityDate = EffectivityDate
            };

            Errors = await PriceIncreaseValidations.ValidateEditPriceIncreaseAsync(dtoToValidate);
            ShowValidationErrors = true;
            if (Errors.Any()) return;

            PendingEditData = (PriceIncreaseAmount!.Value, EffectivityDate!.Value);
        }
        else
        {
            var dto = new AddPriceIncreaseDto
            {
                CompanyItemId = SelectedCompanyItemId,
                PriceIncreaseAmount = PriceIncreaseAmount,
                EffectivityDate = EffectivityDate,
                CreatedBy = CurrentUserId,
                SkippedUomIds = SkippedUomIds.ToList(),
                ManualUomPrices = UomPrices
                    .Where(u => RequiresManualPrice(u) && !SkippedUomIds.Contains(u.ItemsUomId))
                    .Where(u => ManualPriceInputs.TryGetValue(u.ItemsUomId, out var typed) && decimal.TryParse(typed, out _))
                    .ToDictionary(u => u.ItemsUomId, u => decimal.Parse(ManualPriceInputs[u.ItemsUomId]))
            };

            Errors = await PriceIncreaseValidations.ValidateAddPriceIncreaseAsync(dto, AdminPriceIncreaseService);
            ShowValidationErrors = true;
            if (Errors.Any()) return;

            var unresolved = UomPrices.Where(RequiresManualPrice)
                .Where(u => !SkippedUomIds.Contains(u.ItemsUomId))
                .Where(u => !ManualPriceInputs.TryGetValue(u.ItemsUomId, out var typed) || !decimal.TryParse(typed, out _))
                .ToList();

            if (unresolved.Any())
            {
                Errors["general"] = "Enter a new price or mark 'Don't change price' for every UOM missing a conversion/current price.";
                return;
            }

            PendingScheduleDto = dto;
        }

        if (OnRequestConfirm.HasDelegate)
            await OnRequestConfirm.InvokeAsync();
    }

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingEditData == null) return (false, "No pending changes.");
                return await AdminPriceIncreaseService.UpdatePendingIncreaseAsync(
                    PriceIncreaseId!.Value,
                    PendingEditData.Value.Amount,
                    PendingEditData.Value.EffectivityDate,
                    CurrentUserId);
            }
            else
            {
                if (PendingScheduleDto == null) return (false, "No pending data.");
                return await AdminPriceIncreaseService.ScheduleIncreaseAsync(PendingScheduleDto);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        if (onCancel.HasDelegate) return onCancel.InvokeAsync();
        return Task.CompletedTask;
    }
    private string? GetEditableUomValue(CompanyItemUomPriceDto item, string column) => column switch
    {
        "NewPrice" => item.NewPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture),
        _ => null
    };

    private string? GetUomPlaceholder(CompanyItemUomPriceDto item, string column) => column switch
    {
        "NewPrice" when RequiresManualPrice(item) && !SkippedUomIds.Contains(item.ItemsUomId) => "Enter manually",
        _ => null
    };
}

<style>
    .skip-price-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #6B655A;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
}

.skip-price-toggle input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border: 1.5px solid #DDD6C4;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    position: relative;
    transition: background-color 0.15s, border-color 0.15s;
}

    .skip-price-toggle input[type="checkbox"]:checked {
        background: #C9A227;
        border-color: #C9A227;
    }

    .skip-price-toggle input[type="checkbox"]:checked::after {
        content: "";
        position: absolute;
        left: 4px;
        top: 1px;
        width: 4px;
        height: 8px;
        border: solid #fff;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .skip-price-toggle input[type="checkbox"]:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.2);
    }

    .skip-price-toggle input[type="checkbox"]:hover:not(:checked) {
        border-color: #C9A227;
    }
</style>