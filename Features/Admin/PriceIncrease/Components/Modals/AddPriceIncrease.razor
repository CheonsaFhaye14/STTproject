@using STTproject.Features.Admin.PriceIncrease.DTOs
@using STTproject.Features.Admin.PriceIncrease.Validators
@using STTproject.Features.Admin.Subdistributor.DTOs
@using STTproject.Shared.Components.Buttons
@using STTproject.Shared.Components.Forms
@using STTproject.Shared.Components.Modals

@inject STTproject.Features.Admin.PriceIncrease.Services.IAdminPriceIncreaseService AdminPriceIncreaseService
@inject STTproject.Services.IUserContextService UserContextService

<Modal ShowModal="true" Width="1000px" MaxWidth="100%" MaxHeight="92vh" FlushBody="true"
       Title="@(isEdit ? "Edit price change" : "Schedule price change")" Subtitle="@ModalSubtitle"
       IconType="@(isEdit ? ModalIconType.UserEdit : ModalIconType.UserPlus)" OnClose="Cancel">
    <ChildContent>
        <div class="pc">
            <div class="pc-main">

                @* ───── 1 · Company item (add only) ───── *@
                @if (!isEdit)
                {
                    <section class="pc-step">
                        <h5>1 · Company item</h5>
                        @if (SelectedCompanyItem is null)
                        {
                            <div class="pc-grid2">
                                <div class="form-group">
                                    <AutoComplete Label="Principal" Placeholder="All principals" Items="Principals"
                                                  SelectedValue="@Principal" SelectedValueChanged="OnPrincipalChanged" />
                                </div>
                                <div class="form-group">
                                    <AutoComplete Label="Company item" Required="true" Placeholder="Search code or name…"
                                                  TItem="CompanyItemDropdownItem" Items="FilteredCompanyItems"
                                                  ValueSelector="@(x => x.CompanyItemId.ToString())"
                                                  TextSelector="@(x => $"{x.CompanyItemCode} - {x.CompanyItemName}")"
                                                  SelectedValue="@(SelectedCompanyItemId?.ToString())"
                                                  SelectedItemChanged="OnCompanyItemSelected" ShowError="@ShowValidationErrors"
                                                  ErrorText="@GetFieldError(PriceIncreaseValidations.AddPriceIncrease.CompanyItem.Key)" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pc-item">
                                <div>
                                    <span class="pc-code">@SelectedCompanyItem.CompanyItemCode ·
                                        @SelectedCompanyItem.Principal</span>
                                        <b>@SelectedCompanyItem.CompanyItemName</b>
                                        <span class="pc-muted">Stock UOM: @(SelectedCompanyItem.StockUomName ?? "-")</span>
                                    </div>
                                    <Button Title="Change" Variant="ButtonVariant.Secondary" OnClick="ClearItem" />
                                </div>
                            }
                        </section>
                    }

                    @if (IsBlocked)
                    {
                        <div class="pc-note warn">
                            <i class="ti ti-alert-octagon" aria-hidden="true"></i>
                            <span>@PricingStructureResolver.Describe(Structure!.Value)</span>
                        </div>
                    }
                    else if (isEdit || SelectedCompanyItem is not null)
                    {
                        @* ───── 2 · Price list (add, dual-priced items) ───── *@
                        @if (IsDual)
                        {
                            <section class="pc-step">
                                <h5>2 · Price list</h5>
                                <div class="pc-tabs">
                                    <button type="button" class="@(ListChoice == ChoiceBoth ? "on" : null)"
                                            @onclick="() => ListChoice = ChoiceBoth">
                                        <b>Both lists</b><small>Same change and date</small>
                                    </button>
                                    <button type="button" class="@(ListChoice == PriceListTypes.Regional ? "on" : null)"
                                            @onclick="() => ListChoice = PriceListTypes.Regional">
                                        <b>Regional</b><small>@Fmt(SelectedCompanyItem?.StockPriceRegional) now</small>
                                    </button>
                                    <button type="button" class="@(ListChoice == PriceListTypes.National ? "on" : null)"
                                            @onclick="() => ListChoice = PriceListTypes.National">
                                        <b>National</b><small>@Fmt(SelectedCompanyItem?.StockPriceNational) now</small>
                                    </button>
                                </div>

                                @if (ExcludedSubDistributors.Any())
                                {
                                    <div class="pc-note warn">
                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                        <span>
                                            <b>Not affected (no price list assigned):</b> @string.Join(", ", ExcludedSubDistributors)
                                        </span>
                                    </div>
                                }
                            </section>
                        }

                        @* ───── Change and date ───── *@
                        <section class="pc-step">
                            <h5>@(isEdit ? "Change and date" : IsDual ? "3 · Change and date" : "2 · Change and date")</h5>
                            <div class="pc-grid2">
                                <div>
                                    <label class="pc-label">Change <span class="pc-req">*</span></label>
                                    <div class="pc-amt">
                                        <div class="pc-mode">
                                            <button type="button" class="@(ChangeMode == ModeAmount ? "on" : null)"
                                                    @onclick="() => SetMode(ModeAmount)" title="Amount (₱)">₱ ±</button>
                                            <button type="button" class="@(ChangeMode == ModePercent ? "on" : null)"
                                                    @onclick="() => SetMode(ModePercent)" title="Percent">%</button>
                                            <button type="button" class="@(ChangeMode == ModeNewPrice ? "on" : null)"
                                                    @onclick="() => SetMode(ModeNewPrice)" title="Type the new price">New</button>
                                        </div>
                                        <div class="pc-amt-input">
                                            <Input TValue="decimal?" Value="@ChangeValue"
                                                   ValueChanged="@((decimal? v) => ChangeValue = v)" Step="0.01"
                                                   Placeholder="@(ChangeMode == ModePercent ? "e.g. 5" : ChangeMode == ModeNewPrice ? "New price" : "e.g. 50.00")" />
                                        </div>
                                    </div>
                                    <div class="pc-quick">
                                        @foreach (var q in new[] { 2m, 5m, 10m, -5m })
                                        {
                                            var pct = q;
                                            <button type="button" @onclick="() => QuickPercent(pct)">@(pct > 0 ? "+" :
                                                                             "−")@Math.Abs(pct)%</button>
                                            }
                                        </div>
                                        @if (ShowValidationErrors && GetAmountError() is { Length: > 0 } amtErr)
                                        {
                                            <span class="error-text">@amtErr</span>
                                        }
                                    </div>
                                    <div>
                                        @* Same label + 40px box structure as the Change field, so both line up. *@
                                        <label class="pc-label">Effectivity date <span class="pc-req">*</span></label>
                                        <div class="pc-date">
                                            <DateInput @bind-Value="EffectivityDate" ShowError="@ShowValidationErrors"
                                                       ErrorText="@GetDateError()" />
                                        </div>
                                        <div class="pc-quick">
                                            <button type="button"
                                                    @onclick="() => EffectivityDate = DateTime.Today.AddDays(1)">Tomorrow</button>
                                            <button type="button"
                                                    @onclick="() => EffectivityDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1)">1st
                                                of next month</button>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                @if (isEdit && IsAppliedView)
                                {
                                    <div class="pc-note warn">
                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                        <span>
                                            <b>This change is already applied.</b> Saving rebuilds the @(ViewPriceListType ?? "stock") price
                                            history from this change on and
                                            updates the item's current price. Moving the date into the future makes it pending again.
                                            @if (InvoiceLinesUsing > 0)
                                            {
                                                <b> @InvoiceLinesUsing invoice line@(InvoiceLinesUsing == 1 ? " was" : "s were") priced with
                                                    it</b>
                                                    <text>; they keep their amounts until you recalculate those invoices.</text>
                                                }
                                            </span>
                                        </div>
                                    }

                                    @* ───── Effect on sub-items (read-only) ───── *@
                                    var impact = ImpactRows;
                                    <details class="pc-impact">
                                        <summary>
                                            <i class="ti ti-list-details" aria-hidden="true"></i>
                                            Effect on sub-items
                                            <small>· @impact.Select(r => r.SubdItemId).Distinct().Count() sub-items · @impact.Count
                                                UOMs</small>
                                                <i class="ti ti-chevron-right pc-caret" aria-hidden="true"></i>
                                            </summary>
                                            @if (impact.Count == 0)
                                            {
                                                <p class="pc-muted pc-pad">No active sub-item UOMs for this selection.</p>
                                            }
                                            else
                                            {
                                                <div class="pc-imp-scroll">
                                                    <table class="pc-imp">
                                                        <thead>
                                                            <tr>
                                                                <th>Sub-item</th>
                                                                <th>UOM</th>
                                                                <th class="r">Now</th>
                                                                <th class="r">New</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var r in impact)
                                                            {
                                                                <tr class="@(r.ConversionToBase is > 0 ? null : "muted")">
                                                                    <td>
                                                                        @r.SubdItemCode - @r.SubdItemName
                                                                        @if (r.PriceListType is { } pl && IsDual)
                                                                        {
                                                                            <span class="pc-pl @(pl == PriceListTypes.Regional ? "r" : "n")">@pl[0]</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @r.UomName
                                                                        <small class="pc-muted">@(r.ConversionToBase is decimal c && c > 0 ? (c == 1m ?
                                                                                           "stock" : "× " + c.ToString("0.####")) : "no conversion")</small>
                                                                        </td>
                                                                        <td class="r">@Fmt(r.OldPrice)</td>
                                                                        <td class="r"><b>@Fmt(r.NewPrice)</b></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </details>
                                        }

                                        @if (ShowValidationErrors && GetFieldError("general") is { Length: > 0 } generalError)
                                        {
                                            <span class="error-text">@generalError</span>
                                        }
                                    </div>

                                    @* ───── Right: result + history ───── *@
                                    <aside class="pc-side">
                                        <p class="pc-side-h">Result</p>
                                        @if (!isEdit && SelectedCompanyItem is null)
                                        {
                                            <div class="pc-empty">Pick a company item to see the new price.</div>
                                        }
                                        else if (!IsBlocked)
                                        {
                                            <div class="pc-result">
                                                @foreach (var list in Lists)
                                                {
                                                    var basePrice = BaseFor(list);
                                                    var amount = AmountFor(list);
                                                    var newPrice = basePrice + amount;
                                                    <div class="pc-result-row">
                                                        <span
                                                            class="pc-pl @(list == PriceListTypes.Regional ? "r" : list == PriceListTypes.National ? "n" : "s")">@(list
                                                            ?? "Stock")</span>
                                                            <div>
                                                                <span class="pc-from">@Fmt(basePrice)</span>
                                                                <div class="pc-to">@(amount.HasValue ? Fmt(newPrice) : "—")</div>
                                                                <div class="pc-when">@(EffectivityDate.HasValue ? "from " +
                                                                                                    EffectivityDate.Value.ToString("MMM d, yyyy") : "pick a date")</div>
                                                                </div>
                                                                @if (amount is decimal a && basePrice is decimal b && b != 0)
                                                                {
                                                                    <span class="pc-badge @(a >= 0 ? "up" : "down")">@FmtSigned(a) · @((a / b *
                                                                                                    100m).ToString("0.0"))%</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>

                                                        <p class="pc-side-h">Price history@(Lists.Count > 1 ? " · " + Lists[0] : string.Empty)</p>
                                                        var timeline = Timeline;
                                                        @if (timeline.Count == 0)
                                                        {
                                                            <div class="pc-empty">No earlier price changes.</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="pc-hist">
                                                                @foreach (var t in timeline)
                                                                {
                                                                    <div class="pc-h @t.Css">
                                                                        <span class="pc-dot"></span>
                                                                        <b>@t.Price</b>
                                                                        <small>@t.Date · @t.Label</small>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    <div class="pc-note info">
                                                        <i class="ti ti-info-circle" aria-hidden="true"></i>
                                                        <span>UOM prices follow the company price (stock price × conversion). Only the company price is
                                                            saved.</span>
                                                        </div>
                                                    </aside>
                                                </div>
                                            </ChildContent>
                                            <FooterContent>
                                                @if (isEdit)
                                                {
                                                    <span class="pc-danger"><Button Title="Delete change" Variant="ButtonVariant.Secondary"
                                                                                        OnClick="() => showDeleteConfirm = true" Disabled="@isSubmitting" /></span>
                                                    }
                                                    <span class="pc-spacer"></span>
                                                    <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting" />
                                                    <Button
                                                    Title="@(isSubmitting ? (isEdit ? "Saving..." : "Scheduling...") : (isEdit ? "Save changes" : "Schedule change"))"
                                                    Variant="ButtonVariant.Primary" OnClick="RequestConfirm"
                                                    Disabled="@(isSubmitting || IsBlocked || (!isEdit && SelectedCompanyItem is null))" />
                                                </FooterContent>
                                            </Modal>

<ConfirmModal Show="showDeleteConfirm" Title="Delete price change" IconClass="fas fa-trash" Message="@DeleteMessage"
              OnYes="DeleteAsync" OnNo="() => showDeleteConfirm = false" />
<ConfirmModal Show="deleteError is not null" Title="Price change not deleted" ShowError="true"
              ErrorMessage="@deleteError" OnErrorConfirm="() => deleteError = null" />

@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public int? PriceIncreaseId { get; set; }

    private const string ChoiceBoth = "both";
    private const string ModeAmount = "amt";
    private const string ModePercent = "pct";
    private const string ModeNewPrice = "new";

    private bool isEdit => PriceIncreaseId.HasValue;
    private int? CurrentUserId => UserContextService.UserId;

    // ---------------- Add mode ----------------
    private IReadOnlyList<CompanyItemDropdownItem> CompanyItems { get; set; } = new List<CompanyItemDropdownItem>();
    private IReadOnlyList<string?> Principals { get; set; } = new List<string>();
    private string? Principal { get; set; }
    private CompanyItemDropdownItem? SelectedCompanyItem { get; set; }
    private int? SelectedCompanyItemId { get; set; }
    private IReadOnlyList<string> ExcludedSubDistributors { get; set; } = new List<string>();
    private string ListChoice { get; set; } = ChoiceBoth;

    private IEnumerable<CompanyItemDropdownItem> FilteredCompanyItems =>
        string.IsNullOrWhiteSpace(Principal) ? CompanyItems : CompanyItems.Where(c => c.Principal == Principal);

    private PricingStructure? Structure => SelectedCompanyItem?.Structure;
    private bool IsDual => !isEdit && Structure == PricingStructure.Dual;
    private bool IsBlocked => !isEdit && SelectedCompanyItem != null && Structure is PricingStructure.Invalid or
PricingStructure.Incomplete;

    // ---------------- Shared ----------------
    private string ChangeMode { get; set; } = ModeAmount;
    private decimal? ChangeValue { get; set; }
    private DateTime? EffectivityDate { get; set; }
    private IReadOnlyList<CompanyItemUomPriceDto> UomPrices { get; set; } = new List<CompanyItemUomPriceDto>();
    private IReadOnlyList<PriceIncreaseTableListDto> ItemHistory { get; set; } = new List<PriceIncreaseTableListDto>();

    // ---------------- Edit mode ----------------
    private PriceIncreaseTableListDto? EditRow { get; set; }
    private string? ViewPriceListType => EditRow?.PriceListType;
    private decimal? ViewOldPrice => EditRow?.OldPrice;
    private bool IsAppliedView => string.Equals(EditRow?.Status, "Applied", StringComparison.OrdinalIgnoreCase);
    private int InvoiceLinesUsing { get; set; }

    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; }
    private bool isSubmitting;
    private bool showDeleteConfirm;
    private string? deleteError;

    private AddPriceIncreaseDto? PendingScheduleDto;
    private (decimal Amount, DateTime EffectivityDate)? PendingEditData;

    private string? ModalSubtitle => isEdit
        ? EditRow is null ? null
            : $"{EditRow.CompanyItemCode} - {EditRow.CompanyItemName} · {EditRow.PriceListType ?? "Stock price"} · {EditRow.Status}"
        : "Choose an item, the price list, the change and the date.";

    // ---------------- Lists, prices, amounts ----------------

    /// <summary>The price lists this change applies to (null = single stock price).</summary>
    private List<string?> Lists
    {
        get
        {
            if (isEdit) return new List<string?> { ViewPriceListType };
            if (IsDual)
                return ListChoice == ChoiceBoth
                    ? new List<string?> { PriceListTypes.Regional, PriceListTypes.National }
                    : new List<string?> { ListChoice };
            return new List<string?> { null };
        }
    }

    private decimal? BaseFor(string? list) => isEdit
        ? ViewOldPrice
        : list switch
        {
            PriceListTypes.Regional => SelectedCompanyItem?.StockPriceRegional,
            PriceListTypes.National => SelectedCompanyItem?.StockPriceNational,
            _ => SelectedCompanyItem?.StockPrice
        };

    /// <summary>The ₱ change for a list, from the amount / percent / new price typed.</summary>
    private decimal? AmountFor(string? list)
    {
        if (ChangeValue is not decimal v) return null;
        var b = BaseFor(list);
        return ChangeMode switch
        {
            ModePercent => b is decimal bp ? Math.Round(bp * v / 100m, 2, MidpointRounding.AwayFromZero) : null,
            ModeNewPrice => b is decimal bn ? v - bn : null,
            _ => v
        };
    }

    private void SetMode(string mode)
    {
        if (mode == ChangeMode) return;
        // Keep the same change when switching how it is typed (based on the first list).
        var first = Lists.FirstOrDefault();
        var amount = AmountFor(first);
        var b = BaseFor(first);
        ChangeMode = mode;
        if (amount is decimal a && b is decimal bp)
        {
            ChangeValue = mode switch
            {
                ModePercent => bp == 0 ? null : Math.Round(a / bp * 100m, 2),
                ModeNewPrice => bp + a,
                _ => a
            };
        }
    }

    private void QuickPercent(decimal pct)
    {
        ChangeMode = ModePercent;
        ChangeValue = pct;
    }

    // ---------------- Preview ----------------

    private List<CompanyItemUomPriceDto> ImpactRows
    {
        get
        {
            var lists = Lists;
            IEnumerable<CompanyItemUomPriceDto> rows = isEdit || !IsDual
                ? UomPrices
                : UomPrices.Where(u => lists.Contains(u.PriceListType));

            return rows.Select(u =>
                {
                    var now = u.OldPrice ?? u.CurrentPrice;
                    var inc = AmountFor(isEdit ? ViewPriceListType : u.PriceListType) is decimal a
                        ? UomPriceCalculator.Increase(a, u.ConversionToBase)
                        : null;
                    return new CompanyItemUomPriceDto
                    {
                        SubdItemId = u.SubdItemId,
                        SubdItemCode = u.SubdItemCode,
                        SubdItemName = u.SubdItemName,
                        UomName = u.UomName,
                        ConversionToBase = u.ConversionToBase,
                        PriceListType = u.PriceListType,
                        OldPrice = now,
                        NewPrice = now.HasValue && inc.HasValue ? now + inc : null
                    };
                })
                .OrderBy(r => r.PriceListType)
                .ThenBy(r => r.SubdItemCode)
                .ThenByDescending(r => r.ConversionToBase ?? decimal.MinValue)
                .ToList();
        }
    }

    private sealed record TimelineItem(DateTime When, string Date, string Price, string Label, string Css);

    /// <summary>The item's history for the first list, with this change placed where its date puts it.</summary>
    private List<TimelineItem> Timeline
    {
        get
        {
            var list = Lists.FirstOrDefault();
            var rows = ItemHistory.Where(h => h.PriceListType == list).ToList();
            var currentId = rows.Where(h => h.AppliedDate != null)
                                .OrderByDescending(h => h.EffectivityDate).Select(h => (int?)h.CompanyItemPriceHistoryId).FirstOrDefault();

            var items = new List<TimelineItem>();
            foreach (var h in rows)
            {
                if (isEdit && h.CompanyItemPriceHistoryId == PriceIncreaseId) continue; // shown below with the edited values
                var when = h.EffectivityDate ?? DateTime.MinValue;
                var (label, css) = h.AppliedDate == null
                    ? ("Pending", "pend")
                    : h.CompanyItemPriceHistoryId == currentId ? ("Current", "cur") : ("Applied", "");
                items.Add(new TimelineItem(when, when.ToString("MMM d, yyyy"), Fmt(h.NewPrice), label, css));
            }

            var amount = AmountFor(list);
            var newPrice = BaseFor(list) + amount;
            if (EffectivityDate is DateTime d && amount.HasValue)
            {
                items.Add(new TimelineItem(d, d.ToString("MMM d, yyyy"), Fmt(newPrice),
                    isEdit ? "This change · editing" : Lists.Count > 1 ? "New · both lists" : "New", isEdit ? "edit" : "new"));
            }

            var ordered = items.OrderByDescending(i => i.When).ToList();
            var shown = ordered.Take(8).ToList();
            var mine = ordered.FirstOrDefault(i => i.Css is "edit" or "new");
            if (mine is not null && !shown.Contains(mine))
                shown[^1] = mine; // always show this change
            return shown;
        }
    }

    // ---------------- Formatting / errors ----------------

    private static string Fmt(decimal? v) => v is decimal d ? $"₱{d:N2}" : "-";

    private static string FmtSigned(decimal? v) =>
        v is decimal d ? $"{(d >= 0 ? "+" : "−")}{Math.Abs(d):N2}" : "-";

    private string GetFieldError(string key) => Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    private string GetAmountError() =>
        Errors.Where(kv => kv.Key.StartsWith(PriceIncreaseValidations.AddPriceIncrease.PriceIncreaseAmount.Key,
StringComparison.Ordinal))
              .Select(kv => kv.Value).FirstOrDefault() ?? string.Empty;

    private string GetDateError() =>
        Errors.Where(kv => kv.Key.StartsWith(PriceIncreaseValidations.AddPriceIncrease.EffectivityDate.Key,
StringComparison.Ordinal))
              .Select(kv => kv.Value).FirstOrDefault() ?? string.Empty;

    private string DeleteMessage => IsAppliedView
        ? $"This change is already applied. Deleting it rebuilds the item's price history and sets its current price back." +
          (InvoiceLinesUsing > 0 ? $" {InvoiceLinesUsing} invoice line(s) keep their amounts until recalculated." : string.Empty)
+ " Delete it?"
        : "Delete this pending price change?";

    // ---------------- Selection ----------------

    private async Task OnCompanyItemSelected(CompanyItemDropdownItem? item)
    {
        SelectedCompanyItem = item;
        SelectedCompanyItemId = item?.CompanyItemId;
        ResetInputs();
        UomPrices = new List<CompanyItemUomPriceDto>();
        ItemHistory = new List<PriceIncreaseTableListDto>();
        ExcludedSubDistributors = new List<string>();

        if (item is null) return;
        Principal = item.Principal;

        if (item.Structure is PricingStructure.Single or PricingStructure.Dual)
        {
            UomPrices = await AdminPriceIncreaseService.GetUomPricesByCompanyItemIdAsync(item.CompanyItemId);
            ItemHistory = await AdminPriceIncreaseService.GetCompanyItemHistoryAsync(item.CompanyItemId);
            if (item.Structure == PricingStructure.Dual)
                ExcludedSubDistributors = await AdminPriceIncreaseService.GetSubDistributorsWithoutPriceListAsync(item.CompanyItemId);
        }
    }

    private void ClearItem()
    {
        SelectedCompanyItem = null;
        SelectedCompanyItemId = null;
        UomPrices = new List<CompanyItemUomPriceDto>();
        ItemHistory = new List<PriceIncreaseTableListDto>();
        ExcludedSubDistributors = new List<string>();
        ResetInputs();
    }

    private void OnPrincipalChanged(string? value)
    {
        Principal = value;
        if (SelectedCompanyItem != null && !string.IsNullOrWhiteSpace(Principal) && SelectedCompanyItem.Principal != Principal)
            ClearItem();
    }

    private void ResetInputs()
    {
        ListChoice = ChoiceBoth;
        ChangeMode = ModeAmount;
        ChangeValue = null;
        EffectivityDate = null;
        Errors = new();
        ShowValidationErrors = false;
    }

    // ---------------- Load ----------------

    protected override async Task OnInitializedAsync()
    {
        if (isEdit)
        {
            EditRow = await AdminPriceIncreaseService.GetPriceIncreaseByIdAsync(PriceIncreaseId!.Value);
            if (EditRow is null) return;

            ChangeValue = EditRow.PriceIncreaseAmount;
            EffectivityDate = EditRow.EffectivityDate;
            InvoiceLinesUsing = await AdminPriceIncreaseService.CountInvoiceLinesUsingAsync(PriceIncreaseId!.Value);

            if (EditRow.CompanyItemId is int itemId)
                ItemHistory = await AdminPriceIncreaseService.GetCompanyItemHistoryAsync(itemId);

            var details = await AdminPriceIncreaseService.GetCascadedUomDetailsAsync(PriceIncreaseId!.Value);
            UomPrices = details.Select(d => new CompanyItemUomPriceDto
            {
                SubdItemId = d.SubdItemId,
                SubdItemCode = d.SubdItemCode,
                SubdItemName = d.SubdItemName,
                UomName = d.UomName,
                ConversionToBase = d.ConversionToBase,
                PriceListType = d.PriceListType,
                OldPrice = d.OldPrice
            }).ToList();
        }
        else
        {
            Principals = await AdminPriceIncreaseService.GetAllPrincipalsAsync();
            CompanyItems = await AdminPriceIncreaseService.GetCompanyItemsForDropdownAsync();
        }
    }

    // ---------------- Confirm / submit ----------------

    private async Task RequestConfirm()
    {
        Errors = new();
        ShowValidationErrors = true;
        var amountKey = PriceIncreaseValidations.AddPriceIncrease.PriceIncreaseAmount.Key;
        var dateKey = PriceIncreaseValidations.AddPriceIncrease.EffectivityDate.Key;

        if (isEdit)
        {
            var amount = AmountFor(ViewPriceListType);
            Errors = await PriceIncreaseValidations.ValidateEditPriceIncreaseAsync(new AddPriceIncreaseDto
            {
                PriceIncreaseAmount = amount,
                EffectivityDate = EffectivityDate
            });
            if (Errors.Any()) return;

            PendingEditData = (amount!.Value, EffectivityDate!.Value);
        }
        else
        {
            if (SelectedCompanyItem == null)
            {
                Errors[PriceIncreaseValidations.AddPriceIncrease.CompanyItem.Key] = "Select a company item.";
                return;
            }
            if (IsBlocked) return;

            var lines = new List<PriceIncreaseLineDto>();
            foreach (var list in Lists)
            {
                var amount = AmountFor(list);
                var errs = await PriceIncreaseValidations.ValidateAddPriceIncreaseAsync(new AddPriceIncreaseDto
                {
                    CompanyItemId = SelectedCompanyItemId,
                    PriceIncreaseAmount = amount,
                    PriceListType = list,
                    EffectivityDate = EffectivityDate,
                    CreatedBy = CurrentUserId
                }, AdminPriceIncreaseService);

                foreach (var (key, msg) in errs)
                {
                    var prefix = list is null ? string.Empty : $"{list}: ";
                    var target = key == amountKey || key == dateKey ? $"{key}:{list}" : key;
                    Errors.TryAdd(target, Lists.Count > 1 ? prefix + msg : msg);
                }

                if (BaseFor(list) is decimal b && amount is decimal a && b + a < 0)
                    Errors.TryAdd($"{amountKey}:{list}", $"{(list is null ? "The" : list)} price would be negative.");

                if (amount is decimal ok && ok != 0)
                    lines.Add(new PriceIncreaseLineDto { PriceListType = list, Amount = ok, EffectivityDate = EffectivityDate });
            }

            if (Errors.Any()) return;

            PendingScheduleDto = new AddPriceIncreaseDto
            {
                CompanyItemId = SelectedCompanyItemId,
                EffectivityDate = EffectivityDate,
                CreatedBy = CurrentUserId,
                Lines = lines
            };
        }

        if (OnRequestConfirm.HasDelegate)
            await OnRequestConfirm.InvokeAsync();
    }

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingEditData == null) return (false, "No pending changes.");
                return await AdminPriceIncreaseService.UpdatePriceChangeAsync(
                    PriceIncreaseId!.Value, PendingEditData.Value.Amount, PendingEditData.Value.EffectivityDate, CurrentUserId);
            }

            if (PendingScheduleDto == null) return (false, "No pending data.");
            return await AdminPriceIncreaseService.ScheduleIncreaseAsync(PendingScheduleDto);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteAsync()
    {
        showDeleteConfirm = false;
        if (!isEdit) return;

        isSubmitting = true;
        var (success, error) = await AdminPriceIncreaseService.DeletePriceChangeAsync(PriceIncreaseId!.Value, CurrentUserId);
        isSubmitting = false;

        if (!success)
        {
            deleteError = error ?? "The price change could not be deleted.";
            return;
        }

        if (OnDeleted.HasDelegate) await OnDeleted.InvokeAsync();
    }

    private Task Cancel() => onCancel.HasDelegate ? onCancel.InvokeAsync() : Task.CompletedTask;
}
