
@using STTproject.Features.Admin.Users.DTOs
@inject STTproject.Features.Admin.Subdistributor.Services.IAdminSubDistributorService AdminSubDistributorService
@inject STTproject.Services.IUserContextService UserContextService

@inject STTproject.Features.Admin.Customers.Services.IGeographicDataService GeographicDataService


<Modal ShowModal="true" Width="720px" MaxWidth="100%" MaxHeight="88vh" IconType="ModalIconType.ItemView" Title="@(isEdit ? (isViewMode ? "View Subdistributor" : "Edit Subdistributor") : "Add New Subdistributor")" OnClose="Cancel">
    <ChildContent>
        <FormSection Icon="ti ti-building-warehouse" Title="Subdistributor Details" Expandable="true" IsExpanded="true">
           <ChildContent>
                <div class="form-group">
                    <Input Label="Subdistributor Code" Required="true" @bind-Value="SubdCode" Disabled="@isViewMode" Placeholder="Enter subdistributor code..." 
                    ShowError="ShowValidationErrors" ErrorText="@GetFieldError(SubDistributorValidations.AddSubDistributor.subdcode.Key)"/>
                </div>

                <div class="form-group">
                    <Input Label="Subdistributor Name" Required="true" @bind-Value="SubdName" Disabled="@isViewMode" Placeholder="Enter subdistributor name..." 
                    ShowError="ShowValidationErrors" ErrorText="@GetFieldError(SubDistributorValidations.AddSubDistributor.subdname.Key)"/>
                </div>

                <div class="form-group">
                    <AutoComplete 
                        Label="Province" 
                        Placeholder="Search province..."
                        Items="Provinces" 
                        SelectedValue="@Province"
                        SelectedValueChanged="OnProvinceSelected"
                        Disabled="@isViewMode"/>
                </div>

                <div class="form-group">
                    <AutoComplete 
                        Label="City / Municipality" 
                        Placeholder="Search city/municipality..."
                        Items="CitiesMunicipalities" 
                        SelectedValue="@CityMunicipality"
                        SelectedValueChanged="OnCityMunicipalitySelected"
                        Disabled="@isViewMode"/>
                </div>

                <div class="form-group">
                    <AutoComplete 
                        Label="Encoder" 
                        Placeholder="Search encoder..."
                        Items="Encoders" 
                        SelectedValue="@SelectedEncoderId"
                        SelectedValueChanged="OnEncoderSelected"
                        Disabled="@isViewMode"
                        TextSelector="@(e => e.FullName ?? e.UserName)"
                        ValueSelector="@(e => e.UserId.ToString())"
                        ShowAllOnOpen="true"/>
                </div>

                <div class="form-group">
                    <Toggle @bind-Bind="IsActive" Disabled="@isViewMode"/>
                </div>
           </ChildContent> 
        </FormSection>

        @if (isViewMode)
        {
            <FormSection Icon="ti ti-info-circle" Title="Audit Information" Expandable="true" IsExpanded="false">
                <ChildContent>
                    @if(CreatedByName != null)
                    {
                    <div class="form-group">
                        <Input Label="Created By" Disabled="true" @bind-Value="@CreatedByName" />
                    </div>
                    }
                    <div class="form-group">
                        <Input Label="Created Date" Disabled="true" Value="CreatedDateDisplay" />
                    </div>
                    @if(UpdatedByName != null)
                    {
                    <div class="form-group">
                        <Input Label="Updated By" Disabled="true" @bind-Value="@UpdatedByName" />
                    </div>
                    }
                    @if(UpdatedDate != null)
                    {
                    <div class="form-group">
                        <Input Label="Updated Date" Disabled="true" Value="UpdatedDateDisplay" />
                    </div>
                    }
                </ChildContent>
            </FormSection>
        }
    </ChildContent>
    <FooterContent>
        @if (isEdit && isViewMode)
        {
            <Button Title="Edit" OnClick="EnableEdit" Variant="ButtonVariant.Primary" />
            <Button Title="Close" OnClick="Cancel" Variant="ButtonVariant.Secondary" />
        }
        else
        {
            <Button Title="@(isEdit ? "Save Changes" : "Create Subdistributor")" OnClick="CreateSubDistributor" Disabled="@isSubmitting" Variant="ButtonVariant.Primary" />
            <Button Title="Cancel" OnClick="Cancel" Disabled="@isSubmitting" Variant="ButtonVariant.Secondary" />
        }
    </FooterContent>
</Modal>

@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    public SubDistributorCreateDto? PendingDto { get; private set; }
    public SubDistributorUpdateDto? PendingUpdateDto { get; private set; }

    private bool isViewMode = false;
    private GenericAutocomplete<UserListDto>? encoderAutocomplete;
    private ElementReference subdCodeInput;
    private ElementReference subdNameInput;
    private ElementReference cityMunicipalityInput;

    private string? SubdCode { get; set; }
    private string? SubdName { get; set; }
    private string? Province { get; set; }
    private string? CityMunicipality { get; set; }
    private bool IsActive { get; set; } = true;

    private int? EncoderId { get; set; }
    private string? SelectedEncoderName { get; set; }
    private List<EncoderUserDropdownDto> Encoders { get; set; } = new();

    // Audit fields (view mode only)
    private DateTime CreatedDate { get; set; }
    private DateTime? UpdatedDate { get; set; }

    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; } = false;
    private bool isSubmitting = false;

    [Parameter] public int? SubDistributorId { get; set; }
    private bool isEdit => SubDistributorId.HasValue;
    private int? CurrentUserId => UserContextService.UserId;

    private string GetFieldError(string key) =>
        Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    private List<string?> Provinces { get; set; } = new();
    private List<string?> Islands { get; set; } = new();
    private List<string?> CitiesMunicipalities { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Encoders = (await AdminSubDistributorService.GetEncoderUsersAsync()).ToList();
        Provinces = (await GeographicDataService.GetAllProvincesAsync()).ToList();
        CitiesMunicipalities = (await GeographicDataService.GetAllCitiesMunicipalitiesAsync()).ToList();

        if (isEdit)
        {
            isViewMode = true;
            var subd = await AdminSubDistributorService.GetSubDistributorByIdAsync(SubDistributorId!.Value);
            if (subd != null)
            {
                SubdCode = subd.SubdCode;
                SubdName = subd.SubdName;
                Province = subd.Province;
                CityMunicipality = subd.CityMunicipality;
                IsActive = subd.IsActive;
                EncoderId = subd.EncoderId;
                SelectedEncoderId = subd.EncoderId?.ToString();  

                if (!string.IsNullOrWhiteSpace(Province))
                    CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();

                // Audit
                CreatedDate = subd.CreatedDate;
                UpdatedDate = subd.UpdatedDate;
                CreatedByName = subd.CreatedByName;
                UpdatedByName = subd.UpdatedByName;
            }
        }
    }
    private string? SelectedEncoderId { get; set; }      
    private string CreatedDateDisplay => CreatedDate.ToString("yyyy-MM-dd HH:mm:ss");
    private string UpdatedDateDisplay => UpdatedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty;
    private int? CreatedBy { get; set; }
    private int? UpdatedBy { get; set; }
    private string? CreatedByName { get; set; }
    private string? UpdatedByName { get; set; }
    private const string EncoderRoleFallback = "Encoder";
    private void EnableEdit() => isViewMode = false;

    private async Task OnEncoderSelected(string? selected)
    {
        if (string.IsNullOrWhiteSpace(selected) || !int.TryParse(selected, out var userId))
        {
            EncoderId = null;
            SelectedEncoderId = null;
        }
        else
        {
            var encoder = Encoders.FirstOrDefault(e => e.UserId == userId);
            if (encoder != null)
            {
                EncoderId = encoder.UserId;
                SelectedEncoderId = encoder.UserId.ToString();
            }
            else
            {
                EncoderId = null;
                SelectedEncoderId = null;
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateSubDistributor()
    {
        var subdToValidate = new STTproject.Data.SubDistributor
        {
            SubdCode = SubdCode ?? string.Empty,
            SubdName = SubdName ?? string.Empty,
            Province = Province ?? string.Empty,
            CityMunicipality = CityMunicipality ?? string.Empty,
            EncoderId = EncoderId,
        };

        Errors = await SubDistributorValidations.ValidateAddSubDistributorAsync(subdToValidate);
        ShowValidationErrors = true;

        if (Errors.Any()) return;

        if (isEdit)
        {
            PendingUpdateDto = new SubDistributorUpdateDto
            {
                SubDistributorId = SubDistributorId!.Value,
                SubdCode = SubdCode,
                SubdName = SubdName,
                Province = Province,
                CityMunicipality = CityMunicipality,
                EncoderId = EncoderId,
                IsActive = IsActive,
                UpdatedBy = CurrentUserId
            };
        }
        else
        {
            PendingDto = new SubDistributorCreateDto
            {
                SubdCode = SubdCode ?? string.Empty,
                SubdName = SubdName ?? string.Empty,
                Province = Province ?? string.Empty,
                CityMunicipality = CityMunicipality ?? string.Empty,
                EncoderId = EncoderId,
                IsActive = IsActive,
                CreatedBy = CurrentUserId
            };
        }

        await OnRequestConfirm.InvokeAsync();
    }

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingUpdateDto == null) return (false, "No pending update data.");
                await AdminSubDistributorService.UpdateSubDistributorAsync(PendingUpdateDto);
                return (true, null);
            }
            else
            {
                if (PendingDto == null) return (false, "No pending data.");
                await AdminSubDistributorService.CreateSubDistributorAsync(PendingDto);
                return (true, null);
            }
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
            when (ex.InnerException is Microsoft.Data.SqlClient.SqlException sqlEx &&
                  (sqlEx.Number == 2601 || sqlEx.Number == 2627))
        {
            Errors[SubDistributorValidations.AddSubDistributor.subdcode.Key] =
                "This Subdistributor Code already exists.";
            ShowValidationErrors = true;
            await InvokeAsync(StateHasChanged);
            return (false, "This Subdistributor Code already exists. Please choose a different one.");
        }
        catch (InvalidOperationException ex)
        {
            // e.g. thrown by the service when EncoderId isn't a valid active Encoder-role user
            Errors[SubDistributorValidations.AddSubDistributor.encoder.Key] = ex.Message;
            ShowValidationErrors = true;
            await InvokeAsync(StateHasChanged);
            return (false, ex.Message);
        }
        catch (Exception)
        {
            return (false, "Something went wrong while saving. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        if (onCancel.HasDelegate)
            return onCancel.InvokeAsync();
        return Task.CompletedTask;
    }
    private async Task OnProvinceSelected(string? selected)
    {
        Province = selected;
        await ProvinceChanged();
    }
    private async Task ProvinceChanged()
    {
        try
        {
            CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();

        }
        catch (Exception)
        {
            CitiesMunicipalities = new();
        }
        CityMunicipality = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCityMunicipalitySelected(string? selected)
    {
        CityMunicipality = selected;

        if (!string.IsNullOrWhiteSpace(selected) && string.IsNullOrWhiteSpace(Province))
        {
            var inferredProvince = await GeographicDataService.GetProvinceByCityAsync(selected);
            if (!string.IsNullOrWhiteSpace(inferredProvince))
            {
                Province = inferredProvince;
                CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}