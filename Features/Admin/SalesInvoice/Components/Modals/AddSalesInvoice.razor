@using STTproject.Features.Admin.SalesInvoice.DTOs
@using STTproject.Shared.Components
@using STTproject.Features.Admin.SalesInvoice.Validators
@inject STTproject.Features.Admin.SalesInvoice.Services.IAdminSalesInvoiceService SalesInvoiceService
@inject STTproject.Services.IUserContextService UserContextService


<Modal ShowModal="true" Width="900px" MaxWidth="100%" MaxHeight="88vh"
       Title="@(isEdit ? (isViewMode ? "View Sales Invoice" : "Edit Sales Invoice") : "Add New Sales Invoice")"
       IconType="@(isEdit ? (isViewMode ? ModalIconType.UserView : ModalIconType.UserEdit) : ModalIconType.UserPlus)"
       OnClose="Cancel">
    <ChildContent>

        <FormSection Icon="ti ti-file-invoice" Title="Invoice Information" Summary="@GetInvoiceInfoSummary()"
                     Expandable="true" IsExpanded="true">
            <ChildContent>
                <div class="inv-grid">
                    <div class="form-group inv-full">
                        <AutoComplete Label="Subdistributor" Placeholder="Type to search subdistributor..."
                                      TItem="SalesInvoiceSubDistributorDropdownItem" Required="true" Items="SubDistributors"
                                      ValueSelector="x => x.SubDistributorId.ToString()"
                                      TextSelector="x => x.SubdName ?? string.Empty"
                                      SelectedValue="@(SubDistributorId.ToString())"
                                      SelectedItemChanged="OnSubDistributorSelected" Disabled="@isViewMode"
                                      ShowError="@ShowValidationErrors"
                                      ErrorText="@GetFieldError(SalesInvoiceValidator.Fields.SubDistributor)" />
                    </div>

                    <div class="form-group inv-full">
                        <AutoComplete @key="@($"cust-{SubDistributorId}")" Label="Customer"
                                      Placeholder="@(SubDistributorId == 0 ? "Choose a subdistributor first" : "Search by code or name...")"
                                      TItem="SalesInvoiceCustomerDropdownItem" Required="true" Items="Customers"
                                     ValueSelector="x => x.CustomerId.ToString()"
                                      TextSelector='x => $"{x.CustomerCode} – {x.CustomerName}"'
                                      SelectedValue="@(CustomerId.ToString())" SelectedItemChanged="OnCustomerSelected"
                                      Disabled="@(isViewMode || SubDistributorId == 0)" ShowError="@ShowValidationErrors"
                                      ErrorText="@GetFieldError(SalesInvoiceValidator.Fields.Customer)" />
                        @if (!isViewMode && SubDistributorId == 0)
                        {
                            <span class="inv-hint">Customers load after you pick a subdistributor.</span>
                        }
                    </div>

                    <div class="form-group">
                        <Input Label="Invoice Code" Required="true" @bind-Value="SalesInvoiceCode"
                               Disabled="@isViewMode" Placeholder="e.g. INV-2026-0142" ShowError="@ShowValidationErrors"
                               ErrorText="@GetFieldError(SalesInvoiceValidator.Fields.InvoiceCode)" />
                    </div>

                    <div class="form-group">
                        <label>Invoice Date <span class="required-asterisk">*</span></label>
                        <input type="date" @bind="SalesInvoiceDate" @bind:after="OnInvoiceDateChanged"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@isViewMode" />
                        @if (ShowValidationErrors &&
                        !string.IsNullOrWhiteSpace(GetFieldError(SalesInvoiceValidator.Fields.InvoiceDate)))
                        {
                            <span class="error-text">@GetFieldError(SalesInvoiceValidator.Fields.InvoiceDate)</span>
                        }
                    </div>

                    <div class="form-group">
                        <label>Order Type <span class="required-asterisk">*</span></label>
                        <div class="order-toggle" role="group" aria-label="Order type">
                            @foreach (var type in OrderTypeOptions)
                            {
                                var t = type;
                                <button type="button"
                                        class="order-toggle-btn @(OrderType == t ? "active" : "") @(t == "Credit" ? "credit" : "")"
                                        aria-pressed="@(OrderType == t ? "true" : "false")" disabled="@isViewMode"
                                        @onclick="() => OnOrderTypeSelected(t)">@t</button>
                            }
                        </div>
                        <span class="inv-hint">
                            @(OrderType == "Credit" ? "Credit: amounts are saved as negative." : OrderType == "Invoice" ? "Invoice: amounts are positive." : "Choose Invoice or Credit.")
                        </span>
                        @if (ShowValidationErrors &&
                        !string.IsNullOrWhiteSpace(GetFieldError(SalesInvoiceValidator.Fields.OrderType)))
                        {
                            <span class="error-text">@GetFieldError(SalesInvoiceValidator.Fields.OrderType)</span>
                        }
                    </div>

                    <div class="form-group">
                        <Input Label="Salesman (optional)" @bind-Value="SalesMan" Disabled="@isViewMode"
                               Placeholder="Enter salesman name" />
                    </div>
                </div>
            </ChildContent>
        </FormSection>

        @* Items: plain section (no FormSection card) *@
        <div class="inv-items">
            <div class="inv-items-head">
                <h3>Items</h3>
                <span>@GetItemsSummary()</span>
            </div>

            @if (SubDistributorId == 0 && !isEdit)
            {
                <div class="inv-locked">Pick a subdistributor above to start adding items.</div>
            }
            else
            {
                <div class="inv-lines" @key="tableKey">
                    <div class="inv-line inv-line-head">
                        <div>Item</div>
                        <div>UOM</div>
                        <div>Qty</div>
                        <div class="inv-num">Unit Price</div>
                        <div class="inv-num">Amount</div>
                        <div></div>
                    </div>

                    @if (LineItems.Count == 0)
                    {
                        <div class="inv-empty">No items yet. Select “+ Add item” to begin.</div>
                    }

                    @foreach (var line in LineItems)
                    {
                        var current = line;
                        var rowError = GetLineError(LineItems.IndexOf(current));
                        <div class="inv-line" @key="current">
                            <div class="inv-cell inv-cell-item inv-ac">
                                <AutoComplete TItem="SalesInvoiceSubdItemDropdownItem" Items="SubdItems"
                                              Placeholder="Search SKU / item..." Disabled="@isViewMode"
                                              ValueSelector="x => x.SubdItemId.ToString()"
                                              TextSelector='x => $"{x.SubdItemCode} - {x.ItemName}"'
                                              SelectedValue="@(current.SubdItemId == 0 ? string.Empty : current.SubdItemId.ToString())"
                                              SelectedItemChanged="@(item => OnRowItemSelected(current, item))" />
                            </div>
                            <div class="inv-cell inv-ac">
                                <AutoComplete @key="@($"uom-{current.SubdItemId}")" TItem="SalesInvoiceUomOption"
                                              Items="current.AvailableUoms" Placeholder="Select UOM" ShowAllOnOpen="true"
                                              Disabled="@(isViewMode || !current.AvailableUoms.Any())"
                                              ValueSelector="x => x.ItemsUomId.ToString()"
                                              TextSelector='x => x.PriceIssue is null ? x.UomName : $"{x.UomName} (no price)"'
                                              SelectedValue="@(current.SelectedUomId == 0 ? string.Empty : current.SelectedUomId.ToString())"
                                              SelectedItemChanged="@(uom => OnRowUomSelected(current, uom))" />
                            </div>
                            <div class="inv-cell">
                                <div class="inv-step">
                                    @if (!isViewMode)
                                    {
                                        <button type="button" class="inv-step-btn" aria-label="Decrease quantity"
                                                disabled="@isSubmitting" @onclick="() => ChangeQty(current, -1)">−</button>
                                    }
                                    <input type="number" min="1" class="inv-qty" aria-label="Quantity" value="@current.Quantity"
                                           disabled="@(isViewMode || isSubmitting)" @onchange="e => OnQtyChanged(current, e)" />
                                    @if (!isViewMode)
                                    {
                                        <button type="button" class="inv-step-btn" aria-label="Increase quantity"
                                                disabled="@isSubmitting" @onclick="() => ChangeQty(current, 1)">+</button>
                                    }
                                </div>
                            </div>
                            <div class="inv-num">@current.UnitPrice.ToString("N2")</div>
                            <div class="inv-num inv-amt @(current.Amount < 0 ? "neg" : "")">@current.Amount.ToString("N2")</div>
                            <div class="inv-cell">
                                @if (!isViewMode)
                                {
                                    <button type="button" class="inv-remove" title="Remove item" aria-label="Remove item"
                                            disabled="@isSubmitting" @onclick="() => RemoveLine(current)">×</button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(rowError))
                            {
                                <div class="inv-line-error">@rowError</div>
                            }
                        </div>
                    }
                </div>

                @if (!isViewMode)
                {
                    <button type="button" class="inv-add" disabled="@isSubmitting" @onclick="AddLine">+ Add item</button>
                }

                @if (!string.IsNullOrWhiteSpace(GetFieldError(SalesInvoiceValidator.Fields.Items)))
                {
                    <span class="error-text">@GetFieldError(SalesInvoiceValidator.Fields.Items)</span>
                }
            }
        </div>

        @if (isViewMode)
        {
            <FormSection Icon="ti ti-info-circle" Title="Audit Information" Expandable="true" IsExpanded="true">
                <ChildContent>
                    @if (CreatedByName != null)
                    {
                        <div class="form-group"><Input Label="Created By" Disabled="true" Value="@CreatedByName" /></div>
                    }
                    <div class="form-group">
                        <Input Label="Created Date" Disabled="true" Value="@CreatedDate.ToString("MMM d, yyyy hh:mm tt")" />
                    </div>
                    @if (UpdatedByName != null)
                    {
                        <div class="form-group"><Input Label="Updated By" Disabled="true" Value="@UpdatedByName" /></div>
                    }
                    @if (UpdatedDate.HasValue)
                    {
                        <div class="form-group">
                            <Input Label="Updated Date" Disabled="true"
                                   Value="@UpdatedDate.Value.ToString("MMM d, yyyy hh:mm tt")" />
                        </div>
                    }
                </ChildContent>
            </FormSection>
        }
    </ChildContent>

    <FooterContent>
        <span class="inv-total @(LineItems.Sum(l => l.Amount) < 0 ? "neg" : "")">
            <small>Total</small>
            <strong>@LineItems.Sum(l => l.Amount).ToString("N2")</strong>
        </span>
        @if (isEdit && isViewMode)
        {
            <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="Cancel"></Button>
            <Button Title="Edit" Variant="ButtonVariant.Primary" OnClick="EnableEdit"></Button>
        }
        else
        {
            <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting"></Button>
            <Button
            Title="@(isSubmitting ? (isEdit ? "Saving..." : "Creating...") : (isEdit ? "Save Changes" : "Create Invoice"))"
            Variant="ButtonVariant.Primary" OnClick="Submit" Disabled="@isSubmitting"></Button>
        }
    </FooterContent>
</Modal>

@code {
    // ── Parameters ────────────────────────────────────────────────────────────
    [Parameter] public int? SalesInvoiceId { get; set; }
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }

    // Pending DTOs exposed to parent (same pattern as AddCustomer)
    public CreateSalesInvoiceDto? PendingDto { get; private set; }
    public UpdateSalesInvoiceDto? PendingUpdateDto { get; private set; }

    // ── State ─────────────────────────────────────────────────────────────────
    private bool isViewMode = false;
    private bool isEdit => SalesInvoiceId.HasValue;
    private bool isSubmitting = false;
    private bool ShowValidationErrors = false;
    private int tableKey;
    private Dictionary<string, string> Errors { get; set; } = new();

    private int? CurrentUserId => UserContextService.UserId;

    // ── Dropdown data ─────────────────────────────────────────────────────────
    private List<SalesInvoiceSubDistributorDropdownItem> SubDistributors { get; set; } = new();
    private List<SalesInvoiceCustomerDropdownItem> Customers { get; set; } = new();
    private List<SalesInvoiceSubdItemDropdownItem> SubdItems { get; set; } = new();

    // ── Header fields ─────────────────────────────────────────────────────────
    private int SubDistributorId { get; set; }
    private string? SelectedSubDistributorName { get; set; }
    private string? SalesInvoiceCode { get; set; }
    private DateOnly SalesInvoiceDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private int CustomerId { get; set; }
    private string? SelectedCustomerName { get; set; }
    private string? OrderType { get; set; }
    private string? SalesMan { get; set; }

    // ── Audit fields ──────────────────────────────────────────────────────────
    private DateTime CreatedDate { get; set; }
    private DateTime? UpdatedDate { get; set; }
    private string? CreatedByName { get; set; }
    private string? UpdatedByName { get; set; }

    // ── Line items ────────────────────────────────────────────────────────────
    private List<LineItemModel> LineItems { get; set; } = new();

    private sealed class LineItemModel
    {
        public int SalesInvoiceItemId { get; set; }
        public int SubdItemId { get; set; }
        public string? ItemSearchText { get; set; }
        public string? ItemName { get; set; }
        public List<SalesInvoiceUomOption> AvailableUoms { get; set; } = new();
        public int SelectedUomId { get; set; }
        public string? UomName { get; set; }
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; } = 1;
        public decimal Amount { get; set; }
        public int ConversionToBase { get; set; }
        public int StockConvToBase { get; set; }
        public decimal? StockPrice { get; set; }
        public string? PriceIssue { get; set; }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        SubDistributors = await SalesInvoiceService.GetSubDistributorsAsync();

        if (isEdit)
        {
            isViewMode = true;
            var detail = await SalesInvoiceService.GetSalesInvoiceDetailAsync(SalesInvoiceId!.Value);
            if (detail is not null)
            {
                SubDistributorId = detail.SubDistributorId;
                SelectedSubDistributorName = detail.SubdName;

                SalesInvoiceCode = detail.SalesInvoiceCode;
                SalesInvoiceDate = detail.SalesInvoiceDate;
                CustomerId = detail.CustomerId;
                SelectedCustomerName = detail.CustomerName;
                OrderType = detail.OrderType;
                SalesMan = detail.SalesMan;

                await LoadDropdownsForSubdistributor(SubDistributorId, SalesInvoiceDate);
                CreatedDate = detail.CreatedDate;
                UpdatedDate = detail.UpdatedDate;
                CreatedByName = detail.CreatedByName;
                UpdatedByName = detail.UpdatedByName;

                LineItems = detail.Items.Select(i => new LineItemModel
                {
                    SalesInvoiceItemId = i.SalesInvoiceItemId,
                    SubdItemId = i.SubdItemId,
                    ItemSearchText = $"{i.SubdItemCode} – {i.ItemName}",
                    ItemName = i.ItemName,
                    SelectedUomId = i.ItemsUomId,
                    UomName = i.UomName,
                    UnitPrice = i.UomPrice,
                    Quantity = i.Quantity,
                    Amount = i.Amount,
                    AvailableUoms = SubdItems
                        .FirstOrDefault(s => s.SubdItemId == i.SubdItemId)?.Uoms ?? new()
                }).ToList();
                foreach (var line in LineItems)
                {
                    var (storedUnit, storedAmount) = (line.UnitPrice, line.Amount);
                    var uom = line.AvailableUoms.FirstOrDefault(u => u.ItemsUomId == line.SelectedUomId);

                    if (uom is null)
                        line.PriceIssue = "This item or UOM is no longer active. Choose another UOM or remove the line.";
                    else
                        ApplyUom(line, uom);

                    line.UnitPrice = storedUnit;
                    line.Amount = storedAmount;
                }
            }
        }
    }

    private async Task LoadDropdownsForSubdistributor(int subdId, DateOnly invoiceDate)
    {
        Customers = await SalesInvoiceService.GetCustomersForDropdownAsync(subdId);
        SubdItems = await SalesInvoiceService.GetSubdItemsForDropdownAsync(subdId, invoiceDate);
    }

    // ── Selection handlers ────────────────────────────────────────────────────
    private async Task OnSubDistributorSelected(SalesInvoiceSubDistributorDropdownItem? sd)
    {
        if (sd is null) return;
        SubDistributorId = sd.SubDistributorId;
        SelectedSubDistributorName = sd.SubdName;

        // Reset dependent fields
        CustomerId = 0;
        SelectedCustomerName = null;
        LineItems.Clear();
        tableKey++;
        await LoadDropdownsForSubdistributor(SubDistributorId, SalesInvoiceDate);
        await InvokeAsync(StateHasChanged);
    }

    private Task OnCustomerSelected(SalesInvoiceCustomerDropdownItem? c)
    {
        if (c is null) return Task.CompletedTask;
        CustomerId = c.CustomerId;
        SelectedCustomerName = $"{c.CustomerCode} – {c.CustomerName}";
        return Task.CompletedTask;
    }

    private void RecalcLine(LineItemModel line)
    {
        if (line.StockPrice is not decimal price || line.StockConvToBase <= 0 || line.ConversionToBase <= 0)
        {
            line.UnitPrice = 0;
            line.Amount = 0;
            return;
        }

        var unit = Math.Round(price * line.ConversionToBase / line.StockConvToBase, 2, MidpointRounding.AwayFromZero);
        var amount = Math.Round(Math.Abs(line.Quantity) * line.ConversionToBase * price / line.StockConvToBase,
                                2, MidpointRounding.AwayFromZero);

        line.UnitPrice = ApplySign(unit);
        line.Amount = ApplySign(amount);
    }

    private decimal ApplySign(decimal value)
    {
        var isCredit = string.Equals(OrderType, "Credit", StringComparison.OrdinalIgnoreCase);
        var abs = Math.Abs(value);
        return isCredit ? -abs : abs;
    }

    // ── Validation ────────────────────────────────────────────────────────────
    private bool Validate()
    {
        Errors = isEdit
            ? SalesInvoiceValidator.ValidateUpdate(new UpdateSalesInvoiceDto
            {
                SalesInvoiceId = SalesInvoiceId!.Value,
                SalesInvoiceCode = SalesInvoiceCode ?? "",
                SalesInvoiceDate = SalesInvoiceDate,
                CustomerId = CustomerId,
                SubDistributorId = SubDistributorId,
                OrderType = OrderType ?? "",
                Items = LineItems.Select(l => new UpdateSalesInvoiceItemDto
                {
                    SalesInvoiceItemId = l.SalesInvoiceItemId,
                    SubdItemId = l.SubdItemId,
                    ItemsUomId = l.SelectedUomId,
                    Quantity = l.Quantity,
                    Amount = l.Amount
                }).ToList()
            })
            : SalesInvoiceValidator.ValidateCreate(new CreateSalesInvoiceDto
            {
                SalesInvoiceCode = SalesInvoiceCode ?? "",
                SalesInvoiceDate = SalesInvoiceDate,
                CustomerId = CustomerId,
                SubDistributorId = SubDistributorId,
                OrderType = OrderType ?? "",
                Items = LineItems.Select(l => new CreateSalesInvoiceItemDto
                {
                    SubdItemId = l.SubdItemId,
                    ItemsUomId = l.SelectedUomId,
                    Quantity = l.Quantity,
                    Amount = l.Amount
                }).ToList()
            });

        return !Errors.Any();
    }

    // ── Submit (same two-step pattern as AddCustomer) ─────────────────────────
    private async Task Submit()
    {
        foreach (var l in LineItems) RecalcLine(l);

        ShowValidationErrors = true;
        var valid = Validate();
        var rowsOk = !LineItems.Any(l => GetRowError(l, true) is not null);
        if (!valid || !rowsOk) return;

        if (isEdit)
        {
            PendingUpdateDto = new UpdateSalesInvoiceDto
            {
                SalesInvoiceId = SalesInvoiceId!.Value,
                SalesInvoiceCode = SalesInvoiceCode!,
                SalesInvoiceDate = SalesInvoiceDate,
                CustomerId = CustomerId,
                SubDistributorId = SubDistributorId,
                OrderType = OrderType!,
                SalesMan = SalesMan,
                Items = LineItems.Select(l => new UpdateSalesInvoiceItemDto
                {
                    SalesInvoiceItemId = l.SalesInvoiceItemId,
                    SubdItemId = l.SubdItemId,
                    ItemsUomId = l.SelectedUomId,
                    Quantity = l.Quantity,
                    Amount = l.Amount
                }).ToList()
            };
        }
        else
        {
            PendingDto = new CreateSalesInvoiceDto
            {
                SalesInvoiceCode = SalesInvoiceCode!,
                SalesInvoiceDate = SalesInvoiceDate,
                CustomerId = CustomerId,
                SubDistributorId = SubDistributorId,
                OrderType = OrderType!,
                SalesMan = SalesMan,
                Items = LineItems.Select(l => new CreateSalesInvoiceItemDto
                {
                    SubdItemId = l.SubdItemId,
                    ItemsUomId = l.SelectedUomId,
                    Quantity = l.Quantity,
                    Amount = l.Amount
                }).ToList()
            };
        }

        await OnRequestConfirm.InvokeAsync();
    }

    // Called by the parent confirm modal (same as AddCustomer.SubmitAsync)
    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingUpdateDto is null) return (false, "No pending update data.");
                var result = await SalesInvoiceService.UpdateSalesInvoiceAsync(
                    PendingUpdateDto, CurrentUserId!.Value);
                if (!result.IsSuccess) return (false, result.ErrorMessage);
                return (true, null);
            }
            else
            {
                if (PendingDto is null) return (false, "No pending data.");
                var result = await SalesInvoiceService.CreateSalesInvoiceAsync(
                    PendingDto, CurrentUserId!.Value);

                if (!result.IsSuccess)
                {
                    // Surface duplicate code error inline
                    if (result.ErrorMessage?.Contains("already exists") == true)
                    {
                        Errors[SalesInvoiceValidator.Fields.InvoiceCode] = result.ErrorMessage;
                        ShowValidationErrors = true;
                        await InvokeAsync(StateHasChanged);
                    }
                    return (false, result.ErrorMessage);
                }
                return (true, null);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void EnableEdit() => isViewMode = false;

    private Task Cancel()
        => onCancel.HasDelegate ? onCancel.InvokeAsync() : Task.CompletedTask;

    private string GetFieldError(string key)
        => Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    private void OnOrderTypeChanged()
    {
        foreach (var line in LineItems) RecalcLine(line);
    }

    private static readonly string[] OrderTypeOptions = { "Invoice", "Credit" };

    private string GetInvoiceInfoSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(SelectedSubDistributorName)) parts.Add(SelectedSubDistributorName!);
        if (!string.IsNullOrWhiteSpace(SalesInvoiceCode)) parts.Add(SalesInvoiceCode!);
        parts.Add(SalesInvoiceDate.ToString("MMM d, yyyy"));
        if (!string.IsNullOrWhiteSpace(SelectedCustomerName)) parts.Add(SelectedCustomerName!);
        if (!string.IsNullOrWhiteSpace(OrderType)) parts.Add(OrderType!);
        if (!string.IsNullOrWhiteSpace(SalesMan)) parts.Add(SalesMan!);
        return parts.Count > 0 ? string.Join(" • ", parts) : "Subdistributor, code, date, customer, order type";
    }

    private string GetItemsSummary() =>
        LineItems.Count == 0 ? "No items yet" : $"{LineItems.Count} item(s) • {LineItems.Sum(l => l.Amount):N2}";

    private Task OnOrderTypeSelected(string? value)
    {
        if (isViewMode) return Task.CompletedTask;
        OrderType = value;
        OnOrderTypeChanged();
        return Task.CompletedTask;
    }

    // ── Line item helpers ─────────────────────────────────────────────────────
    private Task AddLine()
    {
        LineItems.Add(new LineItemModel());
        return Task.CompletedTask;
    }

    private void RemoveLine(LineItemModel line)
    {
        LineItems.Remove(line);
        tableKey++; // re-creates rows so autocompletes don't keep a removed row's text
    }

    private void ChangeQty(LineItemModel line, int delta)
    {
        line.Quantity = Math.Max(1, line.Quantity + delta);
        RecalcLine(line);
    }

    private void OnQtyChanged(LineItemModel line, ChangeEventArgs e)
    {
        line.Quantity = int.TryParse(e.Value?.ToString(), out var q) && q >= 1 ? q : 1;
        RecalcLine(line);
    }

    private Task OnRowItemSelected(LineItemModel line, SalesInvoiceSubdItemDropdownItem? item)
    {
        if (item is null)
        {
            line.SubdItemId = 0;
            line.ItemName = null;
            line.ItemSearchText = null;
            line.AvailableUoms = new();
            ApplyUom(line, null);
            line.UomName = null;
        }
        else
        {
            line.SubdItemId = item.SubdItemId;
            line.ItemName = item.ItemName;
            line.ItemSearchText = $"{item.SubdItemCode} - {item.ItemName}";
            line.AvailableUoms = item.Uoms;
            ApplyUom(line, item.Uoms.FirstOrDefault()); // default to the first UOM
        }
        RecalcLine(line);
        return Task.CompletedTask;
    }

    private Task OnRowUomSelected(LineItemModel line, SalesInvoiceUomOption? uom)
    {
        ApplyUom(line, uom);
        RecalcLine(line);
        return Task.CompletedTask;
    }

    private void ApplyUom(LineItemModel line, SalesInvoiceUomOption? uom)
    {
        if (uom is null)
        {
            line.SelectedUomId = 0;
            line.UomName = null;
            line.ConversionToBase = 0;
            line.StockConvToBase = 0;
            line.StockPrice = null;
            line.PriceIssue = null;
            return;
        }

        line.SelectedUomId = uom.ItemsUomId;
        line.UomName = uom.UomName;
        line.ConversionToBase = uom.ConversionToBase ?? 0;
        line.StockConvToBase = uom.StockConvToBase;
        line.StockPrice = uom.StockPrice;
        line.PriceIssue = uom.PriceIssue;
    }

    private string? GetLineError(int idx) =>
        idx >= 0 && idx < LineItems.Count ? GetRowError(LineItems[idx], ShowValidationErrors) : null;

    private string? GetRowError(LineItemModel l, bool force)
    {
        if (l.SubdItemId == 0) return force ? "Select an item." : null;
        if (l.SelectedUomId == 0) return force ? "Select a unit of measure." : null;
        if (l.PriceIssue is not null) return l.PriceIssue;
        if (l.Quantity < 1) return "Quantity must be at least 1.";
        return null;
    }

    private async Task OnInvoiceDateChanged()
    {
        if (SubDistributorId <= 0) return;

        SubdItems = await SalesInvoiceService.GetSubdItemsForDropdownAsync(SubDistributorId, SalesInvoiceDate);

        foreach (var line in LineItems.Where(l => l.SubdItemId > 0))
        {
            line.AvailableUoms = SubdItems.FirstOrDefault(s => s.SubdItemId == line.SubdItemId)?.Uoms ?? new();
            var uom = line.AvailableUoms.FirstOrDefault(u => u.ItemsUomId == line.SelectedUomId);

            if (uom is null)
            {
                line.StockPrice = null;
                line.PriceIssue = "This item or UOM is no longer active. Choose another UOM or remove the line.";
            }
            else
            {
                ApplyUom(line, uom);
            }

            RecalcLine(line);
        }

        tableKey++;
    }
}
