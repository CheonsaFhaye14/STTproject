@page "/admin/salesinvoice"
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@using STTproject.Features.Admin.SalesInvoice.Components.Modals
@using STTproject.Features.Admin.SalesInvoice.Components.Sections
@using STTproject.Shared.Components
@inject NavigationManager Nav
@inject STTproject.Features.Admin.SalesInvoice.Services.IAdminSalesInvoiceService SalesInvoiceService

<LoadingOverlay Show="isLoading"
                Title="Loading sales invoices…"
                Subtitle="Please wait while we fetch the latest data."
                IconClass="fa-solid fa-file-invoice" />

<div style="@(isLoading ? "display:none;" : "")">
    <div class="clt-page">

        <!-- Header -->
        <div class="clt-page-header">
            <div>
                <h1 class="clt-page-title">Sales Invoices</h1>
                <p class="clt-page-sub">@totalCount total sales invoices</p>
            </div>
            <div class="clt-page-actions">
                <Button Title="Import invoices"
                        OnClick="@(() => showImportModal = true)"
                        Icon="fa-solid fa-file-arrow-up"
                        Variant="ButtonVariant.Secondary" />
                <Button OnClick="OpenAddModal" Title="Add invoice"
                        Icon="fa-solid fa-plus"
                        Variant="ButtonVariant.Primary" />

                <!-- More actions: rarely used / destructive -->
                <div class="more-menu">
                    <Button Title="More"
                            Icon="fa-solid fa-ellipsis"
                            Variant="ButtonVariant.Secondary"
                            OnClick="ToggleMoreMenu" />
                    @if (showMoreMenu)
                    {
                        <div class="more-menu-backdrop" @onclick="CloseMoreMenu"></div>
                        <div class="more-menu-panel" role="menu">
                            <button type="button" class="more-menu-item" role="menuitem" @onclick="GoToDeleted">
                                <i class="fa-solid fa-trash-can-arrow-up"></i>
                                <span>Deleted invoices</span>
                            </button>
                            <hr class="more-menu-divider" />
                            <button type="button" class="more-menu-item more-menu-item--danger" role="menuitem" @onclick="OpenBatchDelete">
                                <i class="fa-solid fa-trash"></i>
                                <span>Batch delete</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- List table -->
        <SalesInvoiceTable @ref="invoiceTable" OnLoaded="OnTableLoaded" OnCountChanged="OnCountChanged"
                           OnViewInvoice="OpenEditModal" />

        <!-- Confirm create/update modal -->
        <ConfirmModal @ref="confirmModal" Show="showConfirmModal"
                      Title="@(editInvoiceId.HasValue ? "Confirm Update" : "Confirm Creation")"
                      Message="@(editInvoiceId.HasValue
                                                                                                                                                                                ? "Are you sure you want to save changes to this sales invoice?"
                                                                                                                                                                                : "Are you sure you want to create this sales invoice?")"
                      OnYes="ConfirmSave" OnNo="CancelConfirm" />

        <ImportSalesInvoice Show="showImportModal"
                            OnClose="@(() => showImportModal = false)"
                            OnImportCompleted="OnImportCompletedAsync" />

        <!-- Add / Edit modal -->
        @if (showAddModal)
        {
            <AddSalesInvoice @ref="addInvoiceModal" SalesInvoiceId="editInvoiceId" onCancel="CancelAddModal"
                             OnRequestConfirm="OpenConfirmModal" />
        }
        <BatchDelete Show="showBatchDelete"
                     SubDistributors="subDistributors"
                     AvailableYears="availableYears"
                     OnClose="() => showBatchDelete = false"
                     OnDeleted="OnImportCompletedAsync" />

    </div>
</div>

@code {
    private ConfirmModal? confirmModal;
    private SalesInvoiceTable? invoiceTable;
    private AddSalesInvoice? addInvoiceModal;

    private bool showConfirmModal = false;
    private bool showAddModal = false;
    private bool isLoading = true;
    private int totalCount = 0;
    private int? editInvoiceId;

    // ── Table events ──────────────────────────────────────────────────────────

    private async Task OnTableLoaded()
    {
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnCountChanged(int count) => totalCount = count;

    // ── More menu ─────────────────────────────────────────────────────────────

    private bool showMoreMenu = false;

    private void ToggleMoreMenu() => showMoreMenu = !showMoreMenu;
    private void CloseMoreMenu() => showMoreMenu = false;

    private void GoToDeleted()
    {
        showMoreMenu = false;
        Nav.NavigateTo("/admin/salesinvoice/deleted");
    }

    private void OpenBatchDelete()
    {
        showMoreMenu = false;
        showBatchDelete = true;
    }

    // ── Open / close ──────────────────────────────────────────────────────────

    private void OpenAddModal()
    {
        editInvoiceId = null; // new invoice
        showAddModal = true;
    }

    private void OpenEditModal(int id)
    {
        editInvoiceId = id;
        showAddModal = true;
    }

    private void OpenConfirmModal() => showConfirmModal = true;
    private void CancelConfirm() => showConfirmModal = false;
    private void CancelAddModal() => showAddModal = false;

    // ── Save ──────────────────────────────────────────────────────────────────

    private async Task ConfirmSave()
    {
        showConfirmModal = false;

        if (addInvoiceModal is null) return;

        var (success, _) = await addInvoiceModal.SubmitAsync();

        if (success)
        {
            showAddModal = false;
            if (invoiceTable is not null)
                await invoiceTable.LoadPageAsync();
        }
    }
    private bool showImportModal = false;

    private async Task OnImportCompletedAsync()
    {
        await LoadBatchDeleteOptionsAsync();
        if (invoiceTable is not null)
            await invoiceTable.LoadPageAsync();
    }

    private bool showBatchDelete = false;
    private List<(int Id, string? Name)> subDistributors = new();
    private List<int> availableYears = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBatchDeleteOptionsAsync();
    }

    private async Task LoadBatchDeleteOptionsAsync()
    {
        var subdTask = SalesInvoiceService.GetSubDistributorsAsync();
        var datesTask = SalesInvoiceService.GetAvailableInvoiceMonthsAsync();
        await Task.WhenAll(subdTask, datesTask);

        subDistributors = subdTask.Result
            .Select(sd => (sd.SubDistributorId, (string?)sd.SubdName)).ToList();

        availableYears = datesTask.Result
            .Select(d => d.Year).Distinct().OrderByDescending(y => y).ToList();
    }
}