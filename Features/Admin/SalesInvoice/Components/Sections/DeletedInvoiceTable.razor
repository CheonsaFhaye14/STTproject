@using STTproject.Features.Admin.SalesInvoice.DTOs
@using STTproject.Shared.Components
@using STTproject.Features.Admin.SalesInvoice.Components.Modals
@inject STTproject.Features.Admin.SalesInvoice.Services.IAdminSalesInvoiceService SalesInvoiceService
@inject STTproject.Services.IUserContextService UserContextService
<link rel="stylesheet" href="css/Table.css" asp-append-version="true" />

<div class="clt-page">
    <div class="clt-layout">

        <aside class="clt-sidebar">
            <div class="clt-sidebar-stats">
                <div class="clt-stat">
                    <span class="clt-stat-label">Total</span>
                    <span class="clt-stat-value">@totalCount</span>
                </div>
            </div>
            <div class="clt-divider"></div>

            @* Search *@
            <div class="clt-filter-group">
                <Input TValue="string" Label="Search"
                    Placeholder="Search..."
                    Value="@SearchTerm" ValueChanged="OnSearchChanged" />
            </div>

            @* Filter group *@
            <div class="clt-filter-group">
                <label class="clt-filter-label">Status</label>
                <div class="clt-radio-group">
                    <label class="clt-radio-option @(SelectedStatus == "" ? "selected" : "")">
                        <input type="radio" name="status" value=""
                            @onchange="() => OnFilterChanged(status: string.Empty)"
                            checked="@(SelectedStatus == "")" />
                        <span>All</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "deleted" ? "selected" : "")">
                        <input type="radio" name="status" value="deleted"
                            @onchange='() => OnFilterChanged(status: "deleted")'
                            checked="@(SelectedStatus == "deleted")" />
                        <span>Deleted</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "restored" ? "selected" : "")">
                        <input type="radio" name="status" value="restored"
                            @onchange='() => OnFilterChanged(status: "restored")'
                            checked="@(SelectedStatus == "restored")" />
                        <span>Restored</span>
                    </label>
                </div>
            </div>


            <div class="clt-filter-group">
                <AutoComplete @key="@($"subd-{filterResetKey}")"
                            Label="Subdistributor"
                            TItem="SalesInvoiceSubDistributorDropdownItem"
                            Items="SubDistributors"
                            ValueSelector="x => x.SubDistributorId.ToString()"
                            TextSelector="x => x.SubdName ?? string.Empty"
                            Placeholder="All subdistributors"
                            SelectedValue="@(subdFilter?.ToString())"
                            SelectedItemChanged="OnSubdSelected" />
            </div>

            <div class="clt-filter-group">
                <Select @key="@($"month-{filterResetKey}")"
                        Label="Sales Invoice Month"
                        Placeholder="All months"
                        TItem="FilterOption"
                        Items="MonthOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@(SelectedMonth?.ToString() ?? "")"
                        SelectedValueChanged="OnMonthSelected" />
            </div>

            <div class="clt-filter-group">
                <Select @key="@($"year-{filterResetKey}")"
                        Label="Sales Invoice Year"
                        Placeholder="All years"
                        TItem="FilterOption"
                        Items="YearOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@(SelectedYear?.ToString() ?? "")"
                        SelectedValueChanged="OnYearSelected" />
            </div>

            @if (HasActiveFilters)
            {
                <button class="clt-clear-btn" @onclick="ClearFilters">Clear all filters</button>
            }
        </aside>

        <main class="clt-main">
            @if (!string.IsNullOrEmpty(message))
            {
                <p class="@(messageIsError ? "" : "clt-muted")" style="@(messageIsError ? "color:#b91c1c" : "")">@message</p>
            }

            <div class="clt-table-card">
                <div class="clt-table-scroll">
                    <table class="clt-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SortBy("Type")' style="cursor:pointer">Type @SortIndicator("Type")</th>
                                <th @onclick='() => SortBy("Subdistributor")' style="cursor:pointer">Subdistributor @SortIndicator("Subdistributor")</th>
                                <th @onclick='() => SortBy("Period")' style="cursor:pointer">Period @SortIndicator("Period")</th>
                                <th @onclick='() => SortBy("Invoices")' style="cursor:pointer">Invoices @SortIndicator("Invoices")</th>
                                <th @onclick='() => SortBy("DeletedBy")' style="cursor:pointer">Deleted By @SortIndicator("DeletedBy")</th>
                                <th @onclick='() => SortBy("DeletedDate")' style="cursor:pointer">Deleted Date @SortIndicator("DeletedDate")</th>
                                <th @onclick='() => SortBy("Status")' style="cursor:pointer">Status @SortIndicator("Status")</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="9" class="clt-empty"><div class="clt-empty-inner"><p>Loading…</p></div></td></tr>
                            }
                            else if (!Batches.Any())
                            {
                                <tr>
                                    <td colspan="9" class="clt-empty">
                                        <div class="clt-empty-inner">
                                            <p>@(HasActiveFilters ? "No deleted batches match your filters" : "No deleted invoices")</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var b in Batches)
                                {
                                    <tr>
                                        <td><span class="clt-type-badge">@b.DeletionType</span></td>
                                        <td class="clt-name">@b.SubdName</td>
                                        <td class="clt-muted">@b.Period</td>
                                        <td>@b.InvoiceCount.ToString("N0")</td>
                                        <td class="clt-muted">@(b.DeletedByName ?? "—")</td>
                                        <td class="clt-muted">@b.DeletedDate.ToLocalTime().ToString("MMM d, yyyy hh:mm tt")</td>
                                        <td>
                                            <span class="clt-type-badge">@b.Status</span>
                                            @if (b.RestoredDate.HasValue)
                                            {
                                                <div class="clt-muted">
                                                    @(b.RestoredByName ?? "—"), @b.RestoredDate.Value.ToLocalTime().ToString("MMM d, yyyy")
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="clt-actions">
                                                <button class="clt-btn-edit" @onclick="() => viewBatch = b">View</button>
                                                @if (b.Status == "Deleted")
                                                {
                                                    <button class="clt-btn-edit" disabled="@isRestoring"
                                                            @onclick="() => AskRestore(b)">
                                                        Restore
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="clt-footer">
                <span class="clt-footer-count">Showing @Batches.Count of @totalCount batches</span>
                @if (totalPages > 1)
                {
                    <div class="clt-pagination">
                        <button class="clt-page-btn" disabled="@(currentPage == 1)"
                                @onclick="() => GoToPage(currentPage - 1)">←</button>
                        <span>Page @currentPage of @totalPages</span>
                        <button class="clt-page-btn" disabled="@(currentPage >= totalPages)"
                                @onclick="() => GoToPage(currentPage + 1)">→</button>
                    </div>
                }
            </div>
        </main>
    </div>

    <ConfirmModal Show="showRestoreConfirm" Title="Confirm Restore"
                  Message="@restoreMessage" OnYes="ConfirmRestore" OnNo="() => showRestoreConfirm = false" />

    @if (viewBatch is not null)
    {
        <DeletedBatchModal @key="viewBatch.DeletionBatchId"
                        Batch="viewBatch"
                        OnClose="() => viewBatch = null"
                        OnRestore="RestoreFromModal" />
    }
</div>

@code {
    [Parameter] public EventCallback OnLoaded { get; set; }
    [Parameter] public EventCallback OnRestored { get; set; }

    private List<DeletedBatchRow> Batches { get; set; } = new();
    private List<SalesInvoiceSubDistributorDropdownItem> SubDistributors { get; set; } = new();    private DeletedBatchRow? viewBatch;
    private string SelectedStatus { get; set; } = "";
    private int filterResetKey;
    private string typeFilter = "";
    private int? subdFilter;
    private int? SelectedMonth { get; set; }
    private int? SelectedYear { get; set; }
    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    currentPage = 1;
                    await LoadPageAsync();
                });
            }, null, 400, Timeout.Infinite);
        }
    }
    private List<(int Year, int Month)> AvailableDates { get; set; } = new();
    private System.Threading.Timer? _debounceTimer;
    private string SortColumn { get; set; } = "DeletedDate";
    private bool SortAscending { get; set; } = true;
    private void OnSearchChanged(string? value) => SearchTerm = value ?? string.Empty;
    private int currentPage = 1;
    private const int pageSize = 50;
    private int totalCount;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);
    private async Task OnDateChanged(string? month = null, string? year = null)
    {
        if (month != null)
            SelectedMonth = int.TryParse(month, out var m) && m > 0 ? m : null;

        if (year != null)
        {
            SelectedYear = int.TryParse(year, out var y) && y > 0 ? y : null;

            if (SelectedMonth.HasValue && !AvailableMonths.Contains(SelectedMonth.Value))
                SelectedMonth = null;
        }

        currentPage = 1;
        await LoadPageAsync();
    }
    private List<int> AvailableMonths =>
    (SelectedYear.HasValue
        ? AvailableDates.Where(d => d.Year == SelectedYear.Value)
        : AvailableDates)
    .Select(d => d.Month).Distinct().OrderBy(m => m).ToList();

    private bool isLoading = true;
    private bool isRestoring;

    private bool showRestoreConfirm;
    private DeletedBatchRow? pendingRestore;
    private string restoreMessage = "";

    private string? message;
    private bool messageIsError;

    private int? CurrentUserId => UserContextService.UserId;

    private bool HasActiveFilters =>
       !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrEmpty(SelectedStatus) || !string.IsNullOrEmpty(typeFilter) || subdFilter.HasValue || SelectedMonth.HasValue ||
            SelectedYear.HasValue;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SubDistributors = await SalesInvoiceService.GetSubDistributorsAsync();
            AvailableDates = await SalesInvoiceService.GetDeletedInvoiceMonthsAsync();
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing deleted invoices: {ex.Message}");
            isLoading = false;
        }
    }
    
    public async Task LoadPageAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (items, total) = await SalesInvoiceService.GetDeletedBatchesPagedAsync(
                currentPage, pageSize, typeFilter, SelectedStatus, subdFilter,
                SelectedMonth, SelectedYear, _searchTerm, SortColumn, SortAscending);
            Batches = items;
            totalCount = total;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading deleted batches: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            if (OnLoaded.HasDelegate) await OnLoaded.InvokeAsync();
        }
    }
    private record FilterOption(string Value, string Text);

    private List<FilterOption> MonthOptions =>
        AvailableMonths
            .Select(m => new FilterOption(m.ToString(), new DateTime(2000, m, 1).ToString("MMMM")))
            .ToList();

    private List<FilterOption> YearOptions =>
        AvailableYears
            .Select(y => new FilterOption(y.ToString(), y.ToString()))
            .ToList();
    private async Task OnFilterChanged(string? status = null, string? type = null)
    {
        if (status != null) SelectedStatus = status;
        if (type != null) typeFilter = type;

        currentPage = 1;
        await LoadPageAsync();
    }
    private async Task OnMonthSelected(string? value)
    {
        SelectedMonth = int.TryParse(value, out var m) && m > 0 ? m : null;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnYearSelected(string? value)
    {
        SelectedYear = int.TryParse(value, out var y) && y > 0 ? y : null;

        // drop the month if it doesn't exist in the chosen year
        if (SelectedMonth.HasValue && !AvailableMonths.Contains(SelectedMonth.Value))
            SelectedMonth = null;

        currentPage = 1;
        await LoadPageAsync();
    }
    private async Task ClearFilters()
    {
        _debounceTimer?.Dispose();
        _searchTerm = "";
        SelectedStatus = typeFilter = "";
        subdFilter = null;
        SelectedMonth = null;
        SelectedYear = null;
        SortColumn = "DeletedDate";
        SortAscending = true;
        currentPage = 1;
        filterResetKey++;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPageAsync();
    }

    private void RestoreFromModal(DeletedBatchRow b)
    {
        viewBatch = null;   
        AskRestore(b);
    }

    private void AskRestore(DeletedBatchRow b)
    {
        pendingRestore = b;
        restoreMessage = $"Restore batch #{b.DeletionBatchId} ({b.InvoiceCount:N0} sales invoice(s))? " +
                         "They will be added back to the sales invoice list.";
        showRestoreConfirm = true;
    }
    private async Task OnSubdSelected(SalesInvoiceSubDistributorDropdownItem? sd)
    {
        int? newValue = sd is { SubDistributorId: > 0 } ? sd.SubDistributorId : null;
        if (newValue == subdFilter) return;  
        subdFilter = newValue;
        currentPage = 1;
        await LoadPageAsync();
    }
    private async Task ConfirmRestore()
    {
        showRestoreConfirm = false;
        if (pendingRestore is null) return;

        if (CurrentUserId is not int userId)
        {
            message = "Could not determine the current user.";
            messageIsError = true;
            return;
        }

        isRestoring = true;
        try
        {
            var result = await SalesInvoiceService.RestoreBatchAsync(pendingRestore.DeletionBatchId, userId);

            messageIsError = !result.IsRestored;
            message = result.IsRestored
                ? $"Restored {result.RestoredCount:N0} sales invoice(s) from batch #{pendingRestore.DeletionBatchId}."
                : result.ErrorMessage;

            if (result.IsRestored)
            {
                await LoadPageAsync();
                if (OnRestored.HasDelegate) await OnRestored.InvokeAsync();
            }
        }
        finally
        {
            isRestoring = false;
            pendingRestore = null;
        }
    }
    private async Task SortBy(string column)
    {
        if (SortColumn == column)
            SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }
    private List<int> AvailableYears =>
        AvailableDates.Select(d => d.Year).Distinct().OrderByDescending(y => y).ToList();

    private string SortIndicator(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortAscending ? " ▲" : " ▼";
    }
}