@foreach (var c in Columns)
{
    var testing = _testing.Contains(c.RowKey);
    <div class="col-card" @key="c.RowKey">

        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <Input TValue="string" Label="Header in the file" Placeholder="Invoice No." @bind-Value="c.HeaderText" />
            </div>
            <div class="col-md-5">
                <AutoComplete TItem="FieldOption" Label="System field" Placeholder="Choose a field…"
                            Items="_fields" ValueSelector="f => f.Key" TextSelector="f => f.Display"
                            SelectedValue="@c.FieldKey" SelectedValueChanged="v => OnFieldChanged(c, v)" />
            </div>
            <div class="col-md-2 d-flex justify-content-end align-items-center gap-2">
                @if (!string.IsNullOrEmpty(c.FieldKey))
                {
                    <Button Variant="ButtonVariant.IconAction" Icon="fa-solid fa-flask" Tooltip="Test this column"
                            OnClick="() => ToggleTest(c)" Active="@testing" />
                }
                <Button Variant="ButtonVariant.IconActionDelete" Icon="fa-solid fa-trash"
                        Tooltip="Remove this column" OnClick="() => RemoveColumn(c)" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(c.FieldKey))
        {
            @if (Choices(c) is { } choices)
            {
                <div class="it-strip mt-2">
                    <label class="form-label">What the file says → what it means</label>
                    @{ var map = GetMap(c); }
                    @for (var i = 0; i < map.Count; i++)
                    {
                        var idx = i;
                        <div class="row g-2 align-items-end mb-1" @key="idx">
                            <div class="col-md-5">
                                <input value="@map[idx].From" placeholder="Free" @onchange="e => SetFrom(c, idx, e.Value?.ToString())" />
                            </div>
                            <div class="col-auto pb-2">→</div>
                            <div class="col-md-4">
                                <Select TItem="RuleOption" Placeholder="Choose…" Items="ChoiceOptions(choices)"
                                        ValueSelector="r => r.Value" TextSelector="r => r.Text"
                                        SelectedValue="@map[idx].To" SelectedValueChanged="v => SetTo(c, idx, v)" />
                            </div>
                            <div class="col-auto">
                                <Button Variant="ButtonVariant.IconActionDelete" Icon="fa-solid fa-trash"
                                        Tooltip="Remove" OnClick="() => RemoveMapRow(c, idx)" />
                            </div>
                        </div>
                    }
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-5 pb-2"><em>Anything else</em></div>
                        <div class="col-auto pb-2">→</div>
                        <div class="col-md-4">
                            <Select TItem="RuleOption" Placeholder="Choose…" Items="ChoiceOptions(choices)"
                                    ValueSelector="r => r.Value" TextSelector="r => r.Text"
                                    SelectedValue="@Otherwise(c)" SelectedValueChanged="v => SetOtherwise(c, v)" />
                        </div>
                    </div>
                    <Button Variant="ButtonVariant.Secondary" Title="+ Add value" OnClick="() => AddMapRow(c)" />
                    <div class="form-text">@ImportFieldRegistry.GetField(ImportType, c.FieldKey)?.Note</div>
                </div>
            }
            else
            {
                <div class="row g-2 mt-1">
                    <div class="col-md-6">
                        @if (IsDate(c))
                        {
                            <Select TItem="RuleOption" Label="Date format in the file" Placeholder="Detect automatically"
                                    Items="DateFormats" ValueSelector="r => r.Value" TextSelector="r => r.Text"
                                    SelectedValue="@(c.OptionsJson ?? string.Empty)"
                                    SelectedValueChanged="v => OnDateFormatChanged(c, v)" />
                        }
                        else
                        {
                            <Select TItem="RuleOption" Label="How to read it" Placeholder="Use as is"
                                    Items="RuleOptions" ValueSelector="r => r.Value" TextSelector="r => r.Text"
                                    SelectedValue="@RuleValue(c)" SelectedValueChanged="v => OnRuleChanged(c, v)" />
                        }
                    </div>
                </div>

                @if (c.RuleType == ColumnRuleTypes.Regex)
                {
                    <div class="row g-2 mt-1">
                        <div class="col-md-12">
                            <Input TValue="string" Label="Pattern" Placeholder="Put the part to keep in ( ), e.g. ^(\w+)-"
                                   @bind-Value="c.OptionsJson" />
                        </div>
                    </div>
                }
            }

            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="req-@c.RowKey" @bind="c.IsRequired" />
                <label class="form-check-label" for="req-@c.RowKey">Required</label>
            </div>

            @if (testing)
            {
                <div class="it-strip mt-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <Input TValue="string" Label="Example from the file" Placeholder="00123 - ABC STORE"
                                   Value="@GetSample(c)" ValueChanged="v => _samples[c.RowKey] = v ?? string.Empty" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Result</label>
                            @if (string.IsNullOrWhiteSpace(GetSample(c)))
                            {
                                <div class="result-box text-muted">Type an example to see the result</div>
                            }
                            else
                            {
                                <div class="result-box">@PreviewText(c)</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

<Button Variant="ButtonVariant.Secondary" Title="+ Add column" OnClick="AddColumn" />

@code {
    [Parameter, EditorRequired] public string ImportType { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<ImportTemplateColumnEditDto> Columns { get; set; } = new();

    [Parameter] public EventCallback OnChanged { get; set; }

    private sealed record FieldOption(string Key, string Display);
    private sealed record RuleOption(string Value, string Text);

    private static readonly List<RuleOption> RuleOptions = new()
    {
        new("Trim", "Remove extra spaces"),
        new("StripLeadingCode", "Remove the code at the start (00123 - ABC → ABC)"),
        new("StripParenthetical", "Remove text in (parentheses)"),
        new("ExtractBracketed", "Keep only the text in [brackets]"),
        new("StripMarkers", "Remove * at the start and - at the end (*ABC STORE - → ABC STORE)"), 
        new(ColumnRuleTypes.Regex, "Custom pattern (advanced)")
    };

    private static readonly List<RuleOption> DateFormats = new()
    {
        new("dd-MMM-yy", "05-Jan-26"),
        new("d-MMM-yyyy", "5-Jan-2026"),
        new("dd/MM/yyyy", "05/01/2026  (day first)"),
        new("MM/dd/yyyy", "01/05/2026  (month first)"),
        new("yyyy-MM-dd", "2026-01-05")
    };

    private List<FieldOption> _fields = new();
    private readonly Dictionary<Guid, string> _samples = new();

    protected override void OnParametersSet()
    {
        _fields = ImportFieldRegistry.Get(ImportType)?.Fields
                      .Select(f => new FieldOption(f.Key, f.Display)).ToList()
                  ?? new List<FieldOption>();
    }
    private readonly HashSet<Guid> _testing = new();

    private void ToggleTest(ImportTemplateColumnEditDto c)
    {
        if (!_testing.Remove(c.RowKey)) _testing.Add(c.RowKey);
    }
    private ImportFieldType TypeOf(string? key) =>
        ImportFieldRegistry.GetField(ImportType, key)?.Type ?? ImportFieldType.Text;

    private bool IsDate(ImportTemplateColumnEditDto c) => TypeOf(c.FieldKey) == ImportFieldType.Date;

    private IReadOnlyList<string>? Choices(ImportTemplateColumnEditDto c) =>
        ImportFieldRegistry.GetField(ImportType, c.FieldKey)?.Choices;

    private async Task OnFieldChanged(ImportTemplateColumnEditDto c, string? value)
    {
        var oldType = TypeOf(c.FieldKey);
        c.FieldKey = string.IsNullOrWhiteSpace(value) ? null : value;

        var hasChoices = Choices(c) is not null;
        if (oldType != TypeOf(c.FieldKey) || hasChoices || c.RuleType == ColumnRuleTypes.ValueMap)
        {
            c.RuleType = hasChoices ? ColumnRuleTypes.ValueMap : ColumnRuleTypes.Direct;
            c.OptionsJson = null;
        }
        await NotifyChanged();
    }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private static string RuleValue(ImportTemplateColumnEditDto c) =>
        c.RuleType == ColumnRuleTypes.Direct ? string.Empty : c.RuleType;

    private static void OnRuleChanged(ImportTemplateColumnEditDto c, string? value)
    {
        c.RuleType = string.IsNullOrEmpty(value) ? ColumnRuleTypes.Direct : value;
        if (c.RuleType != ColumnRuleTypes.Regex) c.OptionsJson = null;
    }

    private static void OnDateFormatChanged(ImportTemplateColumnEditDto c, string? value)
    {
        c.RuleType = ColumnRuleTypes.Direct;
        c.OptionsJson = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static List<RuleOption> ChoiceOptions(IReadOnlyList<string> choices) =>
        choices.Select(x => new RuleOption(x, x)).ToList();

    private static void SaveMap(ImportTemplateColumnEditDto c, List<ValueMapEntry> list)
    {
        c.RuleType = ColumnRuleTypes.ValueMap;
        c.OptionsJson = System.Text.Json.JsonSerializer.Serialize(list);
    }

    private static void SetFrom(ImportTemplateColumnEditDto c, int i, string? v)
    { var l = GetMap(c); l[i].From = v?.Trim() ?? ""; SaveMap(c, l); }

    private static void SetTo(ImportTemplateColumnEditDto c, int i, string? v)
    { var l = GetMap(c); l[i].To = v ?? ""; SaveMap(c, l); }

    private static void AddMapRow(ImportTemplateColumnEditDto c)
    { var l = GetMap(c); l.Add(new ValueMapEntry()); SaveMap(c, l); }

    private static void RemoveMapRow(ImportTemplateColumnEditDto c, int i)
    { var l = GetMap(c); l.RemoveAt(i); SaveMap(c, l); }

    private string PreviewText(ImportTemplateColumnEditDto c) =>
        IsDate(c)
            ? ImportRulePreview.ApplyDate(GetSample(c), c.OptionsJson)
            : ImportRulePreview.Apply(GetSample(c), c.RuleType, c.OptionsJson);

    private string GetSample(ImportTemplateColumnEditDto c) =>
        _samples.TryGetValue(c.RowKey, out var s) ? s : string.Empty;

    private async Task AddColumn()
    {
        Columns.Add(new ImportTemplateColumnEditDto());
        await NotifyChanged();
    }

    private async Task RemoveColumn(ImportTemplateColumnEditDto c)
    {
        Columns.Remove(c);
        await NotifyChanged();
    }
    private const string Else = "*";

    // the editable rows (without the "anything else" entry)
    private static List<ValueMapEntry> GetMap(ImportTemplateColumnEditDto c)
    {
        var list = ValueMapOptions.Parse(c.OptionsJson).Where(e => e.From != Else).ToList();
        if (list.Count == 0) list.Add(new ValueMapEntry());
        return list;
    }

    private static string Otherwise(ImportTemplateColumnEditDto c) =>
        ValueMapOptions.Parse(c.OptionsJson).FirstOrDefault(e => e.From == Else)?.To ?? "";

    private static void SaveMap(ImportTemplateColumnEditDto c, List<ValueMapEntry> rows, string? otherwise = null)
    {
        var other = otherwise ?? Otherwise(c);
        var all = rows.ToList();
        if (!string.IsNullOrEmpty(other)) all.Add(new ValueMapEntry { From = Else, To = other });
        c.RuleType = ColumnRuleTypes.ValueMap;
        c.OptionsJson = System.Text.Json.JsonSerializer.Serialize(all);
    }

    private static void SetOtherwise(ImportTemplateColumnEditDto c, string? v) =>
        SaveMap(c, GetMap(c), v ?? "");
}