<FormSection Icon="ti ti-file-description" Title="Template information" Summary="@Summary">
    @* Row 1: name and import type side by side *@
    <div class="row">
        <div class="col-md-6">
            <div class="it-field">
                <Input TValue="string" Label="Template name" Placeholder="Ex: Sales Invoice - Starwide"
                       AddOptionalText="true" Value="Model.TemplateName" ValueChanged="OnTemplateNameChanged" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="it-field it-locked-wrap">
                <Select Label="Import type" Items="ImportFieldRegistry.All" ValueSelector="d => d.Type"
                        TextSelector="d => d.Display" SelectedValue="@Model.ImportType"
                        SelectedValueChanged="ImportTypeChanged" Disabled="@(!IsNew)" />
                @if (!IsNew)
                {
                    <i class="fa-solid fa-lock it-locked-icon"
                       title="The import type can't be changed after the template is created"></i>
                }
            </div>
        </div>
    </div>

    @* Row 2: who it applies to, and options *@
    <div class="row">
        <div class="col-md-6">
            <div class="it-field">
                <label>Applies to</label>
                <div class="it-seg">
                    <button type="button" class="it-seg-btn @(IsGlobal ? "active" : "")"
                            @onclick="() => OnScopeToggled(true)">Global default</button>
                    <button type="button" class="it-seg-btn @(!IsGlobal ? "active" : "")"
                            @onclick="() => OnScopeToggled(false)">
                        @(Scope == ImportScope.Principal ? "Specific principal" : "Specific subdistributor")
                    </button>
                </div>

                @if (!IsGlobal)
                {
                    @if (Scope == ImportScope.Principal)
                    {
                        <AutoComplete TItem="string" Placeholder="Search for a principal…" Items="Principals"
                                      ShowAllOnOpen="true" SelectedValue="@Model.Principal" SelectedValueChanged="OnPrincipalChanged" />
                    }
                    else
                    {
                        <AutoComplete TItem="SubDistributorOptionDto" Placeholder="Search for a subdistributor…" Items="Subds"
                                      ShowAllOnOpen="true" ValueSelector="s => s.SubDistributorId.ToString()"
                                      TextSelector="s => s.Display" SelectedValue="@Model.SubDistributorId?.ToString()"
                                      SelectedValueChanged="OnSubdChanged" />
                    }
                }
                else
                {
                    <div class="form-text">
                        Used for @(Scope == ImportScope.Principal ? "every principal" : "every subdistributor")
                        that doesn't have its own template.
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="it-field">
                <label>Options</label>
                <label class="it-option">
                    <span>Active</span>
                    <input type="checkbox" @bind="Model.IsActive" />
                </label>

                @if (!IsNew)
                {
                    <div class="text-muted small mt-1">Version @Model.Version</div>
                }
            </div>
        </div>
    </div>
</FormSection>

<style>
    .it-locked-wrap {
        position: relative;
    }

    .it-locked-icon {
        position: absolute;
        right: 16px;
        bottom: 14px;
        color: #8a8f98;
        pointer-events: none;
    }

    .it-active-switch {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-left: 0;
        min-height: 2.5rem;
    }

    .it-active-switch .form-check-input {
        margin-left: 0;
        width: 2.75rem;
        height: 1.5rem;
        cursor: pointer;
    }

    .it-active-switch .form-check-label {
        cursor: pointer;
    }
</style>

@code {
    [Parameter, EditorRequired] public ImportTemplateEditDto Model { get; set; } = default!;
    [Parameter] public List<SubDistributorOptionDto> Subds { get; set; } = new();
    [Parameter] public List<string> Principals { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    /// <summary>True = global default. Owned by the page; use @bind-IsGlobal.</summary>
    [Parameter] public bool IsGlobal { get; set; } = true;
    [Parameter] public EventCallback<bool> IsGlobalChanged { get; set; }

    /// <summary>Raised when something the other section depends on changes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private ImportScope? Scope => ImportFieldRegistry.Get(Model.ImportType)?.Scope;

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private string Summary
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(Model.TemplateName) ? "Untitled" : Model.TemplateName;
            var who = IsGlobal ? "Global default"
                : Scope == ImportScope.Principal ? (Model.Principal ?? "No principal")
                : (Subds.FirstOrDefault(s => s.SubDistributorId == Model.SubDistributorId)?.Display ?? "No subdistributor");
            return $"{name} · {who}";
        }
    }

    private void OnTemplateNameChanged(string? value) =>
        Model.TemplateName = value ?? string.Empty;

    private async Task OnScopeToggled(bool isGlobal)
    {
        // Going back to global drops whoever was selected.
        if (isGlobal)
        {
            Model.SubDistributorId = null;
            Model.Principal = null;
        }
        await IsGlobalChanged.InvokeAsync(isGlobal);
    }

    // AutoComplete sends null when the user edits the text after picking.
    private void OnSubdChanged(string? value) =>
        Model.SubDistributorId = int.TryParse(value, out var id) ? id : (int?)null;

    private void OnPrincipalChanged(string? value) =>
        Model.Principal = string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task ImportTypeChanged(string? value)
    {
        Model.ImportType = string.IsNullOrEmpty(value) ? Model.ImportType : value;
        Model.SubDistributorId = null;
        Model.Principal = null;

        // Rows that pointed at a field the new type doesn't have go back to "choose a field".
        foreach (var c in Model.Sheets.SelectMany(s => s.Columns)
                     .Where(c => !ImportFieldRegistry.IsValidField(Model.ImportType, c.FieldKey)))
        {
            c.FieldKey = null;
            c.RuleType = ColumnRuleTypes.Direct;
            c.OptionsJson = null;
        }

        await IsGlobalChanged.InvokeAsync(true);
    }
}