<FormSection Icon="ti ti-table" Title="Sheets and columns" Summary="@Summary">

    @if (Missing.Count > 0)
    {
        <div class="it-missing">
            <span class="it-hint">Still to map on this sheet:</span>
            @foreach (var m in Missing)
            {
                <span class="it-chip">@ChipText(m)</span>
            }
        </div>
    }

    @if (HasProblemSheets)
    {
        <div class="alert alert-warning py-2 small">@ProblemSheetsText()</div>
    }

    <div class="it-tabs">
        @for (var i = 0; i < Model.Sheets.Count; i++)
        {
            var idx = i;
            var tab = Model.Sheets[idx];
            <button type="button" @key="tab.RowKey" class="it-tab @(idx == _active ? "active" : "")"
                    @onclick="() => SelectSheet(idx)">
                @(string.IsNullOrWhiteSpace(tab.SheetLabel) ? $"Sheet {idx + 1}" : tab.SheetLabel)
                @if (tab.SheetMatchMode == SheetMatchModes.Ignore)
                {
                    <span class="badge bg-secondary ms-1">ignored</span>
                }
                @if (tab.SheetMatchMode != SheetMatchModes.Ignore && !tab.IsRequired)
                {
                    <span class="badge bg-light text-dark border ms-1">optional</span>
                }
                @if (ReadsProblemSheet(tab))
                {
                    <span class="badge bg-warning text-dark ms-1" title="This tab reads a sheet that still has rows to fix">fix here</span>
                }
                @if (SheetGaps(tab) > 0)
                {
                    <span class="it-dot" title="@SheetGaps(tab) required field(s) still to map on this sheet"></span>
                }
            </button>
        }
        <button type="button" class="it-tab it-tab-add" @onclick="AddSheet">+ Add sheet</button>
       
        @if (Model.Sheets.Count > 1)
        {
            <div class="it-tabs-end">
                <Button Variant="ButtonVariant.IconActionDelete" Icon="fa-solid fa-trash" Tooltip="Remove this sheet"
                        OnClick="AskRemove" />
            </div>
        }

    </div>

    @if (Model.Sheets.Count > 0)
    {
        var s = Model.Sheets[_active];
        var fresh = IsFresh(s);
        var ignored = s.SheetMatchMode == SheetMatchModes.Ignore;

        <div @key="s.RowKey">

            @if (fresh && !ignored)
            {
                <div class="it-steps">
                    <span class="it-step-n @(_showSettings ? "on" : "")">1</span>
                    <span class="@(_showSettings ? "it-step-on" : "")">Sheet details</span>
                    <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    <span class="it-step-n @(_showSettings ? "" : "on")">2</span>
                    <span class="@(_showSettings ? "" : "it-step-on")">Columns</span>
                </div>
            }

            @if (_showSettings)
            {
                <div class="it-setup">
                    <div class="it-groups">
                        <div class="it-group">
                            <div class="it-group-title">Find the sheet</div>

                            <div class="it-field">
                                <Input TValue="string" Label="Sheet label" Placeholder="e.g. Sales" AddOptionalText="true"
                                       @bind-Value="s.SheetLabel"
                                       OptionalText="(Your own name for this sheet. It doesn't have to match Excel.)" />
                            </div>

                            <div class="it-row">
                                <div class="it-field">
                                    <Select TItem="string" Label="How to find it in the file" ShowPlaceholder="false"
                                            Items="SheetMatchModes.All" ValueSelector="m => m" TextSelector="m => MatchModeLabel(m)"
                                            SelectedValue="@s.SheetMatchMode" SelectedValueChanged="v => MatchModeChanged(s, v)"
                                            AddOptionalText="@(!NeedsMatchValue(s))" OptionalText="@Hint(MatchModeHelp(s))" />
                                </div>

                                @if (NeedsMatchValue(s))
                                {
                                    <div class="it-field">
                                        <Input TValue="string" Label="@MatchValueLabel(s)" Placeholder="@MatchValuePlaceholder(s)"
                                               @bind-Value="s.SheetMatchValue" />
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!ignored)
                        {
                            <div class="it-group">
                                <div class="it-group-title">Read the sheet</div>

                                <div class="it-field">
                                    <Select TItem="string" Label="If this sheet is missing from the file" ShowPlaceholder="false"
                                            Items="NeedOptions" ValueSelector="m => m" TextSelector="m => m"
                                            SelectedValue="@(s.IsRequired ? NeedRequired : NeedOptional)"
                                            SelectedValueChanged="v => s.IsRequired = v == NeedRequired" AddOptionalText="true"
                                            OptionalText="@Hint("Required stops the import. Optional skips this sheet with a warning.")" />
                                </div>

                                <div class="it-row">
                                    <div class="it-field">
                                        <Select TItem="string" Label="Where are the headers?" ShowPlaceholder="false"
                                                Items="HeaderRowModes.All" ValueSelector="m => m" TextSelector="m => HeaderModeLabel(m)"
                                                SelectedValue="@s.HeaderRowMode" SelectedValueChanged="v => s.HeaderRowMode = v"
                                                AddOptionalText="true" OptionalText="@Hint(HeaderHelp(s))" />
                                    </div>

                                    @if (s.HeaderRowMode == HeaderRowModes.Fixed)
                                    {
                                        <div class="it-field it-sm">
                                            <Input TValue="int?" Label="First header row" @bind-Value="s.HeaderRowNumber" />
                                        </div>
                                    }

                                    <div class="it-field it-sm">
                                        <Input TValue="int" Label="Header rows" @bind-Value="s.HeaderRowCount" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="it-setup-foot">
                        <span>
                            @if (ReadSheetCount > 1)
                            {
                                <text>Each sheet is read on its own, so every sheet that isn't ignored needs all the required
                                    fields. Set a sheet to Ignore if it shouldn't be read.</text>
                                }
                            </span>
                            <Button Variant="ButtonVariant.Secondary" Title="@(fresh && !ignored ? "Continue to columns" : "Done")"
                                    OnClick="CloseSettings" />
                        </div>
                    </div>
                }
            else
                {
                    <div class="it-sheetbar">
                        <div class="it-chips">
                            @foreach (var chip in SettingsChips(s))
                            {
                                <span class="it-sum-chip @(chip.Warn ? "warn" : "")"><i class="ti @chip.Icon"
                                                                                            aria-hidden="true"></i>@chip.Text</span>
                                }
                            </div>
                            <Button Variant="ButtonVariant.IconAction" Icon="fa-solid fa-pen" Tooltip="Edit sheet details"
                                    OnClick="OpenSettings" />
                        </div>
                    }

                    @if (ignored)
                    {
                        <div class="alert alert-light border small">
                            This sheet is ignored during import, so it doesn't need any columns.
                        </div>
                    }
                    else if (_showSettings && fresh)
                    {
                        <div class="it-locked">
                            <i class="ti ti-lock" aria-hidden="true"></i>
                            Columns come next. Finish the sheet details to start mapping.
                        </div>
                    }
                    else
                    {
                        <HeaderRowInfo ImportType="@Model.ImportType" Columns="s.Columns" OnChanged="Refresh"
                                       FocusField="@FocusField" />
                    }
                </div>
            }
        </FormSection>
<ConfirmModal Show="_confirmRemove" IconClass="fas fa-trash" Title="Remove this sheet?" Subtitle="@ActiveSheetName"
              Message="Its columns go with it. The template isn't changed until you save." YesLabel="Yes, remove" NoLabel="Keep"
              OnYes="RemoveActiveSheet" OnNo="CancelRemove" />
@code {
    [Parameter, EditorRequired] public ImportTemplateEditDto Model { get; set; } = default!;
    [Parameter] public string? FocusField { get; set; }

    /// <summary>Names of the Excel sheets that still have rows to fix (from an import error). Used only to mark and open the tab that reads them.</summary>
    [Parameter] public IReadOnlyList<string>? ProblemSheets { get; set; }

    private bool HasProblemSheets => ProblemSheets is { Count: > 0 };

    // True when this template sheet reads one of the Excel sheets named in the error. Exact and Contains can be compared with the file's sheet
    // name. Any, Headers and Position cannot, so they only count when the template reads a single sheet. Otherwise nothing is guessed.
    private bool ReadsProblemSheet(ImportTemplateSheetEditDto s)
    {
        if (!HasProblemSheets || s.SheetMatchMode == SheetMatchModes.Ignore) return false;

        var value = s.SheetMatchValue?.Trim() ?? string.Empty;
        foreach (var raw in ProblemSheets!)
        {
            var name = raw.Trim();
            if (s.SheetMatchMode == SheetMatchModes.Exact && value.Length > 0 && string.Equals(value, name, StringComparison.OrdinalIgnoreCase)) return true;
            if (s.SheetMatchMode == SheetMatchModes.Contains && value.Length > 0 && name.Contains(value, StringComparison.OrdinalIgnoreCase)) return true;
        }

        return ReadSheetCount == 1
            && (s.SheetMatchMode == SheetMatchModes.Any || s.SheetMatchMode == SheetMatchModes.Headers || s.SheetMatchMode == SheetMatchModes.Position);
    }

    private string ProblemSheetsText()
    {
        var names = string.Join(", ", ProblemSheets!);
        var label = ProblemSheets!.Count == 1 ? "sheet " : "sheets ";
        return Model.Sheets.Any(ReadsProblemSheet)
            ? "The error is in " + label + names + ". The tabs marked \"fix here\" read it."
            : "The error is in " + label + names + ", but Entriel can't tell which tab reads it. Check the tabs that map the field.";
    }

    private const string NeedRequired = "Required";
    private const string NeedOptional = "Optional";
    private static readonly string[] NeedOptions = { NeedRequired, NeedOptional };
    private int _active;

    // Sheet settings are open for a sheet with nothing mapped yet, and tucked into a one-line summary once it has columns.
    private bool _showSettings;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(FocusField))
        {
            var at = Model.Sheets.FindIndex(sh => sh.SheetMatchMode != SheetMatchModes.Ignore && sh.Columns.Any(IsFocusColumn));
            if (at >= 0) _active = at;
        }
        if (HasProblemSheets)
        {
            // Open the tab that reads the sheet with rows to fix, preferring one that maps the field being fixed.
            var at = Model.Sheets.FindIndex(sh => ReadsProblemSheet(sh) && (string.IsNullOrWhiteSpace(FocusField) || sh.Columns.Any(IsFocusColumn)));
            if (at < 0) at = Model.Sheets.FindIndex(ReadsProblemSheet);
            if (at >= 0) _active = at;
        }
        _showSettings = Model.Sheets.Count > 0 && IsFresh(Model.Sheets[Math.Min(_active, Model.Sheets.Count - 1)]);
    }

    protected override void OnParametersSet()
    {
        if (_active >= Model.Sheets.Count) _active = Math.Max(0, Model.Sheets.Count - 1);
    }

    private static bool IsFresh(ImportTemplateSheetEditDto s) =>
        s.Columns.All(c => string.IsNullOrWhiteSpace(c.HeaderText) && string.IsNullOrWhiteSpace(c.FieldKey));

    private void OpenSettings() => _showSettings = true;
    private void CloseSettings() => _showSettings = false;

    private sealed record SheetChip(string Icon, string Text, bool Warn = false);

    // Short chips that say what the hidden settings are.
    private static List<SheetChip> SettingsChips(ImportTemplateSheetEditDto s)
    {
        if (s.SheetMatchMode == SheetMatchModes.Ignore)
            return new() { new("ti-eye-off", "Ignored") };

        var value = s.SheetMatchValue?.Trim() ?? string.Empty;
        var find = s.SheetMatchMode switch
        {
            SheetMatchModes.Exact => value.Length > 0 ? new SheetChip("ti-search", $"Name: {value}") : new SheetChip("ti-search",
"Name not set yet", true),
            SheetMatchModes.Contains => value.Length > 0 ? new SheetChip("ti-search", $"Name contains: {value}") : new
SheetChip("ti-search", "Name text not set yet", true),
            SheetMatchModes.Position => value.Length > 0 ? new SheetChip("ti-search", $"Position {value}") : new
SheetChip("ti-search", "Position not set yet", true),
            SheetMatchModes.Headers => new SheetChip("ti-search", "Found by headers"),
            _ => new SheetChip("ti-search", "Any sheet")
        };

        var chips = new List<SheetChip>
        {
            find,
            new("ti-list-numbers", s.HeaderRowMode == HeaderRowModes.Fixed
                ? $"Header row {s.HeaderRowNumber}"
                : "Headers: automatic")
        };

        if (s.HeaderRowCount > 1)
            chips.Add(new("ti-rows", $"{s.HeaderRowCount} header rows"));

        chips.Add(s.IsRequired ? new("ti-lock", "Required") : new("ti-lock-open", "Optional"));
        return chips;
    }

    // Grid changes call this so the "still missing" alert above stays current.
    private void Refresh() { }

    // Same per-sheet rule the validator enforces on save: each sheet must cover the required groups on its own.
    private List<string> Missing =>
        _active >= 0 && _active < Model.Sheets.Count
            ? STTproject.Features.Admin.ImportTemplate.Validators.ImportTemplateValidator
                .MissingRequiredGroups(Model.Sheets[_active], Model.ImportType)
            : new();

    private int SheetGaps(ImportTemplateSheetEditDto s) =>
        STTproject.Features.Admin.ImportTemplate.Validators.ImportTemplateValidator
            .MissingRequiredGroups(s, Model.ImportType).Count;

    private int ReadSheetCount => Model.Sheets.Count(x => x.SheetMatchMode != SheetMatchModes.Ignore);

    private int TotalGaps =>
        STTproject.Features.Admin.ImportTemplate.Validators.ImportTemplateValidator.RequiredGroupErrors(Model).Count;

    private string ActiveSheetName =>
    _active >= 0 && _active < Model.Sheets.Count
        ? (string.IsNullOrWhiteSpace(Model.Sheets[_active].SheetLabel)
            ? $"Sheet {_active + 1}"
            : Model.Sheets[_active].SheetLabel)
        : string.Empty;
        
    private string Summary
    {
        get
        {
            var cols = Model.Sheets.Sum(s => s.Columns.Count);
            var status = TotalGaps > 0 ? "required fields still to map" : "All required fields mapped";
            return $"{Model.Sheets.Count} sheet{(Model.Sheets.Count == 1 ? "" : "s")} · {cols} columns · {status}";
        }
    }
    private void AddSheet()
    {
        Model.Sheets.Add(new ImportTemplateSheetEditDto
        {
            SheetLabel = $"Sheet {Model.Sheets.Count + 1}",
            SheetMatchMode = SheetMatchModes.Contains, // "Any" is only allowed for a single sheet
            Columns = { new ImportTemplateColumnEditDto() }
        });
        _active = Model.Sheets.Count - 1;
        _showSettings = true;
    }

    private void RemoveActiveSheet()
    {
        _confirmRemove = false;
        if (Model.Sheets.Count <= 1) return;

        Model.Sheets.RemoveAt(_active);
        _active = Math.Min(_active, Model.Sheets.Count - 1);
        _showSettings = IsFresh(Model.Sheets[_active]);
    }

    private static void MatchModeChanged(ImportTemplateSheetEditDto s, string? value)
    {
        if (string.IsNullOrEmpty(value)) return;
        s.SheetMatchMode = value;
        if (!NeedsMatchValue(s)) s.SheetMatchValue = null;
    }

    private static string HeaderModeLabel(string m) => m switch
    {
        HeaderRowModes.Automatic => "Find automatically",
        HeaderRowModes.Fixed => "Always on a specific row",
        _ => m
    };
    private static string ChipText(string m) =>
        m.Replace(" is required.", "").Replace(" is required", "");
    private static bool NeedsMatchValue(ImportTemplateSheetEditDto s) =>
        s.SheetMatchMode is SheetMatchModes.Exact or SheetMatchModes.Contains or SheetMatchModes.Position;

    private static string MatchModeLabel(string m) => m switch
    {
        SheetMatchModes.Any => "Any sheet",
        SheetMatchModes.Exact => "Exact sheet name",
        SheetMatchModes.Contains => "Sheet name contains text",
        SheetMatchModes.Position => "Sheet position",
        SheetMatchModes.Headers => "Sheet with these headers",
        SheetMatchModes.Ignore => "Ignore this sheet",
        _ => m
    };

    private static string MatchValueLabel(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Exact => "Sheet name",
        SheetMatchModes.Contains => "Text the name contains",
        SheetMatchModes.Position => "Position (1 = first sheet)",
        _ => ""
    };

    private static string MatchValuePlaceholder(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Exact => "Sales Data",
        SheetMatchModes.Contains => "Sales",
        SheetMatchModes.Position => "1",
        _ => ""
    };

    private static string MatchModeHelp(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Any => "Uses whatever the sheet is called. Only valid when the template has one sheet.",
        SheetMatchModes.Headers => "Finds the sheet by the column headers below, whatever it's called. Needs at least two different fields.",
        SheetMatchModes.Ignore => "Matches nothing. Use it to skip sheets like Summary.",
        _ => ""
    };

    private static string HeaderModeHelp(ImportTemplateSheetEditDto s) => s.HeaderRowMode switch
    {
        HeaderRowModes.Automatic => "Looks through the first rows for the one containing the headers below.",
        HeaderRowModes.Fixed => "Use this when the header row never moves.",
        _ => ""
    };
    private static string Hint(string text) => $"({text})";

    private static string HeaderHelp(ImportTemplateSheetEditDto s) =>
        HeaderModeHelp(s) + (s.HeaderRowCount > 1
            ? " With several header rows, they're joined top to bottom, e.g. Salesman Name."
            : "");
    private bool _confirmRemove;

    private void AskRemove() => _confirmRemove = true;
    private void CancelRemove() => _confirmRemove = false;

    private bool IsFocusColumn(ImportTemplateColumnEditDto c) =>
        string.Equals(c.FieldKey, FocusField, StringComparison.OrdinalIgnoreCase)
        || (FocusField!.Contains("date", StringComparison.OrdinalIgnoreCase)
            && ImportFieldRegistry.GetField(Model.ImportType, c.FieldKey)?.Type == ImportFieldType.Date);

    private void SelectSheet(int idx)
    {
        _active = idx;
        _confirmRemove = false;
        _showSettings = IsFresh(Model.Sheets[idx]);
    }
}
