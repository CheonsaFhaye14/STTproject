<FormSection Icon="ti ti-table" Title="Sheets and columns" Summary="@Summary">

    @if (Missing.Count > 0)
    {
        <div class="it-missing">
            <span class="it-hint">Still to map:</span>
            @foreach (var m in Missing) { <span class="it-chip">@ChipText(m)</span> }
        </div>
    }

    <div class="it-tabs">
        @for (var i = 0; i < Model.Sheets.Count; i++)
        {
            var idx = i;
            var tab = Model.Sheets[idx];
            <button type="button" @key="tab.RowKey"
                    class="it-tab @(idx == _active ? "active" : "")"
                    @onclick="() => SelectSheet(idx)">
                @(string.IsNullOrWhiteSpace(tab.SheetLabel) ? $"Sheet {idx + 1}" : tab.SheetLabel)
                @if (tab.SheetMatchMode == SheetMatchModes.Ignore)
                {
                    <span class="badge bg-secondary ms-1">ignored</span>
                }
            </button>
        }
        <button type="button" class="it-tab it-tab-add" @onclick="AddSheet">+ Add sheet</button>
       
        @if (Model.Sheets.Count > 1)
        {
            <div class="it-tabs-end">
                <Button Variant="ButtonVariant.IconActionDelete" Icon="fa-solid fa-trash"
                        Tooltip="Remove this sheet" OnClick="AskRemove" />
            </div>
        }

    </div>

   @if (Model.Sheets.Count > 0)
    {
        var s = Model.Sheets[_active];

        <div @key="s.RowKey">
            <div class="it-row">
                <div class="it-field">
                    <Input TValue="string"
                        Label="Sheet label"
                        Placeholder="e.g. Sales"
                        AddOptionalText="true"
                        @bind-Value="s.SheetLabel" 
                        OptionalText="(Your own name for this sheet. It doesn't have to match Excel.)"/>
                </div>

                <div class="it-field">
                <Select TItem="string"
                        Label="How to find it in the file"
                        ShowPlaceholder="false"
                        Items="SheetMatchModes.All"
                        ValueSelector="m => m"
                        TextSelector="m => MatchModeLabel(m)"
                        SelectedValue="@s.SheetMatchMode"
                        SelectedValueChanged="v => MatchModeChanged(s, v)"
                        AddOptionalText="@(!NeedsMatchValue(s))"
                        OptionalText="@Hint(MatchModeHelp(s))" />
                </div>

                @if (NeedsMatchValue(s))
                {
                    <div class="it-field">
                        <Input TValue="string"
                            Label="@MatchValueLabel(s)"
                            Placeholder="@MatchValuePlaceholder(s)"
                            @bind-Value="s.SheetMatchValue" />
                    </div>
                }

            </div>

            @if (s.SheetMatchMode == SheetMatchModes.Ignore)
            {
                <div class="alert alert-light border small">
                    This sheet is ignored during import, so it doesn't need any columns.
                </div>
            }
            else
            {
                <div class="it-row">
                <div class="it-field">
                    <Select TItem="string"
                            Label="Where are the headers?"
                            ShowPlaceholder="false"
                            Items="HeaderRowModes.All"
                            ValueSelector="m => m"
                            TextSelector="m => HeaderModeLabel(m)"
                            SelectedValue="@s.HeaderRowMode"
                            SelectedValueChanged="v => s.HeaderRowMode = v"
                            AddOptionalText="true"
                            OptionalText="@Hint(HeaderHelp(s))" />
                </div>

                    @if (s.HeaderRowMode == HeaderRowModes.Fixed)
                    {
                        <div class="it-field it-sm">
                            <Input TValue="int?" Label="First header row" @bind-Value="s.HeaderRowNumber" />
                        </div>
                    }

                    <div class="it-field it-sm">
                        <Input TValue="int" Label="Header rows" @bind-Value="s.HeaderRowCount" />
                    </div>
                </div>

                <HeaderRowInfo ImportType="@Model.ImportType"
                            Columns="s.Columns"
                            OnChanged="Refresh" />
            }
        </div>
    }
</FormSection>
<ConfirmModal Show="_confirmRemove"
              IconClass="fas fa-trash"
              Title="Remove this sheet?"
              Subtitle="@ActiveSheetName"
              Message="Its columns go with it. The template isn't changed until you save."
              YesLabel="Yes, remove"
              NoLabel="Keep"
              OnYes="RemoveActiveSheet"
              OnNo="CancelRemove" />
@code {
    [Parameter, EditorRequired] public ImportTemplateEditDto Model { get; set; } = default!;

    /// <summary>Whether the template is a global default. Owned by the page.</summary>
    [Parameter] public bool IsGlobal { get; set; } = true;

    private int _active;

    protected override void OnParametersSet()
    {
        if (_active >= Model.Sheets.Count) _active = Math.Max(0, Model.Sheets.Count - 1);
    }

    // Grid changes call this so the "still missing" alert above stays current.
    private void Refresh() { }

    // Global templates, and templates that don't fall back to the global default,
    // have to map every required field (same rule the validator uses).
    private List<string> Missing
    {
        get
        {
            if (!(IsGlobal || !Model.AllowGlobalFallback)) return new();

            var mapped = Model.Sheets
                .Where(s => s.SheetMatchMode != SheetMatchModes.Ignore)
                .SelectMany(s => s.Columns)
                .Where(c => !string.IsNullOrWhiteSpace(c.FieldKey))
                .Select(c => c.FieldKey!);

            return ImportFieldRegistry.MissingRequired(Model.ImportType, mapped);
        }
    }
    private string ActiveSheetName =>
    _active >= 0 && _active < Model.Sheets.Count
        ? (string.IsNullOrWhiteSpace(Model.Sheets[_active].SheetLabel)
            ? $"Sheet {_active + 1}"
            : Model.Sheets[_active].SheetLabel)
        : string.Empty;
        
    private string Summary
    {
        get
        {
            var cols = Model.Sheets.Sum(s => s.Columns.Count);
            var status = Missing.Count > 0 ? $"{Missing.Count} still to map" : "All required fields mapped";
            return $"{Model.Sheets.Count} sheet{(Model.Sheets.Count == 1 ? "" : "s")} · {cols} columns · {status}";
        }
    }
    private void AddSheet()
    {
        Model.Sheets.Add(new ImportTemplateSheetEditDto
        {
            SheetLabel = $"Sheet {Model.Sheets.Count + 1}",
            SheetMatchMode = SheetMatchModes.Contains,   // "Any" is only allowed for a single sheet
            Columns = { new ImportTemplateColumnEditDto() }
        });
        _active = Model.Sheets.Count - 1;
    }

    private void RemoveActiveSheet()
    {
        _confirmRemove = false;
        if (Model.Sheets.Count <= 1) return;

        Model.Sheets.RemoveAt(_active);
        _active = Math.Min(_active, Model.Sheets.Count - 1);
    }

    private static void MatchModeChanged(ImportTemplateSheetEditDto s, string? value)
    {
        if (string.IsNullOrEmpty(value)) return;
        s.SheetMatchMode = value;
        if (!NeedsMatchValue(s)) s.SheetMatchValue = null;
    }

    private static string HeaderModeLabel(string m) => m switch
    {
        HeaderRowModes.Automatic => "Find automatically",
        HeaderRowModes.Fixed => "Always on a specific row",
        _ => m
    };
    private static string ChipText(string m) =>
        m.Replace(" is required.", "").Replace(" is required", "");
    private static bool NeedsMatchValue(ImportTemplateSheetEditDto s) =>
        s.SheetMatchMode is SheetMatchModes.Exact or SheetMatchModes.Contains or SheetMatchModes.Position;

    private static string MatchModeLabel(string m) => m switch
    {
        SheetMatchModes.Any => "Any sheet",
        SheetMatchModes.Exact => "Exact sheet name",
        SheetMatchModes.Contains => "Sheet name contains text",
        SheetMatchModes.Position => "Sheet position",
        SheetMatchModes.Ignore => "Ignore this sheet",
        _ => m
    };

    private static string MatchValueLabel(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Exact => "Sheet name",
        SheetMatchModes.Contains => "Text the name contains",
        SheetMatchModes.Position => "Position (1 = first sheet)",
        _ => ""
    };

    private static string MatchValuePlaceholder(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Exact => "Sales Data",
        SheetMatchModes.Contains => "Sales",
        SheetMatchModes.Position => "1",
        _ => ""
    };

    private static string MatchModeHelp(ImportTemplateSheetEditDto s) => s.SheetMatchMode switch
    {
        SheetMatchModes.Any => "Uses whatever the sheet is called. Only valid when the template has one sheet.",
        SheetMatchModes.Ignore => "Matches nothing. Use it to skip sheets like Summary.",
        _ => ""
    };

    private static string HeaderModeHelp(ImportTemplateSheetEditDto s) => s.HeaderRowMode switch
    {
        HeaderRowModes.Automatic => "Looks through the first rows for the one containing the headers below.",
        HeaderRowModes.Fixed => "Use this when the header row never moves.",
        _ => ""
    };
    private static string Hint(string text) => $"({text})";

    private static string HeaderHelp(ImportTemplateSheetEditDto s) =>
        HeaderModeHelp(s) + (s.HeaderRowCount > 1
            ? " With several header rows, they're joined top to bottom, e.g. Salesman Name."
            : "");
    private bool _confirmRemove;

    private void AskRemove() => _confirmRemove = true;
    private void CancelRemove() => _confirmRemove = false;

    private void SelectSheet(int idx)
    {
        _active = idx;
        _confirmRemove = false;
    }
}
