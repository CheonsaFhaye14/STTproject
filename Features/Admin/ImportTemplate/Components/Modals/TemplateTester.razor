@using System.IO
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Components.Forms
@using STTproject.Features.User.SalesInvoice.DTOs
@using STTproject.Features.User.SalesInvoice.Components.Modals
@inject IImportTemplateTestService Tester
@inject STTproject.Features.User.SalesInvoice.Services.ImportSalesInvoiceService Importer
@inject STTproject.Services.IUserContextService UserContext

<FormSection Icon="ti ti-flask" Title="Try it with a file" Summary="Check the template against a real Excel or CSV file"
             IsExpanded="false">

    @* ── 1. File: big dropzone first, compact bar once a file is chosen ── *@
    @if (_bytes is null)
    {
        <FileInput InputId="template-test-file" Title="Choose an Excel or CSV file to test"
                   Subtitle="@(_busy ? $"Reading {_fileName}…" : "Click to browse or drop a file here. Nothing is imported or saved.")"
                   Accept=".xlsx,.csv" OnFileSelected="OnFile" />
        <div class="form-text mt-2">
            After you choose a file, you'll see which sheets and columns were found, and which rows have problems.
        </div>
    }
    else
    {
        <div class="tt-card">
            <div class="tt-bar">
                <i class="ti ti-file-spreadsheet tt-bar-icon"></i>
                <div class="tt-bar-name">
                    <div class="fw-medium text-truncate">@_fileName</div>
                    <div class="small text-muted">@FileSizeText · first @MaxRows rows of each sheet are checked</div>
                </div>
                <Button Variant="ButtonVariant.Secondary" Title="Replace file" Disabled="@_busy" OnClick="ReplaceFile" />
                <Button Variant="ButtonVariant.Secondary" Title="@(_busy ? "Testing…" : "Test again")" Disabled="@_busy" OnClick="Run" />
            </div>
        </div>
    }

    @if (_busy)
    {
        <div class="tt-loading mt-3" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@(_bytes is null ? $"Reading {_fileName}…" : "Testing the template against the file…")</span>
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger mt-3 mb-0">@_error</div>
    }

    @if (_result is not null)
    {
        var r = _result;
        var blocking = r.Issues.Where(i => i.IsBlocking).ToList();
        var review = r.Issues.Where(i => !i.IsBlocking).ToList();
        var (vCls, vIcon, vTitle, vSub) = VerdictInfo(r);
        var isBlocked = r.Verdict == TestVerdict.Blocked;

        @* ── 2. Status: one slim banner. Opens to show what to review. ── *@
        var groups = OptionalGroups(r);
        var others = review.Where(i => i.Kind != IssueKind.OptionalColumns).ToList();
        var canOpen = blocking.Count > 0 || others.Count > 0 || groups.Count > 0 || r.Warnings.Count > 0;
        <div class="tt-status @vCls mt-3">
            <button type="button" class="tt-status-top @(_open && canOpen ? "tt-open" : "")" disabled="@(!canOpen)"
                    aria-expanded="@(_open && canOpen)" @onclick="() => _open = !_open">
                <i class="ti @vIcon tt-verdict-icon"></i>
                <strong>@vTitle</strong>
                <span class="tt-facts">@r.SheetsFound of @r.SheetsExpected sheets · @r.RowsChecked rows · @r.BlockingCount blocking @(r.BlockingCount == 1 ? "error" : "errors") · @r.ReviewCount to review</span>
                @if (canOpen)
                {
                    <i class="ti ti-chevron-down tt-chev"></i>
                }
            </button>

            @if (_open && canOpen)
            {
                <div class="tt-detail">
                    @foreach (var issue in blocking)
                    {
                        @IssueRow(issue)
                    }

                    @if (r.Warnings.Count > 0)
                    {
                        <div class="tt-group">
                            <div class="fw-medium">Not ready to save yet, but you can still test it</div>
                            <ul class="small text-muted mb-0 ps-3 mt-1">
                                @foreach (var w in r.Warnings)
                                {
                                    <li>@w</li>
                                }
                            </ul>
                        </div>
                    }

                    @foreach (var issue in others)
                    {
                        @IssueRow(issue)
                    }

                    @foreach (var g in groups)
                    {
                        <div class="tt-group tt-group-row">
                            <div class="tt-group-text"><b>@JoinLabels(g.Sheets):</b> @g.Fields not found. These fields will be left empty.</div>
                            <div class="tt-group-actions">
                                @foreach (var lbl in g.Sheets)
                                {
                                    <button type="button" class="it-sum-chip tt-go" @onclick="() => Select(lbl)">View @lbl <i class="ti ti-arrow-right"></i></button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ── 3. Sheets: one tab each, the broken one opens first ── *@
        @if (r.Sheets.Count > 0)
        {
            var s = Current;
            <div class="mt-3">
                <div class="it-tabs" role="tablist">
                    @foreach (var t in r.Sheets)
                    {
                        <button type="button" role="tab" class="it-tab @(t.Label == _cur ? "active" : "")" @onclick="() => Select(t.Label)">
                            @t.Label
                            @if (t.Status == TestSheetStatus.NotFound)
                            {
                                <i class="ti ti-file-off tt-tab-off @(t.IsRequired ? "tt-tab-off-bad" : "")" title="Not in the file"></i>
                            }
                            else
                            {
                                <span class="tt-cnt">@t.Rows.Count</span>
                                @if (t.Status == TestSheetStatus.Blocked)
                                {
                                    <span class="it-dot" title="Blocked"></span>
                                }
                                else if (t.Status == TestSheetStatus.NeedsLook)
                                {
                                    <span class="it-dot it-dot--warn" title="Something to review"></span>
                                }
                            }
                        </button>
                    }
                </div>

                @if (s is not null)
                {
                    <div class="pt-3">
                        @if (s.Status == TestSheetStatus.NotFound)
                        {
                            <div class="tt-empty">
                                <i class="ti ti-file-off tt-empty-icon"></i>
                                <div class="fw-medium">Nothing to preview</div>
                                <div class="small text-muted">@(s.IsRequired ? "This sheet is required, but it isn't in the file." : "This sheet is optional, so it would be skipped.")</div>
                            </div>
                            <div class="fw-medium mt-3 mb-2">Sheets in this file</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var fs in r.FileSheets)
                                {
                                    <div class="tt-chip">
                                        <b>@fs.Name</b>
                                        <span class="text-muted">@(fs.IsHidden ? "hidden, never matched" : fs.UsedBy is null ? "not used" : $"used by {fs.UsedBy}")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* One summary line. The mapping itself is in the table headers below. *@
                            var matchedCount = s.Fields.Count(x => x.State == FieldState.Found);
                            var aliasCount = s.Fields.Count(x => x.State == FieldState.Found && x.IsAlias);
                            var problemFields = s.Fields.Where(x => x.State is FieldState.RequiredMissing or FieldState.Ambiguous).ToList();
                            <div class="it-sheetbar">
                                <div class="it-chips">
                                    <span class="it-sum-chip"><i class="ti ti-columns"></i>@matchedCount of @s.Fields.Count columns matched</span>
                                    @if (s.HeaderRow is not null)
                                    {
                                        <span class="it-sum-chip"><i class="ti ti-list-numbers"></i>Headers on row @s.HeaderRow</span>
                                    }
                                    @if (aliasCount > 0)
                                    {
                                        <span class="it-sum-chip" title="The file used an alias instead of the main header"><i class="ti ti-replace"></i>@aliasCount by alias</span>
                                    }
                                    @foreach (var pf in problemFields)
                                    {
                                        <span class="it-sum-chip warn" title="@MapTitle(pf)"><i class="ti ti-alert-circle"></i>@pf.Display @(pf.State == FieldState.Ambiguous ? "ambiguous" : "missing")</span>
                                    }
                                </div>
                                @if (s.Rows.Count > 0)
                                {
                                    <div class="it-seg tt-seg" title="Original is the file as is. Processed is after the template's cleaning rules.">
                                        <button type="button" class="it-seg-btn @(!_processed ? "active" : "")" aria-pressed="@(!_processed ? "true" : "false")" @onclick="() => _processed = false">Original</button>
                                        <button type="button" class="it-seg-btn @(_processed ? "active" : "")" aria-pressed="@(_processed ? "true" : "false")" @onclick="() => _processed = true">Processed</button>
                                    </div>
                                }
                            </div>

                            @if (s.Status == TestSheetStatus.Blocked)
                            {
                                <div class="tt-banner mt-3">
                                    <i class="ti ti-alert-circle"></i>
                                    <span>This preview is incomplete. @BlockedWhy(s) Only what could be read is shown.</span>
                                </div>
                            }

                            @if (s.Rows.Count > 0)
                            {
                                var rows = _showAll ? s.Rows : s.Rows.Where((x, i) => i < PreviewRows || x.Messages.Count > 0).ToList();
                                var showProblems = rows.Any(x => x.Messages.Count > 0);

                                <div class="tt-scroll mt-2">
                                    <table class="tt-table">
                                        <thead>
                                            <tr>
                                                <th>Row</th>
                                                @foreach (var f in s.Fields)
                                                {
                                                    @if (f.State == FieldState.Found)
                                                    {
                                                        <th>
                                                            @f.Display
                                                            @if (f.IsAlias)
                                                            {
                                                                <span class="tt-alias">alias</span>
                                                            }
                                                            <small>← @f.FoundHeader</small>
                                                        </th>
                                                    }
                                                    else if (f.State == FieldState.RequiredMissing)
                                                    {
                                                        <th class="tt-x" title="@MapTitle(f)">@f.Display<small>not found</small></th>
                                                    }
                                                    else if (f.State == FieldState.OptionalMissing)
                                                    {
                                                        <th class="tt-off" title="@MapTitle(f)">@f.Display<small>not in file</small></th>
                                                    }
                                                    else if (f.State == FieldState.Ambiguous)
                                                    {
                                                        @foreach (var src in f.Sources)
                                                        {
                                                            <th class="tt-x" title="@MapTitle(f)">@f.Display<small>@src.Header (column @src.Letter)</small></th>
                                                        }
                                                    }
                                                }
                                                @if (showProblems)
                                                {
                                                    <th>Problems</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in rows)
                                            {
                                                <tr class="@(row.Messages.Count > 0 ? "tt-bad-row" : "") @(row.RowNumber == _hlRow ? "tt-hl" : "")">
                                                    <td class="tt-row">@row.RowNumber</td>
                                                    @foreach (var f in s.Fields)
                                                    {
                                                        @if (f.State == FieldState.Found)
                                                        {
                                                            var shown = _processed ? row.Values.GetValueOrDefault(f.FieldKey, "") : row.Original.GetValueOrDefault(f.FieldKey, "");
                                                            var changed = _processed && shown != row.Original.GetValueOrDefault(f.FieldKey, "");
                                                            <td title="@shown" class="@(row.BadFields.Contains(f.FieldKey) ? "text-danger fw-medium" : changed ? "tt-changed" : string.IsNullOrEmpty(shown) ? "tt-dash" : "")">@(string.IsNullOrEmpty(shown) ? "—" : shown)</td>
                                                        }
                                                        else if (f.State == FieldState.RequiredMissing)
                                                        {
                                                            <td class="tt-na">Not read</td>
                                                        }
                                                        else if (f.State == FieldState.OptionalMissing)
                                                        {
                                                            <td class="tt-dash">—</td>
                                                        }
                                                        else if (f.State == FieldState.Ambiguous)
                                                        {
                                                            @foreach (var src in f.Sources)
                                                            {
                                                                <td class="tt-x-cell">@row.AmbiguousRaw.GetValueOrDefault(src.ColumnIndex, "")</td>
                                                            }
                                                        }
                                                    }
                                                    @if (showProblems)
                                                    {
                                                        <td class="small">@string.Join("; ", row.Messages)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex align-items-center mt-2">
                                    <span class="small text-muted">
                                        @RowsText(rows.Count, s.Rows.Count)
                                    </span>
                                    @if (s.Rows.Count > PreviewRows)
                                    {
                                        <span class="ms-auto">
                                            <Button Variant="ButtonVariant.Secondary" Title="@(_showAll ? $"Show {PreviewRows}" : $"Show all {s.Rows.Count}")" OnClick="() => _showAll = !_showAll" />
                                        </span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }

        @if (r.Notes.Count > 0)
        {
            <ul class="small text-muted mt-2 mb-0 ps-3">
                @foreach (var n in r.Notes)
                {
                    <li>@n</li>
                }
            </ul>
        }

        @* ── 4. The real import check (Sales Invoice only). Locked while the template can't read the file. ── *@
        @if (Model.ImportType == "SalesInvoice")
        {
            <div class="tt-card mt-3 @(isBlocked ? "tt-locked" : "")">
                <div class="tt-head">
                    <i class="ti @(isBlocked ? "ti-lock" : "ti-list-check") tt-bar-icon"></i>
                    <div>
                        <div class="fw-medium">What would be imported</div>
                        <div class="small text-muted">
                            @(isBlocked
                                ? "Available after the blocking errors are fixed and the file is tested again."
                                : $"Runs the real import check: customer, SKU and UOM lookups, invoice grouping, prices and duplicates. Reads the first {MaxRows} rows of each sheet. Nothing is saved.")
                        </div>
                    </div>
                </div>

                @if (!isBlocked)
                {
                    <div class="px-3 pb-3">
                        @if (IsCsv)
                        {
                            <div class="alert alert-light border small mb-0">
                                This check needs an .xlsx file. The import itself doesn't read CSV.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-end gap-2">
                                @if (Model.SubDistributorId is null)
                                {
                                    <div style="max-width:320px; flex:1;">
                                        <label class="form-label small mb-1">Check against subdistributor</label>
                                        <select class="form-select" @bind="_testSubdId">
                                            <option value="0">Choose…</option>
                                            @foreach (var sd in Subds)
                                            {
                                                <option value="@sd.SubDistributorId">@sd.Display</option>
                                            }
                                        </select>
                                    </div>
                                }
                                <Button Variant="ButtonVariant.Secondary" Disabled="@(_checking || SubdForCheck <= 0)"
                                        Title="@(_checking ? "Checking…" : "Run import check")" OnClick="CheckImportAsync" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</FormSection>

<ImportSalesInvoiceResults Show="_showImport" ImportResult="_importResult" ReadOnly="true" OnClose="CloseImport"
                           ExpectedSheets="ExpectedSheetNames" RowLimit="MaxRows" />

@code {
    private const int MaxRows = 50;
    private const int PreviewRows = 10;
    private const long MaxFileBytes = 20 * 1024 * 1024;

    [Parameter, EditorRequired] public ImportTemplateEditDto Model { get; set; } = default!;
    [Parameter] public List<SubDistributorOptionDto> Subds { get; set; } = new();

    private byte[]? _bytes;
    private string? _fileName;
    private string? _error;
    private bool _busy;
    private TemplateTestResult? _result;

    // What is on screen
    private string _cur = "";
    private bool _processed;
    private bool _showAll;
    private bool _open;
    private int _hlRow;

    private int _testSubdId;
    private bool _checking, _showImport;
    private ImportSalesInvoiceResult? _importResult;

    // The file's sheets this template reads, so the check can say which of them gave no rows.
    private List<string> ExpectedSheetNames => _result?.Sheets
        .Where(s => s.Status != TestSheetStatus.NotFound)
        .Select(s => s.ExcelSheetName ?? s.Label)
        .ToList() ?? new List<string>();

    private bool IsCsv => _fileName?.EndsWith(".csv", StringComparison.OrdinalIgnoreCase) == true;
    private int SubdForCheck => Model.SubDistributorId ?? _testSubdId;
    private TemplateTestSheet? Current => _result?.Sheets.FirstOrDefault(s => s.Label == _cur);

    private string FileSizeText => _bytes is null ? "" :
        _bytes.Length >= 1024 * 1024 ? $"{_bytes.Length / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, _bytes.Length / 1024)} KB";

    private async Task OnFile(IBrowserFile file)
    {
        _error = null;
        _result = null;

        var ok = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)
            || file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase);
        if (!ok)
        {
            _error = "Please choose an .xlsx or .csv file.";
            return;
        }

        _busy = true;
        _fileName = file.Name;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(MaxFileBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _bytes = ms.ToArray();
            await Run();
        }
        catch (IOException)
        {
            _bytes = null;
            _error = "That file is too large to test (20 MB max).";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Run()
    {
        if (_bytes is null) return;

        _error = null;
        _result = null;
        _busy = true;
        StateHasChanged();
        await Task.Yield();   // let the spinner paint before the heavy work starts

        try
        {
            var bytes = _bytes;
            var name = _fileName ?? "";
            var result = await Task.Run(() => Tester.Test(Model, new MemoryStream(bytes), name, MaxRows));

            _result = result;
            _cur = PickSheet(result);
            _open = result.Verdict == TestVerdict.Blocked;
            _showAll = false;
            _hlRow = 0;
        }
        catch (Exception ex)
        {
            _error = $"Couldn't test this file: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ReplaceFile()
    {
        _bytes = null;
        _fileName = null;
        _result = null;
        _error = null;
        _importResult = null;
    }

    private void Select(string label)
    {
        _cur = label;
        _showAll = false;
        _hlRow = 0;
    }

    private void Jump(TemplateTestIssue issue)
    {
        if (issue.SheetLabel is null || _result is null) return;
        _cur = issue.SheetLabel;
        _hlRow = issue.RowNumber ?? 0;
        _showAll = false;
    }

    // The sheet to open first: the one that blocks, then a missing one, then one that needs a look.
    private static string PickSheet(TemplateTestResult r) =>
        (r.Sheets.FirstOrDefault(s => s.Status == TestSheetStatus.Blocked)
         ?? r.Sheets.FirstOrDefault(s => s.Status == TestSheetStatus.NotFound && s.IsRequired)
         ?? r.Sheets.FirstOrDefault(s => s.Status == TestSheetStatus.NeedsLook)
         ?? r.Sheets.FirstOrDefault())?.Label ?? "";

    private async Task CheckImportAsync()
    {
        if (_bytes is null || SubdForCheck <= 0) return;

        _checking = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            using var ms = await Task.Run(TrimToPreview);
            _importResult = await Importer.PrepareFromExcelAsync(
                ms, SubdForCheck, UserContext.UserId ?? 0, Model, int.MaxValue);
        }
        catch (Exception ex)
        {
            _importResult = new ImportSalesInvoiceResult();
            _importResult.AddError(0, string.Empty, $"Check failed: {ex.Message}");
        }
        finally
        {
            _checking = false;
            _showImport = true;
        }
    }

    private void CloseImport() => _showImport = false;

    // A copy of the file with only the first MaxRows data rows of each sheet the template reads, so a big file
    // (80,000 rows, say) still previews quickly and every sheet gets the same share.
    private MemoryStream TrimToPreview()
    {
        using var src = new XLWorkbook(new MemoryStream(_bytes!));
        using var dst = new XLWorkbook();

        foreach (var ws in src.Worksheets)
        {
            var copy = dst.Worksheets.Add(ws.Name);
            copy.Visibility = ws.Visibility;

            var t = _result?.Sheets.FirstOrDefault(x => x.ExcelSheetName == ws.Name);
            var headerRows = Model.Sheets.FirstOrDefault(m => m.SheetLabel == t?.Label)?.HeaderRowCount ?? 1;
            var keepUntil = t?.HeaderRow is int h
                ? h + Math.Max(1, headerRows) - 1 + MaxRows
                : 20 + MaxRows;   // unmatched sheets: just enough to keep matching stable

            var lastRow = Math.Min(ws.LastRowUsed()?.RowNumber() ?? 0, keepUntil);
            var lastCol = ws.LastColumnUsed()?.ColumnNumber() ?? 0;
            if (lastRow > 0 && lastCol > 0)
                ws.Range(1, 1, lastRow, lastCol).CopyTo(copy.Cell(1, 1));
        }

        var ms = new MemoryStream();
        dst.SaveAs(ms);
        ms.Position = 0;
        return ms;
    }

    // ── wording and styling helpers ──────────────────────────────────────

    private static (string Cls, string Icon, string Title, string Sub) VerdictInfo(TemplateTestResult r) => r.Verdict switch
    {
        TestVerdict.Blocked => ("tt-bad", "ti-circle-x", "This file can't be imported with this template",
            $"{r.BlockingCount} {(r.BlockingCount == 1 ? "problem needs" : "problems need")} fixing first. Nothing was imported or saved."),
        TestVerdict.NeedsLook => ("tt-warn", "ti-alert-triangle", "Template can read this file",
            r.ReviewCount > 0
                ? $"{r.ReviewCount} small {(r.ReviewCount == 1 ? "thing" : "things")} to review. None of them stop an import."
                : "The template is incomplete, but it can still read this file."),
        _ => ("tt-ok", "ti-circle-check", "Template can read this file", "Nothing needs fixing.")
    };

    // Sheets whose optional columns are missing, grouped by the same list of fields so one note covers them all.
    private static List<(List<string> Sheets, string Fields)> OptionalGroups(TemplateTestResult r) =>
        r.Sheets
            .Where(s => s.Status != TestSheetStatus.NotFound)
            .Select(s => (s.Label, Fields: s.Fields.Where(f => f.State == FieldState.OptionalMissing).Select(f => f.Display).ToList()))
            .Where(x => x.Fields.Count > 0)
            .GroupBy(x => string.Join(", ", x.Fields))
            .Select(g => (g.Select(x => x.Label).ToList(), g.Key))
            .ToList();

    private static string JoinLabels(List<string> labels) => labels.Count switch
    {
        1 => labels[0],
        2 => $"{labels[0]} and {labels[1]}",
        _ => $"{string.Join(", ", labels.Take(labels.Count - 1))} and {labels[^1]}"
    };

    private string RowsText(int shown, int total) =>
        $"Showing {shown} of {total} checked rows" + (_processed ? " · blue edge = changed by a cleaning rule" : "");

    private static string MapClass(TemplateTestField f) => f.State switch
    {
        FieldState.RequiredMissing or FieldState.Ambiguous => "tt-mr-req",
        FieldState.OptionalMissing => "tt-mr-opt",
        _ => ""
    };

    private static string MapHeader(TemplateTestField f) => f.State switch
    {
        FieldState.Found => $"← {f.FoundHeader}",
        FieldState.Ambiguous => $"matches columns {string.Join(" and ", f.Sources.Select(c => c.Letter))}",
        _ => "not found"
    };

    private static (string Cls, string Text) MapTag(TemplateTestField f) => f.State switch
    {
        FieldState.Found => f.IsAlias ? ("tt-tag-alias", "Alias") : ("", ""),
        FieldState.RequiredMissing => ("tt-tag-req", "Required · missing"),
        FieldState.Ambiguous => ("tt-tag-req", "Ambiguous · not read"),
        _ => ("tt-tag-opt", "Optional · left empty")
    };

    // Hover text: what the template looked for.
    private static string? MapTitle(TemplateTestField f) =>
        f.State == FieldState.Found ? null : $"Looked for: {string.Join(", ", f.LookedFor.Select(h => $"\"{h}\""))}";

    private static string FieldIcon(TemplateTestField f) => f.State switch
    {
        FieldState.Found => "ti-check text-success",
        FieldState.OptionalMissing => "ti-minus",
        _ => "ti-x"
    };

    private static string BlockedWhy(TemplateTestSheet s)
    {
        var parts = new List<string>();
        var missing = s.Fields.Where(f => f.State == FieldState.RequiredMissing).Select(f => f.Display).ToList();
        var ambiguous = s.Fields.Where(f => f.State == FieldState.Ambiguous).Select(f => f.Display).ToList();
        if (missing.Count > 0) parts.Add($"{string.Join(", ", missing)} can't be read, so this sheet can't be imported.");
        if (ambiguous.Count > 0) parts.Add($"{string.Join(", ", ambiguous)} matches more than one column, so it isn't read.");
        return parts.Count == 0 ? "This sheet can't be imported as it is." : string.Join(" ", parts);
    }

    // One issue: kind chip, what happened, and where to fix it (the Excel file or the template).
    private RenderFragment<TemplateTestIssue> IssueRow => i => @<div class="tt-issue" @onclick="() => Jump(i)">
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(i.IsBlocking ? "bg-danger" : "bg-warning text-dark")">@i.KindLabel</span>
            <span class="fw-medium">@i.Title</span>
            @if (i.SheetLabel is not null)
            {
                <i class="ti ti-arrow-right ms-auto text-muted"></i>
            }
        </div>
        @if (i.SheetLabel is not null || i.Detail is not null)
        {
            <div class="small text-muted mt-1">@(i.RowNumber is not null ? $"{i.SheetLabel} · row {i.RowNumber}" + (i.Detail is null ? "" : " · ") : "")@i.Detail</div>
        }
        @if (i.FixInFile is not null)
        {
            <div class="tt-fix"><i class="ti ti-file-spreadsheet"></i><span><b class="text-body">Fix in the Excel file:</b> @i.FixInFile</span></div>
        }
        @if (i.FixInTemplate is not null)
        {
            <div class="tt-fix"><i class="ti ti-template"></i><span><b class="text-body">Fix in the template:</b> @i.FixInTemplate</span></div>
        }
    </div>;
}
