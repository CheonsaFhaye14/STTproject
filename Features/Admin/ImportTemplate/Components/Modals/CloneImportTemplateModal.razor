<Modal ShowModal="true" Width="500px" IconType="ModalIconType.Clone" MaxWidth="100%" MaxHeight="88vh" Subtitle="Clone an existing import template" Title="Clone template" OnClose="OnCancel">
    <ChildContent>
        @if (_scope == ImportScope.Principal)
        {
            <AutoComplete Label="Copy to principal"
                          Placeholder="Search for a principal…"
                          Items="Principals"
                          ShowAllOnOpen="true"
                          SelectedValue="@_dto.TargetPrincipal"
                          SelectedValueChanged="v => _dto.TargetPrincipal = v" />
        }
        else
        {
            <AutoComplete Label="Copy to subdistributor"
                          Placeholder="Search for a subdistributor…"
                          Items="Subds"
                          ShowAllOnOpen="true"
                          ValueSelector="s => s.SubDistributorId.ToString()"
                          TextSelector="s => s.Display"
                          SelectedValue="@_dto.TargetSubDistributorId?.ToString()"
                          SelectedValueChanged="v => _dto.TargetSubDistributorId = string.IsNullOrWhiteSpace(v) ? null : int.Parse(v)" />
        }
            <Input Label="New template name"
                Placeholder="Enter a name for the new template"
                AddOptionalText="true" 
                @bind-Value="_dto.TemplateName"/>
    </ChildContent>
    <FooterContent>
        <Button Title="Cancel" OnClick="OnCancel" Variant="ButtonVariant.Secondary" />
        <Button Title="Clone"
                OnClick="() => OnConfirm.InvokeAsync(_dto)"
                Disabled="@IsSaving"
                Variant="ButtonVariant.Primary" />
    </FooterContent>
</Modal>

@code {
    [Parameter, EditorRequired] public ImportTemplateListItemDto Source { get; set; } = default!;
    [Parameter] public List<SubDistributorOptionDto> Subds { get; set; } = new();
    [Parameter] public List<string> Principals { get; set; } = new();
    [Parameter] public List<string> Errors { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback<CloneImportTemplateDto> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private CloneImportTemplateDto _dto = new();
    private ImportScope? _scope;

    private string TypeDisplay =>
        ImportFieldRegistry.Get(Source.ImportType)?.Display ?? Source.ImportType;

    protected override void OnInitialized()
    {
        _dto = new CloneImportTemplateDto { SourceTemplateId = Source.ImportTemplateId };
        _scope = ImportFieldRegistry.Get(Source.ImportType)?.Scope;
    }
}