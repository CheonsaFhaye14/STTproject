@page "/admin/import-templates"
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@using STTproject.Shared.Components
@using STTproject.Shared.Components.Buttons
@inject NavigationManager Nav

<LoadingOverlay Show="isLoading"
                Title="Loading Templates…"
                Subtitle="Please wait while we fetch the latest data."
                IconClass="fa-solid fa-file-import" />

<div style="@(isLoading ? "display:none;" : "")">
    <div class="clt-page">
        <div class="clt-page-header">
            <div>
                <h1 class="clt-page-title">Import Templates</h1>
                <p class="clt-page-sub">Tell each import how to read a subdistributor's or principal's file.</p>
            </div>
            <Button Title="New template" OnClick="@(() => Nav.NavigateTo("/admin/import-templates/new"))"
                    Icon="fa-solid fa-plus" Variant="ButtonVariant.Primary" />
        </div>

        <ImportTemplatesTable OnLoaded="OnTableLoaded" />
    </div>
</div>

@code {
    private bool isLoading = true;

    private async Task OnTableLoaded()
    {
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}