@page "/admin/import-templates/new"
@page "/admin/import-templates/{Id:int}"

@inject TemplateDraftService Drafts
@implements IDisposable
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@inject IImportTemplateService TemplateService
@inject STTproject.Services.IUserContextService UserContextService
@inject NavigationManager Nav
<link href="css/import-templates.css" rel="stylesheet" />
<div class="mb-3">
    <a href="/admin/import-templates" class="small">← Back to templates</a>
    <h3 class="mb-0">@(IsNew ? "New import template" : "Edit import template")</h3>
</div>

@if (FromErrorId is int fromId)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
        <span>
            <strong>Opened from import error #@fromId.</strong>
            @FocusHint()
            @if (_model?.IsGlobalDefault == true)
            {
                <span><b>This is the global default template.</b> Changing it affects every subdistributor that has no template
                    of its own.</span>
                }
                @if (BatchId is int b)
                {
                    <span>You are fixing the template used by <b>batch #@b</b>.</span>
                }
                Nothing changes until you save. Saving does not resolve the error, and it does not re-check other files it
                appeared in. Re-import each affected file; the error closes only once its rows pass validation.
            </span>
            <a href="@ErrorUrl">← Back to the error</a>
        </div>
    }

    @if (_loading)
    {
        <div class="text-muted">Loading...</div>
    }
    else if (_model is null)
    {
        <div class="alert alert-warning">This template no longer exists.</div>
    }
    else
    {
        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger">
                <strong>Please fix the following:</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }
        @if (_pendingDraft is not null)
        {
            <ConfirmModal Show="true" Title="Unsaved draft found" IconClass="fa-solid fa-file-pen"
                          Message="You have an unsaved draft for this template. Do you want to restore it or discard it?"
                          YesLabel="Restore draft" NoLabel="Discard" OnYes="RestoreDraft" OnNo="DiscardDraft" />
        }
        <div class="it-form">
            <TemplateInfo Model="_model" Subds="_subds" Principals="_principals" IsNew="IsNew" @bind-IsGlobal="_isGlobal"
                          OnChanged="Refresh" />

            <SheetColumnsInfo Model="_model" FocusField="@(FromErrorId.HasValue ? Focus : null)" />

            <TemplateTester Model="_model" Subds="_subds" />
        </div>
        <div class="d-flex justify-content-end gap-2">
            <Button Variant="ButtonVariant.Primary" OnClick="SaveAsync" Disabled="@_saving"
                    Title="@(_saving ? "Saving..." : "Save the template")"></Button>
            <Button Variant="ButtonVariant.Secondary" OnClick="CancelAsync" Title="Cancel"></Button>
        </div>
    }

@code {
    [Parameter] public int? Id { get; set; }

    // Set when the admin arrives from Import Error details ("Fix template"). Used only for the banner and the return link.
    [SupplyParameterFromQuery(Name = "fromError")] public int? FromErrorId { get; set; }
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }

    // The batch whose import context (subdistributor and import type) chose this template. Display only.
    [SupplyParameterFromQuery(Name = "batch")] public int? BatchId { get; set; }

    private string ErrorUrl => FromErrorId is int e ? $"/admin/import-errors/{e}" : "/admin/import-errors";
    private string BackUrl => FromErrorId.HasValue ? ErrorUrl : "/admin/import-templates";

    private string FocusHint() => string.IsNullOrWhiteSpace(Focus)
        ? string.Empty
        : $"Check the \"{Focus}\" column mapping and its date format.";

    private ImportTemplateEditDto? _model;
    private List<SubDistributorOptionDto> _subds = new();
    private List<string> _principals = new();
    private List<string> _errors = new();
    private bool _loading = true;
    private bool _saving;
    private bool _isGlobal = true;

    // Draft state
    private TemplateDraftService.Draft? _pendingDraft;
    private System.Threading.Timer? _timer;
    private string? _lastJson;

    private bool IsNew => Id is null;

    private ImportScope? Scope => _model is null ? null : ImportFieldRegistry.Get(_model.ImportType)?.Scope;

    protected override async Task OnInitializedAsync()
    {
        _subds = await TemplateService.GetSubDistributorsAsync();
        _principals = await TemplateService.GetPrincipalsAsync();

        _model = Id is int id
            ? await TemplateService.GetAsync(id)
            : NewModel();

        if (_model is not null)
        {
            _isGlobal = _model.SubDistributorId is null && string.IsNullOrWhiteSpace(_model.Principal);
            _lastJson = Snapshot();
        }

        _loading = false;
    }

    private static ImportTemplateEditDto NewModel() => new()
    {
        Sheets =
        {
            new ImportTemplateSheetEditDto
            {
                SheetLabel = "Sheet 1",
                Columns = { new ImportTemplateColumnEditDto() }
            }
        }
    };

    private void Refresh() { }

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(_model);

    private Task CancelAsync()
    {
        Nav.NavigateTo(BackUrl);
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;

        _errors = new();

        if (!_isGlobal && _model.SubDistributorId is null && string.IsNullOrWhiteSpace(_model.Principal))
        {
            _errors.Add(Scope == ImportScope.Principal
                ? "Select a principal, or switch to Global default."
                : "Select a subdistributor, or switch to Global default.");
            return;
        }

        _saving = true;

        var userId = UserContextService.UserId ?? 0;
        var result = await TemplateService.SaveAsync(_model, userId);
        _saving = false;

        if (result.Success)
        {
            _timer?.Dispose();
            await Drafts.ClearAsync(Id);
            Nav.NavigateTo(BackUrl);
        }
        else
            _errors = result.Errors;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _pendingDraft = await Drafts.LoadAsync(Id);
        if (_pendingDraft is not null) StateHasChanged();

        _timer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    
                    if (_model is null || _saving || _pendingDraft is not null) return;

                    var json = Snapshot();
                    if (json == _lastJson) return;
                    _lastJson = json;

                    await Drafts.SaveAsync(Id, _model, _isGlobal);
                }
                catch { /* page closed or circuit gone: ignore */ }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void RestoreDraft()
    {
        _model = _pendingDraft!.Model;
        _isGlobal = _pendingDraft.IsGlobal;
        _pendingDraft = null;
        _lastJson = Snapshot();
    }

    private async Task DiscardDraft()
    {
        await Drafts.ClearAsync(Id);
        _pendingDraft = null;
    }

    public void Dispose() => _timer?.Dispose();
}