@page "/admin/import-templates/new"
@page "/admin/import-templates/{Id:int}"

@layout STTproject.Shared.Layout.Admin.AdminSideBar
@inject IImportTemplateService TemplateService
@inject STTproject.Services.IUserContextService UserContextService
@inject NavigationManager Nav

<div class="mb-3">
    <a href="/admin/import-templates" class="small">← Back to templates</a>
    <h3 class="mb-0">@(IsNew ? "New import template" : "Edit import template")</h3>
</div>

@if (_loading)
{
    <div class="text-muted">Loading...</div>
}
else if (_model is null)
{
    <div class="alert alert-warning">This template no longer exists.</div>
}
else
{
    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>Please fix the following:</strong>
            <ul class="mb-0 ps-3">
                @foreach (var e in _errors) { <li>@e</li> }
            </ul>
        </div>
    }

    <TemplateInfo Model="_model"
                  Subds="_subds"
                  Principals="_principals"
                  IsNew="IsNew"
                  @bind-IsGlobal="_isGlobal"
                  OnChanged="Refresh" />

    <SheetColumnsInfo Model="_model" IsGlobal="_isGlobal" />

    <TemplateTester Model="_model" />

    <div class="d-flex gap-2">
        <Button Variant="ButtonVariant.Primary" OnClick="SaveAsync" Disabled="@_saving" Title="@(_saving ? "Saving..." : "Save the template")"></Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="CancelAsync" Title="Cancel"></Button>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private ImportTemplateEditDto? _model;
    private List<SubDistributorOptionDto> _subds = new();
    private List<string> _principals = new();
    private List<string> _errors = new();
    private bool _loading = true;
    private bool _saving;


    private bool _isGlobal = true;

    private bool IsNew => Id is null;

    private ImportScope? Scope => _model is null ? null : ImportFieldRegistry.Get(_model.ImportType)?.Scope;

    protected override async Task OnInitializedAsync()
    {
        _subds = await TemplateService.GetSubDistributorsAsync();
        _principals = await TemplateService.GetPrincipalsAsync();

        _model = Id is int id
            ? await TemplateService.GetAsync(id)
            : NewModel();

        if (_model is not null)
            _isGlobal = _model.SubDistributorId is null && string.IsNullOrWhiteSpace(_model.Principal);

        _loading = false;
    }

    // A new template starts with one "any sheet" sheet and one empty column row.
    private static ImportTemplateEditDto NewModel() => new()
    {
        Sheets =
        {
            new ImportTemplateSheetEditDto
            {
                SheetLabel = "Sheet 1",
                Columns = { new ImportTemplateColumnEditDto() }
            }
        }
    };

    private void Refresh() { }

     private Task CancelAsync()
    {
        Nav.NavigateTo("/admin/import-templates");
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;

        _errors = new();

        // "Specific" with nobody picked would otherwise be saved as a global template.
        if (!_isGlobal && _model.SubDistributorId is null && string.IsNullOrWhiteSpace(_model.Principal))
        {
            _errors.Add(Scope == ImportScope.Principal
                ? "Select a principal, or switch to Global default."
                : "Select a subdistributor, or switch to Global default.");
            return;
        }

        _saving = true;

        var userId = UserContextService.UserId ?? 0;
        var result = await TemplateService.SaveAsync(_model, userId);
        _saving = false;

        if (result.Success)
            Nav.NavigateTo("/admin/import-templates");
        else
            _errors = result.Errors;
    }
}
