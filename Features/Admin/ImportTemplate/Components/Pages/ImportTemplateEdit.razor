@page "/admin/import-templates/new"
@page "/admin/import-templates/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject IImportTemplateService TemplateService
@inject STTproject.Services.IUserContextService UserContextService
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New" : "Edit") import template</PageTitle>

<div class="mb-3">
    <a href="/admin/import-templates" class="small">← Back to templates</a>
    <h3 class="mb-0">@(IsNew ? "New import template" : "Edit import template")</h3>
</div>

@if (_loading)
{
    <div class="text-muted">Loading...</div>
}
else if (_model is null)
{
    <div class="alert alert-warning">This template no longer exists.</div>
}
else
{
    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>Please fix the following:</strong>
            <ul class="mb-0 ps-3">
                @foreach (var e in _errors) { <li>@e</li> }
            </ul>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Import type</label>
                    <select class="form-select" value="@_model.ImportType"
                            @onchange="ImportTypeChanged" disabled="@(!IsNew)">
                        @foreach (var d in ImportFieldRegistry.All)
                        {
                            <option value="@d.Type">@d.Display</option>
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label">Applies to</label>
                    @if (Scope == ImportScope.Principal)
                    {
                        <select class="form-select" @bind="_model.Principal">
                            <option value="">Global default (all principals)</option>
                            @foreach (var p in _principals) { <option value="@p">@p</option> }
                        </select>
                    }
                    else
                    {
                        <select class="form-select" @bind="_model.SubDistributorId">
                            <option value="">Global default (all subdistributors)</option>
                            @foreach (var s in _subds) { <option value="@s.SubDistributorId">@s.Display</option> }
                        </select>
                    }
                </div>

                <div class="col-md-3">
                    <label class="form-label d-block">Options</label>
                    @if (!IsGlobal)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fallback"
                                   @bind="_model.AllowGlobalFallback" />
                            <label class="form-check-label" for="fallback">Also use the global default</label>
                        </div>
                    }
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_model.IsActive" />
                        <label class="form-check-label" for="active">Active</label>
                    </div>
                    @if (!IsNew)
                    {
                        <div class="text-muted small mt-1">Version @_model.Version</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Missing.Count > 0)
    {
        <div class="alert alert-info small">
            This template has to cover everything the import needs. Still missing:
            <ul class="mb-0 ps-3">
                @foreach (var m in Missing) { <li>@m</li> }
            </ul>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">Columns</div>
        <div class="card-body">
            <ImportTemplateColumnGrid ImportType="@_model.ImportType" Columns="_model.Columns" />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving..." : "Save")
        </button>
        <a class="btn btn-outline-secondary" href="/admin/import-templates">Cancel</a>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private ImportTemplateEditDto? _model;
    private List<SubDistributorOptionDto> _subds = new();
    private List<string> _principals = new();
    private List<string> _errors = new();
    private bool _loading = true;
    private bool _saving;

    private bool IsNew => Id is null;

    private ImportScope? Scope => _model is null ? null : ImportFieldRegistry.Get(_model.ImportType)?.Scope;

    private bool IsGlobal =>
        _model is not null && _model.SubDistributorId is null && string.IsNullOrWhiteSpace(_model.Principal);

    // Same rule the validator uses: global templates, and templates that don't
    // fall back to the global default, have to map every required field.
    private List<string> Missing
    {
        get
        {
            if (_model is null || !(IsGlobal || !_model.AllowGlobalFallback)) return new();
            var mapped = _model.Columns
                .Where(c => !string.IsNullOrWhiteSpace(c.FieldKey))
                .Select(c => c.FieldKey!);
            return ImportFieldRegistry.MissingRequired(_model.ImportType, mapped);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _subds = await TemplateService.GetSubDistributorsAsync();
        _principals = await TemplateService.GetPrincipalsAsync();

        _model = Id is int id
            ? await TemplateService.GetAsync(id)
            : new ImportTemplateEditDto { Columns = { new ImportTemplateColumnEditDto() } };

        _loading = false;
    }

    private void ImportTypeChanged(ChangeEventArgs e)
    {
        if (_model is null) return;

        _model.ImportType = e.Value?.ToString() ?? _model.ImportType;
        _model.SubDistributorId = null;
        _model.Principal = null;

        // Rows that pointed at a field the new type doesn't have go back to "choose a field".
        foreach (var c in _model.Columns.Where(c => !ImportFieldRegistry.IsValidField(_model.ImportType, c.FieldKey)))
        {
            c.FieldKey = null;
            c.ReadMode = "Text";
            c.OptionsJson = null;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;

        _errors = new();
        _saving = true;

        var userId = UserContextService.UserId ?? 0;        
        var result = await TemplateService.SaveAsync(_model, userId);
        _saving = false;

        if (result.Success)
            Nav.NavigateTo("/admin/import-templates");
        else
            _errors = result.Errors;
    }
}