@using STTproject.Features.Admin.Customers.Validators
@inject STTproject.Features.Admin.Customers.Services.IAdminCustomerService AdminCustomerService
@inject STTproject.Features.Admin.Customers.Services.IGeographicDataService GeographicDataService
@inject STTproject.Services.IUserContextService UserContextService

<div class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>
                <i class="ti @(isEdit ? (isViewMode ? "ti-eye" : "ti-edit") : "ti-user-plus")" aria-hidden="true"></i>
                @(isEdit ? (isViewMode ? "View Customer" : "Edit Customer") : "Add New Customer")
            </h3>
        </div>

        <div class="modal-body">

            <div class="acc-item">
                <div class="acc-header" @onclick="() => ExpandCustomerInfo = !ExpandCustomerInfo">
                    <div class="acc-header-left">
                        <div class="acc-icon"><i class="ti ti-user" aria-hidden="true"></i></div>
                        <div>
                            <div class="acc-title">Customer information</div>
                            <div class="acc-sub">@GetCustomerInfoSummary()</div>
                        </div>
                    </div>
                    <i class="ti ti-chevron-down acc-chevron @(ExpandCustomerInfo ? "open" : "")" aria-hidden="true"></i>
                </div>
                @if (ExpandCustomerInfo)
                {
                    <div class="acc-body">
                        <div class="form-group">
                            <AutoComplete Label="Subdistributor"
                                          Placeholder="Search subdistributor..."
                                          TItem="STTproject.Features.Admin.Customers.DTOs.SubDistributorDto"
                                          Required="true"
                                          Items="SubDistributors"
                                          ValueSelector="x => x.SubDistributorId.ToString()"
                                          TextSelector="x => x.SubDistributorName ?? string.Empty"
                                          SelectedValue="@(SubDistributorId.ToString())"
                                          SelectedItemChanged="OnSubDistributorSelected"
                                          Disabled=@isViewMode />
                            @if (ShowValidationErrors && !string.IsNullOrWhiteSpace(GetFieldError(CustomerValidations.AddCustomer.subdistributor.Key)))
                            {
                                <span class="error-text">@GetFieldError(CustomerValidations.AddCustomer.subdistributor.Key)</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>
                                @CustomerValidations.AddCustomer.customercode.Label<span class="required-asterisk">*</span>
                            </label>
                            <input @bind="CustomerCode" @ref="customerCodeInput" disabled=@isViewMode Placeholder="Enter customer code..." />
                            @if (ShowValidationErrors &&
                            !string.IsNullOrWhiteSpace(GetFieldError(CustomerValidations.AddCustomer.customercode.Key)))
                            {
                                <span class="error-text">@GetFieldError(CustomerValidations.AddCustomer.customercode.Key)</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>
                                @CustomerValidations.AddCustomer.customername.Label<span class="required-asterisk">*</span>
                            </label>
                            <input @bind="CustomerName" @ref="customerNameInput" disabled=@isViewMode Placeholder="Enter customer name..." />
                            @if (ShowValidationErrors &&
                            !string.IsNullOrWhiteSpace(GetFieldError(CustomerValidations.AddCustomer.customername.Key)))
                            {
                                <span class="error-text">@GetFieldError(CustomerValidations.AddCustomer.customername.Key)</span>
                            }
                        </div>

                        <div class="form-group">
                            <AutoComplete Label="Customer Type"
                                          Placeholder="Search or select customer type..."
                                          Items="ExistingCustomerTypes"
                                          Disabled=@isViewMode
                                          SelectedValue="@CustomerType"
                                          SelectedValueChanged="OnCustomerTypeSelected" />
                        </div>

                        <div class="form-group toggle-group">
                            <label class="toggle-label">
                                <span class="toggle-switch">
                                    <input type="checkbox" @bind="IsActive" disabled=@isViewMode />
                                    <span class="toggle-slider"></span>
                                </span>
                                <span class="toggle-text">Is Active</span>
                            </label>
                        </div>
                    </div>
                }
            </div>

            <div class="acc-item">
                <div class="acc-header" @onclick="() => ExpandCustomerAddress = !ExpandCustomerAddress">
                    <div class="acc-header-left">
                        <div class="acc-icon"><i class="ti ti-map-pin" aria-hidden="true"></i></div>
                        <div>
                            <div class="acc-title">Customer address</div>
                            <div class="acc-sub">@GetAddressSummary()</div>
                        </div>
                    </div>
                    <i class="ti ti-chevron-down acc-chevron @(ExpandCustomerAddress ? "open" : "")" aria-hidden="true"></i>
                </div>
                @if (ExpandCustomerAddress)
                {
                    <div class="acc-body">
                        <div class="form-group">
                            <AutoComplete Label="Island"
                                          Placeholder="Search or select island..."
                                          Items="Islands"
                                          SelectedValue="@Island"
                                          SelectedValueChanged="OnIslandSelected"
                                          Disabled=@isViewMode />
                        </div>
                        <div class="form-group">
                            <AutoComplete Label="Province"
                                          Placeholder="Search or select province..."
                                          Items="Provinces"
                                          SelectedValue="@Province"
                                          SelectedValueChanged="OnProvinceSelected"
                                          Disabled=@isViewMode />
                        </div>

                        <div class="form-group">
                            <AutoComplete Label="City / Municipality"
                                          Placeholder="Search or select city / municipality..."
                                          Items="CitiesMunicipalities"
                                          SelectedValue="@City"
                                          SelectedValueChanged="OnCitySelected"
                                          Disabled=@isViewMode />
                        </div>

                        <div class="form-group">
                            <label>Address Line</label>
                            <input @bind="AddressLine" @ref="addressLineInput" disabled=@isViewMode Placeholder="Enter address line..." />
                        </div>

                        <div class="form-group">
                            <label>Zip Code</label>
                            <input @bind="ZipCode" @ref="zipCodeInput" disabled=True Placeholder="Auto-populated based on selected city..." />
                        </div>
                    </div>
                }
            </div>

            @{
                bool hasAnyPairData = SubdCustPairs.Any(p => !string.IsNullOrWhiteSpace(p.SubdCustCode) || !string.IsNullOrWhiteSpace(p.SubdCustName));
            }

            @if (!isViewMode || hasAnyPairData)
            {
                <div class="acc-item">
                    <div class="acc-header" @onclick="() => ShowSubdMapping = !ShowSubdMapping">
                        <div class="acc-header-left">
                            <div class="acc-icon"><i class="ti ti-link" aria-hidden="true"></i></div>
                            <div>
                                <div class="acc-title">Subd customer mapping <span class="optional-tag">optional</span></div>
                                <div class="acc-sub">@(hasAnyPairData ? $"{SubdCustPairs.Count(p => !string.IsNullOrWhiteSpace(p.SubdCustCode) || !string.IsNullOrWhiteSpace(p.SubdCustName))} mapping(s) added" : "No mappings yet")</div>
                            </div>
                        </div>
                        <i class="ti ti-chevron-down acc-chevron @(ShowSubdMapping ? "open" : "")" aria-hidden="true"></i>
                    </div>
                    @if (ShowSubdMapping)
                    {
                        <div class="acc-body">
                            @if (isViewMode)
                            {
                                var viewPairs = SubdCustPairs.Where(p => !string.IsNullOrWhiteSpace(p.SubdCustCode) || !string.IsNullOrWhiteSpace(p.SubdCustName)).ToList();
                                <div class="subd-table-wrap">
                                    <table class="subd-table">
                                        <thead>
                                            <tr>
                                                <th class="subd-row-num"></th>
                                                <th>Subd Customer Code</th>
                                                <th>Subd Store Name</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < viewPairs.Count; i++)
                                            {
                                                var pair = viewPairs[i];
                                                <tr>
                                                    <td class="subd-row-num">@(i + 1)</td>
                                                    <td><input value="@pair.SubdCustCode" disabled /></td>
                                                    <td><input value="@pair.SubdCustName" disabled /></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="subd-table-wrap">
                                    <table class="subd-table">
                                        <thead>
                                            <tr>
                                                <th class="subd-row-num"></th>
                                                <th>Subd Customer Code</th>
                                                <th>Subd Store Name</th>
                                                <th class="subd-action-col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < SubdCustPairs.Count; i++)
                                            {
                                                var idx = i;
                                                <tr>
                                                    <td class="subd-row-num">@(idx + 1)</td>
                                                    <td><input @bind="SubdCustPairs[idx].SubdCustCode" placeholder="e.g. SUBD-0001" /></td>
                                                    <td><input @bind="SubdCustPairs[idx].SubdCustName" placeholder="e.g. Green Breeze - Montalban Rizal" /></td>
                                                    <td class="subd-action-col">
                                                        @if (SubdCustPairs.Count > 1)
                                                        {
                                                            <button type="button" class="subd-remove-btn" aria-label="Remove mapping" disabled=@isSubmitting @onclick="() => RemoveSubdPair(idx)">
                                                                <i class="ti ti-trash" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (ShowValidationErrors && SubdPairErrors.TryGetValue(idx, out var pairErr))
                                                {
                                                    <tr class="subd-error-row">
                                                        <td></td>
                                                        <td colspan="3"><span class="error-text">@pairErr</span></td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                    <div class="subd-table-footer">
                                        <button type="button" class="subd-add-btn" @onclick="AddSubdPair">+ Add another subd store</button>
                                    </div>
                                </div>

                                @if (ShowValidationErrors && !string.IsNullOrWhiteSpace(SubdPairsGeneralError))
                                {
                                    <span class="error-text">@SubdPairsGeneralError</span>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @* Audit info — view mode only *@
            @if (isEdit && isViewMode)
            {
                <h4>Audit Information</h4>

                <div class="form-group">
                    <label>Created Date</label>
                    <input value="@CreatedDate.ToString("MMM d, yyyy hh:mm tt")" disabled />
                </div>

                <div class="form-group">
                    <label>Created By</label>
                    <input value="@(CreatedByName ?? CreatedById?.ToString() ?? "—")" disabled />
                </div>

                @if (UpdatedDate.HasValue)
                {
                    <div class="form-group">
                        <label>Updated Date</label>
                        <input value="@UpdatedDate.Value.ToString("MMM d, yyyy hh:mm tt")" disabled />
                    </div>

                    <div class="form-group">
                        <label>Updated By</label>
                        <input value="@(UpdatedByName ?? UpdatedById?.ToString() ?? "—")" disabled />
                    </div>
                }
            }

            <div class="action-buttons">
                @if (isEdit && isViewMode)
                {
                    <Button Title="Edit" Variant="ButtonVariant.Primary" OnClick="EnableEdit"></Button>
                    <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="Cancel"></Button>
                }
                else
                {
                    <Button Title="@(isSubmitting ? (isEdit ? "Saving..." : "Creating...") : (isEdit ? "Save Changes" : "Create Customer"))" Variant="ButtonVariant.Primary" OnClick="CreateCustomer" Disabled="@isSubmitting"></Button>
                    <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting"></Button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    public CustomerCreateDto? PendingDto { get; private set; }
    private bool ShowSubdMapping { get; set; } = false;
    private bool ExpandCustomerInfo { get; set; } = true;
    private bool ExpandCustomerAddress { get; set; } = false;
    private List<SubdCustPairInput> SubdCustPairs { get; set; } = new() { new SubdCustPairInput() };
    private Dictionary<int, string> SubdPairErrors { get; set; } = new();
    private string? SubdPairsGeneralError { get; set; }
    private void AddSubdPair() => SubdCustPairs.Add(new SubdCustPairInput { SubDistributorId = SubDistributorId });

    private void RemoveSubdPair(int idx)
    {
        if (idx >= 0 && idx < SubdCustPairs.Count)
            SubdCustPairs.RemoveAt(idx);
        SubdCustPairs.Add(new SubdCustPairInput { SubDistributorId = SubDistributorId });
    }

    private void ValidateSubdPairs()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        for (int i = 0; i < SubdCustPairs.Count; i++)
        {
            var pair = SubdCustPairs[i];
            var hasCode = !string.IsNullOrWhiteSpace(pair.SubdCustCode);
            var hasName = !string.IsNullOrWhiteSpace(pair.SubdCustName);

            if (!hasCode && !hasName)
                continue; // blank row is fine — optional

            if (hasCode != hasName)
            {
                SubdPairErrors[i] = "Enter both a Subd Customer Code and a Subd Store Name, or leave both blank.";
                continue;
            }

            var key = $"{pair.SubdCustCode!.Trim()}|{pair.SubdCustName!.Trim()}".ToUpperInvariant();
            if (!seen.Add(key))
            {
                SubdPairErrors[i] = "This Subd Customer Code / Store Name pair is already entered above.";
            }
        }
    }

    public CustomerUpdateDto? PendingUpdateDto { get; private set; }

    private bool isViewMode = false;
    private ElementReference customerCodeInput;
    private ElementReference customerNameInput;
    private ElementReference addressLineInput;
    private ElementReference zipCodeInput;

    private int SubDistributorId { get; set; }
    private string? SelectedSubDistributorName { get; set; }
    private List<STTproject.Features.Admin.Customers.DTOs.SubDistributorDto> SubDistributors { get; set; } = new();
    private string? CustomerCode { get; set; }
    private string? CustomerName { get; set; }
    private string? CustomerType { get; set; }
    private bool IsActive { get; set; } = true;
    private string? AddressLine { get; set; }
    private string? City { get; set; }
    private string? Island { get; set; }
    private string? Province { get; set; }
    private int? ZipCode { get; set; }
    private List<string?> CitiesMunicipalities { get; set; } = new();
    private List<string?> Islands { get; set; } = new();
    private List<string?> Provinces { get; set; } = new();
    private List<string> ExistingCustomerTypes { get; set; } = new();

    // Audit fields (view mode only)
    private DateTime CreatedDate { get; set; }
    private DateTime? UpdatedDate { get; set; }
    private int? CreatedById { get; set; }
    private int? UpdatedById { get; set; }
    private string? CreatedByName { get; set; }
    private string? UpdatedByName { get; set; }

    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; } = false;
    private bool isSubmitting = false;

    [Parameter] public int? CustomerId { get; set; }
    private bool isEdit => CustomerId.HasValue;
    private int? CurrentUserId => UserContextService.UserId;

    private string GetFieldError(string key) =>
        Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    private string GetCustomerInfoSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(SelectedSubDistributorName)) parts.Add(SelectedSubDistributorName!);
        if (!string.IsNullOrWhiteSpace(CustomerCode)) parts.Add(CustomerCode!);
        if (!string.IsNullOrWhiteSpace(CustomerName)) parts.Add(CustomerName!);
        if (!string.IsNullOrWhiteSpace(CustomerType)) parts.Add(CustomerType!);
        return parts.Count > 0 ? string.Join(" • ", parts) : "Subdistributor, code, name, type";
    }

    private string GetAddressSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Island)) parts.Add(Island!);
        if (!string.IsNullOrWhiteSpace(Province)) parts.Add(Province!);
        if (!string.IsNullOrWhiteSpace(City)) parts.Add(City!);
        return parts.Count > 0 ? string.Join(" • ", parts) : "Island, province, city, address";
    }

    protected override async Task OnInitializedAsync()
    {
        SubDistributors = (await AdminCustomerService.GetSubDistributorsAsync()).ToList();
        ExistingCustomerTypes = (await AdminCustomerService.GetCustomerTypesAsync()).ToList();
        Provinces = (await GeographicDataService.GetAllProvincesAsync()).ToList();
        Islands = (await GeographicDataService.GetAllIslandsAsync()).ToList();
        CitiesMunicipalities = (await GeographicDataService.GetAllCitiesMunicipalitiesAsync()).ToList();

        if (isEdit)
        {
            isViewMode = true;
            ShowSubdMapping = true;
            var customer = await AdminCustomerService.GetCustomerByIdAsync(CustomerId!.Value);
            if (customer != null)
            {
                SubDistributorId = customer.SubDistributorId;
                SelectedSubDistributorName = SubDistributors
                    .FirstOrDefault(s => s.SubDistributorId == customer.SubDistributorId)?.SubDistributorName;
                CustomerCode = customer.CustomerCode;
                CustomerName = customer.CustomerName;
                CustomerType = customer.CustomerType;
                IsActive = customer.IsActive;
                AddressLine = customer.AddressLine;
                City = customer.City;
                Province = customer.Province;
                ZipCode = customer.ZipCode;

                CreatedDate = customer.CreatedDate;
                UpdatedDate = customer.UpdatedDate;
                CreatedById = customer.CreatedBy;
                UpdatedById = customer.UpdatedBy;
                CreatedByName = await AdminCustomerService.GetUserNameByIdAsync(customer.CreatedBy);
                if (customer.UpdatedBy != null)
                    UpdatedByName = await AdminCustomerService.GetUserNameByIdAsync(customer.UpdatedBy);

                if (!string.IsNullOrWhiteSpace(Province))
                    CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();

                var mappings = (await AdminCustomerService.GetCustomerGroupMappingsAsync(CustomerId!.Value)).ToList();
                SubdCustPairs = mappings.Count > 0
                    ? mappings.Select(m => new SubdCustPairInput
                    {
                        CustomerId = m.CustomerId,
                        SubDistributorId = m.SubDistributorId,
                        SubdCustCode = m.SubdCustCode,
                        SubdCustName = m.SubdCustName
                    }).ToList()
                    : new List<SubdCustPairInput> { new SubdCustPairInput { CustomerId = CustomerId, SubDistributorId = SubDistributorId } };
            }
        }
    }

    private void EnableEdit() => isViewMode = false;

    private async Task CreateCustomer()
    {
        var customerToValidate = new STTproject.Data.Customer
        {
            SubDistributorId = SubDistributorId,
            CustomerCode = CustomerCode ?? string.Empty,
            CustomerName = CustomerName ?? string.Empty,
            CustomerType = CustomerType,
        };

        Errors = await CustomerValidations.ValidateAddCustomerAsync(
            customerToValidate,
            AdminCustomerService,
            isEdit ? SubdCustPairs.Where(p => p.CustomerId.HasValue).Select(p => p.CustomerId!.Value) : null);

        SubdPairErrors.Clear();
        SubdPairsGeneralError = null;
        ValidateSubdPairs(); // now runs for both create and edit

        ShowValidationErrors = true;

        if (Errors.Any() || SubdPairErrors.Any())
            return;

        if (isEdit)
        {
            var anchorPair = SubdCustPairs.FirstOrDefault(p => p.CustomerId == CustomerId);

            PendingUpdateDto = new CustomerUpdateDto
            {
                CustomerId = CustomerId!.Value,
                CustomerCode = CustomerCode,
                CustomerName = CustomerName,
                SubdCustCode = anchorPair?.SubdCustCode,
                SubdCustName = anchorPair?.SubdCustName,
                CustomerType = CustomerType,
                SubDistributorId = SubDistributorId,
                IsActive = IsActive,
                AddressLine = AddressLine,
                City = City,
                Province = Province,
                ZipCode = ZipCode,
                UpdatedBy = CurrentUserId
            };

            PendingGroupUpdateDto = new CustomerGroupUpdateDto
            {
                CustomerId = CustomerId!.Value,
                Mappings = SubdCustPairs
                    .Where(p => p.CustomerId.HasValue || !string.IsNullOrWhiteSpace(p.SubdCustCode) || !string.IsNullOrWhiteSpace(p.SubdCustName))
                    .Select(p => new SubdMappingDto
                    {
                        CustomerId = p.CustomerId ?? 0,
                        SubDistributorId = p.CustomerId.HasValue ? p.SubDistributorId : SubDistributorId,
                        SubdCustCode = p.SubdCustCode,
                        SubdCustName = p.SubdCustName
                    }).ToList()
            };
        }
        else
        {
            var validPairs = SubdCustPairs
                .Where(p => !string.IsNullOrWhiteSpace(p.SubdCustCode) || !string.IsNullOrWhiteSpace(p.SubdCustName))
                .ToList();

            PendingDtos = validPairs.Count == 0
                ? new List<CustomerCreateDto> { BuildCreateDto(null, null) }
                : validPairs.Select(p => BuildCreateDto(p.SubdCustCode, p.SubdCustName)).ToList();
        }

        await OnRequestConfirm.InvokeAsync();
    }

    private List<CustomerCreateDto>? PendingDtos { get; set; }
    private CustomerCreateDto BuildCreateDto(string? subdCode, string? subdName) => new CustomerCreateDto
    {
        CustomerCode = CustomerCode,
        CustomerName = CustomerName,
        SubdCustCode = subdCode,
        SubdCustName = subdName,
        CustomerType = CustomerType,
        SubDistributorId = SubDistributorId,
        IsActive = IsActive,
        AddressLine = AddressLine,
        City = City,
        Province = Province,
        ZipCode = ZipCode,
        CreatedBy = CurrentUserId
    };

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingUpdateDto == null || PendingGroupUpdateDto == null)
                    return (false, "No pending update data.");

                var anchorResult = await AdminCustomerService.UpdateCustomerAsync(PendingUpdateDto);
                if (anchorResult == null)
                    return (false, "Customer not found.");

                var (success, error) = await AdminCustomerService.UpdateCustomerGroupAsync(PendingGroupUpdateDto);
                if (!success)
                {
                    Errors[CustomerValidations.AddCustomer.customercode.Key] = error ?? "Update failed.";
                    ShowValidationErrors = true;
                    await InvokeAsync(StateHasChanged);
                }
                return (success, error);
            }
            else
            {
                if (PendingDtos == null || PendingDtos.Count == 0) return (false, "No pending data.");
                foreach (var dto in PendingDtos)
                {
                    await AdminCustomerService.CreateCustomerAsync(dto);
                }
                return (true, null);
            }
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
            when (ex.InnerException is Microsoft.Data.SqlClient.SqlException sqlEx
                && (sqlEx.Number == 2601 || sqlEx.Number == 2627))
        {
            Errors[CustomerValidations.AddCustomer.customercode.Key] =
                "One of the entered Customer Code / Subd Customer Code combinations already exists for the selected subdistributor.";
            ShowValidationErrors = true;
            await InvokeAsync(StateHasChanged);
            return (false, "Duplicate customer mapping.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task OnSubDistributorSelected(STTproject.Features.Admin.Customers.DTOs.SubDistributorDto? sd)
    {
        if (sd != null)
        {
            SubDistributorId = sd.SubDistributorId;
            SelectedSubDistributorName = sd.SubDistributorName;
        }
        return Task.CompletedTask;
    }

    private Task OnCustomerTypeSelected(string? selected)
    {
        CustomerType = selected;
        return Task.CompletedTask;
    }
    private async Task OnIslandSelected(string? selected)
    {
        Island = selected;
        await UpdateProvincesBasedOnIsland();
    }
    private async Task UpdateProvincesBasedOnIsland()
    {
        if (!string.IsNullOrWhiteSpace(Island))
        {
            Provinces = (await GeographicDataService.GetProvincesByIslandAsync(Island)).ToList();
            Province = null;
            CitiesMunicipalities = (await GeographicDataService.GetCitiesMunicipalitiesByIslandAsync(Island)).ToList();
            City = null;
            ZipCode = null;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task OnProvinceSelected(string? selected)
    {
        Province = selected;
        await ProvinceChanged();
    }

    private async Task ProvinceChanged()
    {
        try
        {
            CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();

        }
        catch (Exception)
        {
            CitiesMunicipalities = new();
        }

        City = null;
        Island = (await GeographicDataService.GetIslandByProvinceAsync(Province));
        ZipCode = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCitySelected(string? selected)
    {
        City = selected;

        if (!string.IsNullOrWhiteSpace(selected) && string.IsNullOrWhiteSpace(Province))
        {
            var inferredProvince = await GeographicDataService.GetProvinceByCityAsync(selected);
            if (!string.IsNullOrWhiteSpace(inferredProvince))
            {
                Province = inferredProvince;
                CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        Island = (await GeographicDataService.GetIslandByProvinceAsync(Province));
        await UpdateZipCode(); // ← now Province is guaranteed to be set before this runs
    }

    private async Task UpdateZipCode()
    {
        if (!string.IsNullOrWhiteSpace(Province) && !string.IsNullOrWhiteSpace(City))
        {
            try
            {
                Console.WriteLine($"[ZIP] Province='{Province}' City='{City}'");
                ZipCode = await GeographicDataService.GetZipCodeAsync(Province, City);
                Console.WriteLine($"[ZIP] Result={ZipCode}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[AddCustomer] UpdateZipCode error: {ex.Message}");
                ZipCode = null;
            }
        }
        else
        {
            ZipCode = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task Cancel()
    {
        if (onCancel.HasDelegate)
            return onCancel.InvokeAsync();
        return Task.CompletedTask;
    }
