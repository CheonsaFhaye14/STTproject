@using STTproject.Features.Admin.Customers.Validators
@using STTproject.Shared.Components.Tables
@inject STTproject.Features.Admin.Customers.Services.IAdminCustomerService AdminCustomerService
@inject STTproject.Features.Admin.Customers.Services.IGeographicDataService GeographicDataService
@inject STTproject.Services.IUserContextService UserContextService

<Modal ShowModal="true" Width="720px" MaxWidth="100%" MaxHeight="88vh"
       Title="@(isEdit ? (isViewMode ? "View Customer" : "Edit Customer") : "Add New Customer")"
       IconType="@(isEdit ? (isViewMode ? ModalIconType.UserView : ModalIconType.UserEdit) : ModalIconType.UserPlus)"
       OnClose="Cancel">
    <ChildContent>
        <FormSection Icon="ti ti-user" Title="Customer Information" Summary="@GetCustomerInfoSummary()"
                     Expandable="true" IsExpanded="true">
            <ChildContent>
                <div class="form-group">
                    <AutoComplete Label="Subdistributor" Placeholder="Search subdistributor..."
                                  TItem="STTproject.Features.Admin.Customers.DTOs.SubDistributorDto" Required="true"
                                  Items="SubDistributors" ValueSelector="x => x.SubDistributorId.ToString()"
                                  TextSelector="x => x.SubDistributorName ?? string.Empty"
                                  SelectedValue="@(SubDistributorId.ToString())" SelectedItemChanged="OnSubDistributorSelected"
                                  Disabled=@isViewMode ShowError="@ShowValidationErrors"
                                  ErrorText="@GetFieldError(CustomerValidations.AddCustomer.subdistributor.Key)" />
                </div>

                <div class="form-group">
                    <Input Label="@CustomerValidations.AddCustomer.customercode.Label" Required="true"
                           @bind-Value="CustomerCode" Disabled="@isViewMode" Placeholder="Enter customer code..."
                           ShowError="@ShowValidationErrors"
                           ErrorText="@GetFieldError(CustomerValidations.AddCustomer.customercode.Key)" />
                </div>

                <div class="form-group">
                    <Input Label="Customer Name" Required="true" @bind-Value="CustomerName" Disabled="@isViewMode"
                           Placeholder="Enter customer name..." ShowError="@ShowValidationErrors"
                           ErrorText="@GetFieldError(CustomerValidations.AddCustomer.customername.Key)" />
                </div>
                @if (!isViewMode || (isViewMode && !string.IsNullOrWhiteSpace(CustomerType)))
                {
                    <div class="form-group">
                        <AutoComplete Label="Customer Type" Placeholder="Search or select customer type..."
                                      Items="ExistingCustomerTypes" Disabled=@isViewMode SelectedValue="@CustomerType"
                                      SelectedValueChanged="OnCustomerTypeSelected" AllowCustomValue="true" />
                    </div>
                }
                <div class="form-group">
                    <Toggle @bind-Bind="IsActive" Disabled=@isViewMode />
                </div>
            </ChildContent>
        </FormSection>

        @if (!isViewMode || (isViewMode && (!string.IsNullOrWhiteSpace(Island) || !string.IsNullOrWhiteSpace(Province)
        ||
        !string.IsNullOrWhiteSpace(City) || !string.IsNullOrWhiteSpace(AddressLine) || ZipCode.HasValue)))
        {
            <FormSection Icon="ti ti-map-pin" Title="Customer Address" Optional="true" Summary="@GetAddressSummary()"
                         Expandable="true" IsExpanded="false">
                <ChildContent>
                    @if (!@isViewMode)
                    {
                        <div class="form-group">
                            <AutoComplete Label="Island" Placeholder="Search or select island..." Items="Islands"
                                          SelectedValue="@Island" SelectedValueChanged="OnIslandSelected" Disabled=@isViewMode />
                        </div>
                    }
                    @if (!isViewMode || (isViewMode && !string.IsNullOrWhiteSpace(Province)))
                    {
                        <div class="form-group">
                            <AutoComplete Label="Province" Placeholder="Search or select province..." Items="Provinces"
                                          SelectedValue="@Province" SelectedValueChanged="OnProvinceSelected" Disabled=@isViewMode
                                          AllowCustomValue="true" />
                        </div>
                    }
                    @if (!isViewMode || (isViewMode && !string.IsNullOrWhiteSpace(City)))
                    {
                        <div class="form-group">
                            <AutoComplete Label="City / Municipality" Placeholder="Search or select city / municipality..."
                                          Items="CitiesMunicipalities" SelectedValue="@City" SelectedValueChanged="OnCitySelected"
                                          Disabled=@isViewMode AllowCustomValue="true" />
                        </div>
                    }
                    @if (!isViewMode || (isViewMode && !string.IsNullOrWhiteSpace(AddressLine)))
                    {
                        <div class="form-group">
                            <Input Label="Address Line" @bind-Value="AddressLine" Disabled=@isViewMode
                                   Placeholder="Enter address line..." />
                        </div>
                    }
                    @if (!isViewMode || (isViewMode && ZipCode.HasValue))
                    {
                        <div class="form-group">
                            <Input Label="Zip Code" @bind-Value="ZipCode" Disabled=true
                                   Placeholder="Auto-populated based on selected city..." />
                        </div>
                    }
                </ChildContent>
            </FormSection>
        }
        @{
            var filledPairCount = SubdCustPairs.Count(p => !SubdCustomerKey.IsBlank(p.SubdCustCode, p.SubdCustName));
            bool hasAnyPairData = filledPairCount > 0;
        }

        @if (!isViewMode || hasAnyPairData)
        {
            <FormSection Icon="ti ti-link" Title="Subd Customer Mapping" Optional="true"
                         Summary="@(hasAnyPairData ? $"{filledPairCount} mapping(s) added" : "No mappings yet")" Expandable="true"
                         IsExpanded="isEdit || hasAnyPairData">
                <ChildContent>
                    <AddTable TItem="SubdCustPairInput" Items="SubdCustPairs"
                              Columns="@(new List<string> { "SubdCustCode", "SubdCustName" })"
                              ColumnLabels="@(new Dictionary<string,string> { ["SubdCustCode"] = "Subd Customer Code", ["SubdCustName"] = "Subd Store Name" })"
                              ColumnPlaceholders="@(new Dictionary<string,string> { ["SubdCustCode"] = "e.g. SUBD-0001", ["SubdCustName"] = "e.g. Green Breeze - Montalban Rizal" })"
                              EditableColumns="@(new List<string> { "SubdCustCode", "SubdCustName" })" ViewMode="isViewMode"
                              Disabled="isSubmitting" MinItems="1" AddButtonVisible="!isViewMode"
                              AddTableButtonText="+ Add another subd store" OnAdd="AddSubdPair" RemoveButtonVisible="!isViewMode"
                              RemoveButtonDisabled="isSubmitting" OnRemove="RemoveSubdPair" ShowError="ShowValidationErrors"
                              ErrorSelector="@(idx => SubdPairErrors.TryGetValue(idx, out var err) ? err : null)"
                              GeneralErrorText="@SubdPairsGeneralError" />
                </ChildContent>
            </FormSection>
        }
        @if (isViewMode)
        {
            <FormSection Icon="ti ti-info-circle" Title="Audit Information" Expandable="true" IsExpanded="true">
                <ChildContent>
                    @if (CreatedByName != null)
                    {
                        <div class="form-group">
                            <Input Label="Created By" Disabled="true" @bind-Value="@CreatedByName" />
                        </div>
                    }
                    <div class="form-group">
                        <Input Label="Created Date" Disabled="true" Value="CreatedDateDisplay" />
                    </div>
                    @if (UpdatedByName != null)
                    {
                        <div class="form-group">
                            <Input Label="Updated By" Disabled="true" @bind-Value="@UpdatedByName" />
                        </div>
                    }
                    @if (UpdatedDate != null)
                    {
                        <div class="form-group">
                            <Input Label="Updated Date" Disabled="true" Value="UpdatedDateDisplay" />
                        </div>
                    }
                </ChildContent>
            </FormSection>
        }

    </ChildContent>
    <FooterContent>
        @if (isEdit && isViewMode)
        {
            <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="Cancel"></Button>
            <Button Title="Edit" Variant="ButtonVariant.Primary" OnClick="EnableEdit"></Button>
        }
        else
        {
            <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting"></Button>
            <Button
            Title="@(isSubmitting ? (isEdit ? "Saving..." : "Creating...") : (isEdit ? "Save Changes" : "Create Customer"))"
            Variant="ButtonVariant.Primary" OnClick="CreateCustomer" Disabled="@isSubmitting"></Button>
        }
    </FooterContent>
</Modal>




@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    [Parameter] public int? CustomerId { get; set; }

    private bool isEdit => CustomerId.HasValue;
    private bool isViewMode = false;
    private bool isSubmitting = false;
    private int? CurrentUserId => UserContextService.UserId;

    // ── Customer fields ───────────────────────────────────────────────
    private int SubDistributorId { get; set; }
    private string? SelectedSubDistributorName { get; set; }
    private List<STTproject.Features.Admin.Customers.DTOs.SubDistributorDto> SubDistributors { get; set; } = new();
    private string? CustomerCode { get; set; }
    private string? CustomerName { get; set; }
    private string? CustomerType { get; set; }
    private bool IsActive { get; set; } = true;
    private string? AddressLine { get; set; }
    private string? City { get; set; }
    private string? Island { get; set; }
    private string? Province { get; set; }
    private int? ZipCode { get; set; }
    private List<string?> CitiesMunicipalities { get; set; } = new();
    private List<string?> Islands { get; set; } = new();
    private List<string?> Provinces { get; set; } = new();
    private List<string> ExistingCustomerTypes { get; set; } = new();

    // ── Audit fields (view mode only) ─────────────────────────────────
    private DateTime CreatedDate { get; set; }
    private DateTime? UpdatedDate { get; set; }
    private string? CreatedByName { get; set; }
    private string? UpdatedByName { get; set; }
    private string? CreatedDateDisplay => CreatedDate.ToString("MMM d, yyyy hh:mm tt");
    private string? UpdatedDateDisplay => UpdatedDate?.ToString("MMM d, yyyy hh:mm tt");

    // ── Validation ────────────────────────────────────────────────────
    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; } = false;
    private string GetFieldError(string key) => Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    // ── Subd mappings ─────────────────────────────────────────────────
    // Each row is one SubdCustomer. SubdCustomerId is set for rows loaded from the database.
    private sealed class SubdCustPairInput
    {
        public int? SubdCustomerId { get; set; }
        public string? SubdCustCode { get; set; }
        public string? SubdCustName { get; set; }
    }

    private List<SubdCustPairInput> SubdCustPairs { get; set; } = new() { new SubdCustPairInput() };
    private Dictionary<int, string> SubdPairErrors { get; set; } = new();
    private string? SubdPairsGeneralError { get; set; }

    private void AddSubdPair() => SubdCustPairs.Add(new SubdCustPairInput());

    // AddTable removes the row itself; this keeps one empty row available to type into.
    private void RemoveSubdPair(int idx)
    {
        if (SubdCustPairs.Count == 0 ||
            SubdCustPairs.All(p => !SubdCustomerKey.IsBlank(p.SubdCustCode, p.SubdCustName)))
        {
            SubdCustPairs.Add(new SubdCustPairInput());
        }
    }

    // Non-blank rows as DTOs. A code-only or name-only row is a valid mapping on its own.
    private List<SubdMappingDto> BuildMappings() =>
        SubdCustPairs
            .Where(p => !SubdCustomerKey.IsBlank(p.SubdCustCode, p.SubdCustName))
            .Select(p => new SubdMappingDto
            {
                SubdCustomerId = p.SubdCustomerId ?? 0,
                SubdCustCode = SubdCustomerKey.Code(p.SubdCustCode),
                SubdCustName = SubdCustomerKey.Name(p.SubdCustName)
            })
            .ToList();

    // Checks lengths, repeats within the form, and pairs already used by another customer.
    private async Task ValidateSubdPairsAsync()
    {
        var rowByKey = new Dictionary<string, int>();

        for (int i = 0; i < SubdCustPairs.Count; i++)
        {
            var pair = SubdCustPairs[i];
            var code = SubdCustomerKey.Code(pair.SubdCustCode);
            var name = SubdCustomerKey.Name(pair.SubdCustName);

            if (code.Length == 0 && name.Length == 0)
                continue;

            if (code.Length > SubdCustomerKey.CodeMaxLength)
            {
                SubdPairErrors[i] = $"Subd Customer Code can be at most {SubdCustomerKey.CodeMaxLength} characters.";
                continue;
            }
            if (name.Length > SubdCustomerKey.NameMaxLength)
            {
                SubdPairErrors[i] = $"Subd Store Name can be at most {SubdCustomerKey.NameMaxLength} characters.";
                continue;
            }

            if (!rowByKey.TryAdd(SubdCustomerKey.Compare(code, name), i))
                SubdPairErrors[i] = "This Subd Customer Code / Store Name pair is already entered above.";
        }

        if (SubdPairErrors.Count > 0 || SubDistributorId <= 0 || rowByKey.Count == 0)
            return;

        var conflicts = await AdminCustomerService.FindMappingConflictsAsync(SubDistributorId, BuildMappings(), CustomerId);
        foreach (var c in conflicts)
        {
            if (rowByKey.TryGetValue(SubdCustomerKey.Compare(c.SubdCustCode, c.SubdCustName), out var idx))
                SubdPairErrors[idx] = $"Already mapped to customer {c.CustomerCode} – {c.CustomerName}.";
        }
    }

    // ── Load ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        SubDistributors = (await AdminCustomerService.GetSubDistributorsAsync()).ToList();
        ExistingCustomerTypes = (await AdminCustomerService.GetCustomerTypesAsync()).ToList();
        Provinces = (await GeographicDataService.GetAllProvincesAsync()).ToList();
        Islands = (await GeographicDataService.GetAllIslandsAsync()).ToList();
        CitiesMunicipalities = (await GeographicDataService.GetAllCitiesMunicipalitiesAsync()).ToList();

        if (!isEdit) return;

        isViewMode = true;
        var customer = await AdminCustomerService.GetCustomerByIdAsync(CustomerId!.Value);
        if (customer == null) return;

        SubDistributorId = customer.SubDistributorId;
        SelectedSubDistributorName = SubDistributors
            .FirstOrDefault(s => s.SubDistributorId == customer.SubDistributorId)?.SubDistributorName;
        CustomerCode = customer.CustomerCode;
        CustomerName = customer.CustomerName;
        CustomerType = customer.CustomerType ?? string.Empty;
        IsActive = customer.IsActive;
        City = customer.City;
        Province = customer.Province;
        ZipCode = customer.ZipCode;
        AddressLine = customer.AddressLine;

        CreatedDate = customer.CreatedDate;
        UpdatedDate = customer.UpdatedDate;
        CreatedByName = await AdminCustomerService.GetUserNameByIdAsync(customer.CreatedBy);
        if (customer.UpdatedBy != null)
            UpdatedByName = await AdminCustomerService.GetUserNameByIdAsync(customer.UpdatedBy);

        if (!string.IsNullOrWhiteSpace(Province))
            CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();

        SubdCustPairs = customer.Mappings.Count > 0
            ? customer.Mappings.Select(m => new SubdCustPairInput
            {
                SubdCustomerId = m.SubdCustomerId,
                SubdCustCode = m.SubdCustCode,
                SubdCustName = m.SubdCustName
            }).ToList()
            : new List<SubdCustPairInput> { new SubdCustPairInput() };
    }

    private void EnableEdit() => isViewMode = false;

    // ── Save (validate → confirm → SubmitAsync) ───────────────────────
    private CustomerUpdateDto? PendingDto { get; set; }

    private async Task CreateCustomer()
    {
        var customerToValidate = new STTproject.Data.Customer
        {
            SubDistributorId = SubDistributorId,
            CustomerCode = CustomerCode ?? string.Empty,
            CustomerName = CustomerName ?? string.Empty,
            CustomerType = CustomerType,
        };

        Errors = await CustomerValidations.ValidateAddCustomerAsync(customerToValidate, AdminCustomerService, CustomerId);

        SubdPairErrors.Clear();
        SubdPairsGeneralError = null;
        await ValidateSubdPairsAsync();

        ShowValidationErrors = true;
        if (Errors.Any() || SubdPairErrors.Any())
            return;

        PendingDto = new CustomerUpdateDto
        {
            CustomerId = CustomerId ?? 0,
            CustomerCode = CustomerCode,
            CustomerName = CustomerName,
            CustomerType = CustomerType,
            SubDistributorId = SubDistributorId,
            IsActive = IsActive,
            AddressLine = AddressLine,
            City = City,
            Province = Province,
            ZipCode = ZipCode,
            CreatedBy = CurrentUserId,
            UpdatedBy = CurrentUserId,
            Mappings = BuildMappings()
        };

        await OnRequestConfirm.InvokeAsync();
    }

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        if (PendingDto == null) return (false, "No pending data.");

        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                var updated = await AdminCustomerService.UpdateCustomerAsync(PendingDto);
                if (updated == null) return (false, "Customer not found.");
            }
            else
            {
                await AdminCustomerService.CreateCustomerAsync(PendingDto);
            }
            return (true, null);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
            when (ex.InnerException is Microsoft.Data.SqlClient.SqlException sqlEx
                && (sqlEx.Number == 2601 || sqlEx.Number == 2627))
        {
            // Someone saved the same code or mapping between validation and save.
            var sqlMessage = ex.InnerException.Message;
            if (sqlMessage.Contains("vw_SubdCustomerKey", StringComparison.OrdinalIgnoreCase))
                SubdPairsGeneralError = "One of the Subd Customer Code / Store Name pairs is already mapped to another customer in this subdistributor.";
            else
                Errors[CustomerValidations.AddCustomer.customercode.Key] = "This Customer Code already exists for the selected Subdistributor.";

            ShowValidationErrors = true;
            await InvokeAsync(StateHasChanged);
            return (false, "Duplicate customer or mapping.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // ── Summaries ─────────────────────────────────────────────────────
    private string GetCustomerInfoSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(SelectedSubDistributorName)) parts.Add(SelectedSubDistributorName!);
        if (!string.IsNullOrWhiteSpace(CustomerCode)) parts.Add(CustomerCode!);
        if (!string.IsNullOrWhiteSpace(CustomerName)) parts.Add(CustomerName!);
        if (!string.IsNullOrWhiteSpace(CustomerType)) parts.Add(CustomerType!);
        return parts.Count > 0 ? string.Join(" • ", parts) : "Subdistributor, code, name, type";
    }

    private string GetAddressSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Island)) parts.Add(Island!);
        if (!string.IsNullOrWhiteSpace(Province)) parts.Add(Province!);
        if (!string.IsNullOrWhiteSpace(City)) parts.Add(City!);
        return parts.Count > 0 ? string.Join(" • ", parts) : "Island, province, city, address";
    }

    // ── Field handlers ────────────────────────────────────────────────
    private Task OnSubDistributorSelected(STTproject.Features.Admin.Customers.DTOs.SubDistributorDto? sd)
    {
        if (sd != null)
        {
            SubDistributorId = sd.SubDistributorId;
            SelectedSubDistributorName = sd.SubDistributorName;
        }
        return Task.CompletedTask;
    }

    private Task OnCustomerTypeSelected(string? selected)
    {
        CustomerType = selected;
        return Task.CompletedTask;
    }

    private async Task OnIslandSelected(string? selected)
    {
        Island = selected;
        await UpdateProvincesBasedOnIsland();
    }

    private async Task UpdateProvincesBasedOnIsland()
    {
        if (!string.IsNullOrWhiteSpace(Island))
        {
            Provinces = (await GeographicDataService.GetProvincesByIslandAsync(Island)).ToList();
            Province = null;
            CitiesMunicipalities = (await GeographicDataService.GetCitiesMunicipalitiesByIslandAsync(Island)).ToList();
            City = null;
            ZipCode = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnProvinceSelected(string? selected)
    {
        Province = selected;
        await ProvinceChanged();
    }

    private async Task ProvinceChanged()
    {
        try
        {
            CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();
        }
        catch (Exception)
        {
            CitiesMunicipalities = new();
        }

        City = null;
        Island = await GeographicDataService.GetIslandByProvinceAsync(Province);
        ZipCode = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCitySelected(string? selected)
    {
        City = selected;

        if (!string.IsNullOrWhiteSpace(selected) && string.IsNullOrWhiteSpace(Province))
        {
            var inferredProvince = await GeographicDataService.GetProvinceByCityAsync(selected);
            if (!string.IsNullOrWhiteSpace(inferredProvince))
            {
                Province = inferredProvince;
                CitiesMunicipalities = (await GeographicDataService.GetProvinceCitiesMunicipalitiesAsync(Province)).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        Island = await GeographicDataService.GetIslandByProvinceAsync(Province);
        await UpdateZipCode();
    }

    private async Task UpdateZipCode()
    {
        if (!string.IsNullOrWhiteSpace(Province) && !string.IsNullOrWhiteSpace(City))
        {
            try
            {
                ZipCode = await GeographicDataService.GetZipCodeAsync(Province, City);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[AddCustomer] UpdateZipCode error: {ex.Message}");
                ZipCode = null;
            }
        }
        else
        {
            ZipCode = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task Cancel()
    {
        if (onCancel.HasDelegate)
            return onCancel.InvokeAsync();
        return Task.CompletedTask;
    }
}
