@using STTproject.Features.Admin.Customers.DTOs
@using STTproject.Shared.Components
@inject STTproject.Services.IUserContextService UserContextService
@inject STTproject.Features.Admin.Customers.Services.IAdminCustomerService AdminCustomerService
<link rel="stylesheet" href="css/Table.css" asp-append-version="true" />

<div class="clt-page">
    <div class="clt-layout">

        <aside class="clt-sidebar">
            <div class="clt-sidebar-stats">
                <div class="clt-stat">
                    <span class="clt-stat-label">Total</span>
                    <span class="clt-stat-value">@totalCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Active</span>
                    <span class="clt-stat-value clt-stat-active">@activeCount</span>
                </div>
                <div class="clt-stat">
                    <span class="clt-stat-label">Inactive</span>
                    <span class="clt-stat-value clt-stat-inactive">@inactiveCount</span>
                </div>
            </div>
            <div class="clt-divider"></div>

            @* Search *@
            <div class="clt-filter-group">
                <Input TValue="string" Label="Search"
                    Placeholder="Search..."
                    Value="@SearchTerm" ValueChanged="OnSearchChanged" />
            </div>

            @* Status *@
            <div class="clt-filter-group">
                <label class="clt-filter-label">Status</label>
                <div class="clt-radio-group">
                    <label class="clt-radio-option @(SelectedStatus == "" ? "selected" : "")">
                        <input type="radio" name="status" value=""
                            @onchange="() => OnFilterChanged(status: string.Empty)"
                            checked="@(SelectedStatus == "")" />
                        <span>All</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "active" ? "selected" : "")">
                        <input type="radio" name="status" value="active"
                            @onchange='() => OnFilterChanged(status: "active")'
                            checked="@(SelectedStatus == "active")" />
                        <span>Active</span>
                    </label>
                    <label class="clt-radio-option @(SelectedStatus == "inactive" ? "selected" : "")">
                        <input type="radio" name="status" value="inactive"
                            @onchange='() => OnFilterChanged(status: "inactive")'
                            checked="@(SelectedStatus == "inactive")" />
                        <span>Inactive</span>
                    </label>
                </div>
            </div>

            @* Subdistributor *@
            <div class="clt-filter-group">
                <AutoComplete @key="@($"subd-{filterResetKey}")"
                            Label="Subdistributor"
                            TItem="SubdOption"
                            Items="SubDistributors"
                            ValueSelector="x => x.Id.ToString()"
                            TextSelector="x => x.Name ?? string.Empty"
                            Placeholder="All subdistributors"
                            SelectedValue="@(SelectedSubDistributorId?.ToString())"
                            SelectedItemChanged="OnSubdSelected" />
            </div>

            @* Customer type *@
            <div class="clt-filter-group">
                <AutoComplete @key="@($"type-{filterResetKey}")"
                        Label="Customer type"
                        Placeholder="All types"
                        TItem="FilterOption"
                        Items="CustomerTypeOptions"
                        ValueSelector="x => x.Value"
                        TextSelector="x => x.Text"
                        SelectedValue="@SelectedCustomerType"
                        SelectedValueChanged="OnCustomerTypeSelected" />
            </div>

            @if (HasActiveFilters)
            {
                <button class="clt-clear-btn" @onclick="ClearFilters">Clear all filters</button>
            }
        </aside>

        <main class="clt-main">
            <div class="clt-table-card">
                <div class="clt-table-scroll">
                    <table class="clt-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SortBy("CustomerCode")' style="cursor:pointer">Code @SortIndicator("CustomerCode")</th>
                                <th @onclick='() => SortBy("CustomerName")' style="cursor:pointer">Customer name @SortIndicator("CustomerName")</th>
                                <th @onclick='() => SortBy("CustomerType")' style="cursor:pointer">Type @SortIndicator("CustomerType")</th>
                                <th @onclick='() => SortBy("SubDistributor")' style="cursor:pointer">Subdistributor @SortIndicator("SubDistributor")</th>
                                <th @onclick='() => SortBy("CreatedDate")' style="cursor:pointer">Created @SortIndicator("CreatedDate")</th>
                                <th @onclick='() => SortBy("IsActive")' style="cursor:pointer">Status @SortIndicator("IsActive")</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="7" class="clt-empty"><div class="clt-empty-inner"><p>Loading…</p></div></td></tr>
                            }
                            else if (!PagedCustomers.Any())
                            {
                                <tr>
                                    <td colspan="7" class="clt-empty">
                                        <div class="clt-empty-inner">
                                            <p>@(HasActiveFilters ? "No customers match your filters" : "No customers found")</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var customer in PagedCustomers)
                                {
                                    <tr class="@(!customer.IsActive ? "clt-row-inactive" : "")">
                                        <td><span class="clt-code">@customer.CustomerCode</span></td>
                                        <td class="clt-name">@customer.CustomerName</td>
                                        @if (string.IsNullOrWhiteSpace(customer.CustomerType))
                                        {
                                            <td><span class="clt-type-badge clt-type-empty">Not set</span></td>
                                        }
                                        else
                                        {
                                            <td><span class="clt-type-badge">@customer.CustomerType</span></td>
                                        }
                                        <td class="clt-muted">@customer.SubDistributorName</td>
                                        <td class="clt-muted">@customer.CreatedDate.ToString("MMM d, yyyy hh:mm tt")</td>
                                        <td>
                                            @if (customer.IsActive)
                                            {
                                                <span class="clt-status clt-status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="clt-status clt-status-inactive">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="clt-actions">
                                                <button class="clt-btn-edit"
                                                        @onclick="() => OnViewCustomer.InvokeAsync(customer.CustomerId)">
                                                    View
                                                </button>
                                                @if (customer.IsActive)
                                                {
                                                    <button class="clt-btn-toggle clt-btn-deactivate"
                                                            @onclick="() => SetActive(customer.CustomerId, false)">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="clt-btn-toggle clt-btn-activate"
                                                            @onclick="() => SetActive(customer.CustomerId, true)">
                                                        Activate
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="clt-footer">
                <span class="clt-footer-count">Showing @PagedCustomers.Count of @totalCount customers</span>
                @if (totalPages > 1)
                {
                    <div class="clt-pagination">
                        <button class="clt-page-btn" disabled="@(currentPage == 1)"
                                @onclick="() => GoToPage(currentPage - 1)">←</button>
                        <span>Page @currentPage of @totalPages</span>
                        <button class="clt-page-btn" disabled="@(currentPage >= totalPages)"
                                @onclick="() => GoToPage(currentPage + 1)">→</button>
                    </div>
                }
            </div>
        </main>
    </div>

    <ConfirmModal Show="showToggleConfirmModal" Title="Confirm Status Change"
                  Message="@toggleConfirmMessage" OnYes="ConfirmToggle" OnNo="CancelToggle" />
</div>

@code {
    [Parameter] public EventCallback OnLoaded { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public EventCallback<int> OnViewCustomer { get; set; }

    private record FilterOption(string Value, string Text);
    private record SubdOption(int Id, string? Name);

    private List<CustomerListDto> PagedCustomers { get; set; } = new();
    private List<SubdOption> SubDistributors { get; set; } = new();
    private List<string> AllCustomerTypes { get; set; } = new();

    private List<FilterOption> CustomerTypeOptions =>
        new[] { new FilterOption("__NOTSET__", "Not set") }
            .Concat(AllCustomerTypes.Select(t => new FilterOption(t, t)))
            .ToList();

    private string SelectedStatus { get; set; } = "";
    private string SelectedCustomerType { get; set; } = "";
    private int? SelectedSubDistributorId { get; set; }
    private int filterResetKey;

    private string SortColumn { get; set; } = "CreatedDate";
    private bool SortAscending { get; set; } = true;

    private int currentPage = 1;
    private const int pageSize = 50;
    private int totalCount;
    private int activeCount;
    private int inactiveCount;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private bool isLoading = true;
    private System.Threading.Timer? _debounceTimer;

    private bool showToggleConfirmModal;
    private int pendingToggleId;
    private bool pendingToggleStatus;
    private string toggleConfirmMessage = "";

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _debounceTimer?.Dispose();
            _debounceTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    currentPage = 1;
                    await LoadPageAsync();
                });
            }, null, 400, Timeout.Infinite);
        }
    }
    private void OnSearchChanged(string? value) => SearchTerm = value ?? string.Empty;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrEmpty(SelectedStatus) ||
        !string.IsNullOrEmpty(SelectedCustomerType) ||
        SelectedSubDistributorId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SubDistributors = (await AdminCustomerService.GetSubDistributorsAsync())
                .Select(sd => new SubdOption(sd.SubDistributorId, sd.SubDistributorName))
                .ToList();
            AllCustomerTypes = (await AdminCustomerService.GetCustomerTypesAsync()).ToList();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
            isLoading = false;
        }
    }

    public async Task LoadPageAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (items, total) = await AdminCustomerService.GetPagedAsync(
                currentPage, pageSize, _searchTerm, SelectedStatus,
                SelectedCustomerType, SelectedSubDistributorId,
                SortColumn, SortAscending);

            PagedCustomers = items.ToList();
            totalCount = total;

            var (_, activeTotal) = await AdminCustomerService.GetPagedAsync(
                1, 1, _searchTerm, "active", SelectedCustomerType, SelectedSubDistributorId);
            var (_, inactiveTotal) = await AdminCustomerService.GetPagedAsync(
                1, 1, _searchTerm, "inactive", SelectedCustomerType, SelectedSubDistributorId);
            activeCount = activeTotal;
            inactiveCount = inactiveTotal;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            if (OnCountChanged.HasDelegate) await OnCountChanged.InvokeAsync(totalCount);
            if (OnLoaded.HasDelegate) await OnLoaded.InvokeAsync();
        }
    }

    private async Task OnFilterChanged(string? status = null)
    {
        if (status != null) SelectedStatus = status;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnSubdSelected(SubdOption? sd)
    {
        int? newValue = sd is { Id: > 0 } ? sd.Id : null;
        if (newValue == SelectedSubDistributorId) return;
        SelectedSubDistributorId = newValue;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnCustomerTypeSelected(string? value)
    {
        SelectedCustomerType = value ?? string.Empty;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        _debounceTimer?.Dispose();
        _searchTerm = "";
        SelectedStatus = "";
        SelectedCustomerType = "";
        SelectedSubDistributorId = null;
        SortColumn = "CreatedDate";
        SortAscending = true;
        currentPage = 1;
        filterResetKey++;
        await LoadPageAsync();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPageAsync();
    }

    private void SetActive(int id, bool isActive)
    {
        pendingToggleId = id;
        pendingToggleStatus = isActive;
        toggleConfirmMessage = isActive
            ? "Are you sure you want to activate this customer?"
            : "Are you sure you want to deactivate this customer?";
        showToggleConfirmModal = true;
    }

    private async Task ConfirmToggle()
    {
        showToggleConfirmModal = false;
        await AdminCustomerService.ToggleCustomerStatusAsync(pendingToggleId, pendingToggleStatus, UserContextService.UserId);
        var customer = PagedCustomers.FirstOrDefault(x => x.CustomerId == pendingToggleId);
        if (customer != null) customer.IsActive = pendingToggleStatus;
        await InvokeAsync(StateHasChanged);
    }

    private void CancelToggle() => showToggleConfirmModal = false;

    private async Task SortBy(string column)
    {
        if (SortColumn == column)
            SortAscending = !SortAscending;
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }

    private string SortIndicator(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortAscending ? " ▲" : " ▼";
    }
}