@page "/admin/import-errors/{ImportErrorId:int}"
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IImportErrorDetailsService DetailsData
@inject IImportErrorVerificationService Verifier
@using STTproject.Features.Admin.ImportTemplate.Components.Modals

<LoadingOverlay Show="isLoading" Title="Loading error…" Subtitle="Please wait while we fetch the details."
                IconClass="fa-solid fa-exclamation-triangle" />

<div style="@(isLoading ? "display:none;" : "")">
    <div class="clt-page ied-page">

        @if (error is null)
        {
            <nav class="ied-crumb" aria-label="Breadcrumb">
                <button type="button" class="ied-link" @onclick="Back">← Back to Import Errors</button>
            </nav>
            <div class="ied-card ied-empty">
                <h1 class="clt-page-title">Error not found</h1>
                <p class="clt-page-sub">It may have been removed, or the link is wrong.</p>
                <Button Title="← Back to Import Errors" Variant="ButtonVariant.Secondary" OnClick="Back" />
            </div>
        }
        else
        {
            var title = ImportErrorPresentation.Title(error.ErrorType);
            var guide = ImportErrorGuidance.For(error.ErrorType, error.Message);
            var pending = ImportErrorPresentation.IsPending(error.Status);
            var ignored = ImportErrorPresentation.StatusKey(error.Status) == ImportErrorPresentation.Ignored;
            var resolved = ImportErrorPresentation.StatusKey(error.Status) == ImportErrorPresentation.Resolved;
            var auto = error.ResolutionType != null && error.ResolutionType.Contains("auto",
        StringComparison.OrdinalIgnoreCase);

            <nav class="ied-crumb" aria-label="Breadcrumb">
                <button type="button" class="ied-link" @onclick="Back">← Back to Import Errors</button>
            </nav>

            <div class="ied-head">
                <div>
                    <h1 class="clt-page-title">@title</h1>
                    <div class="ied-meta">
                        <span
                        class="ied-pill @StatusClass(error.Status)">@ImportErrorPresentation.StatusText(error.Status)</span>
                        <span class="ied-pill @CorrectionClass(error.CorrectionState)"
                              title="@error.CorrectionNote">@error.CorrectionState</span>
                    </div>
                </div>
                <div class="ied-actions">
                    @if (pending)
                    {
                        @if (ImportErrorGuidance.FixChoices(error.ErrorType).Count > 0 || OffersSynonyms)
                        {
                            <Button Title="Fix" Variant="ButtonVariant.Primary" Icon="ti ti-tool" OnClick="Fix" Disabled="busy" />
                        }
                        @if (error.CanVerify)
                        {
                            <Button Title="Verify" Variant="ButtonVariant.Secondary" Icon="ti ti-circle-check"
                                    OnClick="VerifyRowsAsync" Disabled="busy" />
                        }
                        <Button Title="Ignore" Variant="ButtonVariant.Muted" Icon="ti ti-eye-off"
                                OnClick="() => showIgnore = true" Disabled="busy" />
                    }
                    else if (ignored)
                    {
                        <Button Title="Reopen error" Variant="ButtonVariant.Secondary" Icon="ti ti-rotate-2"
                                OnClick="ReopenAsync" Disabled="busy" />
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="ied-note ied-note-@(messageIsError ? "warn" : "gold")" role="status">@message</div>
            }
            @if (verifying)
            {
                <div class="ied-note ied-note-gold" role="status">
                    <b>Verifying…</b>
                    <span>Entriel is checking the affected rows against the latest upload and the current template. Nothing is
                        imported or saved.</span>
                    </div>
                }
                @if (error.Recurrence is { } rec)
                {
                    <div class="ied-note ied-note-gold" role="note">
                        <b>Returned</b>
                        <span>@RecurrenceIntro(rec)</span>
                        <span>
                            Previous error:
                            <button type="button" class="ied-link"
                                    @onclick="() => OpenError(rec.PreviousImportErrorId)">#@rec.PreviousImportErrorId</button>
                            · @RecurrenceDetail(rec)
                        </span>
                        <span>@RecurrenceBatch()</span>
                    </div>
                }
                @if (resolved)
                {
                    <div class="ied-note ied-note-ok">
                        <b>@ResolvedTitle(auto)</b>
                        <span>@ResolvedLine(auto)</span>
                    </div>
                }
                @if (ignored)
                {
                    <div class="ied-note ied-note-gray">
                        <b>Ignored</b>
                        <span>This error is out of the pending list but stays on record. You can reopen it any time.</span>
                    </div>
                }

                @* ---------- summary ---------- *@
                <p class="ied-summary">@SummaryText()</p>

                <div class="ied-two">
                    @* ---------- what's wrong ---------- *@
                    <section class="ied-card ied-sec">
                        <h3>What's wrong</h3>
                        <div class="ied-body">
                            <ol class="ied-steps">
                                <li class="ied-step">
                                    <h4>Problem</h4>
                                    @if (error.Facts.Count > 0)
                                    {
                                        @* Customer and unit-of-measure errors: each fact on its own line instead of one combined value. *@
                                        <div class="ied-val ied-facts">
                                            <dl>
                                                @foreach (var fact in error.Facts)
                                                {
                                                    <div>
                                                        <dt>@fact.Label</dt>
                                                        <dd>@fact.Value</dd>
                                                    </div>
                                                }
                                            </dl>
                                            <small>@ValueSource()</small>
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(error.Value))
                                    {
                                        <div class="ied-val">
                                            @error.Value
                                            <small>@ValueSource()</small>
                                        </div>
                                    }
                                    @if (!ImportErrorGuidance.IsKnown(error.ErrorType))
                                    {
                                        <p class="ied-what">@guide.What</p>
                                    }
                                </li>
                                <li class="ied-step">
                                    <h4>Why it happened</h4>
                                    <p>@guide.Why</p>
                                </li>
                                <li class="ied-step ied-step-fix">
                                    <h4>What to do</h4>
                                    <p>@guide.Todo</p>
                                </li>
                            </ol>
                        </div>
                    </section>

                    @* ---------- import history ---------- *@
                    <section class="ied-card ied-sec">
                        <div class="ied-sh">
                            <h3>Import history</h3>
                            <span class="ied-sub">@Plural(error.Batches.Count, "upload")</span>
                        </div>
                        @if (error.Batches.Count == 0)
                        {
                            <p class="ied-sub">No import batches are linked to this error.</p>
                        }
                        else
                        {
                            <div class="ied-body">
                                <ul class="ied-tl">
                                    @foreach (var (g, gi) in error.UploadGroups.Select((g, gi) => (g, gi)))
                                    {
                                        if (g.AttemptCount == 1)
                                        {
                                            @BatchItem(g.Batches[0], false)
                                        }
                                        else
                                        {
                                            var groupIndex = gi;
                                            var groupOpen = expandedGroups.Contains(gi);
                                            <li>
                                                <i class="ied-dot"></i>
                                                <span>
                                                    <b>@Date(g.LastUploadedAtPht) · @g.FileName</b>
                                                    <span class="ied-chip">@Plural(g.AttemptCount, "upload attempt")</span>
                                                    <span class="ied-sub">@GroupText(g)</span>
                                                </span>
                                                <span class="ied-ac">
                                                    <Button Title="@(groupOpen ? "Hide attempts" : "Show attempts")"
                                                            Variant="ButtonVariant.Secondary" OnClick="() => ToggleGroup(groupIndex)" />
                                                </span>
                                            </li>
                                            @if (groupOpen)
                                            {
                                                @foreach (var attempt in g.Batches)
                                                {
                                                    @BatchItem(attempt, true)
                                                }
                                            }
                                        }
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                </div>

                @* ---------- ambiguous sheet: the sheets the file really has ---------- *@
                @if (IsAmbiguousSheet)
                {
                    <section class="ied-card ied-sec ied-rows">
                        <div class="ied-sh">
                            <h3>Sheets in this file</h3>
                            <span class="ied-sub">@SheetsHint()</span>
                        </div>

                        @if (sheetPreview is null)
                        {
                            <p class="ied-sub">No upload is linked to this error, so its sheets can't be shown.</p>
                        }
                        else if (sheetPreview.Problem is not null)
                        {
                            <p class="ied-sub">@sheetPreview.Problem</p>
                        }
                        else if (sheetPreview.Sheets.Count == 0)
                        {
                            <p class="ied-sub">This file has no sheets.</p>
                        }
                        else
                        {
                            <div class="ied-tabs" role="tablist" aria-label="Sheets in this file">
                                @for (var ti = 0; ti < sheetPreview.Sheets.Count; ti++)
                                {
                                    var tabIndex = ti;
                                    var tab = sheetPreview.Sheets[ti];
                                    var named = SameText(tab.Name, AmbiguousSheetName);
                                    var tabTitle = tab.Name + (named ? " (named in the error)" : string.Empty) + (tab.IsHidden ? " (hidden sheet)" : string.Empty);
                                    <button type="button" role="tab" class="@(tabIndex == ActiveSheet ? "ied-tab ied-tab-on" : "ied-tab")"
                                            aria-selected="@(tabIndex == ActiveSheet ? "true" : "false")" title="@tabTitle"
                                            @onclick="() => selectedSheet = tabIndex">
                                        @if (named)
                                        {
                                            <span class="ied-tab-flag" aria-hidden="true">●</span>
                                        }
                                        <span class="ied-tab-name">@tab.Name</span>
                                    </button>
                                }
                            </div>

                            foreach (var sh in sheetPreview.Sheets.Where((_, i) => i == ActiveSheet))
                            {
                                <div class="ied-sheet">
                                    <div class="ied-sheet-head">
                                        <strong>@sh.Name</strong>
                                        @if (SameText(sh.Name, AmbiguousSheetName))
                                        {
                                            <span class="ied-tag">Named in the error</span>
                                        }
                                        @if (sh.IsHidden)
                                        {
                                            <span class="ied-tag ied-tag-muted">Hidden</span>
                                        }
                                        <span class="ied-sub">@Plural(sh.RowCount, "row") · @Plural(sh.ColumnCount, "column")</span>
                                    </div>

                                    @if (sh.Rows.Count == 0)
                                    {
                                        <p class="ied-sub">This sheet is empty.</p>
                                    }
                                    else
                                    {
                                        <div class="ied-rowscroll">
                                            <table class="ied-table ied-sheetprev">
                                                <thead>
                                                    <tr>
                                                        <th>Row</th>
                                                        @for (var ci = 0; ci < sh.ShownColumns; ci++)
                                                        {
                                                            <th>@ColumnLetter(ci)</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var ri = 0; ri < sh.Rows.Count; ri++)
                                                    {
                                                        var row = sh.Rows[ri];
                                                        <tr class="@(ri == 0 ? "ied-hdrrow" : null)">
                                                            <td>@row.RowNumber</td>
                                                            @foreach (var cell in row.Cells)
                                                            {
                                                                <td title="@cell">@(string.IsNullOrEmpty(cell) ? "—" : cell)</td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        @if (sh.ColumnCount > sh.ShownColumns)
                                        {
                                            <p class="ied-sub">@("Showing the first " + sh.ShownColumns + " of " + sh.ColumnCount + " columns.")</p>
                                        }
                                    }
                                </div>
                            }
                        }
                    </section>
                }
                else
                {
                    @* ---------- rows to fix ---------- *@
                    <section class="ied-card ied-sec ied-rows">
                        <div class="ied-sh">
                            <h3>Rows to fix</h3>
                            <span class="ied-sub">@RowsHint()</span>
                        </div>

                        @if (error.LogicalRows.Count == 0)
                        {
                            <p class="ied-sub">No row details were stored for this error.</p>
                        }
                        else
                        {
                            var filtered = FilteredRows();
                            var shown = showAll ? filtered : filtered.Take(PageSize).ToList();
                            var cols = allColumns ? ExtraColumns(filtered) : new List<string>();
                            var numeric = cols.Where(c => IsNumericColumn(c, shown)).ToHashSet();

                            <div class="ied-tools">
                                <input type="search" class="ied-search" placeholder="Search row, invoice or value" value="@search"
                                       @oninput="OnSearch" aria-label="Search rows" />
                                <label class="ied-xopt">
                                    <input type="checkbox" checked="@allColumns" @onchange="OnAllColumns" />
                                    <span>All Excel columns</span>
                                </label>
                            </div>

                            @if (filtered.Count == 0)
                            {
                                <p class="ied-sub">No rows match.</p>
                            }
                            else
                            {
                                <div class="ied-rowscroll">
                                    <table class="ied-table ied-flat">
                                        <thead>
                                            <tr>
                                                <th>Row</th>
                                                <th>Invoice</th>
                                                <th>Problem</th>
                                                <th>Status</th>
                                                @if (ShowInvoiceFacts)
                                                {
                                                    <th>Invoice date</th>
                                                    <th>Customer</th>
                                                }
                                                @foreach (var col in cols)
                                                {
                                                    <th class="@(numeric.Contains(col) ? "ied-num" : null)">@col</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in shown)
                                            {
                                                var st = StatusOf(r);
                                                var problem = ProblemText(r);
                                                var fixedNow = NowFixedValue(r) is not null;
                                                <tr class="@(r.IsReportedRow ? null : "ied-ctxrow")">
                                                    <td>@SheetRow(r)</td>
                                                    <td>@(r.Invoice ?? "—")</td>
                                                    <td>
                                                        @if (r.IsReportedRow)
                                                        {
                                                            <span
                                                            class="@(problem == "missing" ? "ied-pv ied-missing-pv" : fixedNow ? "ied-pv ied-ok-pv" : "ied-pv")"
                                                            title="@problem">@problem</span>
                                                        }
                                                        else
                                                        {
                                                            <span
                                                            class="@(problem == "missing" ? "ied-sub ied-missing" : "ied-sub")">@problem</span>
                                                        }
                                                    </td>
                                                    <td><span class="ied-st @st.Css" title="@st.Hint">@st.Text</span></td>
                                                    @if (ShowInvoiceFacts)
                                                    {
                                                        <td title="@RowDate(r)">@CellValue(RowDate(r))</td>
                                                        <td title="@RowCustomer(r)">@CellValue(RowCustomer(r))</td>
                                                    }
                                                    @foreach (var col in cols)
                                                    {
                                                        <td class="@(numeric.Contains(col) ? "ied-num" : null)" title="@DataCell(r, col)">
                                                            @CellValue(DataCell(r, col))</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="ied-foot">
                                        <span class="ied-sub">@("Showing " + shown.Count + " of " + filtered.Count + " rows")</span>
                                        @if (filtered.Count > PageSize)
                                        {
                                            <Button Title="@(showAll ? "Show fewer" : "Show all " + filtered.Count + " rows")"
                                                    Variant="ButtonVariant.Secondary" OnClick="ToggleShowAll" />
                                        }
                                    </div>
                                }
                                @if (error.RowsTruncated)
                                {
                                    <p class="ied-sub">@TruncText()</p>
                                }
                            }
                        </section>
                    }

                    @* ---------- technical details ---------- *@
                    <section class="ied-card ied-sec ied-tech">
                        <button type="button" class="ied-techhead" @onclick="ToggleTech"
                                aria-expanded="@(showTech ? "true" : "false")">
                            <span class="ied-chev">@(showTech ? "▾" : "▸")</span>
                            <span>Technical details</span>
                        </button>
                        @if (showTech)
                        {
                            <dl class="ied-techlist">
                                <div>
                                    <dt>Error code</dt>
                                    <dd class="ied-mono">@error.ErrorType</dd>
                                </div>
                                <div>
                                    <dt>Error ID</dt>
                                    <dd class="ied-mono">#@error.ImportErrorId</dd>
                                </div>
                                <div>
                                    <dt>Total across uploads</dt>
                                    <dd>@Plural(error.Occurrences, "problem row") counted over @Plural(error.Batches.Count, "upload")
                                    </dd>
                                </div>
                                <div>
                                    <dt>First detected</dt>
                                    <dd>@Date(error.FirstSeenAtPht)</dd>
                                </div>
                                <div>
                                    <dt>Last detected</dt>
                                    <dd>@Date(error.LastSeenAtPht)</dd>
                                </div>
                            </dl>
                        }
                    </section>
                }
            </div>
        </div>

        @if (showIgnore)
        {
            <Modal ShowModal="showIgnore" Width="480px" MaxWidth="100%" Title="Ignore this error?"
                   Subtitle="Here's what happens next." OnClose="() => showIgnore = false">
                <ChildContent>
                    <div class="ied-ign">
                        <div class="ied-ign-item">
                            <i class="ti ti-list-check" aria-hidden="true"></i>
                            <div>
                                <b>Leaves your pending list</b>
                                <span>Removes this row from your to-fix count</span>
                            </div>
                        </div>
                        <div class="ied-ign-item">
                            <i class="ti ti-archive" aria-hidden="true"></i>
                            <div>
                                <b>Stays on record</b>
                                <span>Still visible in import history</span>
                            </div>
                        </div>
                        <div class="ied-ign-item">
                            <i class="ti ti-rotate-2" aria-hidden="true"></i>
                            <div>
                                <b>Reopen any time</b>
                                <span>Use Reopen error on this page</span>
                            </div>
                        </div>
                    </div>
                </ChildContent>
                <FooterContent>
                    <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showIgnore = false" />
                    <Button Title="Ignore error" Variant="ButtonVariant.Primary" OnClick="IgnoreAsync" Disabled="busy" />
                </FooterContent>
            </Modal>
        }

        @if (showBatchPick)
        {
            <Modal ShowModal="showBatchPick" Width="760px" MaxWidth="100%" Title="Which file do you want to fix?"
                   Subtitle="This error appeared in files with different import settings, so Entriel can't pick a template for you."
                   OnClose="() => showBatchPick = false">
                <ChildContent>
                    <div class="ied-note ied-note-gold" style="margin-bottom:10px;text-align:left;">
                        Fixing one file's template does not resolve this error for the other files. It stays pending until every
                        affected file has been re-imported and passes validation.
                    </div>
                    <div class="ied-scroll" style="max-height:320px;">
                        <table class="ied-table">
                            <thead>
                                <tr>
                                    <th>Batch</th>
                                    <th>Subdistributor</th>
                                    <th>Import type</th>
                                    <th>Uploaded</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in batchOptions)
                                {
                                    var id = o.ImportBatchId;
                                    <tr>
                                        <td>#@o.ImportBatchId</td>
                                        <td>@(o.SubDistributorName ?? "—")</td>
                                        <td>@o.ImportType</td>
                                        <td>@Date(o.UploadedAtPht)</td>
                                        <td><Button Title="Fix this template" Variant="ButtonVariant.Secondary"
                                                        OnClick="() => ChooseBatchAsync(id)" Disabled="busy" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </ChildContent>
                    <FooterContent>
                        <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showBatchPick = false" />
                    </FooterContent>
                </Modal>
            }

            @if (showFix)
            {
                <Modal ShowModal="showFix" Width="520px" MaxWidth="100%" Title="How do you want to fix this?"
                       Subtitle="Pick one. When you are done, come back here and press Verify." OnClose="() => showFix = false">
                    <ChildContent>
                        @* One click per row: the whole row is the button and goes straight to that fix. *@
                        <div class="ied-actlist">
                            @foreach (var choice in ImportErrorGuidance.FixChoices(error?.ErrorType))
                            {
                                @FixRow(choice.Key, choice.Label, choice.Description)
                                @if (OffersSynonyms && choice.Key == ImportErrorGuidance.ChoiceMapping)
                                {
                                    @SynonymsChoice
                                }
                            }
                            @if (OffersSynonyms && !ImportErrorGuidance.FixChoices(error?.ErrorType).Any(c => c.Key ==
            ImportErrorGuidance.ChoiceMapping))
                            {
                                @SynonymsChoice
                            }
                        </div>
                    </ChildContent>
                    <FooterContent>
                        <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showFix = false" />
                    </FooterContent>
                </Modal>
            }

            @if (showPick)
            {
                <Modal ShowModal="showPick" Width="480px" MaxWidth="100%" Title="Which template read this file?"
                       Subtitle="@("More than one active template could apply to batch #" + pickedBatchId + ". Pick the one its file uses.")"
                       OnClose="() => showPick = false">
                    <ChildContent>
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            @foreach (var o in pickOptions)
                            {
                                var id = o.ImportTemplateId;
                                <Button Title="@(o.TemplateName + (o.IsGlobalDefault ? " (global default)" : string.Empty))"
                                        Variant="ButtonVariant.Secondary" OnClick="() => OpenTemplate(id)" />
                            }
                        </div>
                    </ChildContent>
                    <FooterContent>
                        <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showPick = false" />
                    </FooterContent>
                </Modal>
            }

            @if (showSynonyms)
            {
                <UomSynonymsModal InitialSubDistributorId="@error?.SubDistributorId" InitialTryText="@UploadedUom"
                                  OnSaved="() => synonymsSaved = true" OnClose="CloseSynonyms" />
            }

@code {
    [Parameter] public int ImportErrorId { get; set; }

    private const int PageSize = 10;

    private ImportErrorDetailsDto? error;
    private bool isLoading = true;
    private bool busy;
    private int loadedId = -1;

    private readonly HashSet<int> expandedGroups = new();

    private bool allColumns;
    private bool showTech;
    private string search = string.Empty;
    private bool showAll;
    private bool showIgnore;
    private bool showPick;
    private bool showFix;
    private bool verifying;

    // ---- Fix UOM synonyms (Unit of measure not mapped) ----
    private const string ChoiceSynonyms = "UomSynonyms";
    private bool showSynonyms;
    private bool synonymsSaved;

    private bool OffersSynonyms => string.Equals(error?.ErrorType, "UomNotFound", StringComparison.OrdinalIgnoreCase);

    // The unit as the file had it, so the modal's Try it shows straight away whether a synonym now covers it.
    private string? UploadedUom =>
        error?.Facts.FirstOrDefault(f => string.Equals(f.Label, "Uploaded UOM", StringComparison.OrdinalIgnoreCase))?.Value
        ?? error?.Value;

    private RenderFragment SynonymsChoice => FixRow(ChoiceSynonyms, "Fix UOM synonyms",
        "The file's unit is just another spelling of one the item already has (for example CS for Case). Add it as a synonym.");

    // One row of the Fix window: icon, label, short description and a chevron. The whole row is clickable.
    private RenderFragment FixRow(string key, string label, string? description) =>
        @<button type="button" class="ied-act" disabled="@busy" @onclick="() => ChooseFixAsync(key)">
            <span class="ied-act-icon" aria-hidden="true"><i class="@FixIcon(key)"></i></span>
            <span class="ied-act-text">
                <b>@label</b>
                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <span>@description</span>
                }
            </span>
            <i class="fa-solid fa-chevron-right ied-act-chev" aria-hidden="true"></i>
        </button>;

    private static string FixIcon(string key) => key switch
    {
        ImportErrorGuidance.ChoiceMapping => "fa-solid fa-link",
        ImportErrorGuidance.ChoiceReimport => "fa-solid fa-file-arrow-up",
        ImportErrorGuidance.ChoiceTemplate => "fa-solid fa-table-columns",
        ChoiceSynonyms => "fa-solid fa-right-left",
        _ => "fa-solid fa-wrench"
    };

    private void CloseSynonyms()
    {
        showSynonyms = false;
        if (!synonymsSaved) return;

        synonymsSaved = false;
        messageIsError = false;
        message = "UOM synonyms saved. Press Verify to recheck the original file with them.";
    }

    // Too many files to recheck at once: Verify then only checks the newest upload.
    private bool RecheckTooManyFiles => error is not null && error.Batches.Count >
ImportErrorVerificationService.MaxRecheckBatches;
    private bool showBatchPick;
    private int pickedBatchId;
    private List<FixContextDto> batchOptions = new();
    private List<FixTemplateOption> pickOptions = new();

    private string? message;
    private bool messageIsError;

    // ---- Ambiguous sheet: show what the uploaded file really contains ----
    private ImportSheetPreviewDto? sheetPreview;
    private int selectedSheet;
    private int ActiveSheet => sheetPreview is null || sheetPreview.Sheets.Count == 0 ? 0 : Math.Min(selectedSheet,
sheetPreview.Sheets.Count - 1);
    private bool IsAmbiguousSheet => ImportErrorGuidance.IsAmbiguousSheet(error?.ErrorType);

    // The error message names the sheet: Sheet "Sheet 1" fits "Summary", ... equally well
    private string? AmbiguousSheetName
    {
        get
        {
            var m = System.Text.RegularExpressions.Regex.Match(error?.Message ?? string.Empty, "^Sheet \"(.+?)\" fits");
            return m.Success ? m.Groups[1].Value : null;
        }
    }

    private string SheetsHint() => sheetPreview is null || sheetPreview.Problem is not null
        ? "What the uploaded file contains"
        : $"From {sheetPreview.FileName} (upload #{sheetPreview.ImportBatchId}) · first rows of the selected sheet";

    private static string ColumnLetter(int index)
    {
        var s = string.Empty;
        for (var n = index + 1; n > 0; n = (n - 1) / 26) s = (char)('A' + (n - 1) % 26) + s;
        return s;
    }

    private async Task LoadSheetPreviewAsync()
    {
        sheetPreview = null;
        if (!IsAmbiguousSheet || error is null || error.Batches.Count == 0) return;

        try
        {
            var batch = error.Batches[0];
            sheetPreview = await DetailsData.GetSheetPreviewAsync(batch.ImportBatchId);
            sheetPreview.FileName = batch.FileName;

            // Open on the sheet the error names; otherwise the first one.
            var named = sheetPreview.Sheets.FindIndex(x => SameText(x.Name, AmbiguousSheetName));
            selectedSheet = named >= 0 ? named : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            sheetPreview = null;
        }
    }

    private int? firstBatchId => error?.Batches.Count > 0 ? error.Batches[^1].ImportBatchId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ImportErrorId) return;
        loadedId = ImportErrorId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            error = await DetailsData.GetAsync(ImportErrorId);
            showAll = false;
            expandedGroups.Clear();
            await LoadSheetPreviewAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading import error {ImportErrorId}: {ex.Message}");
            error = null;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Back() => Nav.NavigateTo("/admin/import-errors");
    private void OpenError(int importErrorId) => Nav.NavigateTo($"/admin/import-errors/{importErrorId}");
    private void OpenFile(int importBatchId) => Nav.NavigateTo($"/admin/import-errors/files/{importBatchId}");
    // One way to fix it: go straight there. Several: let the admin choose.
    private async Task Fix()
    {
        var choices = ImportErrorGuidance.FixChoices(error?.ErrorType);
        var total = choices.Count + (OffersSynonyms ? 1 : 0);
        if (total == 1 && choices.Count == 1) await ChooseFixAsync(choices[0].Key);
        else if (total == 1) await ChooseFixAsync(ChoiceSynonyms);
        else if (total > 1) showFix = true;
    }

    private async Task ChooseFixAsync(string key)
    {
        showFix = false;

        // Remember the way chosen so the resolved banner can say how the error was fixed. Best effort, never blocks the fix.
        try { await DetailsData.RecordFixChoiceAsync(ImportErrorId, key); } catch { }

        switch (key)
        {
            case ImportErrorGuidance.ChoiceReimport:
                // A wrong subdistributor is a likely cause of "Ambiguous sheet", so the import window opens without one selected.
                Nav.NavigateTo(ImportErrorGuidance.ReimportRoute(ImportErrorGuidance.IsAmbiguousSheet(error?.ErrorType) ? null :
error?.SubDistributorId));
                break;
            case ImportErrorGuidance.ChoiceMapping:
                if (string.Equals(error?.ErrorType, "UomNotFound", StringComparison.OrdinalIgnoreCase))
                {
                    // Opens Map Item with the subdistributor loaded, the item in edit mode and the Add UOM window open on the unit.
                    string? Fact(string label) => error?.Facts.FirstOrDefault(f => string.Equals(f.Label, label,
StringComparison.OrdinalIgnoreCase))?.Value;
                    Nav.NavigateTo(ImportErrorGuidance.UomMappingRoute(error?.SubDistributorId, Fact("Item code"), Fact("Item name"),
Fact("Uploaded UOM")));
                }
                else if (string.Equals(error?.ErrorType, "SkuNotFound", StringComparison.OrdinalIgnoreCase))
                {
                    // Map Item with the subdistributor selected and the file's item code and name already in its header.
                    string? RowFact(string key) => error?.LogicalRows.Where(r => r.IsReportedRow && r.Details != null)
                        .Select(r => r.Details!.TryGetValue(key, out var v) ? v : null).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
                    var field = error?.LogicalRows.FirstOrDefault(r => r.IsReportedRow &&
!string.IsNullOrWhiteSpace(r.ProblemField))?.ProblemField;
                    var code = RowFact("RowItemCode") ?? (string.Equals(field, "SkuCode", StringComparison.OrdinalIgnoreCase) ? error?.Value
: null);
                    var itemName = RowFact("RowItem") ?? (string.Equals(field, "ItemName", StringComparison.OrdinalIgnoreCase) ?
error?.Value : null);
                    Nav.NavigateTo(ImportErrorGuidance.ItemMappingRoute(error?.SubDistributorId, code, itemName));
                }
                else Nav.NavigateTo(ImportErrorGuidance.FixRoute(error?.ErrorType, ImportErrorId));
                break;
            case ImportErrorGuidance.ChoiceTemplate:
                await FixTemplateAsync();
                break;
            case ChoiceSynonyms:
                message = null;
                synonymsSaved = false;
                showSynonyms = true;
                break;
        }
    }

    private async Task FixTemplateAsync()
    {
        await GuardedAsync(async () =>
        {
            var contexts = await DetailsData.GetFixContextsAsync(ImportErrorId);
            if (contexts.Count == 0)
            {
                messageIsError = true;
                message = "No import batch is linked to this error, so Entriel can't tell which template to open.";
                return;
            }

            // Same subdistributor and import type in every batch: one template applies, so no choice is needed.
            // Different contexts: never guess. The admin picks the batch whose template they want to fix.
            var sameContext = contexts
                .Select(x => (x.SubDistributorId, (x.ImportType ?? string.Empty).Trim().ToLowerInvariant()))
                .Distinct().Count() == 1;

            if (sameContext) await OpenForBatchAsync(contexts[0].ImportBatchId);
            else { batchOptions = contexts.ToList(); showBatchPick = true; }
        });
    }

    private async Task ChooseBatchAsync(int batchId)
    {
        showBatchPick = false;
        await GuardedAsync(() => OpenForBatchAsync(batchId));
    }

    private async Task OpenForBatchAsync(int batchId)
    {
        pickedBatchId = batchId;
        var options = await DetailsData.FindFixTemplatesAsync(ImportErrorId, batchId);
        if (options.Count == 1) OpenTemplate(options[0].ImportTemplateId);
        else if (options.Count > 1) { pickOptions = options.ToList(); showPick = true; }
        else
        {
            messageIsError = true;
            message = "No active import template was found for batch #" + batchId + ", so there is nothing to fix. Create one under Import Templates.";
        }
    }

    private async Task GuardedAsync(Func<Task> work)
    {
        busy = true;
        message = null;
        try { await work(); }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The import template could not be found. Please try again.";
        }
        finally { busy = false; }
    }

    // The template page only reads these; it never saves anything by itself.
    private void OpenTemplate(int templateId)
    {
        showPick = false;
        var focus = Uri.EscapeDataString(string.IsNullOrWhiteSpace(error?.FieldName) ? "InvoiceDate" : error!.FieldName!);
        // The Excel sheets that still have rows to fix, so the template page can point at the tab that reads them.
        var sheetNames = error is null ? string.Empty : string.Join("|", error.LogicalRows
            .Where(r => r.IsReportedRow && NowFixedValue(r) is null && !string.IsNullOrWhiteSpace(r.Sheet))
            .Select(r => r.Sheet!).Distinct());
        var sheets = sheetNames.Length == 0 ? string.Empty : "&sheets=" + Uri.EscapeDataString(sheetNames);
        Nav.NavigateTo($"/admin/import-templates/{templateId}?fromError={ImportErrorId}&batch={pickedBatchId}&focus={focus}{sheets}");
    }
