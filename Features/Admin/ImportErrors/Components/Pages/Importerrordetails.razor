    private string SummaryText()
    {
        if (error is null) return string.Empty;
        var fixedCount = FixedRowCount();
        var text = Plural(ReportedRowCount() - fixedCount, "row") + " to fix";
        if (fixedCount > 0) text += " (" + fixedCount + " fixed)";
        if (error.AffectedInvoices > 0) text += " in " + Plural(error.AffectedInvoices, "invoice");
        text += " · uploaded " + Plural(error.Batches.Count, "time");
        if (error.LastSeenAtPht.HasValue) text += ", last on " + Date(error.LastSeenAtPht);
        return text;
    }

    private int ReportedRowCount() => error is null ? 0 : error.LogicalRows.Count(r => r.IsReportedRow);

    private int FixedRowCount() =>
        error is null ? 0
        : error.CorrectionState == ImportErrorCorrectionState.Corrected ? ReportedRowCount()
        : error.LogicalRows.Count(r => r.IsReportedRow && NowFixedValue(r) is not null);

    private static string GroupText(ImportErrorUploadGroupDto g)
    {
        var counts = g.Batches.Select(b => b.Occurrences).Distinct().OrderBy(n => n).ToList();
        var head = "The same file was uploaded " + g.AttemptCount + " times.";
        return counts.Count == 1
            ? head + " Each upload had the same " + Plural(counts[0], "problem row") + "."
            : head + " Problem rows per upload: " + string.Join(", ", g.Batches.Select(b => b.Occurrences)) + ".";
    }

    private string RowsHint() =>
        allColumns ? "Every column from the Excel file" : "Row, invoice, problem and status";

    private bool ShowInvoiceFacts =>
        string.Equals(error?.ErrorType, "InvoiceInconsistent", StringComparison.OrdinalIgnoreCase)
        || string.Equals(error?.ErrorType, "InvoiceHeaderInvalid", StringComparison.OrdinalIgnoreCase);

    private static string? Fact(ImportErrorLogicalRowDto r, string key) =>
        r.Details != null && r.Details.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v.Trim() : null;

    private static string RowDate(ImportErrorLogicalRowDto r)
    {
        var fact = Fact(r, "RowInvoiceDate");
        if (fact != null) return fact;

        static bool LooksLikeInvoiceDate(string header)
        {
            var h = header.Trim().ToLowerInvariant();
            return h == "date" || (h.Contains("invoice") && h.Contains("date")) || h.Contains("inv date") || h.Contains("inv. date");
        }

        var cell = r.Data?.FirstOrDefault(kv => LooksLikeInvoiceDate(kv.Key) && !string.IsNullOrWhiteSpace(kv.Value)).Value;
        return string.IsNullOrWhiteSpace(cell) ? string.Empty : cell.Trim();
    }

    private static string RowCustomer(ImportErrorLogicalRowDto r) => Fact(r, "RowCustomer") ?? string.Empty;

    private List<ImportErrorLogicalRowDto> FilteredRows()
    {
        if (error is null) return new();
        var q = search.Trim();
        return error.LogicalRows
            .Where(r => r.IsReportedRow || ShowInvoiceFacts)
            .Where(r => q.Length == 0 || RowMatches(r, q))
            .ToList();
    }

    private bool RowMatches(ImportErrorLogicalRowDto r, string q)
    {
        bool Has(string? t) => t != null && t.Contains(q, StringComparison.OrdinalIgnoreCase);
        if (Has(SheetRow(r)) || Has(r.Invoice) || Has(ProblemText(r))) return true;
        return allColumns && r.Data != null && r.Data.Any(kv => Has(kv.Value));
    }

    // Row-level proof that a reported row is fixed, from the newest evidence Entriel holds for it:
    // - a recheck that read a real value for the error's field with the current template (the value is the proof), or
    // - the newest upload that kept this row did not report it and holds a real value for the field.
    // A row no later upload or recheck mentions is not treated as fixed.
    private static string? NowFixedValue(ImportErrorLogicalRowDto r)
    {
        if (r.HasCheckedValue && !string.IsNullOrWhiteSpace(r.CheckedValue)) return r.CheckedValue.Trim();

        var newest = r.Snapshots.FirstOrDefault();
        if (newest is null || newest.IsReportedRow || !newest.HasProblemValue || string.IsNullOrWhiteSpace(newest.ProblemValue))
            return null;
        if (!r.Snapshots.Any(sn => sn.IsReportedRow)) return null;
        return newest.ProblemValue.Trim();
    }

    private (string Text, string Css, string Hint) StatusOf(ImportErrorLogicalRowDto r)
    {
        if (!r.IsReportedRow)
            return ("Context", "ied-st-ctx", "Another row of the same invoice, listed for comparison. The importer did not report it.");
        if (NowFixedValue(r) is { } now)
            return ("Fixed", "ied-st-ok", r.HasCheckedValue && !string.IsNullOrWhiteSpace(r.CheckedValue)
                ? "Read as " + now + " from the original file with the current template on " + Date(r.CheckedAtPht) + "."
                : "Upload #" + r.Snapshots[0].ImportBatchId + " has this row with a value of " + now + ".");
        return error?.CorrectionState == ImportErrorCorrectionState.Corrected
            ? ("Fixed", "ied-st-ok", error.CorrectionNote)
            : ("Not fixed", "ied-st-bad", error?.CorrectionNote ?? string.Empty);
    }

    private string ProblemText(ImportErrorLogicalRowDto r)
    {
        if (NowFixedValue(r) is { } now) return now;
        if (error?.CorrectionState == ImportErrorCorrectionState.Corrected) return "—";
        if (r.IsReportedRow) return ReportedValue(r);
        if (r.HasProblemValue && !string.IsNullOrWhiteSpace(r.ProblemField))
            return string.IsNullOrWhiteSpace(r.ProblemValue) ? "missing" : r.ProblemValue!.Trim();
        return "—";
    }

    private static string DataCell(ImportErrorLogicalRowDto r, string header) =>
        r.Data?.FirstOrDefault(kv => kv.Key == header).Value ?? string.Empty;

    private static bool SameText(string? a, string? b) =>
        !string.IsNullOrWhiteSpace(a) && !string.IsNullOrWhiteSpace(b) && string.Equals(a.Trim(), b.Trim(),
StringComparison.OrdinalIgnoreCase);

    private List<string> ExtraColumns(List<ImportErrorLogicalRowDto> rows)
    {
        if (error is null) return new();
        var withData = error.LogicalRows.Where(r => r.Data != null).ToList();
        var skip = new HashSet<string>(StringComparer.Ordinal);
        var headers = withData.SelectMany(r => r.Data!.Select(kv => kv.Key)).Distinct().ToList();
        var isSalesman = string.Equals(error.ErrorType, "SalesmanMissing", StringComparison.OrdinalIgnoreCase);

        foreach (var h in headers)
        {
            var invoiceRows = withData.Where(r => !string.IsNullOrWhiteSpace(r.Invoice)).ToList();
            if (invoiceRows.Count > 0 && invoiceRows.All(r => SameText(DataCell(r, h), r.Invoice))) { skip.Add(h); continue; }

            var reported = withData.Where(r => r.IsReportedRow).ToList();
            if (!isSalesman && reported.Count > 0 && reported.All(r => SameText(DataCell(r, h), error.Value))) skip.Add(h);
        }

        return rows.Where(r => r.Data != null).SelectMany(r => r.Data!.Select(kv => kv.Key))
            .Distinct().Where(h => !skip.Contains(h)).ToList();
    }

    // A column is right-aligned when every filled cell in it is a number.
    private static bool IsNumericColumn(string header, List<ImportErrorLogicalRowDto> rows)
    {
        var values = rows.Select(r => DataCell(r, header).Trim()).Where(v => v.Length > 0).ToList();
        return values.Count > 0 && values.All(v => decimal.TryParse(v, System.Globalization.NumberStyles.Number,
System.Globalization.CultureInfo.InvariantCulture, out _));
    }

    private static string CellValue(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private async Task RunAsync(Func<Task<bool>> action, string done)
    {
        busy = true;
        message = null;
        try
        {
            var ok = await action();
            messageIsError = !ok;
            message = ok ? done : "This error was changed by someone else. The page has been refreshed.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "That didn't work. Please try again, or contact support if it keeps happening.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task IgnoreAsync()
    {
        showIgnore = false;
        await RunAsync(() => DetailsData.IgnoreAsync(ImportErrorId), "Error ignored.");
    }

    private Task ReopenAsync() => RunAsync(() => DetailsData.ReopenAsync(ImportErrorId), "Error reopened.");

    private async Task VerifyRowsAsync()
    {
        if (error is null || verifying) return;

        verifying = true;
        busy = true;
        message = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var attempts = 0;
            var unverifiable = 0;
            var verified = false;

            var candidates = await Verifier.GetCandidatesAsync(ImportErrorId);
            if (candidates.Count > 0)
            {
                var r = await Verifier.VerifyAndResolveAsync(ImportErrorId, candidates[0].ImportBatchId);
                attempts++;
                verified = r.Outcome == VerificationOutcome.Verified;
                if (r.Outcome == VerificationOutcome.Unverifiable) unverifiable++;
            }

            if (!verified && !RecheckTooManyFiles)
            {
                var r = await Verifier.RecheckWithCurrentSettingsAsync(ImportErrorId);
                attempts++;
                verified = r.Outcome == VerificationOutcome.Verified;
                if (r.Outcome == VerificationOutcome.Unverifiable) unverifiable++;
            }

            await LoadAsync();

            var total = ReportedRowCount();
            var fixedNow = FixedRowCount();
            var resolvedNow = error is not null && ImportErrorPresentation.StatusKey(error.Status) ==
ImportErrorPresentation.Resolved;

            if (resolvedNow)
            {
                messageIsError = false;
                message = "All " + Plural(total, "row") + " fixed. This error is resolved.";
            }
            else if (attempts > 0 && unverifiable == attempts && fixedNow == 0)
            {
                messageIsError = true;
                message = "Entriel could not check this error right now, so nothing changed. Upload the corrected file or try again.";
            }
            else
            {
                messageIsError = fixedNow == 0;
                message = fixedNow == 0
                    ? "No rows are fixed yet. " + Plural(total, "row") + " still need fixing."
                    : fixedNow + " of " + Plural(total, "row") + " fixed. " + (total - fixedNow) + " still need fixing.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The check could not be completed. The error is still Pending. Please try again.";
        }
        finally
        {
            verifying = false;
            busy = false;
        }
    }

    private async Task DownloadAsync(ImportErrorBatchDetailDto batch)
    {
        busy = true;
        message = null;
        try
        {
            var file = await DetailsData.GetOriginalFileAsync(batch.ImportBatchId);
            if (file is null)
            {
                messageIsError = true;
                message = $"The original file for batch #{batch.ImportBatchId} was not found. It may never have been saved, or it was cleaned up.";
                return;
            }
            await JS.InvokeVoidAsync("downloadFileFromBytes", file.FileName, file.ContentType, Convert.ToBase64String(file.Bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The file could not be downloaded.";
        }
        finally
        {
            busy = false;
        }
    }


    // Text is built here (not inline in the markup) so the Razor parser never has to read quotes, colons or interpolations.
    private static string Date(DateTime? d) => d.HasValue ? d.Value.ToString("MMM d, yyyy") : "—";
    private static string Plural(int n, string noun) => n + " " + noun + (n == 1 ? "" : "s");

    private bool IsReimport => error is not null && (ImportErrorPresentation.IsVerifiedByReimport(error.ResolutionType)
        || (error.VerifiedImportBatchId.HasValue && !ImportErrorPresentation.IsVerifiedByRecheck(error.ResolutionType)));
        
    private bool IsRecheck => error is not null && ImportErrorPresentation.IsVerifiedByRecheck(error.ResolutionType);

    private string? FixedVia => error is null || (!IsRecheck && !IsReimport) ? null :
ImportErrorGuidance.FixChoiceName(error.ErrorType, error.FixChoice);

    private string ResolvedTitle(bool auto) =>
        FixedVia is { } via ? "Fixed via " + via
        : IsRecheck ? "Verified by recheck"
        : IsReimport ? "Verified by re-import"
        : auto ? "Resolved automatically"
        : "Resolved manually";

    private string ResolvedLine(bool auto)
    {
        if (error is null) return string.Empty;
        if (!IsRecheck && !IsReimport && auto)
            return "Entriel re-checked the affected rows" + (error.ResolvedAtPht.HasValue ? " on " + Date(error.ResolvedAtPht) : "")
+ " and they now pass validation.";

        var parts = new List<string>();
        if (FixedVia != null) parts.Add(IsRecheck ? "Verified by recheck" : "Verified by re-import");
        if (IsRecheck && error.RecheckedImportBatchIds.Count > 0)
            parts.Add("Original file(s) rechecked: " + string.Join(", ", error.RecheckedImportBatchIds.Select(id => "batch #" +
id)));
        if (error.ResolvedByName != null) parts.Add("By " + error.ResolvedByName);
        if (error.ResolvedAtPht.HasValue) parts.Add(Date(error.ResolvedAtPht));
        if (IsReimport && error.VerifiedImportBatchId.HasValue) parts.Add("Verified against batch #" +
error.VerifiedImportBatchId.Value);
        if (IsRecheck) parts.Add("Rechecked with the current template and master data. Nothing was imported: upload the file again to import these invoices.");
        else if (!IsReimport && !string.IsNullOrWhiteSpace(error.ResolutionType)) parts.Add("Type: " + error.ResolutionType);
        return string.Join(" · ", parts);
    }

    private static string RecurrenceIntro(ImportErrorRecurrenceDto r)
    {
        var status = ImportErrorPresentation.StatusKey(r.PreviousStatus);
        if (status == ImportErrorPresentation.Resolved)
        {
            if (ImportErrorPresentation.IsVerifiedByRecheck(r.PreviousResolutionType))
                return "This problem was previously resolved by a recheck.";
            if (ImportErrorPresentation.IsVerifiedByReimport(r.PreviousResolutionType))
                return "This problem was previously resolved by a re-import.";
            var auto = r.PreviousResolutionType != null && r.PreviousResolutionType.Contains("auto",
StringComparison.OrdinalIgnoreCase);
            return "This problem was previously marked as resolved " + (auto ? "automatically." : "manually.");
        }
        return "This problem was previously recorded as " +
ImportErrorPresentation.StatusText(r.PreviousStatus).ToLowerInvariant() + ".";
    }

    private static string RecurrenceDetail(ImportErrorRecurrenceDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.PreviousResolutionType)) parts.Add("Resolution: " + r.PreviousResolutionType);
        if (r.PreviousResolvedByName != null) parts.Add("Resolved by " + r.PreviousResolvedByName);
        if (r.PreviousResolvedAtPht.HasValue) parts.Add(Date(r.PreviousResolvedAtPht));
        parts.Add(Plural(r.PreviousOccurrences, "earlier occurrence"));
        return string.Join(" · ", parts);
    }

    private string RecurrenceBatch() =>
        firstBatchId.HasValue ? "The same problem was detected again in Batch #" + firstBatchId.Value + "." : "The same problem was detected again.";

    private static string HistoryTail(ImportErrorBatchDetailDto b) => b.UploadedByName is null ? string.Empty : " · " +
b.UploadedByName;

    private string ValueSource()
    {
        if (error is null) return string.Empty;
        var field = ImportErrorPresentation.FieldLabel(error.FieldName);
        var source = error.SubDistributorName ?? "Source file";
        return field.Length > 0 ? source + " · " + field : source;
    }

    private static string SheetRow(ImportErrorLogicalRowDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(r.Sheet)) parts.Add(r.Sheet);
        if (r.RowNumber.HasValue) parts.Add(r.RowNumber.Value.ToString());
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    // What a reported row shows in the Problem value column.
    private string ReportedValue(ImportErrorLogicalRowDto r) =>
        error is not null && string.Equals(error.ErrorType, "SalesmanMissing", StringComparison.OrdinalIgnoreCase)
            ? "missing"
            : error?.Value ?? string.Empty;

    private static string TruncText() =>
        "At least one file had more affected rows than Entriel stores (" +
STTproject.Services.ImportLogService.MaxAffectedRows.ToString("N0") +
        " per error per file), so this list is not complete. The occurrence count above is.";

    private static string CorrectionClass(string? state) => state switch
    {
        ImportErrorCorrectionState.Corrected => "ied-pill-corrected",
        ImportErrorCorrectionState.PreviouslyReported => "ied-pill-previous",
        _ => "ied-pill-still"
    };

    private static string StatusClass(string? status) => ImportErrorPresentation.StatusKey(status) switch
    {
        ImportErrorPresentation.Ignored => "ied-pill-ignored",
        ImportErrorPresentation.Resolved => "ied-pill-resolved",
        _ => "ied-pill-pending"
    };
}
