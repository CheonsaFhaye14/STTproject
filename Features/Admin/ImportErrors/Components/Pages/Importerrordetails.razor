@page "/admin/import-errors/{ImportErrorId:int}"
@layout STTproject.Shared.Layout.Admin.AdminSideBar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IImportErrorDetailsService DetailsData
@inject IImportErrorVerificationService Verifier

<LoadingOverlay Show="isLoading" Title="Loading error…" Subtitle="Please wait while we fetch the details."
                IconClass="fa-solid fa-exclamation-triangle" />

<div style="@(isLoading ? "display:none;" : "")">
    <div class="clt-page ied-page">

        @if (error is null)
        {
            <nav class="ied-crumb" aria-label="Breadcrumb">
                <button type="button" class="ied-link" @onclick="Back">← Back to Import Errors</button>
            </nav>
            <div class="ied-card ied-empty">
                <h1 class="clt-page-title">Error not found</h1>
                <p class="clt-page-sub">It may have been removed, or the link is wrong.</p>
                <Button Title="← Back to Import Errors" Variant="ButtonVariant.Secondary" OnClick="Back" />
            </div>
        }
        else
        {
            var title = ImportErrorPresentation.Title(error.ErrorType);
            var guide = ImportErrorGuidance.For(error.ErrorType, error.Message);
            var pending = ImportErrorPresentation.IsPending(error.Status);
            var ignored = ImportErrorPresentation.StatusKey(error.Status) == ImportErrorPresentation.Ignored;
            var resolved = ImportErrorPresentation.StatusKey(error.Status) == ImportErrorPresentation.Resolved;
            var auto = error.ResolutionType != null && error.ResolutionType.Contains("auto",
        StringComparison.OrdinalIgnoreCase);

            <nav class="ied-crumb" aria-label="Breadcrumb">
                <button type="button" class="ied-link" @onclick="Back">← Back to Import Errors</button>
            </nav>

            <div class="ied-head">
                <div>
                    <h1 class="clt-page-title">@title</h1>
                    <div class="ied-meta">
                        <span
                        class="ied-pill @StatusClass(error.Status)">@ImportErrorPresentation.StatusText(error.Status)</span>
                        <span class="ied-pill @CorrectionClass(error.CorrectionState)"
                              title="@error.CorrectionNote">@error.CorrectionState</span>
                    </div>
                </div>
                <div class="ied-actions">
                    @if (pending)
                    {
                        @if (ImportErrorGuidance.FixChoices(error.ErrorType).Count > 0)
                        {
                            <Button Title="Fix" Variant="ButtonVariant.Primary" OnClick="Fix" Disabled="busy" />
                        }
                        @if (error.CanVerify)
                        {
                            <Button Title="Verify" Variant="ButtonVariant.Secondary" OnClick="VerifyRowsAsync" Disabled="busy" />
                        }
                        else
                        {
                            <Button Title="Resolve Manually" Variant="ButtonVariant.Secondary" OnClick="OpenResolve" Disabled="busy" />
                        }
                        <Button Title="Ignore" Variant="ButtonVariant.Secondary" OnClick="() => showIgnore = true" Disabled="busy" />
                    }
                    else if (ignored)
                    {
                        <Button Title="Reopen error" Variant="ButtonVariant.Secondary" OnClick="ReopenAsync" Disabled="busy" />
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="ied-note ied-note-@(messageIsError ? "warn" : "gold")" role="status">@message</div>
            }
            @if (verifying)
            {
                <div class="ied-note ied-note-gold" role="status">
                    <b>Verifying…</b>
                    <span>Entriel is checking the affected rows against the latest upload and the current template. Nothing is imported or saved.</span>
                </div>
            }
                    @if (error.Recurrence is { } rec)
                    {
                        <div class="ied-note ied-note-gold" role="note">
                            <b>Returned</b>
                            <span>@RecurrenceIntro(rec)</span>
                            <span>
                                Previous error:
                                <button type="button" class="ied-link"
                                        @onclick="() => OpenError(rec.PreviousImportErrorId)">#@rec.PreviousImportErrorId</button>
                                · @RecurrenceDetail(rec)
                            </span>
                            <span>@RecurrenceBatch()</span>
                        </div>
                    }
                    @if (resolved)
                    {
                        <div class="ied-note ied-note-ok">
                            <b>@ResolvedTitle(auto)</b>
                            <span>@ResolvedLine(auto)</span>
                        </div>
                    }
                    @if (ignored)
                    {
                        <div class="ied-note ied-note-gray">
                            <b>Ignored</b>
                            <span>This error is out of the pending list but stays on record. You can reopen it any time.</span>
                        </div>
                    }

                    @* ---------- summary ---------- *@
                    <p class="ied-summary">@SummaryText()</p>

                    <div class="ied-two">
                        @* ---------- what's wrong ---------- *@
                        <section class="ied-card ied-sec">
                            <h3>What's wrong</h3>
                            <div class="ied-body">
                                @if (error.Facts.Count > 0)
                                {
                                    @* Customer and unit-of-measure errors: each fact on its own line instead of one combined value. *@
                                    <div class="ied-val ied-facts">
                                        <dl>
                                            @foreach (var fact in error.Facts)
                                            {
                                                <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div>
                                            }
                                        </dl>
                                        <small>@ValueSource()</small>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(error.Value))
                                {
                                    <div class="ied-val">
                                        @error.Value
                                        <small>@ValueSource()</small>
                                    </div>
                                }
                                @if (!ImportErrorGuidance.IsKnown(error.ErrorType))
                                {
                                    <p class="ied-what">@guide.What</p>
                                }
                                <div class="ied-q">
                                    <h4>Why did this happen?</h4>
                                    <p>@guide.Why</p>
                                </div>
                                <div class="ied-todo">
                                    <h4>What to do</h4>
                                    <p>@guide.Todo</p>
                                </div>
                            </div>
                        </section>

                        @* ---------- import history ---------- *@
                        <section class="ied-card ied-sec">
                            <div class="ied-sh">
                                <h3>Import history</h3>
                                <span class="ied-sub">@Plural(error.Batches.Count, "upload")</span>
                            </div>
                            @if (error.Batches.Count == 0)
                            {
                                <p class="ied-sub">No import batches are linked to this error.</p>
                            }
                            else
                            {
                                <div class="ied-body">
                                    <ul class="ied-tl">
                                        @foreach (var (g, gi) in error.UploadGroups.Select((g, gi) => (g, gi)))
                                        {
                                            if (g.AttemptCount == 1)
                                            {
                                                @BatchItem(g.Batches[0], false)
                                            }
                                            else
                                            {
                                                var groupIndex = gi;
                                                var groupOpen = expandedGroups.Contains(gi);
                                                <li>
                                                    <i class="ied-dot"></i>
                                                    <span>
                                                        <b>@Date(g.LastUploadedAtPht) · @g.FileName</b>
                                                        <span class="ied-chip">@Plural(g.AttemptCount, "upload attempt")</span>
                                                        <span class="ied-sub">@GroupText(g)</span>
                                                    </span>
                                                    <span class="ied-ac">
                                                        <Button Title="@(groupOpen ? "Hide attempts" : "Show attempts")"
                                                                Variant="ButtonVariant.Secondary" OnClick="() => ToggleGroup(groupIndex)" />
                                                    </span>
                                                </li>
                                                @if (groupOpen)
                                                {
                                                    @foreach (var attempt in g.Batches)
                                                    {
                                                        @BatchItem(attempt, true)
                                                    }
                                                }
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </section>
                    </div>

                    @* ---------- rows to fix ---------- *@
                    <section class="ied-card ied-sec ied-rows">
                        <div class="ied-sh">
                            <h3>Rows to fix</h3>
                            <span class="ied-sub">@RowsHint()</span>
                        </div>

                        @if (error.LogicalRows.Count == 0)
                        {
                            <p class="ied-sub">No row details were stored for this error.</p>
                        }
                        else
                        {
                            var filtered = FilteredRows();
                            var shown = showAll ? filtered : filtered.Take(PageSize).ToList();
                            var cols = allColumns ? ExtraColumns(filtered) : new List<string>();
                            var numeric = cols.Where(c => IsNumericColumn(c, shown)).ToHashSet();

                            <div class="ied-tools">
                                <input type="search" class="ied-search" placeholder="Search row, invoice or value"
                                       value="@search" @oninput="OnSearch" aria-label="Search rows" />
                                <label class="ied-xopt">
                                    <input type="checkbox" checked="@allColumns" @onchange="OnAllColumns" />
                                    <span>All Excel columns</span>
                                </label>
                            </div>

                            @if (filtered.Count == 0)
                            {
                                <p class="ied-sub">No rows match.</p>
                            }
                            else
                            {
                                <div class="ied-rowscroll">
                                    <table class="ied-table ied-flat">
                                        <thead>
                                            <tr>
                                                <th>Row</th>
                                                <th>Invoice</th>
                                                <th>Problem</th>
                                                <th>Status</th>
                                                @foreach (var col in cols)
                                                {
                                                    <th class="@(numeric.Contains(col) ? "ied-num" : null)">@col</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in shown)
                                            {
                                                var st = StatusOf(r);
                                                var problem = ProblemText(r);
                                                var fixedNow = NowFixedValue(r) is not null;
                                                <tr class="@(r.IsReportedRow ? null : "ied-ctxrow")">
                                                    <td>@SheetRow(r)</td>
                                                    <td>@(r.Invoice ?? "—")</td>
                                                    <td>
                                                        @if (r.IsReportedRow)
                                                        {
                                                            <span class="@(problem == "missing" ? "ied-pv ied-missing-pv" : fixedNow ? "ied-pv ied-ok-pv" : "ied-pv")" title="@problem">@problem</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="@(problem == "missing" ? "ied-sub ied-missing" : "ied-sub")">@problem</span>
                                                        }
                                                    </td>
                                                    <td><span class="ied-st @st.Css" title="@st.Hint">@st.Text</span></td>
                                                    @foreach (var col in cols)
                                                    {
                                                        <td class="@(numeric.Contains(col) ? "ied-num" : null)" title="@DataCell(r, col)">@CellValue(DataCell(r, col))</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="ied-foot">
                                    <span class="ied-sub">@("Showing " + shown.Count + " of " + filtered.Count + " rows")</span>
                                    @if (filtered.Count > PageSize)
                                    {
                                        <Button Title="@(showAll ? "Show fewer" : "Show all " + filtered.Count + " rows")"
                                                Variant="ButtonVariant.Secondary" OnClick="ToggleShowAll" />
                                    }
                                </div>
                            }
                            @if (error.RowsTruncated)
                            {
                                <p class="ied-sub">@TruncText()</p>
                            }
                        }
                    </section>

                    @* ---------- technical details ---------- *@
                    <section class="ied-card ied-sec ied-tech">
                        <button type="button" class="ied-techhead" @onclick="ToggleTech" aria-expanded="@(showTech ? "true" : "false")">
                            <span class="ied-chev">@(showTech ? "▾" : "▸")</span>
                            <span>Technical details</span>
                        </button>
                        @if (showTech)
                        {
                            <dl class="ied-techlist">
                                <div><dt>Error code</dt><dd class="ied-mono">@error.ErrorType</dd></div>
                                <div><dt>Error ID</dt><dd class="ied-mono">#@error.ImportErrorId</dd></div>
                                <div><dt>Total across uploads</dt><dd>@Plural(error.Occurrences, "problem row") counted over @Plural(error.Batches.Count, "upload")</dd></div>
                                <div><dt>First detected</dt><dd>@Date(error.FirstSeenAtPht)</dd></div>
                                <div><dt>Last detected</dt><dd>@Date(error.LastSeenAtPht)</dd></div>
                            </dl>
                        }
                    </section>
                    }
                </div>
            </div>

            @if (showIgnore)
            {
                <Modal ShowModal="showIgnore" Width="480px" MaxWidth="100%" Title="Ignore this error"
                       Subtitle="It leaves your pending list but stays on record. You can reopen it any time."
                       OnClose="() => showIgnore = false">
                    <ChildContent>
                        <div class="ied-ctx"><b>@ImportErrorPresentation.Title(error?.ErrorType)</b><span>@error?.Value</span></div>
                    </ChildContent>
                    <FooterContent>
                        <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showIgnore = false" />
                        <Button Title="Ignore error" Variant="ButtonVariant.Primary" OnClick="IgnoreAsync" Disabled="busy" />
                    </FooterContent>
                </Modal>
            }

            @if (showBatchPick)
            {
                <Modal ShowModal="showBatchPick" Width="760px" MaxWidth="100%" Title="Which file do you want to fix?"
                       Subtitle="This error appeared in files with different import settings, so Entriel can't pick a template for you."
                       OnClose="() => showBatchPick = false">
                    <ChildContent>
                        <div class="ied-note ied-note-gold" style="margin-bottom:10px;text-align:left;">
                            Fixing one file's template does not resolve this error for the other files. It stays pending until every
                            affected file has been re-imported and passes validation.
                        </div>
                        <div class="ied-scroll" style="max-height:320px;">
                            <table class="ied-table">
                                <thead>
                                    <tr>
                                        <th>Batch</th>
                                        <th>Subdistributor</th>
                                        <th>Import type</th>
                                        <th>Uploaded</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in batchOptions)
                                    {
                                        var id = o.ImportBatchId;
                                        <tr>
                                            <td>#@o.ImportBatchId</td>
                                            <td>@(o.SubDistributorName ?? "—")</td>
                                            <td>@o.ImportType</td>
                                            <td>@Date(o.UploadedAtPht)</td>
                                            <td><Button Title="Fix this template" Variant="ButtonVariant.Secondary"
                                                            OnClick="() => ChooseBatchAsync(id)" Disabled="busy" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showBatchPick = false" />
                        </FooterContent>
                    </Modal>
                }

            @if (showFix)
            {
                <Modal ShowModal="showFix" Width="520px" MaxWidth="100%" Title="How do you want to fix this?"
                       Subtitle="Pick one. When you are done, come back here and press Verify."
                       OnClose="() => showFix = false">
                    <ChildContent>
                        <div class="ied-choices">
                            @foreach (var choice in ImportErrorGuidance.FixChoices(error?.ErrorType))
                            {
                                var key = choice.Key;
                                <div class="ied-choice">
                                    <Button Title="@choice.Label" Variant="ButtonVariant.Secondary" OnClick="() => ChooseFixAsync(key)" />
                                    <span class="ied-sub">@choice.Description</span>
                                </div>
                            }
                        </div>
                    </ChildContent>
                    <FooterContent>
                        <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showFix = false" />
                    </FooterContent>
                </Modal>
            }

                        @if (showPick)
                        {
                            <Modal ShowModal="showPick" Width="480px" MaxWidth="100%" Title="Which template read this file?"
                                   Subtitle="@("More than one active template could apply to batch #" + pickedBatchId + ". Pick the one its file uses.")"
                                   OnClose="() => showPick = false">
                                <ChildContent>
                                    <div style="display:flex;flex-direction:column;gap:8px;">
                                        @foreach (var o in pickOptions)
                                        {
                                            var id = o.ImportTemplateId;
                                            <Button Title="@(o.TemplateName + (o.IsGlobalDefault ? " (global default)" : string.Empty))"
                                                    Variant="ButtonVariant.Secondary" OnClick="() => OpenTemplate(id)" />
                                        }
                                    </div>
                                </ChildContent>
                                <FooterContent>
                                    <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showPick = false" />
                                </FooterContent>
                            </Modal>
                        }

                        @if (showResolve)
                        {
                            <Modal ShowModal="showResolve" Width="480px" MaxWidth="100%" Title="Resolve manually"
                                   Subtitle="Use this only when Entriel can't verify the fix on its own, for example when the mistake is in the source Excel file."
                                   OnClose="() => showResolve = false">
                                <ChildContent>
                                    <div class="ied-ctx"><b>@ImportErrorPresentation.Title(error?.ErrorType)</b><span>@error?.Value</span></div>
                                    <label class="ied-field">
                                        <span>Resolution type</span>
                                        <select @bind="resolveType">
                                            <option value="">Select…</option>
                                            @foreach (var t in ImportErrorDetailsService.ManualResolutionTypes)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="ied-check">
                                        <input type="checkbox" @bind="resolveConfirm" />
                                        <span>I confirm this has been addressed. Entriel has not verified it automatically.</span>
                                    </label>
                                    @if (!string.IsNullOrEmpty(resolveError))
                                    {
                                        <div class="ied-err" role="alert">@resolveError</div>
                                    }
                                </ChildContent>
                                <FooterContent>
                                    <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="() => showResolve = false" />
                                    <Button Title="Resolve" Variant="ButtonVariant.Primary" OnClick="ResolveAsync" Disabled="busy" />
                                </FooterContent>
                            </Modal>
                        }

@code {
    [Parameter] public int ImportErrorId { get; set; }

    private const int PageSize = 10;

    private ImportErrorDetailsDto? error;
    private bool isLoading = true;
    private bool busy;
    private int loadedId = -1;

    private readonly HashSet<int> expandedGroups = new();

    private bool allColumns;
    private bool showTech;
    private string search = string.Empty;
    private bool showAll;
    private bool showIgnore;
    private bool showResolve;
    private bool showPick;
    private bool showFix;
    private bool verifying;

    // Too many files to recheck at once: Verify then only checks the newest upload.
    private bool RecheckTooManyFiles => error is not null && error.Batches.Count > ImportErrorVerificationService.MaxRecheckBatches;
    private bool showBatchPick;
    private int pickedBatchId;
    private List<FixContextDto> batchOptions = new();
    private List<FixTemplateOption> pickOptions = new();
    private string resolveType = "";
    private bool resolveConfirm;
    private string? resolveError;

    private string? message;
    private bool messageIsError;

    private int? firstBatchId => error?.Batches.Count > 0 ? error.Batches[^1].ImportBatchId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ImportErrorId) return;
        loadedId = ImportErrorId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            error = await DetailsData.GetAsync(ImportErrorId);
            showAll = false;
            expandedGroups.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading import error {ImportErrorId}: {ex.Message}");
            error = null;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Back() => Nav.NavigateTo("/admin/import-errors");
    private void OpenError(int importErrorId) => Nav.NavigateTo($"/admin/import-errors/{importErrorId}");
    private void OpenFile(int importBatchId) => Nav.NavigateTo($"/admin/import-errors/files/{importBatchId}");
    // One way to fix it: go straight there. Several: let the admin choose.
    private async Task Fix()
    {
        var choices = ImportErrorGuidance.FixChoices(error?.ErrorType);
        if (choices.Count == 1) await ChooseFixAsync(choices[0].Key);
        else if (choices.Count > 1) showFix = true;
    }

    private async Task ChooseFixAsync(string key)
    {
        showFix = false;
        switch (key)
        {
            case ImportErrorGuidance.ChoiceReimport:
                Nav.NavigateTo(ImportErrorGuidance.ReimportRoute(error?.SubDistributorId));
                break;
            case ImportErrorGuidance.ChoiceMapping:
                Nav.NavigateTo(ImportErrorGuidance.FixRoute(error?.ErrorType, ImportErrorId));
                break;
            case ImportErrorGuidance.ChoiceTemplate:
                await FixTemplateAsync();
                break;
        }
    }

    private async Task FixTemplateAsync()
    {
        await GuardedAsync(async () =>
        {
            var contexts = await DetailsData.GetFixContextsAsync(ImportErrorId);
            if (contexts.Count == 0)
            {
                messageIsError = true;
                message = "No import batch is linked to this error, so Entriel can't tell which template to open.";
                return;
            }

            // Same subdistributor and import type in every batch: one template applies, so no choice is needed.
            // Different contexts: never guess. The admin picks the batch whose template they want to fix.
            var sameContext = contexts
                .Select(x => (x.SubDistributorId, (x.ImportType ?? string.Empty).Trim().ToLowerInvariant()))
                .Distinct().Count() == 1;

            if (sameContext) await OpenForBatchAsync(contexts[0].ImportBatchId);
            else { batchOptions = contexts.ToList(); showBatchPick = true; }
        });
    }

    private async Task ChooseBatchAsync(int batchId)
    {
        showBatchPick = false;
        await GuardedAsync(() => OpenForBatchAsync(batchId));
    }

    private async Task OpenForBatchAsync(int batchId)
    {
        pickedBatchId = batchId;
        var options = await DetailsData.FindFixTemplatesAsync(ImportErrorId, batchId);
        if (options.Count == 1) OpenTemplate(options[0].ImportTemplateId);
        else if (options.Count > 1) { pickOptions = options.ToList(); showPick = true; }
        else
        {
            messageIsError = true;
            message = "No active import template was found for batch #" + batchId + ", so there is nothing to fix. Create one under Import Templates.";
        }
    }

    private async Task GuardedAsync(Func<Task> work)
    {
        busy = true;
        message = null;
        try { await work(); }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The import template could not be found. Please try again.";
        }
        finally { busy = false; }
    }

    // The template page only reads these; it never saves anything by itself.
    private void OpenTemplate(int templateId)
    {
        showPick = false;
        var focus = Uri.EscapeDataString(string.IsNullOrWhiteSpace(error?.FieldName) ? "InvoiceDate" : error!.FieldName!);
        // The Excel sheets that still have rows to fix, so the template page can point at the tab that reads them.
        var sheetNames = error is null ? string.Empty : string.Join("|", error.LogicalRows
            .Where(r => r.IsReportedRow && NowFixedValue(r) is null && !string.IsNullOrWhiteSpace(r.Sheet))
            .Select(r => r.Sheet!).Distinct());
        var sheets = sheetNames.Length == 0 ? string.Empty : "&sheets=" + Uri.EscapeDataString(sheetNames);
        Nav.NavigateTo($"/admin/import-templates/{templateId}?fromError={ImportErrorId}&batch={pickedBatchId}&focus={focus}{sheets}");
    }
    private void ToggleGroup(int key) { if (!expandedGroups.Add(key)) expandedGroups.Remove(key); }
    private void ToggleTech() => showTech = !showTech;
    private void ToggleShowAll() => showAll = !showAll;
    private void OnSearch(ChangeEventArgs e) { search = e.Value?.ToString() ?? string.Empty; }
    private void OnAllColumns(ChangeEventArgs e) { allColumns = e.Value is true; }

    // One upload attempt in the import history. Used for a lone attempt and for each attempt inside an expanded group.
    private RenderFragment BatchItem(ImportErrorBatchDetailDto b, bool nested) =>
        @<li class="@(nested ? "ied-nested" : null)">
            <i class="ied-dot"></i>
            <span>
                <b>@Date(b.UploadedAtPht) · Batch #@b.ImportBatchId</b>
                @if (b.ImportBatchId == firstBatchId)
                {
                    <span class="ied-chip">First detected</span>
                }
                <span class="ied-sub ied-clip" title="@b.FileName">
                    @b.FileName · @Plural(b.Occurrences, "problem row")
                    @HistoryTail(b)
                </span>
                @if (!string.IsNullOrEmpty(b.ReportedRowsText))
                {
                    <span class="ied-sub ied-clip" title="@b.ReportedRowsText">Reported Excel row: @b.ReportedRowsText</span>
                }
            </span>
            <span class="ied-ac">
                <Button Title="View details" Variant="ButtonVariant.Secondary" OnClick="() => OpenFile(b.ImportBatchId)" />
                <Button Title="Download" Variant="ButtonVariant.Secondary" OnClick="() => DownloadAsync(b)" Disabled="busy" />
            </span>
        </li>;

    private string SummaryText()
    {
        if (error is null) return string.Empty;
        var fixedCount = FixedRowCount();
        var text = Plural(ReportedRowCount() - fixedCount, "row") + " to fix";
        if (fixedCount > 0) text += " (" + fixedCount + " fixed)";
        if (error.AffectedInvoices > 0) text += " in " + Plural(error.AffectedInvoices, "invoice");
        text += " · uploaded " + Plural(error.Batches.Count, "time");
        if (error.LastSeenAtPht.HasValue) text += ", last on " + Date(error.LastSeenAtPht);
        return text;
    }

    private int ReportedRowCount() => error is null ? 0 : error.LogicalRows.Count(r => r.IsReportedRow);

    private int FixedRowCount() =>
        error is null ? 0
        : error.CorrectionState == ImportErrorCorrectionState.Corrected ? ReportedRowCount()
        : error.LogicalRows.Count(r => r.IsReportedRow && NowFixedValue(r) is not null);

    private static string GroupText(ImportErrorUploadGroupDto g)
    {
        var counts = g.Batches.Select(b => b.Occurrences).Distinct().OrderBy(n => n).ToList();
        var head = "The same file was uploaded " + g.AttemptCount + " times.";
        return counts.Count == 1
            ? head + " Each upload had the same " + Plural(counts[0], "problem row") + "."
            : head + " Problem rows per upload: " + string.Join(", ", g.Batches.Select(b => b.Occurrences)) + ".";
    }

    private string RowsHint() =>
        allColumns ? "Every column from the Excel file" : "Row, invoice, problem and status";

    // Only the rows the importer reported (invoice context rows stay in the stored evidence but are not listed). The search looks at what the table shows (and the Excel cells when they are shown).
    private List<ImportErrorLogicalRowDto> FilteredRows()
    {
        if (error is null) return new();
        var q = search.Trim();
        return error.LogicalRows
            .Where(r => r.IsReportedRow)
            .Where(r => q.Length == 0 || RowMatches(r, q))
            .ToList();
    }

    private bool RowMatches(ImportErrorLogicalRowDto r, string q)
    {
        bool Has(string? t) => t != null && t.Contains(q, StringComparison.OrdinalIgnoreCase);
        if (Has(SheetRow(r)) || Has(r.Invoice) || Has(ProblemText(r))) return true;
        return allColumns && r.Data != null && r.Data.Any(kv => Has(kv.Value));
    }

    // Row-level proof that a reported row is fixed, from the newest evidence Entriel holds for it:
    //  - a recheck that read a real value for the error's field with the current template (the value is the proof), or
    //  - the newest upload that kept this row did not report it and holds a real value for the field.
    // A row no later upload or recheck mentions is not treated as fixed.
    private static string? NowFixedValue(ImportErrorLogicalRowDto r)
    {
        if (r.HasCheckedValue && !string.IsNullOrWhiteSpace(r.CheckedValue)) return r.CheckedValue.Trim();

        var newest = r.Snapshots.FirstOrDefault();
        if (newest is null || newest.IsReportedRow || !newest.HasProblemValue || string.IsNullOrWhiteSpace(newest.ProblemValue)) return null;
        if (!r.Snapshots.Any(sn => sn.IsReportedRow)) return null;
        return newest.ProblemValue.Trim();
    }

    private (string Text, string Css, string Hint) StatusOf(ImportErrorLogicalRowDto r)
    {
        if (!r.IsReportedRow)
            return ("Context", "ied-st-ctx", "Another row of the same invoice, listed for comparison. The importer did not report it.");
        if (NowFixedValue(r) is { } now)
            return ("Fixed", "ied-st-ok", r.HasCheckedValue && !string.IsNullOrWhiteSpace(r.CheckedValue)
                ? "Read as " + now + " from the original file with the current template on " + Date(r.CheckedAtPht) + "."
                : "Upload #" + r.Snapshots[0].ImportBatchId + " has this row with a value of " + now + ".");
        return error?.CorrectionState == ImportErrorCorrectionState.Corrected
            ? ("Fixed", "ied-st-ok", error.CorrectionNote)
            : ("Not fixed", "ied-st-bad", error?.CorrectionNote ?? string.Empty);
    }

    // What the Problem column shows: the error's value for a reported row, the row's own value of that field for a context row.
    private string ProblemText(ImportErrorLogicalRowDto r)
    {
        if (NowFixedValue(r) is { } now) return now;
        if (error?.CorrectionState == ImportErrorCorrectionState.Corrected) return "—";
        if (r.IsReportedRow) return ReportedValue(r);
        if (r.HasProblemValue && !string.IsNullOrWhiteSpace(r.ProblemField))
            return string.IsNullOrWhiteSpace(r.ProblemValue) ? "missing" : r.ProblemValue!.Trim();
        return "—";
    }

    private static string DataCell(ImportErrorLogicalRowDto r, string header) =>
        r.Data?.FirstOrDefault(kv => kv.Key == header).Value ?? string.Empty;

    private static bool SameText(string? a, string? b) =>
        !string.IsNullOrWhiteSpace(a) && !string.IsNullOrWhiteSpace(b) && string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase);

    // The Excel columns added by "All Excel columns". A column is left out when it only repeats what the table already shows:
    // the invoice number (its value equals the row's invoice in every row), or the problem value (equals it in every reported row).
    private List<string> ExtraColumns(List<ImportErrorLogicalRowDto> rows)
    {
        if (error is null) return new();
        var withData = error.LogicalRows.Where(r => r.Data != null).ToList();
        var skip = new HashSet<string>(StringComparer.Ordinal);
        var headers = withData.SelectMany(r => r.Data!.Select(kv => kv.Key)).Distinct().ToList();
        var isSalesman = string.Equals(error.ErrorType, "SalesmanMissing", StringComparison.OrdinalIgnoreCase);

        foreach (var h in headers)
        {
            var invoiceRows = withData.Where(r => !string.IsNullOrWhiteSpace(r.Invoice)).ToList();
            if (invoiceRows.Count > 0 && invoiceRows.All(r => SameText(DataCell(r, h), r.Invoice))) { skip.Add(h); continue; }

            var reported = withData.Where(r => r.IsReportedRow).ToList();
            if (!isSalesman && reported.Count > 0 && reported.All(r => SameText(DataCell(r, h), error.Value))) skip.Add(h);
        }

        return rows.Where(r => r.Data != null).SelectMany(r => r.Data!.Select(kv => kv.Key))
            .Distinct().Where(h => !skip.Contains(h)).ToList();
    }

    // A column is right-aligned when every filled cell in it is a number.
    private static bool IsNumericColumn(string header, List<ImportErrorLogicalRowDto> rows)
    {
        var values = rows.Select(r => DataCell(r, header).Trim()).Where(v => v.Length > 0).ToList();
        return values.Count > 0 && values.All(v => decimal.TryParse(v, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out _));
    }

    private static string CellValue(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private async Task RunAsync(Func<Task<bool>> action, string done)
    {
        busy = true;
        message = null;
        try
        {
            var ok = await action();
            messageIsError = !ok;
            message = ok ? done : "This error was changed by someone else. The page has been refreshed.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "That didn't work. Please try again, or contact support if it keeps happening.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task IgnoreAsync()
    {
        showIgnore = false;
        await RunAsync(() => DetailsData.IgnoreAsync(ImportErrorId), "Error ignored.");
    }

    private Task ReopenAsync() => RunAsync(() => DetailsData.ReopenAsync(ImportErrorId), "Error reopened.");

    // One Verify for every kind of fix. It checks the newest upload first (a corrected file), then rechecks the original file(s) with the
    // current template and master data (a template or mapping fix). The error is resolved only when Entriel's own checks pass for every
    // affected invoice. Either way the page reloads, so the rows show what the stored uploads prove, and a short note says how many are fixed.
    private async Task VerifyRowsAsync()
    {
        if (error is null || verifying) return;

        verifying = true;
        busy = true;
        message = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var attempts = 0;
            var unverifiable = 0;
            var verified = false;

            var candidates = await Verifier.GetCandidatesAsync(ImportErrorId);
            if (candidates.Count > 0)
            {
                var r = await Verifier.VerifyAndResolveAsync(ImportErrorId, candidates[0].ImportBatchId);
                attempts++;
                verified = r.Outcome == VerificationOutcome.Verified;
                if (r.Outcome == VerificationOutcome.Unverifiable) unverifiable++;
            }

            if (!verified && !RecheckTooManyFiles)
            {
                var r = await Verifier.RecheckWithCurrentSettingsAsync(ImportErrorId);
                attempts++;
                verified = r.Outcome == VerificationOutcome.Verified;
                if (r.Outcome == VerificationOutcome.Unverifiable) unverifiable++;
            }

            await LoadAsync();

            var total = ReportedRowCount();
            var fixedNow = FixedRowCount();
            var resolvedNow = error is not null && ImportErrorPresentation.StatusKey(error.Status) == ImportErrorPresentation.Resolved;

            if (resolvedNow)
            {
                messageIsError = false;
                message = "All " + Plural(total, "row") + " fixed. This error is resolved.";
            }
            else if (attempts > 0 && unverifiable == attempts && fixedNow == 0)
            {
                messageIsError = true;
                message = "Entriel could not check this error right now, so nothing changed. Upload the corrected file or try again.";
            }
            else
            {
                messageIsError = fixedNow == 0;
                message = fixedNow == 0
                    ? "No rows are fixed yet. " + Plural(total, "row") + " still need fixing."
                    : fixedNow + " of " + Plural(total, "row") + " fixed. " + (total - fixedNow) + " still need fixing.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The check could not be completed. The error is still Pending. Please try again.";
        }
        finally
        {
            verifying = false;
            busy = false;
        }
    }

    private void OpenResolve()
    {
        resolveType = "";
        resolveConfirm = false;
        resolveError = null;
        showResolve = true;
    }

    private async Task ResolveAsync()
    {
        if (string.IsNullOrEmpty(resolveType) || !resolveConfirm)
        {
            resolveError = "Please choose a type and confirm.";
            return;
        }
        showResolve = false;
        await RunAsync(() => DetailsData.ResolveManuallyAsync(ImportErrorId, resolveType), "Marked as resolved manually.");
    }

    private async Task DownloadAsync(ImportErrorBatchDetailDto batch)
    {
        busy = true;
        message = null;
        try
        {
            var file = await DetailsData.GetOriginalFileAsync(batch.ImportBatchId);
            if (file is null)
            {
                messageIsError = true;
                message = $"The original file for batch #{batch.ImportBatchId} was not found. It may never have been saved, or it was cleaned up.";
                return;
            }
            await JS.InvokeVoidAsync("downloadFileFromBytes", file.FileName, file.ContentType, Convert.ToBase64String(file.Bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            messageIsError = true;
            message = "The file could not be downloaded.";
        }
        finally
        {
            busy = false;
        }
    }


    // Text is built here (not inline in the markup) so the Razor parser never has to read quotes, colons or interpolations.
    private static string Date(DateTime? d) => d.HasValue ? d.Value.ToString("MMM d, yyyy") : "—";
    private static string Plural(int n, string noun) => n + " " + noun + (n == 1 ? "" : "s");

    private bool IsReimport => error is not null && (ImportErrorPresentation.IsVerifiedByReimport(error.ResolutionType)
        || (error.VerifiedImportBatchId.HasValue && !ImportErrorPresentation.IsVerifiedByRecheck(error.ResolutionType)));
        
    private bool IsRecheck => error is not null && ImportErrorPresentation.IsVerifiedByRecheck(error.ResolutionType);

    private string ResolvedTitle(bool auto) =>
        IsRecheck ? "Verified by recheck"
        : IsReimport ? "Verified by re-import"
        : auto ? "Resolved automatically"
        : "Resolved manually";

    private string ResolvedLine(bool auto)
    {
        if (error is null) return string.Empty;
        if (!IsRecheck && !IsReimport && auto)
            return "Entriel re-checked the affected rows" + (error.ResolvedAtPht.HasValue ? " on " + Date(error.ResolvedAtPht) : "")
+ " and they now pass validation.";

        var parts = new List<string>();
        if (IsRecheck && error.RecheckedImportBatchIds.Count > 0)
            parts.Add("Original file(s) rechecked: " + string.Join(", ", error.RecheckedImportBatchIds.Select(id => "batch #" +
id)));
        if (error.ResolvedByName != null) parts.Add("By " + error.ResolvedByName);
        if (error.ResolvedAtPht.HasValue) parts.Add(Date(error.ResolvedAtPht));
        if (IsReimport && error.VerifiedImportBatchId.HasValue) parts.Add("Verified against batch #" +
error.VerifiedImportBatchId.Value);
        if (IsRecheck) parts.Add("Rechecked with the current template and master data. Nothing was imported: upload the file again to import these invoices.");
        else if (!IsReimport && !string.IsNullOrWhiteSpace(error.ResolutionType)) parts.Add("Type: " + error.ResolutionType);
        return string.Join(" · ", parts);
    }

    private static string RecurrenceIntro(ImportErrorRecurrenceDto r)
    {
        var status = ImportErrorPresentation.StatusKey(r.PreviousStatus);
        if (status == ImportErrorPresentation.Resolved)
        {
            if (ImportErrorPresentation.IsVerifiedByRecheck(r.PreviousResolutionType))
                return "This problem was previously resolved by a recheck.";
            if (ImportErrorPresentation.IsVerifiedByReimport(r.PreviousResolutionType))
                return "This problem was previously resolved by a re-import.";
            var auto = r.PreviousResolutionType != null && r.PreviousResolutionType.Contains("auto",
StringComparison.OrdinalIgnoreCase);
            return "This problem was previously marked as resolved " + (auto ? "automatically." : "manually.");
        }
        return "This problem was previously recorded as " +
ImportErrorPresentation.StatusText(r.PreviousStatus).ToLowerInvariant() + ".";
    }

    private static string RecurrenceDetail(ImportErrorRecurrenceDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.PreviousResolutionType)) parts.Add("Resolution: " + r.PreviousResolutionType);
        if (r.PreviousResolvedByName != null) parts.Add("Resolved by " + r.PreviousResolvedByName);
        if (r.PreviousResolvedAtPht.HasValue) parts.Add(Date(r.PreviousResolvedAtPht));
        parts.Add(Plural(r.PreviousOccurrences, "earlier occurrence"));
        return string.Join(" · ", parts);
    }

    private string RecurrenceBatch() =>
        firstBatchId.HasValue ? "The same problem was detected again in Batch #" + firstBatchId.Value + "." : "The same problem was detected again.";

    private static string HistoryTail(ImportErrorBatchDetailDto b) => b.UploadedByName is null ? string.Empty : " · " +
b.UploadedByName;

    private string ValueSource()
    {
        if (error is null) return string.Empty;
        var field = ImportErrorPresentation.FieldLabel(error.FieldName);
        var source = error.SubDistributorName ?? "Source file";
        return field.Length > 0 ? source + " · " + field : source;
    }

    private static string SheetRow(ImportErrorLogicalRowDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(r.Sheet)) parts.Add(r.Sheet);
        if (r.RowNumber.HasValue) parts.Add(r.RowNumber.Value.ToString());
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    // What a reported row shows in the Problem value column.
    private string ReportedValue(ImportErrorLogicalRowDto r) =>
        error is not null && string.Equals(error.ErrorType, "SalesmanMissing", StringComparison.OrdinalIgnoreCase)
            ? "missing"
            : error?.Value ?? string.Empty;

    private static string TruncText() =>
        "At least one file had more affected rows than Entriel stores (" +
STTproject.Services.ImportLogService.MaxAffectedRows.ToString("N0") +
        " per error per file), so this list is not complete. The occurrence count above is.";

    private static string CorrectionClass(string? state) => state switch
    {
        ImportErrorCorrectionState.Corrected => "ied-pill-corrected",
        ImportErrorCorrectionState.PreviouslyReported => "ied-pill-previous",
        _ => "ied-pill-still"
    };

    private static string StatusClass(string? status) => ImportErrorPresentation.StatusKey(status) switch
    {
        ImportErrorPresentation.Ignored => "ied-pill-ignored",
        ImportErrorPresentation.Resolved => "ied-pill-resolved",
        _ => "ied-pill-pending"
    };
}
