@using STTproject.Features.Admin.Users.Validators
@using STTproject.Shared.Components.Buttons
@using STTproject.Shared.Components.Forms
@using STTproject.Shared.Components.Modals
@inject STTproject.Features.Admin.Users.Services.IAdminUserService AdminUserService
@inject STTproject.Services.IUserContextService UserContextService

<Modal ShowModal="true" Width="720px" MaxWidth="100%" MaxHeight="88vh" 
    Title="@(isEdit ? (isViewMode ? "View User" : "Edit User") : "Add New User")"
    IconType="@(isEdit ? (isViewMode ? ModalIconType.UserView : ModalIconType.UserEdit) : ModalIconType.UserPlus)"
    OnClose="Cancel">
    <ChildContent>
        <FormSection Icon="ti ti-user" Title="User Details" Expandable="@isEdit" IsExpanded="true">
            <ChildContent>
                <div class="form-group">
                    <Input Label="Full Name" Required="true" @bind-Value="FullName" Disabled="@isViewMode" Placeholder="Enter full name"
                    ShowError="@ShowValidationErrors" ErrorText="@GetFieldError(UserValidations.AddUser.fullname.Key)" />
                </div>
                <div class="form-group">
                    <Input Label="Username" Required="true" @bind-Value="UserName" Disabled="@isViewMode" Placeholder="Enter username"
                    ShowError="@ShowValidationErrors" ErrorText="@GetFieldError(UserValidations.AddUser.username.Key)" />
                </div>
                <div class="form-group">
                    <Input Label="Email" Required="true" @bind-Value="Email" Disabled="@isViewMode" Placeholder="Enter email"
                    ShowError="@ShowValidationErrors" ErrorText="@GetFieldError(UserValidations.AddUser.email.Key)" />
                </div>
                @if (!isViewMode)
                {
                    <div class="form-group">
                        <InputPass @bind-Value="Password" Label="Password" Required="!isEdit" AddOptionalText="isEdit" OptionalText="(leave blank to keep current password)"
                                    ShowGenerate="true" ShowToggle="!isEdit"
                                    Placeholder="@(isEdit ? "Leave blank to keep current password" : "Enter password")"
                                    ShowError="@ShowValidationErrors"
                                    ErrorText="@GetFieldError(UserValidations.AddUser.password.Key)" />
                    </div>
                }
                <div class="form-group">
                    <Select Label="Role" Required="true" Items="@(new List<string> { "Admin", "Encoder" })" SelectedValue="@Role"
                            SelectedValueChanged="@(v => Role = v)" Disabled="@isViewMode" Placeholder="Select role"
                            ErrorText="@GetFieldError(UserValidations.AddUser.role.Key)" ShowError="@ShowValidationErrors"></Select>
                </div>
                <div class="form-group">
                    <Toggle @bind-Bind="IsActive" Disabled="@isViewMode"/>
                </div>

            </ChildContent>
        </FormSection>

        @if (isViewMode)
        {
            <FormSection Icon="ti ti-info-circle" Title="Audit Information" Expandable="true" IsExpanded="false">
                <ChildContent>
                    <div class="form-group">
                        <Input Label="Created Date" Disabled="true" Value="@CreatedDateDisplay" />
                    </div>
                    @if(UpdatedDate != null)
                    {
                    <div class="form-group">
                        <Input Label="Updated Date" Disabled="true" Value="@UpdatedDateDisplay" />
                    </div>
                    }
                </ChildContent>
            </FormSection>
        }
    </ChildContent>
    <FooterContent>
        @if(isEdit && isViewMode)
        {
            <Button Title="Close" Variant="ButtonVariant.Secondary" OnClick="Cancel"></Button>
            <Button Title="Edit" Variant="ButtonVariant.Primary" OnClick="EnableEdit"></Button>
        }
        else
        {
            <Button Title="Cancel" Variant="ButtonVariant.Secondary" OnClick="Cancel" Disabled="@isSubmitting"></Button>
            <Button Title="@(isSubmitting ? (isEdit ? "Saving..." : "Creating...") : (isEdit ? "Save Changes" : "Create User"))" Variant="ButtonVariant.Primary" OnClick="CreateUser" Disabled="@isSubmitting"></Button>
        } 
    </FooterContent>
</Modal>

@code {
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback OnRequestConfirm { get; set; }
    public UserCreateDto? PendingDto { get; private set; }
    public UserUpdateDto? PendingUpdateDto { get; private set; }

    private string? Password { get; set; }
    private bool showPassword = false;
    private bool isViewMode = false;
    private ElementReference fullNameInput;
    private ElementReference emailInput;
    private ElementReference userNameInput;
    private ElementReference RoleSelect;
    private string? FullName { get; set; }
    private string? Email { get; set; }
    private string? UserName { get; set; }
    private string? Role { get; set; }
    private bool IsActive { get; set; } = true;

    // Audit fields (view mode only)
    private DateTime CreatedDate { get; set; }
    private DateTime? UpdatedDate { get; set; }
    private string? CreatedDateDisplay => CreatedDate.ToString("MMM d, yyyy hh:mm tt");
    private string? UpdatedDateDisplay => UpdatedDate?.ToString("MMM d, yyyy hh:mm tt");

    private Dictionary<string, string> Errors { get; set; } = new();
    private bool ShowValidationErrors { get; set; } = false;
    private bool isSubmitting = false;

    [Parameter] public int? UserId { get; set; }
    private bool isEdit => UserId.HasValue;
    private int? CurrentUserId => UserContextService.UserId;

    private string GetFieldError(string key) =>
        Errors.TryGetValue(key, out var msg) ? msg : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (isEdit)
        {
            isViewMode = true;
            var user = await AdminUserService.GetUserByIdAsync(UserId!.Value);
            if (user != null)
            {
                FullName = user.FullName;
                Email = user.Email;
                UserName = user.UserName;
                Role = user.Role;
                IsActive = user.IsActive;
                // Audit
                CreatedDate = user.CreatedDate;
                UpdatedDate = user.UpdatedDate;
                @*
                CreatedById = user.CreatedBy;
                UpdatedById = user.UpdatedBy;
                CreatedByName = await AdminUserService.GetUserNameByIdAsync(user.CreatedBy);
                if (user.UpdatedBy != null)
                    UpdatedByName = await AdminUserService.GetUserNameByIdAsync(user.UpdatedBy);
                    *@

            }
        }
    }

    private void EnableEdit()
    {
        isViewMode = false;
        Password = null;
        showPassword = false;
    }

    private void ToggleShowPassword() => showPassword = !showPassword;

    private void GenerateAndFillPassword()
    {
        Password = GenerateRandomPassword();
        showPassword = true; // reveal so the user can copy/note it down
    }

    private async Task CreateUser()
    {

        var userToValidate = new STTproject.Data.User
        {
            FullName = FullName ?? string.Empty,
            Email = Email ?? string.Empty,
            Username = UserName ?? string.Empty, // 👈 lowercase n
            Role = Role ?? string.Empty,
        };

        Errors = await UserValidations.ValidateAddUserAsync(userToValidate);

        // Password is required when creating a new user.
        // For edits, it's optional (blank = keep current password).
        if (!isEdit && string.IsNullOrWhiteSpace(Password))
        {
            Errors[UserValidations.AddUser.password.Key] = UserValidations.AddUser.password.ErrorMessage;
        }
        else if (!string.IsNullOrEmpty(Password) && Password.Length < 6)
        {
            Errors[UserValidations.AddUser.password.Key] = "Password must be at least 6 characters.";
        }

        ShowValidationErrors = true;

        if (Errors.Any()) return;

        if (isEdit)
        {
            PendingUpdateDto = new UserUpdateDto
            {
                UserId = UserId!.Value,
                FullName = FullName,
                Email = Email,
                UserName = UserName,
                Role = Role,
                IsActive = IsActive,
                // Only send a password if the admin entered/generated a new one.
                Password = string.IsNullOrWhiteSpace(Password) ? null : Password,
                // UpdatedBy = CurrentUserId
            };
        }
        else
        {
            PendingDto = new UserCreateDto
            {
                FullName = FullName,
                Email = Email,
                UserName = UserName,
                Role = Role,
                IsActive = IsActive,
                Password = Password,

                // CreatedBy = CurrentUserId // ← current user
            };
        }

        await OnRequestConfirm.InvokeAsync();
    }

    public async Task<(bool success, string? error)> SubmitAsync()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                if (PendingUpdateDto == null) return (false, "No pending update data.");
                await AdminUserService.UpdateUserAsync(PendingUpdateDto);
                return (true, null);
            }
            else
            {
                if (PendingDto == null) return (false, "No pending data.");
                await AdminUserService.CreateUserAsync(PendingDto);
                return (true, null);
            }
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
            when (ex.InnerException is Microsoft.Data.SqlClient.SqlException sqlEx &&
                  (sqlEx.Number == 2601 || sqlEx.Number == 2627))
        {
            // 2601: duplicate key in a unique INDEX
            // 2627: duplicate key in a unique/primary KEY CONSTRAINT
            Errors[UserValidations.AddUser.username.Key] =
                "This Username already exists.";
            ShowValidationErrors = true;
            await InvokeAsync(StateHasChanged);
            return (false, "This Username already exists. Please choose a different one.");
        }
        catch (Exception)
        {
            // Catch-all so unexpected errors surface in the confirm modal
            // instead of crashing the Blazor circuit.
            return (false, "Something went wrong while saving. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task Cancel()
    {
        if (onCancel.HasDelegate)
            return onCancel.InvokeAsync();
        return Task.CompletedTask;
    }
    private bool isSendingPassword;
    private string? passwordResetMessage;

    private async Task ResetPasswordAndSendEmail()
    {
        if (UserId == null) return;

        // must have an email
        if (string.IsNullOrWhiteSpace(Email))
        {
            passwordResetMessage = "⚠️ No email on this user — cannot send password.";
            return;
        }

        isSendingPassword = true;
        passwordResetMessage = null;

        var newPass = GenerateRandomPassword();

        var dto = new UserUpdateDto
        {
            UserId = UserId!.Value,
            FullName = FullName,
            Email = Email,
            UserName = UserName,
            Role = Role,
            IsActive = IsActive,
            Password = newPass, // service will hash + email this
        };

        await AdminUserService.UpdateUserAsync(dto);

        isSendingPassword = false;
        passwordResetMessage = $"✅ New password sent to {Email}";
    }

    private static string GenerateRandomPassword(int length = 12)
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%";
        var rng = System.Security.Cryptography.RandomNumberGenerator.Create();
        var bytes = new byte[length];
        rng.GetBytes(bytes);
        return new string(bytes.Select(b => chars[b % chars.Length]).ToArray());
    }
}
