<div @ref="overlayRef" tabindex="-1" @onkeydown="HandleKeyDown" style="outline: none;">
    <Modal ShowModal="true" Width="720px" MaxWidth="100%" MaxHeight="88vh" Title="Customer Details" OnClose="CloseModal" IconType="ModalIconType.UserView">
        <ChildContent>
            <FormSection Icon="ti ti-user" Title="Customer Information" Expandable="true" IsExpanded="true">
                <ChildContent>
                    <div class="form-group">
                        <Input Label="Customer Code" Value="@Customer?.CustomerCode" Disabled="true" />
                    </div>
                    <div class="form-group">
                        <Input Label="Customer Name" Value="@Customer?.CustomerName" Disabled="true" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Customer?.CustomerType))
                    {
                        <div class="form-group">
                            <Input Label="Customer Type" Value="@Customer?.CustomerType" Disabled="true" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Customer?.Province))
                    {
                        <div class="form-group">
                            <Input Label="Province" Value="@Customer?.Province" Disabled="true" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Customer?.City))
                    {
                        <div class="form-group">
                            <Input Label="City" Value="@Customer?.City" Disabled="true" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Customer?.AddressLine))
                    {
                        <div class="form-group">
                            <Input Label="Address Line" Value="@Customer?.AddressLine" Disabled="true" />
                        </div>
                    }
                    @if (Customer?.ZipCode != null)
                    {
                        <div class="form-group">
                            <Input Label="Zip Code" Value="@Customer?.ZipCode.ToString()" Disabled="true" />
                        </div>
                    }
                </ChildContent>
            </FormSection>
            <FormSection Icon="ti ti-link" Title="Subd Customer" Expandable="true" IsExpanded="true">
                <ChildContent>
                    <AddTable TItem="SubdCustInfoDto" Items="Customer?.SubdCustomers"
                     Columns="@(new List<string> { "SubdCustCode", "SubdCustName" })"
                     ColumnLabels="@(new Dictionary<string,string> { ["SubdCustCode"] = "Subd Customer Code", ["SubdCustName"] = "Subd Customer Name" })"/>
                </ChildContent>
            </FormSection>
        </ChildContent>
        <FooterContent>
            <Button Title="Close" OnClick="CloseModal" Variant="ButtonVariant.Secondary" />
        </FooterContent>
    </Modal>
</div>

@code {
    private ElementReference overlayRef;

    [Parameter]
    public CustomerInfoDto? Customer { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await overlayRef.FocusAsync();
            }
            catch (InvalidOperationException)
            {

            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private Task CloseModal()
    {
        return OnClose.InvokeAsync(null);
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            return CloseModal();
        }

        return Task.CompletedTask;
    }
}