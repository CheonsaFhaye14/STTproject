@using STTproject.Data
@using STTproject.Services
@using STTproject.Features.User.Home.Components.Modals

@inject IHomeService homeService
@inject NavigationManager Navigation

<div class="activity">
    <div class="activity-top">
        <h3>Recent Activity...</h3>

        <!-- VIEW MODE TOGGLE -->
        <div class="view-toggle" role="group" aria-label="View mode">
            <button type="button" class="btn-toggle @(IsBatchView ? "active" : "")"
                    aria-pressed="@(IsBatchView ? "true" : "false")" @onclick="() => SetViewMode(BatchView)">
                Batch View
            </button>
            <button type="button" class="btn-toggle @(!IsBatchView ? "active" : "")"
                    aria-pressed="@(!IsBatchView ? "true" : "false")" @onclick="() => SetViewMode(FlatView)">
                Invoice List
            </button>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="filters @(IsBatchView ? "filters-batch" : "filters-flat")">
        <!-- Search -->
        <div class="filter-group filter-search">
            <Input TValue="string" Label="Search"
                   Placeholder="@(IsBatchView ? "Batch, subdistributor, invoice code or customer..." : "Invoice code, customer or subdistributor...")"
                   Value="@searchTerm" ValueChanged="OnSearchChanged" />
        </div>

        <!-- Order type (invoice list only: a batch can mix invoices and credits) -->
        @if (!IsBatchView)
        {
            <div class="filter-group">
                <OrderTypeFilter @key="@($"order-{filterResetKey}")" Value="@selectedOrderType"
                                 ValueChanged="OnOrderTypeChanged" />
            </div>
        }

        <!-- Subdistributor -->
        <div class="filter-group">
            <AutoComplete Label="Subdistributor" @key="@($"subd-{filterResetKey}")" TItem="SubDistributor"
                          Items="SubdList" ValueSelector="x => x.SubDistributorId.ToString()"
                          TextSelector="x => x.SubdName ?? string.Empty" Placeholder="All subdistributors"
                          SelectedValue="@(selectedSubDistributorId?.ToString())" SelectedItemChanged="OnSubdSelected" />
        </div>

        <!-- Month -->
        <div class="filter-group">
            <Select @key="@($"month-{filterResetKey}")" Label="Sales Invoice Month" Placeholder="All months"
                    TItem="FilterChoice" Items="MonthOptions" ValueSelector="x => x.Value" TextSelector="x => x.Text"
                    SelectedValue="@(selectedMonth?.ToString() ?? "")" SelectedValueChanged="OnMonthSelected" />
        </div>

        <!-- Year -->
        <div class="filter-group">
            <Select @key="@($"year-{filterResetKey}")" Label="Sales Invoice Year" Placeholder="All years"
                    TItem="FilterChoice" Items="yearOptions" ValueSelector="x => x.Value" TextSelector="x => x.Text"
                    SelectedValue="@(selectedYear?.ToString() ?? "")" SelectedValueChanged="OnYearSelected" />
        </div>

        <!-- Sort -->
        <div class="filter-group">
            <Select @key="@($"sort-{filterResetKey}")" Label="Sort by" Placeholder="Newest first" TItem="FilterChoice"
                    Items="SortOptions" ValueSelector="x => x.Value" TextSelector="x => x.Text" SelectedValue="@sortBy"
                    SelectedValueChanged="OnSortSelected" />
        </div>
    </div>

    <div class="result-bar">
        <span class="result-count">
            @if (IsBatchView)
            {
                @($"Showing {filteredBatchRows.Count} of {batchRows.Count} batches")
            }
            else
            {
                @($"Showing {filteredFlatRows.Count} of {flatRows.Count} invoices")
            }
        </span>

        @if (HasActiveFilters)
        {
            <button type="button" class="btn-clear" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

    <!-- BATCH VIEW (Grouped View) -->
    @if (IsBatchView)
    {
        <div class="activity-table-wrapper">
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>BATCH NAME</th>
                        <th>SubDistributor Name</th>
                        <th>Invoice Date Range</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredBatchRows.Count > 0)
                    {
                        @foreach (var row in filteredBatchRows)
                        {
                            <tr @key="row.BatchId">
                                <td>@row.BatchId</td>
                                <td>@row.SubdName</td>
                                <td>
                                    @if (row.LatestInvoiceDate == row.OldestInvoiceDate)
                                    {
                                        @row.LatestInvoiceDate.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        @($"{row.OldestInvoiceDate:yyyy-MM-dd} - {row.LatestInvoiceDate:yyyy-MM-dd}")
                                    }
                                </td>
                                <td>
                                    <button class="btn-primary" @onclick="() => OpenBatchDetailsAsync(row)">View Details</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                @(HasActiveFilters ? "No batches match your filters." : "No sales invoice activity found.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- FLAT VIEW (Invoice List) -->
        <div class="activity-table-wrapper">
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>Sales Invoice Code</th>
                        <th>Sales Invoice Date</th>
                        <th>SubDistributor Name</th>
                        <th>Customer Name</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredFlatRows.Count > 0)
                    {
                        @foreach (var row in filteredFlatRows)
                        {
                            <tr @key="row.SalesInvoiceId">
                                <td>@row.InvoiceCode</td>
                                <td>@row.SalesInvoiceDate.ToString("yyyy-MM-dd")</td>
                                <td>@row.SubdName</td>
                                <td>@row.CustomerName</td>
                                <td>@row.CreatedDate.ToString("MMM d, yyyy hh:mm tt")</td>
                                <td>
                                    <button class="btn-primary" @onclick="() => OpenInvoiceDetailsAsync(row)">View Details</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                @(HasActiveFilters ? "No invoices match your filters." : "No sales invoice found.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODALS -->
<BatchDetail Show="showBatchDetailsModal" BatchId="@selectedBatchId" SubdName="@selectedBatchSubdName"
             BatchInvoices="selectedBatchInvoices" OnClose="CloseBatchDetails"
             OnViewInvoiceDetails="async (id) => await OpenInvoiceDetailsByIdAsync(id)" />

<InvoiceDetail Show="showInvoiceDetailsModal" InvoiceCode="@selectedInvoiceCode" InvoiceDetails="selectedInvoiceDetails"
               OnClose="CloseInvoiceDetails" OnEdit="EditInvoiceDetails" />
