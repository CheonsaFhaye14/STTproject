@using STTproject.Services
@using STTproject.Features.User.SalesInvoice.DTOs
@inject STTproject.Features.User.SalesInvoice.Services.ImportSalesInvoiceService ImportSalesInvoiceService
@inject STTproject.Features.User.SalesInvoice.Services.DownloadTemplateService DownloadTemplateService
@inject IUserContextService UserContext
@inject IJSRuntime JS

<LoadingOverlay Show="isPreparing"
                Title="Checking your file…"
                Subtitle="Validating headers, rows, and data. This may take a moment."
                IconClass="fa-solid fa-file-arrow-up" />

@if (Show && !showResults)
{
    <Modal ShowModal="Show"
           Title="Import Sales Invoices"
           Subtitle="Import invoice rows from an Excel file for this sub-distributor."
           IconType="ModalIconType.Upload"
           Details="Excel should contain: Invoice Code, Invoice Date, Customer, SKU/Item, UOM, Quantity (required)."
           OnClose="HandleClose">
        <ChildContent>
            <FileInput OnFileSelected="HandleFileSelected" />
            @if (SubDistributorId <= 0)
            {
                <p class="text-muted" style="font-size:13px;">Select a sub-distributor before importing.</p>
            }
        </ChildContent>
        <FooterContent>
            <Button Title="Cancel" OnClick="HandleClose" Variant="ButtonVariant.Secondary" />
            <Button Title="Check File"
                    OnClick="OnPrepare"
                    Disabled="@(selectedFile == null || isPreparing || SubDistributorId <= 0)"
                    Icon="fa-solid fa-check"
                    Variant="ButtonVariant.Primary" />
        </FooterContent>
    </Modal>
}

<ImportSalesInvoiceResults Show="showResults"
                           ImportResult="importResult"
                           OnCommit="HandleCommitAsync"
                           OnClose="CloseResults"
                           OnDownloadErrorReport="HandleDownloadErrorReport" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int SubDistributorId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private IBrowserFile? selectedFile;
    private bool isPreparing;
    private bool showResults;
    private ImportSalesInvoiceResult? importResult;

    private const long MaxFileSizeBytes = 20 * 1024 * 1024;

    private void HandleFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        importResult = null;
    }

    private async Task OnPrepare()
    {
        if (selectedFile == null || SubDistributorId <= 0) return;

        isPreparing = true;
        importResult = null;
        StateHasChanged();

        try
        {
            byte[] fileBytes;
            await using (var stream = selectedFile.OpenReadStream(MaxFileSizeBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                fileBytes = ms.ToArray();
            }

            using var importStream = new MemoryStream(fileBytes);
            importResult = await ImportSalesInvoiceService.PrepareFromExcelAsync(
                importStream, SubDistributorId, UserContext.UserId ?? 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            importResult = new ImportSalesInvoiceResult();
            importResult.AddError(0, string.Empty, $"Failed to open/import file: {ex.Message}. Supported formats: .xlsx, .xlsm.");
        }
        finally
        {
            isPreparing = false;
            showResults = importResult != null;
            StateHasChanged();
        }
    }

    private async Task HandleCommitAsync()
    {
        if (importResult == null || !UserContext.UserId.HasValue) return;

        var toCommit = importResult.PreparedInvoices
            .Where(p => p.Selected && (p.Issues == null || p.Issues.Count == 0))
            .ToList();

        if (toCommit.Count == 0) return;

        var commitResult = await ImportSalesInvoiceService.CommitPreparedInvoicesAsync(toCommit, UserContext.UserId.Value);

        // Merge saved status back into the invoices the results modal is displaying.
        foreach (var prepared in toCommit)
        {
            var existing = importResult.PreparedInvoices.FirstOrDefault(p => p.InvoiceNumber == prepared.InvoiceNumber);
            if (existing != null)
            {
                existing.IsSaved = prepared.IsSaved;
                existing.SaveErrorMessage = prepared.SaveErrorMessage;
                existing.Selected = !existing.IsSaved; // unselect what's already saved
            }
        }

        if (commitResult.HasIssues)
        {
            foreach (var issue in commitResult.Issues)
            {
                importResult.Issues.Add(issue);
            }
        }

        if (commitResult.ImportedInvoiceCount > 0)
        {
            await OnImportCompleted.InvokeAsync();
        }

        // Keep the results modal open so the user can see which invoices were saved.
        StateHasChanged();
    }

    private async Task HandleDownloadErrorReport()
    {
        if (importResult == null) return;

        var bytes = DownloadTemplateService.GenerateErrorReportExcel(importResult);
        var fileName = $"SalesInvoice-Import-Errors-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx";

        await JS.InvokeVoidAsync(
            "downloadFileFromBytes",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task CloseResults()
    {
        showResults = false;
        selectedFile = null;
        importResult = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleClose()
    {
        selectedFile = null;
        importResult = null;
        await OnClose.InvokeAsync();
    }
}