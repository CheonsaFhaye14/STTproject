@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (Show)
{
    <div class="modal-overlay import-sales-invoice-overlay" id="import-sales-invoice-overlay">
        <div class="modal-box">

            @* ── Modal header ── *@
            <div class="modal-header-ent">
                <div class="mh-left">
                    <div class="mh-icon">
                        <i class="ti ti-file-import" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="mh-title">Import results</div>
                        <div class="mh-sub">@ImportResult?.PreparedInvoices?.FirstOrDefault()?.SubDistributor</div>
                    </div>
                </div>
                <button type="button" class="mh-close" @onclick="OnClose" aria-label="Close">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>

            @* ── Modal body ── *@
            <div class="modal-body-ent">
                @if (ImportResult == null)
                {
                    <p class="text-muted" style="font-size:13px;">No import result to display.</p>
                }
                else
                {
                    var invoiceCards = GetInvoiceCards();
                    var globalIssues = GetGlobalIssues();
                    var hasSuccessCards = invoiceCards.Any(c => !c.HasErrors && !HasWarningOnly(c));
                    var hasErrorCards = invoiceCards.Any(c => c.HasErrors);
                    var hasWarningCards = invoiceCards.Any(HasWarningOnly);
                    if (cardFilter == InvoiceCardFilter.SuccessOnly && !hasSuccessCards)
                        cardFilter = hasWarningCards ? InvoiceCardFilter.WarningOnly : (hasErrorCards ? InvoiceCardFilter.ErrorOnly : cardFilter);
                    else if (cardFilter == InvoiceCardFilter.WarningOnly && !hasWarningCards)
                        cardFilter = hasSuccessCards ? InvoiceCardFilter.SuccessOnly : (hasErrorCards ? InvoiceCardFilter.ErrorOnly : cardFilter);
                    else if (cardFilter == InvoiceCardFilter.ErrorOnly && !hasErrorCards)
                        cardFilter = hasSuccessCards ? InvoiceCardFilter.SuccessOnly : (hasWarningCards ? InvoiceCardFilter.WarningOnly : cardFilter);

                    var filteredCards = GetFilteredCards(invoiceCards);
                    // Split once instead of calling .Where() twice per render in the markup
                    var successCards = filteredCards.Where(c => !c.HasErrors).ToList();                    
                    var errorCards = filteredCards.Where(c => c.HasErrors).ToList();
                    var selectedCount = invoiceCards.Count(c => c.Prepared?.Selected == true && !c.HasErrors && c.Prepared?.IsSaved != true);
                    var selectableCount = invoiceCards.Count(c => c.Prepared != null && !c.HasErrors && c.Prepared.IsSaved != true);
                    var totalRows = ImportResult.TotalRowsProcessed;

                    @* ── Summary stat bar ── *@
                    <div class="stat-bar">
                        <div class="sc">
                            <div class="sc-label">Total rows</div>
                            <div class="sc-val">@totalRows</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">Invoices</div>
                            <div class="sc-val">@invoiceCards.Count</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">Valid</div>
                            <div class="sc-val sc-ok">@invoiceCards.Count(c => !c.HasErrors && !HasWarningOnly(c))</div>                        
                        </div>
                        <div class="sc">
                            <div class="sc-label">With warnings</div>
                            <div class="sc-val sc-warn">@invoiceCards.Count(HasWarningOnly)</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">With errors</div>
                            <div class="sc-val @(hasErrorCards ? "sc-er" : "")">@invoiceCards.Count(c => c.HasErrors)</div>
                        </div>
                    </div>

                    @* ── Global file-level failure ── *@
                    @if (globalIssues.Any())
                    {
                        <div class="global-alert">
                            <i class="ti ti-shield-x global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">Import failed — file could not be processed</div>
                                <ul class="global-alert-list">
                                    @foreach (var issue in globalIssues)
                                    {
                                        <li>
                                            <span class="row-tag">Row @issue.RowNumber</span>
                                            @issue.Message
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <p class="hint-text">Fix the issues in your file and re-upload to continue.</p>
                    }

                    @* ── Pure success (no cards, no global issues) ── *@
                    @if (!invoiceCards.Any() && !globalIssues.Any())
                    {
                        <div class="success-banner">
                            <div class="success-banner-icon">
                                <i class="ti ti-circle-check" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="success-banner-title">Import complete</div>
                                <div class="success-banner-sub">
                                    @ImportResult.ImportedInvoiceCount invoice(s) imported successfully across @ImportResult.ImportedRowCount total row(s). Ready to commit.
                                </div>
                            </div>
                        </div>
                    }

                    @* ── Tabs ── *@
                    @if (invoiceCards.Any())
                    {
                    <div class="tabs">
                        @if (hasSuccessCards)
                        {
                            <button type="button"
                                    class="tab @GetTabClass(InvoiceCardFilter.SuccessOnly)"
                                    @onclick='() => SetTab(InvoiceCardFilter.SuccessOnly)'>
                                <span class="dot dot-ok"></span>
                                Valid (@invoiceCards.Count(c => !c.HasErrors))
                            </button>
                        }
                        @if (hasWarningCards)
                        {
                            <button type="button" class="tab @GetTabClass(InvoiceCardFilter.WarningOnly)" @onclick='() => SetTab(InvoiceCardFilter.WarningOnly)'>
                                <span class="dot dot-warn"></span>
                                Warnings (@invoiceCards.Count(HasWarningOnly))
                            </button>
                        }
                        @if (hasErrorCards)
                        {
                            <button type="button"
                                    class="tab @GetTabClass(InvoiceCardFilter.ErrorOnly)"
                                    @onclick='() => SetTab(InvoiceCardFilter.ErrorOnly)'>
                                <span class="dot dot-er"></span>
                                Errors (@invoiceCards.Count(c => c.HasErrors))
                            </button>
                        }
                    </div>

                        @* ── Error filter bar (only on error tab) ── *@
                        @if (cardFilter == InvoiceCardFilter.ErrorOnly)
                        {
                            <div class="err-filter-bar">
                                <span class="err-filter-label">
                                    <i class="ti ti-filter" aria-hidden="true"></i>
                                    Filter by error
                                </span>
                                <select @onchange="OnErrorFilterChanged" value="@(selectedErrorFilter ?? string.Empty)">
                                    <option value="">All error types</option>
                                    @foreach (var entry in GetDistinctErrorMessages())
                                    {
                                        var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                        <option value="@entry.Message">@display (@entry.Count)</option>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(selectedErrorFilter))
                                {
                                    <button type="button" class="clear-filter-btn" @onclick="ClearErrorFilter">
                                        <i class="ti ti-x" aria-hidden="true"></i>
                                        Clear
                                    </button>
                                }
                            </div>
                            <button type="button" class="btn-download-errors" @onclick="HandleDownloadErrorReport">
                                <i class="ti ti-download" aria-hidden="true"></i>
                                Download Error Report
                            </button>
                        }

                        @* ── Select all (only on valid / all tab) ── *@
                        @if (cardFilter == InvoiceCardFilter.SuccessOnly && selectableCount > 0)
                        {
                            <div class="sel-all-bar">
                                <input type="checkbox"
                                       id="select-all-check"
                                       checked="@(selectedCount == selectableCount)"
                                       @onchange="(e) => ToggleSelectAllInvoices(e.Value)" />
                                <label for="select-all-check">Select all valid (@selectedCount / @selectableCount ready)</label>
                            </div>
                        }

                        @* ── Invoice cards ── *@
                        <div class="import-results">
                            <div class="search-sort-bar">
                                <div class="search-input-wrap">
                                    <i class="ti ti-search" aria-hidden="true"></i>
                                    <input type="text"
                                        placeholder="Search…"
                                        value="@searchTerm"
                                        @oninput="(e) => searchTerm = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <select @onchange="OnSortChanged" value="@sortMode">
                                    <option value="@InvoiceSortMode.RowAscending">Row order</option>
                                    <option value="@InvoiceSortMode.InvoiceNumber">Invoice number</option>
                                    <option value="@InvoiceSortMode.InvoiceDateAscending">Invoice date (oldest first)</option>
                                    <option value="@InvoiceSortMode.InvoiceDateDescending">Invoice date (newest first)</option>
                                </select>
                            </div>
                            @if (cardFilter != InvoiceCardFilter.ErrorOnly)
                            {
                                <Virtualize Items="successCards" Context="card" ItemSize="72">
                                    @{
                                        var isExpanded = expandedCards.Contains(card.InvoiceNumber);
                                    }
                                    <div class="icard">
                                        <div class="ich ich-ok @(isExpanded ? "open" : "")"
                                             @onclick="() => ToggleExpand(card.InvoiceNumber)">
                                            <div class="ich-left">
                                                <div class="iicon iicon-ok">
                                                    <i class="ti ti-file-check" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num inv-ok">@card.InvoiceNumber</div>
                                                    @if (card.Prepared?.Invoice != null)
                                                    {
                                                        <div class="inv-sub inv-sub-ok">
                                                            <span>@card.Prepared.Invoice.InvoiceDate.ToString("MMM d, yyyy")</span>
                                                            <span class="sep">·</span>
                                                            <span>@card.Prepared.Invoice.CustomerName</span>
                                                            <span class="sep">·</span>
                                                            <span>@(card.Prepared.Items?.Count ?? 0) item(s)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="ich-right">
                                                @if (card.Prepared?.IsSaved == true)
                                                {
                                                    <span class="badge badge-saved">
                                                        <i class="ti ti-circle-check" aria-hidden="true"></i>
                                                        Saved
                                                    </span>
                                                }
                                                else if (card.Prepared != null)
                                                {
                                                    <span class="badge badge-ready">
                                                        <i class="ti ti-check" aria-hidden="true"></i>
                                                        Ready
                                                    </span>
                                                    <div class="chk" @onclick:stopPropagation="true">
                                                        <input type="checkbox" @bind="card.Prepared.Selected" id="chk-@card.InvoiceNumber" />
                                                        <label for="chk-@card.InvoiceNumber">Select</label>
                                                    </div>
                                                }
                                                <i class="ti ti-chevron-down chev @(isExpanded ? "open" : "")" aria-hidden="true"></i>
                                            </div>
                                        </div>

                                        @if (isExpanded && card.Prepared != null)
                                        {
                                            <div class="icb">
                                                @if (card.Prepared.Invoice != null)
                                                {
                                                    <div class="cust-meta">
                                                        <div>
                                                            <span class="cust-meta-label">Customer</span>
                                                            <strong>@card.Prepared.Invoice.CustomerCode – @card.Prepared.Invoice.CustomerName</strong>
                                                        </div>
                                                        @if(!string.IsNullOrWhiteSpace(card.Prepared.Invoice.CustomerType))
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Customer Type</span>
                                                                <strong>@card.Prepared.Invoice.CustomerType</strong>
                                                            </div>
                                                        }
                                                        @if(!string.IsNullOrWhiteSpace(card.Prepared.Invoice.CustomerAddress))
                                                        {
                                                            <div>
                                                                <span class="cust-meta-label">Address</span>
                                                                <strong>@card.Prepared.Invoice.CustomerAddress</strong>
                                                            </div>
                                                        }
                                                        <div>
                                                            <span class="cust-meta-label">Order type</span>
                                                            <strong>@card.Prepared.Invoice.OrderType</strong>
                                                        </div>
                                                    </div>
                                                }
                                                @if (card.Prepared.ItemChoices != null && card.Prepared.ItemChoices.Count > 0)
                                                {
                                                    @foreach (var choice in card.Prepared.ItemChoices)
                                                    {
                                                        <div class="item-choice-card">
                                                            <div class="cust-meta-label">
                                                                SKU '@choice.SkuCode' has multiple matching records — choose which one to use:
                                                            </div>
                                                            <select value="@choice.SelectedSubdItemId"
                                                                    @onchange="(e) => OnItemChoiceChanged(card.Prepared, choice, e.Value)">
                                                                @foreach (var candidate in choice.Candidates)
                                                                {
                                                                    <option value="@candidate.SubdItemId">
                                                                        @candidate.SubdItemCode - @candidate.ItemName (@candidate.UomName @@ ₱@candidate.UnitPrice.ToString("N2"))
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    }
                                                }
                                                @if (card.Prepared.Warnings != null && card.Prepared.Warnings.Count > 0)
                                                {
                                                    <div class="warn-block">
                                                        @foreach (var w in card.Prepared.Warnings)
                                                        {
                                                            <div class="warn-msg">
                                                                <i class="ti ti-alert-triangle" aria-hidden="true"></i> @w
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                @if (card.Prepared.Items != null && card.Prepared.Items.Count > 0)
                                                {
                                                    <div class="itbl-wrap">
                                                        <table class="itbl">
                                                            <thead>
                                                                <tr> 
                                                                    <th>Row</th>
                                                                    <th>SKU</th>
                                                                    <th>Item Name</th>
                                                                    <th class="r">UOM</th>
                                                                    <th class="r">Qty</th>
                                                                    <th class="r">Amount</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var it in card.Prepared.Items)
                                                                {
                                                                    <tr>
                                                                        <td class="mono">@it.LineItemId</td>
                                                                        <td class="mono">@it.ItemCode</td>
                                                                        <td>@it.ItemName</td>
                                                                        <td class="r">@it.UomName</td>
                                                                        <td class="r">@it.Quantity</td>
                                                                        <td class="r">₱@it.Amount.ToString("N2")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                            <tfoot>
                                                                <tr class="itbl-total-row">
                                                                    <td colspan="4" class="r"><strong>Total</strong></td>
                                                                    <td class="r"><strong>₱@card.Prepared.Items.Sum(i => i.Amount).ToString("N2")</strong></td>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </Virtualize>
                            }

                            @if (cardFilter != InvoiceCardFilter.SuccessOnly)
                            {
                                @if (!string.IsNullOrWhiteSpace(selectedErrorFilter) && UsesItemGrouping(selectedErrorFilter))
                                {
                                    var itemGroups = GetItemGroupedCards(selectedErrorFilter);
                                    <Virtualize Items="itemGroups" Context="grp" ItemSize="72">
                                        <div class="icard">
                                            <div class="ich ich-er">
                                                <div class="ich-left">
                                                    <div class="iicon iicon-er">
                                                        <i class="ti ti-file-alert" aria-hidden="true"></i>
                                                    </div>
                                                    <div>
                                                        <div class="inv-num inv-er">@grp.Title</div>
                                                        @if (!string.IsNullOrWhiteSpace(grp.Subtitle))
                                                        {
                                                            <div class="inv-sub inv-sub-er">@grp.Subtitle</div>
                                                        }
                                                    </div>
                                                </div>
                                                <span class="badge badge-err">
                                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                    @(grp.Occurrences.Count == 1 ? "1 row" : $"{grp.Occurrences.Count} rows")
                                                </span>
                                            </div>
                                            <div class="icb-err-rows">
                                                <div class="err-msg-card">
                                                    <div class="err-msg-hdr">
                                                        <i class="ti ti-alert-circle err-msg-icon" aria-hidden="true"></i>
                                                        <div>
                                                            <div class="err-msg-text">@grp.Message</div>
                                                            <div class="err-rows-pill">
                                                                <i class="ti ti-row-insert-bottom" aria-hidden="true"></i>
                                                                @FormatRowList(grp.Occurrences)
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </Virtualize>
                                }
                                else
                                {
                                    <Virtualize Items="errorCards" Context="card" ItemSize="72">
                                        @{
                                            var grouped = GetGroupedIssues(card, selectedErrorFilter);
                                        }
                                        <div class="icard">
                                            <div class="ich ich-er">
                                                <div class="ich-left">
                                                    <div class="iicon iicon-er">
                                                        <i class="ti ti-file-alert" aria-hidden="true"></i>
                                                    </div>
                                                    <div>
                                                        <div class="inv-num inv-er">@card.InvoiceNumber</div>
                                                    </div>
                                                </div>
                                                <span class="badge badge-err">
                                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                    @GetErrorBadgeText(card)
                                                </span>
                                            </div>

                                            @if (grouped.Any())
                                            {
                                                <div class="icb-err-rows">
                                                    @foreach (var grp in grouped)
                                                    {
                                                        <div class="err-msg-card">
                                                            <div class="err-msg-hdr">
                                                                <i class="ti ti-alert-circle err-msg-icon" aria-hidden="true"></i>
                                                                <div>
                                                                    <div class="err-msg-text">@grp.Message</div>
                                                                    @if (grp.Rows.Count > 0)
                                                                    {
                                                                    <div class="err-rows-pill">
                                                                        <i class="ti ti-row-insert-bottom" aria-hidden="true"></i>
                                                                        @FormatRowList(grp.Rows)
                                                                    </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </Virtualize>
                                }
                            }
                        </div>
                    }
                }
            </div>

            @* ── Modal footer ── *@
            <div class="modal-footer-ent">
                @if (ImportResult != null && ImportResult.PreparedInvoices != null && ImportResult.PreparedInvoices.Count > 0)
                {
                    <button type="button" class="btn-commit" disabled="@(!CanCommit)" @onclick="OpenCommitConfirmModal">
                        <i class="ti ti-send" aria-hidden="true"></i>
                        Commit selected (@GetSelectedInvoiceCount())
                    </button>
                }
                <button type="button" class="btn-close-modal" @onclick="OnClose">Close</button>
            </div>

        </div>
    </div>
}

<ConfirmModal Show="showCommitConfirmModal"
              Title="Commit selected invoices"
              Message="@($"Commit {GetSelectedInvoiceCount()} selected invoice(s)?")"
              OnYes="ConfirmCommit"
              OnNo="CancelCommit"
              CloseOnOverlayClick="true" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public ImportSalesInvoiceResult? ImportResult { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDownloadErrorReport { get; set; }

    private InvoiceCardFilter cardFilter = InvoiceCardFilter.SuccessOnly;
    private bool showCommitConfirmModal;
    private string? selectedErrorFilter;
    private HashSet<string> expandedCards = new();

    // ── Caches ────────────────────────────────────────────────────────────
    private List<InvoiceCardViewModel>? _cachedCards;
    private ImportSalesInvoiceResult? _cachedForResult;

    private List<(string Message, int Count)>? _cachedErrorMessages;

    private readonly Dictionary<string, List<GroupedIssue>> _groupedIssuesCache = new();
    private string? _groupedIssuesCacheFilter;

    private bool CanCommit => ImportResult != null && ImportResult.PreparedInvoices != null &&
        ImportResult.PreparedInvoices.Any(p => p.Selected && (p.Issues == null || p.Issues.Count == 0) && !p.IsSaved);

    private void ToggleExpand(string invoiceNumber)
    {
        if (!expandedCards.Remove(invoiceNumber))
            expandedCards.Add(invoiceNumber);
    }

    private string GetTabClass(InvoiceCardFilter filter) => filter switch
    {
        InvoiceCardFilter.ErrorOnly => cardFilter == filter ? "tab act-er" : "tab",
        InvoiceCardFilter.WarningOnly => cardFilter == filter ? "tab act-warn" : "tab",
        _ => cardFilter == filter ? "tab act-ok" : "tab"
    };

    private void SetTab(InvoiceCardFilter filter)
    {
        cardFilter = filter;
        selectedErrorFilter = null;
    }

    private static string BuildCardKey(string invoiceNumber, PreparedInvoice? prepared)
    {
        if (prepared?.Invoice != null)
        {
            return string.Join("|",
                (invoiceNumber ?? string.Empty).Trim().ToUpperInvariant(),
                (prepared.Invoice.CustomerCode ?? string.Empty).Trim().ToUpperInvariant(),
                (prepared.Invoice.OrderType ?? string.Empty).Trim().ToUpperInvariant(),
                prepared.Invoice.InvoiceDate.ToString("yyyy-MM-dd"));
        }

        return (invoiceNumber ?? string.Empty).Trim().ToUpperInvariant();
    }

    private List<InvoiceCardViewModel> GetInvoiceCards()
    {
        if (_cachedForResult == ImportResult && _cachedCards != null)
            return _cachedCards;

        if (ImportResult == null)
        {
            _cachedCards = new List<InvoiceCardViewModel>();
            _cachedForResult = ImportResult;
            _cachedErrorMessages = null;
            _groupedIssuesCache.Clear();
            _cachedItemGroups = null;
            _cachedItemGroupsFilter = null;
            return _cachedCards;
        }

        var cards = new List<InvoiceCardViewModel>();

        foreach (var prepared in ImportResult.PreparedInvoices ?? new List<PreparedInvoice>())
        {
            var matchingIssues = (prepared.Issues ?? new List<ImportSalesInvoiceIssue>())
                .GroupBy(issue => new { issue.RowNumber, issue.InvoiceNumber, issue.ColumnName, issue.Message })
                .Select(g => g.First())
                .OrderBy(issue => issue.RowNumber)
                .ThenBy(issue => issue.ColumnName)
                .ThenBy(issue => issue.Message)
                .ToList();

            cards.Add(new InvoiceCardViewModel(prepared.InvoiceNumber, prepared, matchingIssues));
        }

        // Merge cards using the SAME composite key the backend grouped by —
        // InvoiceNumber alone can collide across different customers/dates/order types.
        var mergedCards = cards
            .GroupBy(c => BuildCardKey(c.InvoiceNumber, c.Prepared), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var first = g.First();
                var allIssues = g.SelectMany(c => c.Issues)
                    .GroupBy(i => new { i.RowNumber, i.ColumnName, i.Message })
                    .Select(ig => ig.First())
                    .OrderBy(i => i.RowNumber)
                    .ThenBy(i => i.Message)
                    .ToList();
                return new InvoiceCardViewModel(first.InvoiceNumber, first.Prepared, allIssues);
            })
            .ToList();

        var coveredIssueKeys = new HashSet<(int RowNumber, string InvoiceNumber, string? ColumnName, string? Message)>(
            mergedCards.SelectMany(c => c.Issues)
                .Select(i => (i.RowNumber, i.InvoiceNumber ?? string.Empty, i.ColumnName, (string?)i.Message)));

        var orphanIssues = (ImportResult.Issues ?? new List<ImportSalesInvoiceIssue>())
            .Where(issue => issue.RowNumber > 0)
            .Where(issue => !coveredIssueKeys.Contains(
                (issue.RowNumber, issue.InvoiceNumber ?? string.Empty, issue.ColumnName, (string?)issue.Message)))
            .GroupBy(issue => issue.RowNumber)
            .ToList();

        foreach (var group in orphanIssues)
        {
            var issues = group
                .GroupBy(issue => new { issue.RowNumber, issue.InvoiceNumber, issue.ColumnName, issue.Message })
                .Select(g => g.First())
                .OrderBy(issue => issue.RowNumber)
                .ThenBy(issue => issue.ColumnName)
                .ThenBy(issue => issue.Message)
                .ToList();

            var firstIssue = group.First();
            var displayInvoiceNumber = string.IsNullOrWhiteSpace(firstIssue.InvoiceNumber)
                ? "[Blank invoice code]"
                : firstIssue.InvoiceNumber;

            mergedCards.Add(new InvoiceCardViewModel(displayInvoiceNumber, null, issues));
        }

        var finalCards = new List<InvoiceCardViewModel>();
        finalCards.AddRange(mergedCards.Where(c => !c.HasErrors));

        var mergedErrorCards = mergedCards
            .Where(c => c.HasErrors)
            .GroupBy(c => (c.InvoiceNumber ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var allIssues = g.SelectMany(c => c.Issues)
                    .GroupBy(i => new { i.RowNumber, i.ColumnName, i.Message })
                    .Select(ig => ig.First())
                    .OrderBy(i => i.RowNumber)
                    .ThenBy(i => i.Message)
                    .ToList();

                var preparedWithInvoice = g.Select(c => c.Prepared).FirstOrDefault(p => p?.Invoice != null);
                var prepared = preparedWithInvoice ?? g.First().Prepared;

                return new InvoiceCardViewModel(g.Key, prepared, allIssues);
            })
            .ToList();

        finalCards.AddRange(mergedErrorCards);

        _cachedCards = finalCards
            .OrderBy(card => card.Issues.Count > 0 ? card.Issues.Min(issue => issue.RowNumber) : int.MaxValue)
            .ThenBy(card => card.InvoiceNumber)
            .ToList();
        _cachedForResult = ImportResult;

        _cachedErrorMessages = null;
        _groupedIssuesCache.Clear();

        return _cachedCards;
    }
    
    private List<ImportSalesInvoiceIssue> GetGlobalIssues()
    {
        if (ImportResult == null)
            return new List<ImportSalesInvoiceIssue>();

        return ImportResult.Issues
            .Concat((ImportResult.PreparedInvoices ?? new List<PreparedInvoice>())
                .SelectMany(prepared => prepared.Issues ?? new List<ImportSalesInvoiceIssue>()))
            .Where(issue => issue.RowNumber == 0)
            .OrderBy(issue => issue.RowNumber)
            .ThenBy(issue => issue.Message)
            .ToList();
    }
    private string searchTerm = string.Empty;
    private InvoiceSortMode sortMode = InvoiceSortMode.RowAscending;
    private enum InvoiceSortMode { RowAscending, InvoiceNumber, InvoiceDateAscending, InvoiceDateDescending }
    private List<InvoiceCardViewModel> GetFilteredCards(List<InvoiceCardViewModel> cards)
    {
        var filtered = cardFilter switch
        {
            InvoiceCardFilter.ErrorOnly => !string.IsNullOrWhiteSpace(selectedErrorFilter)
                ? cards.Where(card => CardContainsError(card, selectedErrorFilter)).ToList()
                : cards.Where(card => card.HasErrors).ToList(),
            InvoiceCardFilter.WarningOnly => cards.Where(HasWarningOnly).ToList(),
            _ => cards.Where(card => !card.HasErrors && !HasWarningOnly(card)).ToList()
        };

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            var termIsRowNumber = int.TryParse(term, out var rowNum);
            filtered = filtered.Where(card => CardMatchesSearch(card, term, termIsRowNumber, rowNum)).ToList();
        }

        return ApplySort(filtered);
    }

    private static bool CardMatchesSearch(InvoiceCardViewModel card, string term, bool termIsRowNumber, int rowNum)
    {
        if (card.InvoiceNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            return true;

        var inv = card.Prepared?.Invoice;
        if (inv != null)
        {
            if ((inv.CustomerCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (inv.CustomerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (inv.SalesManName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                return true;
        }

        if (card.Prepared?.Items != null)
        {
            foreach (var item in card.Prepared.Items)
            {
                if ((item.ItemCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (item.ItemName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                    return true;
                if (termIsRowNumber && item.LineItemId == rowNum)
                    return true;
            }
        }

        var allIssues = (card.Issues ?? new List<ImportSalesInvoiceIssue>())
            .Concat(card.Prepared?.Issues ?? Enumerable.Empty<ImportSalesInvoiceIssue>());

        foreach (var issue in allIssues)
        {
            if (issue.Message?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                return true;
            if (termIsRowNumber && issue.RowNumber == rowNum)
                return true;
        }

        return false;
    }

    private List<InvoiceCardViewModel> ApplySort(List<InvoiceCardViewModel> cards)
    {
        return sortMode switch
        {
            InvoiceSortMode.InvoiceNumber => cards.OrderBy(c => c.InvoiceNumber, StringComparer.OrdinalIgnoreCase).ToList(),
            InvoiceSortMode.InvoiceDateAscending => cards
                .OrderBy(c => c.Prepared?.Invoice?.InvoiceDate ?? DateOnly.MaxValue)
                .ToList(),
            InvoiceSortMode.InvoiceDateDescending => cards
                .OrderByDescending(c => c.Prepared?.Invoice?.InvoiceDate ?? DateOnly.MinValue)
                .ToList(),
            _ => cards.OrderBy(c => c.FirstRowNumber).ToList()
        };
    }

    private int GetSelectedInvoiceCount()
    {
        if (ImportResult?.PreparedInvoices == null) return 0;
        return ImportResult.PreparedInvoices.Count(p => p.Selected && !p.IsSaved && (p.Issues == null || p.Issues.Count == 0));
    }

    private List<(string Message, int Count)> GetDistinctErrorMessages()
    {
        if (_cachedErrorMessages != null)
            return _cachedErrorMessages;

        var cards = GetInvoiceCards();
        var all = new List<string>();

        foreach (var card in cards)
        {
            if (card.Issues != null)
                all.AddRange(card.Issues.Select(i => NormalizeSalesIssueType(i)));
            if (card.Prepared?.Issues != null)
                all.AddRange(card.Prepared.Issues.Select(i => NormalizeSalesIssueType(i)));
        }

        _cachedErrorMessages = all.Where(m => !string.IsNullOrWhiteSpace(m))
            .GroupBy(m => m)
            .Select(g => (Message: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();

        return _cachedErrorMessages;
    }

