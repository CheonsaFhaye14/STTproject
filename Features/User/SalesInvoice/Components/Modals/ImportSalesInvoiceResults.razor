<ConfirmModal Show="showCommitConfirmModal"
              Title="Commit selected invoices"
              Message="@($"Commit {GetSelectedInvoiceCount()} selected invoice(s)?")"
              OnYes="ConfirmCommit"
              OnNo="CancelCommit"
              CloseOnOverlayClick="true" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public ImportSalesInvoiceResult? ImportResult { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<List<ErrorReportEntry>> OnDownloadErrorReport { get; set; }

    private InvoiceCardFilter cardFilter = InvoiceCardFilter.SuccessOnly;
    private bool showCommitConfirmModal;
    private string? selectedErrorFilter;
    private string? selectedConflictFilter;
    private string? selectedWarningKindFilter;
    private HashSet<string> confirmedChoiceKeys = new();
    private int? bulkApplyCandidateId;
    private HashSet<string> expandedCards = new();

    // ── Caches ────────────────────────────────────────────────────────────
    private List<InvoiceCardViewModel>? _cachedCards;
    private ImportSalesInvoiceResult? _cachedForResult;

    private List<(string Message, int Count)>? _cachedErrorMessages;

    private readonly Dictionary<string, List<GroupedIssue>> _groupedIssuesCache = new();
    private string? _groupedIssuesCacheFilter;

    private bool CanCommit => GetInvoiceCards().Any(c =>
        !c.HasErrors && !HasWarningOnly(c) &&
        c.Prepared != null && c.Prepared.Selected && !c.Prepared.IsSaved);

    private InvoiceCardViewModel? detailCard;
    private void OpenDetail(InvoiceCardViewModel card) => detailCard = card;
    private void CloseDetail() => detailCard = null;
    private void ToggleExpand(string invoiceNumber)
    {
        if (!expandedCards.Remove(invoiceNumber))
            expandedCards.Add(invoiceNumber);
    }

    private string GetTabClass(InvoiceCardFilter filter) => filter switch
    {
        InvoiceCardFilter.ErrorOnly => cardFilter == filter ? "tab act-er" : "tab",
        InvoiceCardFilter.WarningOnly => cardFilter == filter ? "tab act-warn" : "tab",
        _ => cardFilter == filter ? "tab act-ok" : "tab"
    };

    private void SetTab(InvoiceCardFilter filter)
    {
        cardFilter = filter;
        selectedErrorFilter = null;
        selectedWarningKindFilter = null;  
        selectedConflictFilter = null;
        bulkApplyCandidateId = null;
    }

    private static string BuildCardKey(string invoiceNumber, PreparedInvoice? prepared)
    {
        if (!string.IsNullOrWhiteSpace(prepared?.GroupKey))
            return prepared!.GroupKey;
        return (invoiceNumber ?? string.Empty).Trim().ToUpperInvariant();
    }

    private string BuildRawRowKey(int rowNumber, string invoiceNumber)
    {
        var inv = (invoiceNumber ?? string.Empty).Trim().ToUpperInvariant();
        if (ImportResult?.RawValuesByRow == null ||
            !ImportResult.RawValuesByRow.TryGetValue(rowNumber, out var raw))
            return inv;

        string Get(string k) => raw.TryGetValue(k, out var v) ? (v ?? string.Empty).Trim().ToUpperInvariant() : string.Empty;

        var customer = Get("CustomerCode");
        if (customer.Length == 0) customer = Get("CustomerName");

        return string.Join("|", inv, customer, Get("OrderType"), Get("SalesManName"));
    }
    private List<InvoiceCardViewModel> GetInvoiceCards()
    {
        if (_cachedForResult == ImportResult && _cachedCards != null)
            return _cachedCards;

        if (ImportResult == null)
        {
            _cachedCards = new List<InvoiceCardViewModel>();
            _cachedForResult = ImportResult;
            _cachedErrorMessages = null;
            _groupedIssuesCache.Clear();
            _cachedItemGroups = null;
            _cachedItemGroupsFilter = null;
            return _cachedCards;
        }

        var cards = new List<InvoiceCardViewModel>();

        foreach (var prepared in ImportResult.PreparedInvoices ?? new List<PreparedInvoice>())
        {
            var matchingIssues = (prepared.Issues ?? new List<ImportSalesInvoiceIssue>())
                .GroupBy(issue => new { issue.RowNumber, issue.InvoiceNumber, issue.ColumnName, issue.Message })
                .Select(g => g.First())
                .OrderBy(issue => issue.RowNumber)
                .ThenBy(issue => issue.ColumnName)
                .ThenBy(issue => issue.Message)
                .ToList();

            cards.Add(new InvoiceCardViewModel(prepared.InvoiceNumber, prepared, matchingIssues));
        }

        var allCards = new List<InvoiceCardViewModel>(cards);

        // Invoice number → the card keys that already exist for it (from prepared invoices)
        var keysByInvoice = cards
            .Where(c => c.Prepared != null)
            .GroupBy(c => (c.InvoiceNumber ?? string.Empty).Trim().ToUpperInvariant())
            .ToDictionary(g => g.Key, g => g.Select(c => c.CardKey).Distinct(StringComparer.OrdinalIgnoreCase).ToList());

        var coveredIssueKeys = new HashSet<(int RowNumber, string InvoiceNumber, string? ColumnName, string? Message)>(
            cards.SelectMany(c => c.Issues)
                .Select(i => (i.RowNumber, i.InvoiceNumber ?? string.Empty, i.ColumnName, (string?)i.Message)));

        var orphanGroups = (ImportResult.Issues ?? new List<ImportSalesInvoiceIssue>())
            .Where(issue => issue.RowNumber > 0)
            .Where(issue => !coveredIssueKeys.Contains(
                (issue.RowNumber, issue.InvoiceNumber ?? string.Empty, issue.ColumnName, (string?)issue.Message)))
            .GroupBy(issue => issue.RowNumber);

        foreach (var group in orphanGroups)
        {
            var issues = group
                .GroupBy(i => new { i.RowNumber, i.InvoiceNumber, i.ColumnName, i.Message })
                .Select(g => g.First())
                .OrderBy(i => i.RowNumber).ThenBy(i => i.ColumnName).ThenBy(i => i.Message)
                .ToList();

            var firstIssue = group.First();
            var displayInvoiceNumber = string.IsNullOrWhiteSpace(firstIssue.InvoiceNumber)
                ? "[Blank invoice code]"
                : firstIssue.InvoiceNumber;

            var invKey = displayInvoiceNumber.Trim().ToUpperInvariant();
            var key = keysByInvoice.TryGetValue(invKey, out var keys) && keys.Count == 1
                ? keys[0]
                : BuildRawRowKey(firstIssue.RowNumber, firstIssue.InvoiceNumber ?? string.Empty);

            allCards.Add(new InvoiceCardViewModel(displayInvoiceNumber, null, issues, key));
        }

        var finalCards = allCards
            .GroupBy(c => c.CardKey, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var primary = g.OrderBy(c => c.Prepared == null).First();
                var prepared = g.Select(c => c.Prepared).FirstOrDefault(p => p != null);
                var issues = g.SelectMany(c => c.Issues)
                    .GroupBy(i => new { i.RowNumber, i.ColumnName, i.Message })
                    .Select(ig => ig.First())
                    .OrderBy(i => i.RowNumber).ThenBy(i => i.Message)
                    .ToList();
                return new InvoiceCardViewModel(primary.InvoiceNumber, prepared, issues, g.Key);
            })
            .ToList();

        _cachedCards = finalCards
            .OrderBy(card => card.Issues.Count > 0 ? card.Issues.Min(issue => issue.RowNumber) : int.MaxValue)
            .ThenBy(card => card.InvoiceNumber)
            .ToList();
        _cachedForResult = ImportResult;

        _cachedErrorMessages = null;
        _groupedIssuesCache.Clear();

        return _cachedCards;
    }
    private void OnWarningKindFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        selectedWarningKindFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        selectedConflictFilter = null;
        bulkApplyCandidateId = null;
    }
    private sealed record BulkOption(int SubdItemId, string Code, string Name, string UomSummary, int Lines);

    private List<BulkOption> GetBulkOptionsForSku(string skuCode) =>
        GetInvoiceCards()
            .SelectMany(c => c.Prepared?.ItemChoices ?? new List<PendingItemChoice>())
            .Where(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase))
            .Where(ch => ch.Candidates.Select(x => x.SubdItemId).Distinct().Count() > 1) // real SKU conflicts only
            .SelectMany(ch => ch.Candidates)
            .GroupBy(cand => cand.SubdItemId)
            .Select(g =>
            {
                var f = g.First();
                var uoms = string.Join(" · ", g
                    .GroupBy(x => x.UomName)
                    .Select(ug =>
                    {
                        var min = ug.Min(x => x.UnitPrice);
                        var max = ug.Max(x => x.UnitPrice);
                        return min == max ? $"{ug.Key} ₱{min:N2}" : $"{ug.Key} ₱{min:N2}–₱{max:N2}";
                    }));
                return new BulkOption(f.SubdItemId, f.SubdItemCode, f.ItemName, uoms, g.Count());
            })
            .OrderBy(o => o.Code).ThenBy(o => o.Name).ThenBy(o => o.SubdItemId)
            .ToList();
    private void ClearWarningKindFilter()
    {
        selectedWarningKindFilter = null;
        selectedConflictFilter = null;
        bulkApplyCandidateId = null;
    }

    private List<ImportSalesInvoiceIssue> GetGlobalIssues()
    {
        if (ImportResult == null)
            return new List<ImportSalesInvoiceIssue>();

        return ImportResult.Issues
            .Concat((ImportResult.PreparedInvoices ?? new List<PreparedInvoice>())
                .SelectMany(prepared => prepared.Issues ?? new List<ImportSalesInvoiceIssue>()))
            .Where(issue => issue.RowNumber == 0 && string.IsNullOrWhiteSpace(issue.InvoiceNumber))
            .OrderBy(issue => issue.RowNumber)
            .ThenBy(issue => issue.Message)
            .ToList();
    }
    private string searchTerm = string.Empty;
    private InvoiceSortMode sortMode = InvoiceSortMode.RowAscending;
    private enum InvoiceSortMode { RowAscending, InvoiceNumber, InvoiceDateAscending, InvoiceDateDescending }
    private List<InvoiceCardViewModel> GetFilteredCards(List<InvoiceCardViewModel> cards)
    {
        var filtered = cardFilter switch
        {
            InvoiceCardFilter.ErrorOnly => !string.IsNullOrWhiteSpace(selectedErrorFilter)
                ? cards.Where(card => CardContainsError(card, selectedErrorFilter)).ToList()
                : cards.Where(card => card.HasErrors).ToList(),
            InvoiceCardFilter.WarningOnly => cards.Where(HasWarningOnly)
                .Where(card => CardHasWarningKind(card, selectedWarningKindFilter))
                .Where(CardMatchesSelectedWarningValue)
                .ToList(),
            _ => cards.Where(card => !card.HasErrors && !HasWarningOnly(card)).ToList()
        };

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            var termIsRowNumber = int.TryParse(term, out var rowNum);
            filtered = filtered.Where(card => CardMatchesSearch(card, term, termIsRowNumber, rowNum)).ToList();
        }

        return ApplySort(filtered);
    }

    private bool CardMatchesSearch(InvoiceCardViewModel card, string term, bool termIsRowNumber, int rowNum)
    {
        if (card.InvoiceNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            return true;

        var inv = card.Prepared?.Invoice;
        if (inv != null)
        {
            if ((inv.CustomerCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (inv.CustomerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (inv.SalesManName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (inv.OrderType?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                return true;
        }

        if (card.Prepared?.Items != null)
        {
            foreach (var item in card.Prepared.Items)
            {
                if ((item.ItemCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (item.ItemName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                    return true;
                if (termIsRowNumber && item.LineItemId == rowNum)
                    return true;
            }
        }

        var allIssues = (card.Issues ?? new List<ImportSalesInvoiceIssue>())
            .Concat(card.Prepared?.Issues ?? Enumerable.Empty<ImportSalesInvoiceIssue>());

        foreach (var issue in allIssues)
        {
            if (issue.Message?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) return true;
            if (termIsRowNumber && issue.RowNumber == rowNum) return true;
            if (issue.RowNumber > 0 && RawRowContains(issue.RowNumber, term)) return true;
        }

        return false;
    }

    private List<InvoiceCardViewModel> ApplySort(List<InvoiceCardViewModel> cards)
    {
        return sortMode switch
        {
            InvoiceSortMode.InvoiceNumber => cards.OrderBy(c => c.InvoiceNumber, StringComparer.OrdinalIgnoreCase).ToList(),
            InvoiceSortMode.InvoiceDateAscending => cards
                .OrderBy(c => c.Prepared?.Invoice?.InvoiceDate ?? DateOnly.MaxValue)
                .ToList(),
            InvoiceSortMode.InvoiceDateDescending => cards
                .OrderByDescending(c => c.Prepared?.Invoice?.InvoiceDate ?? DateOnly.MinValue)
                .ToList(),
            _ => cards.OrderBy(c => c.FirstRowNumber).ToList()
        };
    }


    private int GetSelectedInvoiceCount() => GetInvoiceCards().Count(c =>
        !c.HasErrors && !HasWarningOnly(c) &&
        c.Prepared != null && c.Prepared.Selected && !c.Prepared.IsSaved);

    private List<(string Message, int Count)> GetDistinctErrorMessages()
    {
        if (_cachedErrorMessages != null) return _cachedErrorMessages;

        var all = GetInvoiceCards().SelectMany(EffectiveIssues).Select(NormalizeSalesIssueType).ToList();

        _cachedErrorMessages = all.Where(m => !string.IsNullOrWhiteSpace(m))
            .GroupBy(m => m)
            .Select(g => (Message: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count).ThenBy(x => x.Message)
            .ToList();

        return _cachedErrorMessages;
    }

    private void OnErrorFilterChanged(ChangeEventArgs e)
    {
        selectedErrorFilter = e?.Value?.ToString();
    }

    private void ClearErrorFilter()
    {
        selectedErrorFilter = null;
    }

    private bool CardContainsError(InvoiceCardViewModel card, string? message)
    {
        if (string.IsNullOrWhiteSpace(message)) return false;
        var norm = message?.Trim() ?? string.Empty;
        if (card.Issues != null && card.Issues.Any(i => NormalizeSalesIssueType(i) == norm)) return true;
        if (card.Prepared?.Issues != null && card.Prepared.Issues.Any(i => NormalizeSalesIssueType(i) == norm)) return true;
        return false;
    }
    private sealed record GroupedIssue(string? Message, List<int> Rows);
    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<InvoiceSortMode>(e.Value?.ToString(), out var mode))
            sortMode = mode;
    }
    private List<GroupedIssue> GetGroupedIssues(InvoiceCardViewModel card, string? filter)
    {
        if (_groupedIssuesCacheFilter != filter)
        {
            _groupedIssuesCache.Clear();
            _groupedIssuesCacheFilter = filter;
        }

        if (_groupedIssuesCache.TryGetValue(card.CardKey, out var cached)) return cached;

        var visibleIssues = EffectiveIssues(card).AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filter))
                visibleIssues = visibleIssues.Where(i => NormalizeSalesIssueType(i) == filter);


        var grouped = visibleIssues
            .GroupBy(i => i.Message?.Trim())
            .Select(g => new GroupedIssue(
                g.Key,
                g.Select(i => i.RowNumber)
                    .Where(r => r > 0)
                    .Distinct()
                    .OrderBy(r => r)
                    .ToList()))
            .Where(g => !string.IsNullOrWhiteSpace(g.Message))
            .OrderBy(g => g.Message, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _groupedIssuesCache[card.CardKey] = grouped;
        return grouped;
    }

    private static string NormalizeMessage(string? m) => (m ?? string.Empty).Trim();

    private static string NormalizeMessageType(string? m)
    {
        var msg = NormalizeMessage(m).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.Contains("has no valid item lines to import")) return "No Valid Items";

        if (msg.Contains("duplicat") && (msg.Contains("uploaded") || msg.Contains("excel")))
        {
            if (msg.Contains("subd") || msg.Contains("subditem") || msg.Contains("subdistributor"))
                return "SubdItem Duplicated In Excel";
            return "Duplicated In Excel";
        }
        if (msg.Contains("duplicate") && msg.Contains("uom")) return "Duplicate UOM";
        if (msg.Contains("duplicate") && msg.Contains("conversion")) return "Duplicate Conversion";
        if (msg.Contains("already mapped") || (msg.Contains("already") && msg.Contains("mapped"))) return "Already Mapped";
        if (msg.Contains("already exists") || msg.Contains("already exist") || msg.Contains("is already")) return "Already Exists";
        if (msg.Contains("duplicate") && msg.Contains("invoice")) return "Duplicate Invoice Code";
        if (msg.Contains("uom not found") || (msg.Contains("not found") && msg.Contains("uom"))) return "UOM Not Found";
        if (msg.Contains("invalid uom") || (msg.Contains("invalid") && msg.Contains("uom"))) return "Invalid UOM";
        if (msg.Contains("conversion mismatch") || (msg.Contains("mismatch") && msg.Contains("conversion"))) return "Conversion Mismatch";

        return NormalizeMessage(m);
    }

    private static string NormalizeSalesIssueType(ImportSalesInvoiceIssue issue)
    {
        if (issue == null) return string.Empty;

        var col = (issue.ColumnName ?? string.Empty).Trim().ToLowerInvariant();
        var msg = NormalizeMessage(issue.Message).ToLowerInvariant();

        if (!string.IsNullOrWhiteSpace(col))
        {
            if (col.Contains("uom"))
            {
                if (msg.Contains("not found") || msg.Contains("missing")) return "UOM Not Found";
                if (msg.Contains("invalid")) return "Invalid UOM";
                return "UOM Error";
            }
            if (col.Contains("quantity") && (msg.Contains("uom") || msg.Contains("unit")))
            {
                if (msg.Contains("not found") || msg.Contains("missing")) return "UOM Not Found";
                return "UOM Error";
            }
            if (col.Contains("quantity")) return "Quantity Error";
            if (col.Contains("amount") || col.Contains("netamount")) return "Amount Error";
            if (col.Contains("ordertype")) return "Order Type Missing";
            if (col.Contains("customercode") || col.Contains("customer") && msg.Contains("not found")) return "Customer Not Found";
            if (col.Contains("skucode") || col.Contains("itemname") && msg.Contains("not found")) return "SKU Not Found";

        }

        return NormalizeMessageType(issue.Message);
    }

    private void ToggleSelectAllInvoices(List<InvoiceCardViewModel> cards, object? checkedValue)
    {
        if (checkedValue is not bool isChecked) return;
        foreach (var card in cards)
        {
            if (card.Prepared == null || card.Prepared.IsSaved) continue;
            card.Prepared.Selected = isChecked;
        }
    }

    private void OpenCommitConfirmModal() => showCommitConfirmModal = true;
    private void CancelCommit() => showCommitConfirmModal = false;
    private async Task ConfirmCommit()
    {
        showCommitConfirmModal = false;

        foreach (var card in GetInvoiceCards())
        {
            if (card.Prepared != null && (card.HasErrors || HasWarningOnly(card)))
                card.Prepared.Selected = false;
        }

        await Commit();
    }

    private string GetErrorBadgeText(InvoiceCardViewModel card)
    {
        var issues = EffectiveIssues(card);
        int errorCount = string.IsNullOrWhiteSpace(selectedErrorFilter)
            ? issues.Count
            : issues.Count(i => NormalizeSalesIssueType(i) == selectedErrorFilter);
        return errorCount == 1 ? "1 error" : $"{errorCount} errors";
    }
    private List<FilterGroupCardViewModel> ApplyGroupSearch(List<FilterGroupCardViewModel> groups)
    {
        if (string.IsNullOrWhiteSpace(searchTerm)) return groups;

        var term = searchTerm.Trim();
        var isRow = int.TryParse(term, out var rowNum);

        return groups.Where(g =>
            g.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            (g.Subtitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
            g.Message.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            (isRow && g.Occurrences.Contains(rowNum)) ||
            g.Occurrences.Any(r => RawRowContains(r, term)))
        .ToList();
    }

    private bool RawRowContains(int rowNumber, string term)
    {
        if (ImportResult?.RawValuesByRow == null ||
            !ImportResult.RawValuesByRow.TryGetValue(rowNumber, out var raw)) return false;

        return raw.Values.Any(v => v?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task Commit()
    {
        if (OnCommit.HasDelegate)
            await OnCommit.InvokeAsync(null);
    }

    private sealed record InvoiceCardViewModel(
        string InvoiceNumber,
        PreparedInvoice? Prepared,
        List<ImportSalesInvoiceIssue> Issues,
        string? KeyOverride = null)
    {
        public string CardKey => KeyOverride ?? BuildCardKey(InvoiceNumber, Prepared);

        public bool HasErrors => Issues.Count > 0 || (Prepared?.Issues?.Count ?? 0) > 0;

        public int FirstRowNumber => Issues.Count > 0
            ? Issues.Min(i => i.RowNumber)
            : (Prepared?.Items != null && Prepared.Items.Count > 0
                ? Prepared.Items.Min(i => i.LineItemId)
                : int.MaxValue);
    }

    private enum InvoiceCardFilter { SuccessOnly, ErrorOnly, WarningOnly }
    private bool showDownloadModal;
    private bool downloadScopeAll = true;
    private string? downloadErrorType;

    private void OpenDownloadModal()
    {
        // Pre-select whatever error the user is already filtering by
        downloadErrorType = selectedErrorFilter;
        downloadScopeAll = string.IsNullOrWhiteSpace(selectedErrorFilter);
        showDownloadModal = true;
    }

    private void CloseDownloadModal() => showDownloadModal = false;

    private List<ErrorReportEntry> BuildReportEntries(string? errorType) =>
        GetInvoiceCards()
            .Where(c => c.HasErrors)
            .SelectMany(EffectiveIssues)
            .Where(i => i.RowNumber > 0)
            .Select(i => new ErrorReportEntry(i.RowNumber, NormalizeSalesIssueType(i), i.Message))
            .Where(e => string.IsNullOrWhiteSpace(errorType) || e.ErrorType == errorType)
            .Distinct()
            .ToList();

    private async Task ConfirmDownload()
    {
        var entries = BuildReportEntries(downloadScopeAll ? null : downloadErrorType);
        showDownloadModal = false;
        if (OnDownloadErrorReport.HasDelegate)
            await OnDownloadErrorReport.InvokeAsync(entries);
    }

    private static readonly System.Text.RegularExpressions.Regex UomNotFoundRegex =
        new(@"UOM '(?<uom>.+?)' was not found for SKU '(?<sku>.+?)'(?: \((?<item>.+?)\))?\.",
            System.Text.RegularExpressions.RegexOptions.Compiled);

    private static readonly System.Text.RegularExpressions.Regex SkuNotFoundRegex =
    new(@"SKU '(?<sku>.+?)'", System.Text.RegularExpressions.RegexOptions.Compiled);

    private delegate (string Key, string Title, string? Subtitle) IssueGroupParser(ImportSalesInvoiceIssue issue);

    private static readonly Dictionary<string, IssueGroupParser> ItemGroupParsers =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["UOM Not Found"] = ParseUomIssue,
            ["SKU Not Found"] = ParseSkuIssue,
            ["Customer Not Found"] = ParseCustomerIssue,
        };

    private static bool UsesItemGrouping(string? filter) =>
        !string.IsNullOrWhiteSpace(filter) && ItemGroupParsers.ContainsKey(filter);

    private sealed record FilterGroupCardViewModel(
        string Key,
        string Title,
        string? Subtitle,
        string Message,
        List<int> Occurrences);

    private static (string Key, string Title, string? Subtitle) ParseUomIssue(ImportSalesInvoiceIssue issue)
    {
        var match = UomNotFoundRegex.Match(issue.Message ?? string.Empty);
        if (!match.Success)
        {
            var msg = (issue.Message ?? string.Empty).Trim();
            return (msg, msg, null);
        }

        var sku = match.Groups["sku"].Value;
        var uom = match.Groups["uom"].Value;
        var itemName = match.Groups["item"].Success ? match.Groups["item"].Value : null;

        var title = string.IsNullOrWhiteSpace(itemName) ? sku : $"{sku} - {itemName}";
        var subtitle = $"Missing UOM: '{uom}'";
        var key = $"{sku}||{uom}";
        return (key, title, subtitle);
    }
    private static (string Key, string Title, string? Subtitle) ParseSkuIssue(ImportSalesInvoiceIssue issue)
    {
        var match = SkuNotFoundRegex.Match(issue.Message ?? string.Empty);
        var SuggCount = issue.SuggestionCount ?? 0;
        if (!match.Success)
        {
            var msg = (issue.Message ?? string.Empty).Trim();
            return (msg, msg, null);
        }

        var sku = match.Groups["sku"].Value;
        var subtitle = SuggCount > 0 ? $"{SuggCount} suggestion" + (SuggCount == 1 ? "" : "s") + " available" : null;
        return (sku, sku, subtitle);
    }

    private static readonly System.Text.RegularExpressions.Regex CustomerNotFoundRegex =
        new(@"Customer '(?<customer>.+?)'", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static (string Key, string Title, string? Subtitle) ParseCustomerIssue(ImportSalesInvoiceIssue issue)
    {
        var match = CustomerNotFoundRegex.Match(issue.Message ?? string.Empty);
        var SuggCount = issue.SuggestionCount ?? 0;

        if (!match.Success)
        {
            var msg = (issue.Message ?? string.Empty).Trim();
            return (msg, msg, null);
        }

        var customer = match.Groups["customer"].Value;
        var subtitle = SuggCount > 0 ? $"{SuggCount} suggestion" + (SuggCount == 1 ? "" : "s") + " available" : null;
        return (customer, customer, subtitle);
    }

    private List<FilterGroupCardViewModel>? _cachedItemGroups;
    private string? _cachedItemGroupsFilter;

    private List<FilterGroupCardViewModel> GetItemGroupedCards(string filter)
    {
        if (_cachedItemGroupsFilter == filter && _cachedItemGroups != null)
            return _cachedItemGroups;

        if (!ItemGroupParsers.TryGetValue(filter, out var parser))
        {
            _cachedItemGroups = new List<FilterGroupCardViewModel>();
            _cachedItemGroupsFilter = filter;
            return _cachedItemGroups;
        }

        var allIssues = GetInvoiceCards()
            .Where(c => c.HasErrors)
            .SelectMany(c => (c.Issues ?? new List<ImportSalesInvoiceIssue>())
                .Concat(c.Prepared?.Issues ?? Enumerable.Empty<ImportSalesInvoiceIssue>()))
            .Where(issue => NormalizeSalesIssueType(issue) == filter)
            .ToList();

        _cachedItemGroups = allIssues
            .Select(issue => new { Issue = issue, Parsed = parser(issue) })
            .GroupBy(x => x.Parsed.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var first = g.First();
                var occurrences = g.Select(x => x.Issue.RowNumber).Where(r => r > 0).Distinct().OrderBy(r => r).ToList();
                return new FilterGroupCardViewModel(g.Key, first.Parsed.Title, first.Parsed.Subtitle, first.Issue.Message?.Trim() ?? string.Empty, occurrences);
            })
            .OrderBy(c => c.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _cachedItemGroupsFilter = filter;
        return _cachedItemGroups;
    }

    private static string FormatRowList(IReadOnlyList<int> rows)
    {
        if (rows == null || rows.Count == 0)
            return string.Empty;

        if (rows.Count == 1)
            return $"Row {rows[0]}";

        return $"Rows: {string.Join(", ", rows.Take(rows.Count - 1))} & {rows[^1]}";
    }

    private bool HasWarningOnly(InvoiceCardViewModel c) =>
        !c.HasErrors && ((c.Prepared?.Warnings.Count(w => !IsWarningResolved(c, w)) ?? 0) > 0 ||
            (c.Prepared?.ItemChoices.Count(ch => !confirmedChoiceKeys.Contains(ChoiceKey(c.InvoiceNumber, ch))) ?? 0) > 0);

    private static readonly System.Text.RegularExpressions.Regex DefaultMatchWarningRegex =
        new(@"SKU '(?<sku>.+?)' matched \d+ records", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static readonly System.Text.RegularExpressions.Regex UomChoiceWarningRegex =
        new(@"UOM '(?<uom>.+?)' has multiple possible matches for SKU '(?<sku>.+?)'",
            System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool IsWarningResolved(InvoiceCardViewModel c, string warning)
    {
        string? sku = null;

        var skuMatch = DefaultMatchWarningRegex.Match(warning ?? string.Empty);
        if (skuMatch.Success) sku = skuMatch.Groups["sku"].Value;
        else
        {
            var uomMatch = UomChoiceWarningRegex.Match(warning ?? string.Empty);
            if (uomMatch.Success) sku = uomMatch.Groups["sku"].Value;
            else
            {
                var fallbackMatch = UomFallbackWarningRegex.Match(warning ?? string.Empty);
                if (fallbackMatch.Success) sku = fallbackMatch.Groups["sku"].Value;
            }
        }

        if (sku is null) return false;

        var choice = c.Prepared?.ItemChoices?.FirstOrDefault(ch => ch.SkuCode.Equals(sku, StringComparison.OrdinalIgnoreCase));
        return choice != null && confirmedChoiceKeys.Contains(ChoiceKey(c.InvoiceNumber, choice));
    }

    private static string ChoiceKey(string invoiceNumber, PendingItemChoice choice) =>
        $"{invoiceNumber}|{choice.LineItemId}";

    private List<(string SkuCode, int InvoiceCount)> GetDistinctConflictSkus() =>
        GetInvoiceCards()
            .Where(c => c.Prepared?.ItemChoices != null && c.Prepared.ItemChoices.Count > 0)
            .SelectMany(c => c.Prepared!.ItemChoices.Select(ch => (ch.SkuCode, Key: c.CardKey)))
            .GroupBy(x => x.SkuCode, StringComparer.OrdinalIgnoreCase)
            .Select(g => (SkuCode: g.Key, InvoiceCount: g.Select(x => x.Key).Distinct().Count()))
            .OrderByDescending(x => x.InvoiceCount)
            .ThenBy(x => x.SkuCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static bool CardHasConflict(InvoiceCardViewModel c, string? skuCode) =>
        !string.IsNullOrWhiteSpace(skuCode) &&
        (c.Prepared?.ItemChoices?.Any(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase)) ?? false);

    private List<ItemCandidateOption> GetCandidatesForSku(string skuCode) =>
        GetInvoiceCards()
            .SelectMany(c => c.Prepared?.ItemChoices ?? new List<PendingItemChoice>())
            .FirstOrDefault(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase))
            ?.Candidates ?? new List<ItemCandidateOption>();

    private int CountInvoicesWithSku(string skuCode) =>
        GetInvoiceCards().Count(c => CardHasConflict(c, skuCode));

    private int CountUnconfirmedInvoicesWithSku(string skuCode) =>
        GetInvoiceCards().Count(c => c.Prepared?.ItemChoices != null &&
            c.Prepared.ItemChoices.Any(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase) &&
                !confirmedChoiceKeys.Contains(ChoiceKey(c.InvoiceNumber, ch))));

    private void OnConflictFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        selectedConflictFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        bulkApplyCandidateId = null;
    }

    private void ClearConflictFilter()
    {
        selectedConflictFilter = null;
        bulkApplyCandidateId = null;
    }

    private void OnBulkCandidateChanged(ChangeEventArgs e)
    {
        bulkApplyCandidateId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private void ApplyToAllWithSku(string skuCode)
    {
        if (bulkApplyCandidateId is not int subdItemId) return;

        foreach (var card in GetInvoiceCards())
        {
            if (card.Prepared == null) continue;
            foreach (var choice in card.Prepared.ItemChoices.Where(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase)))
            {
                if (confirmedChoiceKeys.Contains(ChoiceKey(card.InvoiceNumber, choice))) continue;
                if (choice.Candidates.Select(c => c.SubdItemId).Distinct().Count() < 2) continue; // UOM-only choice

                var candidate = choice.Candidates.FirstOrDefault(c => c.SubdItemId == subdItemId);
                if (candidate == null) continue;
                ApplyCandidate(card.Prepared, choice, candidate);
            }
        }
    }

    private void ConfirmAllWithSku(string skuCode)
    {
        foreach (var card in GetInvoiceCards())
        {
            if (card.Prepared == null) continue;
            foreach (var choice in card.Prepared.ItemChoices.Where(ch => ch.SkuCode.Equals(skuCode, StringComparison.OrdinalIgnoreCase)))
            {
                confirmedChoiceKeys.Add(ChoiceKey(card.InvoiceNumber, choice));
            }
        }
    }

    private void OnItemChoiceChanged(InvoiceCardViewModel card, PendingItemChoice choice, object? value)
    {
        var prepared = card.Prepared;
        if (prepared == null || !int.TryParse(value?.ToString(), out var newId)) return;
        var candidate = choice.Candidates.FirstOrDefault(c => c.SubdItemId == newId);
        if (candidate == null) return;

        ApplyCandidate(prepared, choice, candidate);
        confirmedChoiceKeys.Remove(ChoiceKey(card.InvoiceNumber, choice));
    }

    private void ConfirmChoice(InvoiceCardViewModel card, PendingItemChoice choice)
    {
        confirmedChoiceKeys.Add(ChoiceKey(card.InvoiceNumber, choice));
    }

    private static void ApplyCandidate(PreparedInvoice prepared, PendingItemChoice choice, ItemCandidateOption candidate)
    {
        foreach (var raw in prepared.RawItems.Where(r => r.Item.LineItemId == choice.LineItemId))
        {
            raw.Item.SubdItemId = candidate.SubdItemId;
            raw.Item.ItemCode = candidate.SubdItemCode;
            raw.Item.ItemName = candidate.ItemName;
            raw.Item.ItemsUomId = candidate.ItemsUomId;
            raw.Item.UomName = candidate.UomName;
            raw.Item.Amount = (raw.IsFreeItem ? 0m : candidate.UnitPrice) * raw.Item.Quantity;
        }

        choice.SelectedSubdItemId = candidate.SubdItemId;
        prepared.Items = ImportSalesInvoiceService.BuildAggregatedItems(prepared.RawItems, prepared.Invoice?.OrderType);
    }
    private enum WarningKind { SkuConflict, UomFallback, Other }

    private static string WarningKindLabel(WarningKind kind) => kind switch
    {
        WarningKind.SkuConflict => "SKU Conflicts",
        WarningKind.UomFallback => "UOM Fallbacks",
        _ => "Other"
    };

    private static readonly System.Text.RegularExpressions.Regex UomFallbackWarningRegex =
        new(@"UOM '(?<uom>.+?)' isn't defined for this SKU '(?<sku>.+?)'",
            System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    private static WarningKind ClassifyWarning(string? warning)
    {
        if (DefaultMatchWarningRegex.IsMatch(warning ?? string.Empty)) return WarningKind.SkuConflict;
        if (UomChoiceWarningRegex.IsMatch(warning ?? string.Empty)) return WarningKind.SkuConflict;
        if (UomFallbackWarningRegex.IsMatch(warning ?? string.Empty)) return WarningKind.UomFallback;
        return WarningKind.Other;
    }

    private List<(WarningKind Kind, int InvoiceCount)> GetDistinctWarningKinds()
    {
        var counts = new Dictionary<WarningKind, HashSet<string>>();

        void Track(WarningKind kind, string invoiceNumber)
        {
            if (!counts.TryGetValue(kind, out var set))
            {
                set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                counts[kind] = set;
            }
            set.Add(invoiceNumber);
        }

        foreach (var card in GetInvoiceCards().Where(HasWarningOnly))
        {
            if (card.Prepared?.ItemChoices != null &&
                card.Prepared.ItemChoices.Any(ch => !confirmedChoiceKeys.Contains(ChoiceKey(card.InvoiceNumber, ch))))
                Track(WarningKind.SkuConflict, card.CardKey);

            foreach (var w in card.Prepared?.Warnings ?? new List<string>())
            {
                if (IsWarningResolved(card, w)) continue;
                Track(ClassifyWarning(w), card.CardKey);
            }
        }

        return counts
            .Select(kv => (Kind: kv.Key, InvoiceCount: kv.Value.Count))
            .OrderByDescending(x => x.InvoiceCount)
            .ThenBy(x => x.Kind)
            .ToList();
    }

    private bool CardHasWarningKind(InvoiceCardViewModel c, string? kindName)
    {
        if (string.IsNullOrWhiteSpace(kindName)) return true;
        if (!Enum.TryParse<WarningKind>(kindName, out var kind)) return true;

        if (kind == WarningKind.SkuConflict &&
            c.Prepared?.ItemChoices != null &&
            c.Prepared.ItemChoices.Any(ch => !confirmedChoiceKeys.Contains(ChoiceKey(c.InvoiceNumber, ch))))
            return true;

        return c.Prepared?.Warnings != null &&
            c.Prepared.Warnings.Any(w => !IsWarningResolved(c, w) && ClassifyWarning(w) == kind);
    }

    private List<(string Value, int InvoiceCount)> GetDistinctWarningValues(WarningKind kind)
    {
        if (kind == WarningKind.SkuConflict)
        {
            return GetDistinctConflictSkus()
                .Select(x => (Value: x.SkuCode, x.InvoiceCount))
                .ToList();
        }

        var counts = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var card in GetInvoiceCards().Where(HasWarningOnly))
        {
            foreach (var w in card.Prepared?.Warnings ?? new List<string>())
            {
                if (IsWarningResolved(card, w)) continue;
                if (ClassifyWarning(w) != kind) continue;

                var key = w.Trim();
                if (!counts.TryGetValue(key, out var set))
                {
                    set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    counts[key] = set;
                }
                set.Add(card.CardKey);
            }
        }

        return counts
            .Select(kv => (Value: kv.Key, InvoiceCount: kv.Value.Count))
            .OrderByDescending(x => x.InvoiceCount)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private bool CardHasWarningValue(InvoiceCardViewModel c, WarningKind kind, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return true;

        if (kind == WarningKind.SkuConflict)
            return CardHasConflict(c, value);

        return c.Prepared?.Warnings != null &&
            c.Prepared.Warnings.Any(w => !IsWarningResolved(c, w) && ClassifyWarning(w) == kind &&
                w.Trim().Equals(value, StringComparison.OrdinalIgnoreCase));
    }

    private string? GetEffectiveConflictFilter()
    {
        if (selectedWarningKindFilter != nameof(WarningKind.SkuConflict))
            return null;

        if (!string.IsNullOrWhiteSpace(selectedConflictFilter))
            return selectedConflictFilter;

        var values = GetDistinctWarningValues(WarningKind.SkuConflict);
        return values.Count == 1 ? values[0].Value : null;
    }

    private bool CardMatchesSelectedWarningValue(InvoiceCardViewModel card)
    {
        if (string.IsNullOrWhiteSpace(selectedConflictFilter)) return true;
        if (!Enum.TryParse<WarningKind>(selectedWarningKindFilter, out var kind)) return true;
        return CardHasWarningValue(card, kind, selectedConflictFilter);
    }
    private static List<ImportSalesInvoiceIssue> EffectiveIssues(InvoiceCardViewModel card) =>
    card.Issues.Count > 0 ? card.Issues : (card.Prepared?.Issues ?? new List<ImportSalesInvoiceIssue>());
}
