@page "/salesinvoice"
@page "/salesinvoice/{SubDistributorId:int}"
@page "/salesinvoice/edit/{InvoiceId:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using STTproject.Features.User.SalesInvoice.Components.Sections
@using STTproject.Services
@using STTproject.Shared.Components
@inject ISalesInvoiceService salesInvoiceService
@inject IHomeService homeService
@inject IUserContextService userContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject STTproject.Features.User.SalesInvoice.Services.DownloadTemplateService downloadTemplateService
@inject STTproject.Features.User.SalesInvoice.Services.ImportSalesInvoiceService importSalesInvoiceService
@inject STTproject.Services.IMapItemService mapItemService

@implements IAsyncDisposable

@rendermode InteractiveServer
<div class="sales-invoice-header">
    <div class="sales-invoice-title-area">
        <button class="btn-icon-only" @onclick="GoBackToHome" title="Press Esc to go back" aria-label="Go back">
            <i class="fa-solid fa-arrow-left"></i>
        </button>

        <div class="sales-invoice-title-wrap">
            <TitleHeader Subdistributors="subdList" @bind-SelectedSubdId="invoice.SubdistributorId"
                         OnSubdChanged="UpdateSubdDisplay" IsSaved="isSaved" />
        </div>
    </div>

    <div class="top-buttons">
        <button class="btn-primary" @onclick="DownloadTemplate" disabled="@(invoice.SubdistributorId <= 0)">
            <span class="btn-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.42l2.3 2.3V4a1 1 0 0 1 1-1ZM5 19a1 1 0 0 0 0 2h14a1 1 0 0 0 0-2H5Z"/></svg>
            </span>
            <span>Download Template</span>
        </button>
        <button class="btn-primary" type="button" @onclick="OpenImportFilePicker"
                disabled="@(invoice.SubdistributorId <= 0)">
            <span class="btn-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M14 2a2 2 0 0 1 2 2v6h4a1 1 0 0 1 .8 1.6l-7 8a1 1 0 0 1-1.6 0l-7-8A1 1 0 0 1 4 10h4V4a2 2 0 0 1 2-2h4Zm-1 2h-2v8H7.6L12 15.2 16.4 12H15V4Zm-1 13v3a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-3h2v3a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3v-3h2Z"/></svg>
            </span>
            <span>Import</span>
        </button>
        <InputFile id="salesinvoice-import-file" class="d-none" accept=".xls,.xlsx,.xlsm,.xlsb" OnChange="HandleImportFileSelected" />
    </div>
</div>

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="loading-bar-track">
            <div class="loading-bar-fill"></div>
        </div>
        <p>@loadingMessage</p>
    </div>
}

@if (showDownloadSuccess)
{
    <div class="alert alert-success" role="alert">
        @downloadSuccessMessage
        <button class="btn btn-sm btn-link" @onclick="() => showDownloadSuccess = false">Dismiss</button>
    </div>
}


    <ConfirmModal Show="showCommitConfirmModal" Title="Commit Invoice" Message="Commit this invoice to the database?"
                  OnYes="ConfirmCommitInvoice" OnNo="CancelCommitInvoice" />

    <ConfirmModal Show="showErrorModal" Title="Error" ErrorMessage="@errorMessage" ShowError="true"
                  OnErrorConfirm="CloseErrorModal" />

    <ConfirmModal Show="showAddItemsConfirmModal" Title="Save Items"
                  Message="@($"Add {addItemsConfirmCount} item(s) to the invoice?")" OnYes="ConfirmAddItems"
                  OnNo="CancelAddItemsConfirm" />

    <ConfirmModal Show="showAddItemsErrorModal" Title="Save Items" ShowError="true"
                  ErrorMessage="Please add at least one item before saving." OnErrorConfirm="CloseAddItemsErrorModal" />

    <ConfirmModal Show="showEditItemsConfirmModal" Title="Save Changes" Message="@editItemsConfirmMessage"
                  OnYes="ConfirmEditItems" OnNo="CancelEditItemsConfirm" />

    <ConfirmModal Show="showClearConfirmModal" Title="Clear Draft"
                  Message="Clear all unsaved changes for this sub-distributor?" OnYes="ConfirmClearDraft" OnNo="CancelClearConfirm" />

    <ConfirmModal Show="showImportConfirmModal" Title="Import Sales Invoices"
                  Message="@($"Import invoices from Excel file to [{subdList.FirstOrDefault(s => s.SubDistributorId == invoice.SubdistributorId)?.SubdName ?? "Unknown"}]?")"
                  OnYes="ConfirmImport" OnNo="CancelImport" />

    <ImportSalesInvoice Show="showImportResultsModal" ImportResult="lastImportResult" OnClose="CloseImportResultsModal"
                        OnCommit="CommitSelectedImportedInvoices" OnDownloadErrorReport="HandleDownloadErrorReport"/>

    <InvoiceHeader Invoice="invoice" IsSaved="isSaved" OnSaveClick="SaveDraft" OnEditClick="EnableEdit"
                   OnDraftChanged="PersistDraftAsync" Customers="customers"
                   SelectedSubdistributorId="invoice.SubdistributorId" CurrentInvoiceId="currentInvoiceId" />

    @if (isSaved)
    {
        <div class="item-actions">
            <button class="btn-primary" @onclick="OpenAddItemsModal">Add Items (F3)</button>
            <button class="btn-primary" @onclick="OpenEditItemsModal" disabled="@(!items.Any())">Edit Items (F4)</button>
        </div>
    }

    <AddInvoiceItems @ref="addItemsModalRef" ShowModal="showAddItemsModal" OnSaveModalItems="OnModalItemsSaved"
                     OnCancelModal="CloseAddItemsModal" Items="items" ItemsChanged="OnItemsChanged" AvailableItems="subdItems"
                     AvailableUoms="availableUoms" SelectedSubdistributorId="invoice.SubdistributorId" HeaderIsSaved="isSaved"
                     InvoiceDate="invoice.InvoiceDate" OnBeforeSave="OnAddItemsBeforeSave" OnDraftChanged="PersistDraftAsync"
                     IsCredit="@(string.Equals(invoice.OrderType, "Credit", StringComparison.OrdinalIgnoreCase))" />

    <EditInvoiceItems @ref="editItemsModalRef" ShowModal="showEditItemsModal" OnSaveEditedItems="OnEditedItemsSaved"
                      OnCancelModal="CloseEditItemsModal" Items="items" AvailableItems="subdItems" AvailableUoms="availableUoms"
                      InvoiceDate="invoice.InvoiceDate" OnBeforeSave="OnEditItemsBeforeSave" />

    <InvoiceItemsTable Items="items" ItemsChanged="OnItemsChanged" AvailableItems="subdItems"
                       AvailableUoms="availableUoms" />



    <div class="commit-actions">
        <button class="btn-secondary" type="button" @onclick="ShowClearConfirmModal"
                disabled="@(invoice.SubdistributorId <= 0)">
            Clear Draft
        </button>
        @if (isSaved)
        {
            <button class="btn-primary" @onclick="ShowCommitInvoiceConfirm">Commit Invoice (Ctrl+S)</button>
            <span class="shortcut-hint">Commit saves the invoice header and all items to the database.</span>
        }
    </div>



