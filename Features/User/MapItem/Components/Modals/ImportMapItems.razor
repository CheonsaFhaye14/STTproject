@using STTproject.Services
@using STTproject.Features.User.MapItem.DTOs
@inject STTproject.Features.User.MapItem.Services.ImportMapItemService ImportMapItemService
@inject STTproject.Features.User.MapItem.Services.DownloadTemplateService DownloadTemplateService
@inject IUserContextService UserContext
@inject IJSRuntime JS

<LoadingOverlay Show="isPreparing"
                Title="Checking your file…"
                Subtitle="Validating headers, rows, and data. This may take a moment."
                IconClass="fa-solid fa-file-arrow-up" />
                
@if (Show && !showResults)
{
    <Modal ShowModal="Show"
           Title="Import Map Items"
           Subtitle="Map subdistributor items to your database by importing an Excel file."
           IconType="ModalIconType.Upload"
           Details="Excel should contain: SubDistributor Code, CompanyItem Code, CompanyItem Name (required); UOM, Conversion, Price (optional)."
           OnClose="HandleClose">
        <ChildContent>
            <FileInput OnFileSelected="HandleFileSelected" />
        </ChildContent>
        <FooterContent>
            <Button Title="Cancel" OnClick="HandleClose" Variant="ButtonVariant.Secondary" />
            <Button Title="Check File"
                    OnClick="OnPrepare"
                    Disabled="@(selectedFile == null || isPreparing)"
                    Icon="fa-solid fa-check"
                    Variant="ButtonVariant.Primary" />
        </FooterContent>
    </Modal>
}

<ImportMapItemResults Show="showResults"
                      ImportResult="importResult"
                      SelectedGroupKeys="selectedGroupKeys"
                      OnCommit="HandleCommitAsync"
                      OnClose="CloseResults"
                      OnDownloadErrorReport="HandleDownloadErrorReport" />

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private IBrowserFile? selectedFile;
    private bool isPreparing;
    private bool showResults;
    private ImportMapItemResult? importResult;
    private HashSet<string> selectedGroupKeys = new(StringComparer.OrdinalIgnoreCase);

    private const long MaxFileSizeBytes = 20 * 1024 * 1024;

    private void HandleFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        importResult = null;
    }

    private async Task OnPrepare()
    {
        if (selectedFile == null) return;

        isPreparing = true;
        importResult = null;
        StateHasChanged();

        try
        {
            byte[] fileBytes;
            await using (var stream = selectedFile.OpenReadStream(MaxFileSizeBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                fileBytes = ms.ToArray();
            }

            using var importStream = new MemoryStream(fileBytes);
            importResult = await ImportMapItemService.ImportFromExcelAsync(importStream, UserContext.UserId ?? 0);

            // Nothing is selected when the results open; the user picks what to commit.
            selectedGroupKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            importResult = new ImportMapItemResult();
            importResult.AddError(0, string.Empty, $"Failed to open/import file: {ex.Message}.");
        }
        finally
        {
            isPreparing = false;
            showResults = importResult != null;
            StateHasChanged();
        }
    }

    private async Task HandleCommitAsync()
    {
        if (importResult == null) return;

        var userId = UserContext.UserId ?? 0;

        // Work with whole groups (one group = one Subd item with all its UOM rows).
        var selectedGroups = importResult.PreparedGroups
            .Where(g => g.Selected && !g.IsSaved && g.Rows.Count > 0
                        && g.Issues.Count == 0 && g.Rows.All(r => r.Issues.Count == 0)
                        && selectedGroupKeys.Contains(GroupKey(g)))
            .ToList();

        var selectedRows = selectedGroups.SelectMany(g => g.Rows).ToList();

        // Nothing matched the selection. The results modal reports these groups as
        // "not processed" instead of failing silently.
        if (selectedRows.Count == 0) return;

        // CommitPreparedRowsAsync quietly returns 0 when there is no user, so stop here
        // and give every selected row a reason instead of pretending it was saved.
        if (userId <= 0)
        {
            foreach (var row in selectedRows)
            {
                row.Issues.Add("Save failed: unable to identify the current user. Please sign in again.");
                row.IsSuccess = false;
            }
            StateHasChanged();
            return;
        }

        var committedGroups = 0;
        try
        {
            committedGroups = await ImportMapItemService.CommitPreparedRowsAsync(selectedRows, userId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            foreach (var row in selectedRows.Where(r => r.Issues.Count == 0))
            {
                row.Issues.Add($"Save failed: {ex.Message}");
                row.IsSuccess = false;
            }
        }

        // A group counts as saved only when every row succeeded AND got a Subd item id.
        // The results stay open, so the user sees what was saved and what was not.
        foreach (var g in selectedGroups)
        {
            if (g.Rows.All(r => r.IsSuccess && r.Issues.Count == 0 && r.SubdItemId.HasValue))
                g.IsSaved = true;
        }

        if (committedGroups > 0)
            await OnImportCompleted.InvokeAsync();

        StateHasChanged();
    }

    private async Task HandleDownloadErrorReport(List<ImportMapItemRowResult> filteredRows)
    {
        if (importResult == null || filteredRows.Count == 0) return;

        var bytes = DownloadTemplateService.GenerateErrorReportExcel(importResult, filteredRows);
        var fileName = $"MapItem-Import-Errors-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx";

        await JS.InvokeVoidAsync(
            "downloadFileFromBytes",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task CloseResults()
    {
        showResults = false;
        selectedFile = null;
        importResult = null;
        selectedGroupKeys.Clear();
        await OnClose.InvokeAsync();
    }

    private async Task HandleClose()
    {
        selectedFile = null;
        importResult = null;
        await OnClose.InvokeAsync();
    }

    // Must stay identical to BuildGroupKey in ImportMapItemResults.razor
    // (sub distributor | company item code | company item name | subd item code | subd item name).
    private static string GroupKey(PreparedItemGroup g)
    {
        var row = g.Rows.FirstOrDefault();
        if (row == null) return string.Empty;

        static string NormalizePart(string? v) => (v ?? string.Empty).Trim().ToUpperInvariant();
        return string.Join("|",
            NormalizePart(row.SubDistributorCode),
            NormalizePart(row.CompanyItemCode),
            NormalizePart(row.CompanyItemName),
            NormalizePart(row.SubdItemCode),
            NormalizePart(row.SubdItemName));
    }
}
