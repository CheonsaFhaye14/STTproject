@inject IJSRuntime JSRuntime


<Modal ShowModal="ShowAddUomModal" Width="900px" MaxWidth="100%" MaxHeight="80vh"
    Title="Add Unit of Measure" OnClose="CancelAsync" IconType="ModalIconType.Ruler" Subtitle="@getModalSubtitle()">
    <ChildContent>
        @{
            var messages = BuildMessages();
        }
        <FormSection Icon="ti ti-library-plus" Title="Additional Units of Measure" Expandable="true" IsExpanded="true">
            <ChildContent>
                <div class="form-group">
                    <Select Label="Unit of Measure" Required="true" Items="@DefaultOptions" SelectedValue="@SelectedUomOption"
                            SelectedValueChanged="OnUomSelectChanged" Placeholder="-- Select Unit of Measure --"
                            ExtraOptions="@(new[] { ("__custom", "Other (type custom)") })"
                            ShowError="@(!string.IsNullOrWhiteSpace(GetFieldError("uom")))" ErrorText='@GetFieldError("uom")' />
                </div>
                @if (SelectedUomOption == "__custom")
                {
                    <div class="form-group">
                        <Input Label="Custom Unit of Measure" Required="true" @bind-Value="CustomUom" Placeholder="Enter unit name"
                                 ShowError="@(!string.IsNullOrWhiteSpace(GetFieldError("customUom")))" ErrorText='@GetFieldError("customUom")' />
                    </div>
                }
                @if (!IsConversionNotSet)
                {
                <div class="form-group">
                    <div class="conversion-label">
                        <label>Conversion</label>
                    </div>
                    <div class="input-row">
                        <Input TValue="string"
                            Value="@ConversionInput"
                            ValueChanged="@(async v => { ConversionInput = v ?? string.Empty; await PersistDraftAsync(); })"
                            Placeholder="e.g., 12"
                            Disabled="@IsBaseUom(GetSelectedUomName())"/>
                        <Button Title="Clear conversion" OnClick="ClearConversionInputAsync" Disabled="@IsBaseUom(GetSelectedUomName())" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(GetFieldError("conversion")))
                    {
                        <span class="error-text">@GetFieldError("conversion")</span>
                    }
                </div>
                <div class="form-group">
                    <Select Items="@ConversionBasedOnOptions"
                            Label="@getLabelForConversionBased()"
                            ValueSelector="@(k => k)"
                            TextSelector="@(k => k)"
                            SelectedValue="@ConversionBasedOnInput"
                            SelectedValueChanged="OnConversionBasedOnChanged"
                            Disabled="@IsBaseUom(GetSelectedUomName())" />
                </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Conversion</label>
                        <div class="input-row">
                            <input type="text" value="Not set" disabled />
                            <Button Title="Set conversion" OnClick="SetConversionInput" Disabled="@IsBaseUom(GetSelectedUomName())" />
                        </div>
                    </div>
                }

                <div class="form-group">
                    <Input Label="Price" @bind-Value="PriceInput" Placeholder="0.00" Step="0.01" AddOptionalText="true" OptionalText="(Optional - will be calculated if left empty)"
                           ShowError="@(!string.IsNullOrWhiteSpace(GetFieldError("price")))" ErrorText='@GetFieldError("price")' />
                </div>
                <Button Title="Add UOM" OnClick="() => AddUomEntryAsync(false)" Variant="ButtonVariant.Primary"></Button>
            </ChildContent>
        </FormSection>

        <FormSection Title="All Units of Measures" Icon="ti ti-clipboard-list" IsExpanded="true" Expandable="true">
            <ChildContent>
                <div class="stock-ref" id="uom-ref">
                    <span class="stock-chip">
                        Company stock UOM
                        <strong>@(string.IsNullOrWhiteSpace(CompanyStockUomName) ? "Not set" : CompanyStockUomName)</strong>
                    </span>
                    <span class="stock-chip">
                        Applicable price
                        <strong>@(ApplicableStockPrice?.ToString("N2") ?? "-")</strong>
                        @if (!string.IsNullOrWhiteSpace(PriceListLabel))
                        {
                            <em>· @PriceListLabel</em>
                        }
                    </span>
                </div>
                @{
                    var uomRows = UomRows;
                }
                @if (uomRows.Count > 0)
                {
                    <div id="uom-table" class="uom-table-block">
                    <AddTable TItem="UomRow"
                            Items="uomRows"
                            Columns="UomColumns"
                            ColumnLabels="UomColumnLabels"
                            ColumnWidths="UomColumnWidths"
                            EditableColumns="UomEditableColumns"
                            ColumnInputTypes="UomColumnInputTypes"
                            TemplateColumns="UomTemplateColumns"
                            DisplayValueSelector="GetUomDisplayValue"
                            RowClassSelector="@(r => r.Entry.IsActive && r.Entry.IsStockUom ? "row-highlight" : null)"
                            RowIdSelector="@(r => UomRowDomId(r.Name))"
                            CellClassSelector="GetCellClass"
                            OnCellChanged="HandleUomCellChangedAsync"
                            RemoveButtonVisible="true"
                            ShowError="false">
                        <CellTemplate Context="cell">
                            @if (cell.Column == StockColumn)
                            {
                                <div class="stock-radio-cell">
                                    <input type="radio" name="stock-uom" data-col="@StockColumn"
                                        aria-label="Use @cell.Item.Name as the stock UOM"
                                        checked="@cell.Item.Entry.IsStockUom"
                                        disabled="@(!cell.Item.Entry.IsActive)"
                                        @onchange="() => SelectStockUom(cell.Item.Name)" />
                                </div>
                            }
                        </CellTemplate>
                        <CellSuffixTemplate Context="cell">
                            @if (cell.Column == nameof(UomRow.UnitLabel))
                            {
                                @if (cell.Item.IsBase)
                                {
                                    <span class="uom-badge uom-badge-base">Base</span>
                                }
                                @if (IsSuggested(cell.Item.Name))
                                {
                                    <span class="uom-badge uom-badge-suggested">Suggested</span>
                                }
                            }
                            else if (cell.Column == nameof(UomRow.Conversion) && !cell.Item.IsBase && cell.Item.Entry.Conversion is > 0)
                            {
                                <span class="uom-sub">1 @cell.Item.Name = @cell.Item.Entry.Conversion @BaseUomName</span>
                            }
                            else if (cell.Column == nameof(UomRow.Price)
                                && cell.Item.Entry.IsActive && cell.Item.Entry.IsStockUom
                                && StockUomSuggester.PriceMatches(ApplicableStockPrice, cell.Item.Entry))
                            {
                                <span class="uom-note uom-note-ok" role="img" aria-label="Matches company price" title="Matches company price">
                                    <i class="ti ti-check" aria-hidden="true"></i>
                                </span>
                            }
                        </CellSuffixTemplate>
                        <RowActionsTemplate Context="row">
                            @if (!row.IsBase)
                            {
                                @if (row.Entry.IsActive)
                                {
                                    <Button OnClick="() => RemoveUomEntry(row.Name)" Tooltip="@(IsUomInUse(row.Name) ? "Deactivate" : "Remove")" Variant="ButtonVariant.IconActionDelete" Icon="ti ti-trash"></Button>
                                }
                                else
                                {
                                    <Button OnClick="() => ReactivateUomEntry(row.Name)" Title="Reactivate"></Button>
                                }
                            }
                        </RowActionsTemplate>
                    </AddTable>
                    </div>
                }

                <UomReviewPanel @ref="reviewPanel" Messages="messages" PanelId="@ReviewPanelId" OnJump="JumpToMessageAsync" />
            </ChildContent>
        </FormSection>
    </ChildContent>
    <FooterContent>
        <Button Title="Cancel" OnClick="CancelAsync" />
        <Button Title="Clear Draft" OnClick="ShowClearDraftConfirmModal" />
        <Button Title="Save" OnClick="AddAsync" Variant="ButtonVariant.Primary" />
    </FooterContent>
</Modal>

@if (showClearDraftConfirmModal)
{
    <ConfirmModal Show="showClearDraftConfirmModal" Title="Clear Draft"
                    Message="Clear all unsaved changes for this UOM draft?" OnYes="ConfirmClearDraftAsync"
                    OnNo="CancelClearDraftConfirm" />
}

@if (showReactivateConflictModal)
{
    <ConfirmModal Show="showReactivateConflictModal" Title="Reactivate UOM" Message="@reactivateConflictMessage"
                    OnYes="DismissReactivateConflictModal" OnNo="DismissReactivateConflictModal" />
}
