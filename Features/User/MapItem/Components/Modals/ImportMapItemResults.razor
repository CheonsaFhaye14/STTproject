@using STTproject.Features.User.MapItem.DTOs

<div class="modal @(Show ? "show" : "")"
     style="@(Show ? "display: block;" : "display: none;")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            @* ── Modal header ── *@
            <div class="modal-header-ent">
                <div class="mh-left">
                    <div class="mh-icon">
                        <i class="ti ti-replace" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="mh-title">Import results</div>
                        <div class="mh-sub">Subdistributor Item mapping</div>
                    </div>
                </div>
                <button type="button" class="mh-close" @onclick="HandleClose" aria-label="Close">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>

            @* ── Modal body ── *@
            <div class="modal-body-ent">
                @if (ImportResult == null)
                {
                    <p class="text-muted" style="font-size:13px;">No import result to display.</p>
                }
                else if (!GetGlobalIssues().Any() && !ImportResult.Rows.Any())
                {
                    <div class ="global-alert">
                        <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                        <div>
                            <div class="global-alert-title">No rows to import</div>
                            <p class="hint-text" style="margin:0;">The import file did not contain any valid rows to process.</p>
                        </div>
                    </div>
                }
                else
                {
                    var globalIssues = GetGlobalIssues();
                    var groups = ImportResult.PreparedGroups ?? new List<PreparedItemGroup>();

                    foreach (var g in groups)
                    {
                        if (g.Rows.Any())
                        {
                            var key = BuildGroupKey(g.Rows.First());
                            g.Selected = SelectedGroupKeys.Contains(key);
                        }
                    }

                    var hasWarningGroups = groups.Any(GroupHasWarningOnly);                    
                    var hasSuccessGroups = groups.Any(g => (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0));
                    var hasErrorGroups = groups.Any(g => (g.Issues?.Count ?? 0) > 0 || g.Rows.Any(r => r.Issues.Count > 0));
                    var selectableCount = groups.Count(g => (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0) && !g.IsSaved);
                    var selectedCount = groups.Count(g => g.Selected && !g.IsSaved && (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0));
                    var warningSelectableCount = groups.Count(g => GroupHasWarningOnly(g) && !g.IsSaved);
                    var warningSelectedCount = groups.Count(g => g.Selected && !g.IsSaved && GroupHasWarningOnly(g));
                    var totalRows = ImportResult.Rows.Count;

                    @* ── Summary stat bar ── *@
                    <div class="stat-bar">
                        <div class="sc">
                            <div class="sc-label">Total rows</div>
                            <div class="sc-val">@totalRows</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">Subd Items</div>
                            <div class="sc-val">@groups.Count</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">Valid</div>
                            <div class="sc-val sc-ok">@groups.Count(g => (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0))</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">With warnings</div>
                            <div class="sc-val sc-warn">@groups.Count(GroupHasWarningOnly)</div>
                        </div>
                        <div class="sc">
                            <div class="sc-label">With errors</div>
                            <div class="sc-val @(hasErrorGroups ? "sc-er" : "")">@groups.Count(g => (g.Issues?.Count ?? 0) > 0 || g.Rows.Any(r => r.Issues.Count > 0))</div>
                        </div>
                    </div>

                    @* ── Global file-level failure ── *@
                    @if (globalIssues.Any())
                    {
                        <div class="global-alert">
                            <i class="ti ti-shield-x global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">Import failed — file could not be processed</div>
                                <ul class="global-alert-list">
                                    @foreach (var issue in globalIssues)
                                    {
                                        <li>
                                            <span class="row-tag">Row @issue.RowNumber</span>
                                            @issue.Message
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <p class="hint-text">Fix the issues in your file and re-upload to continue.</p>
                    }

                    @* ── Pure success (no groups, no global issues) ── *@
                    @if (!groups.Any() && !globalIssues.Any())
                    {
                        <div class="success-banner">
                            <div class="success-banner-icon">
                                <i class="ti ti-circle-check" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="success-banner-title">Import complete</div>
                                <div class="success-banner-sub">All rows have already been processed. Nothing left to commit.</div>
                            </div>
                        </div>
                    }

                    @* ── Tabs ── *@
                    @if(groups.Any()){
                    <div class="tabs">
                        <button type="button" class="tab @GetTabClass(GroupFilter.All)" @onclick='() => SetTab(GroupFilter.All)'>
                            All (@groups.Count)
                        </button>
                        @if (hasSuccessGroups)
                        {
                            <button type="button" class="tab @GetTabClass(GroupFilter.SuccessOnly)" @onclick='() => SetTab(GroupFilter.SuccessOnly)'>
                                <span class="dot dot-ok"></span>
                                Valid (@groups.Count(g => (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0)))
                            </button>
                        }
                        @if (hasWarningGroups)
                        {
                            <button type="button" class="tab @GetTabClass(GroupFilter.WarningOnly)" @onclick='() => SetTab(GroupFilter.WarningOnly)'>
                                <span class="dot dot-warn"></span>
                                Warnings (@groups.Count(GroupHasWarningOnly))
                            </button>
                        }
                        @if (hasErrorGroups)
                        {
                            <button type="button" class="tab @GetTabClass(GroupFilter.ErrorOnly)" @onclick='() => SetTab(GroupFilter.ErrorOnly)'>
                                <span class="dot dot-er"></span>
                                Errors (@groups.Count(g => (g.Issues?.Count ?? 0) > 0 || g.Rows.Any(r => r.Issues.Count > 0)))
                            </button>
                        }
                    </div>
                    }

                        @* ── Error filter bar (only on error tab) ── *@
                        @if (groupFilter == GroupFilter.ErrorOnly && hasErrorGroups)
                        {
                            <div class="err-filter-bar">
                                <span class="err-filter-label">
                                    <i class="ti ti-filter" aria-hidden="true"></i>
                                    Rows with Errors: @GetTotalErrorCount()
                                </span>
                                <select @onchange="OnErrorFilterChanged" value="@(selectedErrorFilter ?? string.Empty)">
                                    <option value="">All errors</option>
                                    @foreach (var entry in GetDistinctErrorMessages())
                                    {
                                        var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                        <option value="@entry.Message">@display (@entry.Count)</option>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(selectedErrorFilter))
                                {
                                    <button type="button" class="clear-filter-btn" @onclick="ClearErrorFilter">
                                        <i class="ti ti-x" aria-hidden="true"></i>
                                        Clear
                                    </button>
                                }
                            </div>
                            <button type="button" class="btn-download-errors" @onclick="HandleDownloadErrorReport">
                                <i class="ti ti-download" aria-hidden="true"></i>
                                Download @(!string.IsNullOrEmpty(selectedErrorFilter) ? $"'{selectedErrorFilter}'" : "all") errors
                            </button>
                        }

                        @* ── Select all (only on valid / all tab) ── *@
                        @if (groupFilter == GroupFilter.SuccessOnly && selectableCount > 0) 
                        {
                            <div class="sel-all-bar">
                                <input type="checkbox" id="select-all-check"
                                       checked="@(selectedCount == selectableCount)"
                                       @onchange="(e) => ToggleSelectAllCards(e.Value)" />
                                <label for="select-all-check">Select all valid (@selectedCount / @selectableCount ready)</label>
                            </div>
                        }
                        else if (groupFilter == GroupFilter.WarningOnly && selectableCount > 0)
                        {
                            <div class="sel-all-bar">
                                <input type="checkbox" id="select-all-warnings-check"
                                    checked="@(warningSelectedCount == warningSelectableCount)"
                                    @onchange="(e) => ToggleSelectAllWarningCards(e.Value)" />
                                <label for="select-all-warnings-check">Select all with warnings (@warningSelectedCount / @warningSelectableCount ready)</label>
                            </div>
                        }

                        @* ── Item cards ── *@
                        <div class="import-results">
                            @foreach (var group in groups.Where(ShouldShowGroup).OrderBy(GetGroupSortKey))
                            {
                                var groupRows = group.Rows!;
                                var hasErrors = (group.Issues?.Count ?? 0) > 0 || groupRows.Any(r => r.Issues.Count > 0);
                                var first = groupRows.FirstOrDefault();
                                var displayName = first == null
                                    ? "[Orphan]"
                                    : (string.IsNullOrWhiteSpace(first.CompanyItemCode) ? "[Blank Item]" : $"{first.CompanyItemCode} - {first.CompanyItemName}");
                                var groupKey = first != null ? BuildGroupKey(first) : Guid.NewGuid().ToString();
                                var isExpanded = expandedGroups.Contains(groupKey) || groupFilter == GroupFilter.WarningOnly;

                                @if (!hasErrors)
                                {
                                    <div class="icard">
                                        <div class="ich ich-ok @(isExpanded ? "open" : "")" @onclick="() => ToggleExpand(groupKey)">
                                            <div class="ich-left">
                                                <div class="iicon iicon-ok">
                                                    <i class="ti ti-package" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num inv-ok">@displayName</div>
                                                    @if (first != null)
                                                    {
                                                        <div class="inv-sub inv-sub-ok">
                                                            <span>@first.SubDistributorCode - @first.SubDistributorName</span>
                                                            <span class="sep">·</span>
                                                            <span>@groupRows.Count row(s)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="ich-right">
                                                @if (group.IsSaved)
                                                {
                                                    <span class="badge badge-saved">
                                                        <i class="ti ti-circle-check" aria-hidden="true"></i>
                                                        Saved
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-ready">
                                                        <i class="ti ti-check" aria-hidden="true"></i>
                                                        Ready
                                                    </span>
                                                    <div class="chk" @onclick:stopPropagation="true">
                                                        <input type="checkbox" checked="@group.Selected"
                                                               @onchange="(e) => ToggleGroupSelectionLocal(group, e.Value)"
                                                               id="chk-@groupKey" />
                                                        <label for="chk-@groupKey">Select</label>
                                                    </div>
                                                }
                                                <i class="ti ti-chevron-down chev @(isExpanded ? "open" : "")" aria-hidden="true"></i>
                                            </div>
                                        </div>

                                        @if (isExpanded && first != null)
                                        {
                                            <div class="icb">
                                                <div class="cust-meta">
                                                    <div>
                                                        <span class="cust-meta-label">Principal</span>
                                                        <strong>@first.Principal</strong>
                                                    </div>
                                                    <div>
                                                        <span class="cust-meta-label">Subdistributor</span>
                                                        <strong>@first.SubDistributorCode - @first.SubDistributorName</strong>
                                                    </div>
                                                    <div style="grid-column: 1 / -1;">
                                                        <span class="cust-meta-label">Subdistributor Item</span>
                                                        <strong>@first.SubdItemCode - @first.SubdItemName</strong>
                                                    </div>
                                                </div>
                                                @{
                                                    var groupWarnings2 = groupRows.SelectMany(r => r.Warnings).Distinct().ToList();
                                                }
                                                @if (groupWarnings2.Any())
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                        @groupWarnings2.First()
                                                    </div>
                                                }
                                                <div class="itbl-wrap">
                                                    <table class="itbl">
                                                        <thead>
                                                            <tr>
                                                                <th>Row</th>
                                                                <th>UOM</th>
                                                                <th class="r">Conversion</th>
                                                                <th class="r">Price</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in groupRows.OrderBy(r => r.RowNumber))
                                                            {
                                                                <tr>
                                                                    <td class="mono">@row.RowNumber</td>
                                                                    <td>@row.UomName</td>
                                                                    <td class="r">@row.Conversion?.ToString("0") ?? "Not Set"</td>
                                                                    <td class="r">@row.Price?.ToString("N2")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var groupErrorCount = GetGroupErrorRowCount(group);

                                    var visibleIssues = (group.Issues ?? new List<ImportMapItemIssue>())
                                        .Concat(groupRows.SelectMany(r => r.Issues.Select(i => new ImportMapItemIssue(r.RowNumber, r.SubdItemCode, i))));

                                    if (!string.IsNullOrWhiteSpace(selectedErrorFilter))
                                    {
                                        if (selectedErrorFilter == "SubdItem Duplicated In Excel")
                                        {
                                            var matching = visibleIssues.Where(i => NormalizeMessageType(i.Message) == selectedErrorFilter).ToList();
                                            var dupCodes = groupRows.Select(r => r.SubdItemCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                                            var extras = new List<ImportMapItemIssue>();
                                            var allRows = ImportResult?.Rows ?? new List<ImportMapItemRowResult>();
                                            foreach (var code in dupCodes)
                                            {
                                                var others = allRows.Where(rr => rr.RowNumber > 0 && !string.IsNullOrWhiteSpace(rr.SubdItemCode) && string.Equals(rr.SubdItemCode, code, StringComparison.OrdinalIgnoreCase)).ToList();
                                                foreach (var other in others)
                                                {
                                                    if (!groupRows.Any(r => r.RowNumber == other.RowNumber))
                                                    {
                                                        var msg = $"SubdItem code '{other.SubdItemCode}' is duplicated within the uploaded Excel for SubDistributor '{other.SubDistributorCode}'.";
                                                        extras.Add(new ImportMapItemIssue(other.RowNumber, other.SubdItemCode, msg));
                                                    }
                                                }
                                            }
                                            visibleIssues = matching.Concat(extras);
                                        }
                                        else
                                        {
                                            visibleIssues = visibleIssues.Where(i => NormalizeMessageType(i.Message) == selectedErrorFilter);
                                        }
                                    }

                                var grouped = visibleIssues
                                    .GroupBy(i => i.Message)
                                    .Select(g => new { Message = g.Key, RowNumbers = g.Select(x => x.RowNumber).Where(r => r > 0).Distinct().OrderBy(r => r).ToList() })
                                    .OrderBy(g => g.RowNumbers.FirstOrDefault())
                                    .ToList();

                                    <div class="icard">
                                        <div class="ich ich-er">
                                            <div class="ich-left">
                                                <div class="iicon iicon-er">
                                                    <i class="ti ti-package-off" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num inv-er">@displayName</div>
                                                    @if (first != null)
                                                    {
                                                        <div class="inv-sub inv-sub-er">
                                                            <span>@first.SubDistributorCode - @first.SubDistributorName</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <span class="badge badge-err">
                                                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                @((groupErrorCount == 1) ? "1 error" : $"{groupErrorCount} errors")
                                            </span>
                                        </div>

                                        @if (grouped.Any())
                                        {
                                            <div class="icb-err-rows">
                                                @foreach (var issueGroup in grouped)
                                                {
                                                    <div class="err-msg-card">
                                                        <div class="err-msg-hdr">
                                                            <i class="ti ti-alert-circle err-msg-icon" aria-hidden="true"></i>
                                                            <div>
                                                                <div class="err-msg-text">@issueGroup.Message</div>
                                                                @if (issueGroup.RowNumbers.Any())
                                                                {
                                                                    <div class="err-rows-pill">
                                                                        <i class="ti ti-row-insert-bottom" aria-hidden="true"></i>
                                                                        Row: @string.Join(" & ", issueGroup.RowNumbers)
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                
                }
            </div>

            @* ── Modal footer ── *@
            <div class="modal-footer-ent">
                @if (ImportResult != null && GetSelectedCardCount() > 0)
                {
                    <button type="button" class="btn-commit" disabled="@(!CanCommit)" @onclick="OpenCommitConfirmModal">
                        <i class="ti ti-send" aria-hidden="true"></i>
                        Commit mapped items (@GetSelectedCardCount())
                    </button>
                }
                <button type="button" class="btn-close-modal" @onclick="HandleClose">Close</button>
            </div>

        </div>
    </div>
</div>

<ConfirmModal Show="showCommitConfirmModal" Title="Commit Selected Items"
              Message="@($"Commit {GetSelectedCardCount()} selected item(s)?")"
              OnYes="ConfirmCommit" OnNo="CancelCommit" CloseOnOverlayClick="true" />

@code {
    [Parameter] public EventCallback<List<ImportMapItemRowResult>> OnDownloadErrorReport { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public ImportMapItemResult? ImportResult { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public HashSet<string> SelectedGroupKeys { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private bool showCommitConfirmModal;
    private bool wasShown;
    private GroupFilter groupFilter = GroupFilter.All;
    private string? selectedErrorFilter;
    private HashSet<string> expandedGroups = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (Show && !wasShown) { groupFilter = GroupFilter.All; wasShown = true; }
        else if (!Show) { wasShown = false; }
    }

    private bool CanCommit => ImportResult != null && GetSelectedCardCount() > 0;

    private void ToggleExpand(string key)
    {
        if (!expandedGroups.Remove(key))
            expandedGroups.Add(key);
    }

    private string GetTabClass(GroupFilter filter) => groupFilter == filter
        ? filter switch
        {
            GroupFilter.SuccessOnly => "tab act-ok",
            GroupFilter.WarningOnly => "tab act-warn",
            GroupFilter.ErrorOnly => "tab act-er",
            _ => "tab act-all"
        }
        : "tab";

    private void SetTab(GroupFilter filter)
    {
        groupFilter = filter;
        selectedErrorFilter = null;
    }

    private List<ImportMapItemIssue> GetGlobalIssues()
    {
        if (ImportResult == null) return new List<ImportMapItemIssue>();

        var headerIssues = ImportResult.Issues.Where(i => i.RowNumber == 0).ToList();

        var rowHeaderIssues = ImportResult.Rows
            .Where(row => row.RowNumber == 0)
            .SelectMany(row => row.Issues.Select(issue => new ImportMapItemIssue(row.RowNumber, row.SubdItemCode, issue)))
            .ToList();

        var preparedHeaderIssues = ImportResult.PreparedGroups
            .SelectMany(g => g.Issues)
            .Where(i => i.RowNumber == 0)
            .ToList();

        return headerIssues
            .Concat(rowHeaderIssues)
            .Concat(preparedHeaderIssues)
            .GroupBy(i => new { i.RowNumber, i.SubdItemCode, i.Message })
            .Select(g => g.First())
            .ToList();
    }

    private IEnumerable<(string Message, int Count)> GetDistinctErrorMessages()
    {
        if (ImportResult?.PreparedGroups == null)
            return Enumerable.Empty<(string, int)>();

        var groups = ImportResult.PreparedGroups;
        var messageTypes = new HashSet<string>();

        foreach (var g in groups)
        {
            if (g.Issues != null)
            {
                foreach (var i in g.Issues)
                {
                    var t = NormalizeMessageType(i.Message);
                    if (!string.IsNullOrWhiteSpace(t)) messageTypes.Add(t);
                }
            }
            if (g.Rows != null)
            {
                foreach (var r in g.Rows)
                foreach (var i in r.Issues)
                {
                    var t = NormalizeMessageType(i);
                    if (!string.IsNullOrWhiteSpace(t)) messageTypes.Add(t);
                }
            }
        }

        return messageTypes
            .Select(type => (Message: type, Count: groups.Sum(g => GetGroupErrorRowCount(g, type))))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();
    }

    private static string NormalizeMessage(string? m) => (m ?? string.Empty).Trim();

    private static string NormalizeMessageType(string? m)
    {
        var msg = NormalizeMessage(m).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.Contains("duplicate") && msg.Contains("uom")) return "Duplicate UOM";
        if (msg.Contains("duplicate") && msg.Contains("conversion")) return "Duplicate Conversion";
        if (msg.Contains("already exist") && msg.Contains("subd")) return "SubdItem Already Exists In Excel";
        if (msg.Contains("duplicat") && (msg.Contains("uploaded") || msg.Contains("excel")) && (msg.Contains("subd") || msg.Contains("subditem") || msg.Contains("subdistributor")))
            return "SubdItem Duplicated In Excel";
        if (msg.Contains("already mapped") || (msg.Contains("already") && msg.Contains("mapped"))) return "Already Mapped";
        if (msg.Contains("uom not found") || (msg.Contains("not found") && msg.Contains("uom"))) return "UOM Not Found";
        if (msg.Contains("invalid uom") || (msg.Contains("invalid") && msg.Contains("uom"))) return "Invalid UOM";
        if (msg.Contains("conversion mismatch") || (msg.Contains("mismatch") && msg.Contains("conversion"))) return "Conversion Mismatch";
        if (msg.Contains("uom is required") || msg.Contains("uom is missing")) return "UOM Required";
        if (msg.Contains("price is required") || msg.Contains("price missing")) return "Price Required";
        if (msg.Contains("conversion is required")) return "Conversion Required";
        if (msg.Contains("company item") && msg.Contains("not found")) return "Company Item Not Found";
        if (msg.Contains("duplicate map item")) return "Duplicate Map Item";
        if (msg.Contains("subdistributor") && msg.Contains("not found")) return "SubDistributor Not Found";
        return NormalizeMessage(m);
    }

    private void OnErrorFilterChanged(ChangeEventArgs e) => selectedErrorFilter = e?.Value?.ToString();
    private void ClearErrorFilter() => selectedErrorFilter = null;

    private int GetSelectedCardCount()
    {
        if (ImportResult == null) return 0;
        var groups = ImportResult.PreparedGroups ?? new List<PreparedItemGroup>();
        return groups.Count(g => g.Rows.Any() && SelectedGroupKeys.Contains(BuildGroupKey(g.Rows.First()))
            && (g.Issues?.Count ?? 0) == 0 && g.Rows.All(r => r.Issues.Count == 0) && !g.IsSaved);
    }

    private int GetTotalErrorCount()
    {
        if (ImportResult == null) return 0;
        var groups = ImportResult.PreparedGroups ?? new List<PreparedItemGroup>();
        return groups.Sum(g => GetGroupErrorRowCount(g, null));
    }

    private void ToggleSelectAllCards(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        var groups = ImportResult.PreparedGroups ?? new List<PreparedItemGroup>();
        foreach (var g in groups)
        {
            if (g.Rows == null || g.Rows.Count == 0) continue;
            if ((g.Issues?.Count ?? 0) > 0) continue;
            var key = BuildGroupKey(g.Rows.First());
            if (isChecked) { SelectedGroupKeys.Add(key); g.Selected = true; }
            else { SelectedGroupKeys.Remove(key); g.Selected = false; }
        }
    }

    private enum GroupFilter { All, SuccessOnly, ErrorOnly, WarningOnly }

    private static string BuildGroupKey(ImportMapItemRowResult row)
    {
        static string NormalizePart(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();
        return string.Join("|", NormalizePart(row.SubDistributorCode), NormalizePart(row.CompanyItemCode), NormalizePart(row.CompanyItemName));
    }

    private void OpenCommitConfirmModal() => showCommitConfirmModal = true;
    private void CancelCommit() => showCommitConfirmModal = false;

    private async Task ConfirmCommit()
    {
        showCommitConfirmModal = false;
        await HandleCommit();
    }

    private async Task HandleCommit()
    {
        if (OnCommit.HasDelegate) await OnCommit.InvokeAsync(null);
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync(null);
    }

    private void ToggleGroupSelectionLocal(PreparedItemGroup? prepared, object? checkedValue)
    {
        if (prepared == null || checkedValue is not bool isChecked) return;

        if (prepared.Rows.Any())
        {
            var key = BuildGroupKey(prepared.Rows.First());
            if (isChecked) SelectedGroupKeys.Add(key); else SelectedGroupKeys.Remove(key);
        }
    }

    private bool ShouldShowGroup(PreparedItemGroup group)
    {
        var rows = group.Rows;
        var hasRowIssues = rows.Any(r => r.Issues.Count > 0);
        var hasGroupIssues = (group.Issues?.Count ?? 0) > 0;
        return groupFilter switch
        {
            GroupFilter.SuccessOnly => !hasGroupIssues && !hasRowIssues,
            GroupFilter.WarningOnly => GroupHasWarningOnly(group),
            GroupFilter.ErrorOnly => !string.IsNullOrWhiteSpace(selectedErrorFilter)
                ? GroupContainsError(group, selectedErrorFilter)
                : (hasGroupIssues || hasRowIssues),
            _ => true
        };
    }

    private bool GroupContainsError(PreparedItemGroup group, string? message)
    {
        if (string.IsNullOrWhiteSpace(message)) return false;
        var norm = NormalizeMessageType(message);
        if (group.Issues != null && group.Issues.Any(i => NormalizeMessageType(i.Message) == norm)) return true;
        if (group.Rows != null && group.Rows.Any(r => r.Issues.Any(i => NormalizeMessageType(i) == norm))) return true;
        return false;
    }

    private static int GetGroupSortKey(PreparedItemGroup group)
    {
        var rows = group.Rows;
        return rows.Count > 0 ? rows.Min(r => r.RowNumber) : int.MaxValue;
    }

    private int GetDisplayRowErrorCount(ImportMapItemRowResult row)
    {
        if (string.IsNullOrWhiteSpace(selectedErrorFilter)) return row.Issues.Count;
        return row.Issues.Count(i => NormalizeMessageType(i) == selectedErrorFilter);
    }

    private int GetGroupErrorRowCount(PreparedItemGroup group) => GetGroupErrorRowCount(group, selectedErrorFilter);
    private void ToggleSelectAllWarningCards(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        var groups = ImportResult.PreparedGroups ?? new List<PreparedItemGroup>();
        foreach (var g in groups)
        {
            if (g.Rows == null || g.Rows.Count == 0) continue;
            if (!GroupHasWarningOnly(g)) continue;

            var key = BuildGroupKey(g.Rows.First());
            if (isChecked) { SelectedGroupKeys.Add(key); g.Selected = true; }
            else { SelectedGroupKeys.Remove(key); g.Selected = false; }
        }
    }
    private static int GetGroupErrorRowCount(PreparedItemGroup group, string? filterMessageType)
    {
        var affectedRows = new HashSet<int>();

        foreach (var row in group.Rows.Where(r => r.Issues.Count > 0))
        {
            if (string.IsNullOrWhiteSpace(filterMessageType)) affectedRows.Add(row.RowNumber);
            else if (row.Issues.Any(i => NormalizeMessageType(i) == filterMessageType)) affectedRows.Add(row.RowNumber);
        }

        if (group.Issues != null)
        {
            foreach (var issue in group.Issues)
            {
                if (issue.RowNumber > 0)
                {
                    if (string.IsNullOrWhiteSpace(filterMessageType) || NormalizeMessageType(issue.Message) == filterMessageType)
                        affectedRows.Add(issue.RowNumber);
                }
            }

            if (group.Issues.Any(issue => issue.RowNumber == 0 && (string.IsNullOrWhiteSpace(filterMessageType) || NormalizeMessageType(issue.Message) == filterMessageType)))
                return affectedRows.Count + 1;
        }

        return affectedRows.Count;
    }

    private async Task HandleDownloadErrorReport()
    {
        if (OnDownloadErrorReport.HasDelegate)
        {
            var rowsToExport = GetFilteredErrorReportRows();
            await OnDownloadErrorReport.InvokeAsync(rowsToExport);
        }
    }

    private List<ImportMapItemRowResult> GetFilteredErrorReportRows()
    {
        if (ImportResult == null) return new List<ImportMapItemRowResult>();

        var errorRows = ImportResult.Rows.Where(r => r.Issues.Count > 0).ToList();

        if (string.IsNullOrWhiteSpace(selectedErrorFilter))
        {
            return errorRows;
        }

        return errorRows
            .Where(r => r.Issues.Any(i => NormalizeMessageType(i) == selectedErrorFilter))
            .ToList();
    }

    private static bool GroupHasWarningOnly(PreparedItemGroup group)
    {
        var hasErrors = (group.Issues?.Count ?? 0) > 0 || group.Rows.Any(r => r.Issues.Count > 0);
        if (hasErrors) return false;
        return group.Rows.Any(r => r.Warnings.Count > 0);
    }
}