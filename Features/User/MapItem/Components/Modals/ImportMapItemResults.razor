@using Microsoft.AspNetCore.Components.Web.Virtualization
@using STTproject.Features.User.MapItem.DTOs

<LoadingOverlay Show="isCommitting" Title="Committing mapped items..." IconClass="fa-solid fa-upload" />

@if (Show)
{
    <div id="import-results-overlay" class="modal-overlay show" style="display: flex;">
        <div class="modal-box">

            @* ── Modal header ── *@
            <div class="modal-header-ent">
                <div class="mh-left">
                    <div class="mh-icon">
                        <i class="ti ti-replace" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="mh-title">Mapped Item Import results</div>
                        <div class="mh-sub">@GetHeaderSubtitle()</div>
                    </div>
                </div>
                <button type="button" class="mh-close" @onclick="HandleClose" aria-label="Close">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>

            @* ── Modal body ── *@
            <div class="modal-body-ent">
                @if (ImportResult == null)
                {
                    <p class="text-muted" style="font-size:13px;">No import result to display.</p>
                }
                else if (!GetGlobalIssues().Any() && !ImportResult.Rows.Any())
                {
                    <div class="global-alert">
                        <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                        <div>
                            <div class="global-alert-title">No rows to import</div>
                            <p class="hint-text" style="margin:0;">The import file did not contain any valid rows to process.</p>
                        </div>
                    </div>
                }
                else
                {
                    var cards = GetCards();
                    var globalIssues = GetGlobalIssues();
                    var counts = GetCounts(cards);
                    var hasSuccessGroups = counts.Valid > 0;
                    var hasWarningGroups = counts.Warning > 0;
                    var hasErrorGroups = counts.Error > 0;

                    // If the current tab has nothing left in it (e.g. after a commit), jump to one that does.
                    EnsureValidTab(hasSuccessGroups, hasWarningGroups, hasErrorGroups);

                    var displayCards = GetFilteredAndSortedCards(cards);
                    var selectableCount = cards.Count(c => c.CanSelect && !c.IsWarningOnly);
                    var selectedCount = cards.Count(c => c.CanSelect && !c.IsWarningOnly && SelectedGroupKeys.Contains(c.Key));
                    var warningSelectableCount = cards.Count(c => c.CanSelect && c.IsWarningOnly);
                    var warningSelectedCount = cards.Count(c => c.CanSelect && c.IsWarningOnly && SelectedGroupKeys.Contains(c.Key));
                    var totalRows = ImportResult.Rows.Count;

                    @if (!string.IsNullOrEmpty(commitError))
                    {
                        <div class="global-alert">
                            <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">⚠️ @commitError</div>
                            </div>
                        </div>
                    }

                    @if (hasCommitted)
                    {
                        if (commitFailedCount == 0)
                        {
                            <div class="success-banner">
                                <div class="success-banner-icon"><i class="ti ti-circle-check" aria-hidden="true"></i></div>
                                <div>
                                    <div class="success-banner-title">✅ Successfully committed @commitSavedCount item(s).</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="global-alert">
                                <i class="ti ti-alert-triangle global-alert-icon" aria-hidden="true"></i>
                                <div>
                                    <div class="global-alert-title">
                                        ⚠️ @commitSavedCount item(s) committed. @commitFailedCount item(s) could not be saved. Check the Errors tab for the reason.
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @* ── Sticky header controls (stay in place while cards scroll) ── *@
                    <div class="sticky-controls">

                        @* ── Summary stat bar ── *@
                        <div class="stat-bar">
                            <div class="sc">
                                <div class="sc-label">Total rows</div>
                                <div class="sc-val">@totalRows</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">Subd Items</div>
                                <div class="sc-val">@cards.Count</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">Valid</div>
                                <div class="sc-val sc-ok">@counts.Valid</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">With warnings</div>
                                <div class="sc-val sc-warn">@counts.Warning</div>
                            </div>
                            <div class="sc">
                                <div class="sc-label">With errors</div>
                                <div class="sc-val @(hasErrorGroups ? "sc-er" : "")">@counts.Error</div>
                            </div>
                        </div>

                        @if (cards.Count > 0)
                        {
                            @* ── Tabs ── *@
                            <div class="tabs">
                                @if (hasSuccessGroups)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.SuccessOnly)" @onclick='() => SetTab(GroupFilter.SuccessOnly)'>
                                        <span class="dot dot-ok"></span>
                                        Valid (@counts.Valid)
                                    </button>
                                }
                                @if (hasWarningGroups)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.WarningOnly)" @onclick='() => SetTab(GroupFilter.WarningOnly)'>
                                        <span class="dot dot-warn"></span>
                                        Warnings (@counts.Warning)
                                    </button>
                                }
                                @if (hasErrorGroups)
                                {
                                    <button type="button" class="tab @GetTabClass(GroupFilter.ErrorOnly)" @onclick='() => SetTab(GroupFilter.ErrorOnly)'>
                                        <span class="dot dot-er"></span>
                                        Errors (@counts.Error)
                                    </button>
                                }
                            </div>

                            @* ── Error filter bar (only on error tab) ── *@
                            @if (groupFilter == GroupFilter.ErrorOnly)
                            {
                                <div class="err-filter-bar">
                                    <span class="err-filter-label">
                                        <i class="ti ti-filter" aria-hidden="true"></i>
                                        Filter by error
                                    </span>
                                    <select @onchange="OnErrorFilterChanged" value="@(selectedErrorFilter ?? string.Empty)">
                                        <option value="">All errors</option>
                                        @foreach (var entry in GetDistinctErrorMessages())
                                        {
                                            var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                            <option value="@entry.Message">@display (@entry.Count)</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedErrorFilter))
                                    {
                                        <button type="button" class="clear-filter-btn" @onclick="ClearErrorFilter">
                                            <i class="ti ti-x" aria-hidden="true"></i>
                                            Clear
                                        </button>
                                    }
                                    <button type="button" class="btn-download-errors" @onclick="OpenDownloadModal">
                                        <i class="ti ti-download" aria-hidden="true"></i>
                                        Download
                                    </button>
                                </div>
                            }

                            @* ── Select all (valid tab selects valid only, warnings tab selects warnings only) ── *@
                            @if (groupFilter == GroupFilter.SuccessOnly && selectableCount > 0)
                            {
                                <div class="sel-all-bar">
                                    <input type="checkbox" id="select-all-check"
                                           checked="@(selectedCount == selectableCount)"
                                           @onchange="(e) => ToggleSelectAllCards(e.Value)" />
                                    <label for="select-all-check">Select all valid (@selectedCount / @selectableCount ready)</label>
                                </div>
                            }
                            else if (groupFilter == GroupFilter.WarningOnly && warningSelectableCount > 0)
                            {
                                <div class="sel-all-bar">
                                    <input type="checkbox" id="select-all-warnings-check"
                                           checked="@(warningSelectedCount == warningSelectableCount)"
                                           @onchange="(e) => ToggleSelectAllWarningCards(e.Value)" />
                                    <label for="select-all-warnings-check">Select all with warnings (@warningSelectedCount / @warningSelectableCount ready)</label>
                                </div>
                            }

                            @* ── Warning filter bar (only on warning tab) ── *@
                            @if (groupFilter == GroupFilter.WarningOnly && hasWarningGroups)
                            {
                                <div class="err-filter-bar">
                                    <span class="err-filter-label">
                                        <i class="ti ti-filter" aria-hidden="true"></i>
                                        Rows with Warnings: @GetTotalWarningCount(cards)
                                    </span>
                                    <select @onchange="OnWarningFilterChanged" value="@(selectedWarningFilter ?? string.Empty)">
                                        <option value="">All warnings</option>
                                        @foreach (var entry in GetDistinctWarningMessages(cards))
                                        {
                                            var display = entry.Message.Length > 80 ? entry.Message[..77] + "..." : entry.Message;
                                            <option value="@entry.Message">@display (@entry.Count)</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(selectedWarningFilter))
                                    {
                                        <button type="button" class="clear-filter-btn" @onclick="ClearWarningFilter">
                                            <i class="ti ti-x" aria-hidden="true"></i>
                                            Clear
                                        </button>
                                    }
                                </div>
                            }

                            @* ── Search + sort ── *@
                            <div class="search-sort-bar">
                                <div class="search-input-wrap">
                                    <i class="ti ti-search" aria-hidden="true"></i>
                                    <input type="text"
                                           placeholder="Search item, code, row or any value from the file…"
                                           value="@searchTerm"
                                           @oninput="OnSearchInput" />
                                </div>
                                <select @onchange="OnSortChanged" value="@sortMode">
                                    <option value="@ItemSortMode.RowAscending">Row order</option>
                                    <option value="@ItemSortMode.CompanyItem">Company Item Code</option>
                                    <option value="@ItemSortMode.SubdItem">Subd Item Code</option>
                                </select>
                            </div>
                        }
                    </div>

                    @* ── Global file-level failure ── *@
                    @if (globalIssues.Any())
                    {
                        <div class="global-alert">
                            <i class="ti ti-shield-x global-alert-icon" aria-hidden="true"></i>
                            <div>
                                <div class="global-alert-title">Import failed — file could not be processed</div>
                                <ul class="global-alert-list">
                                    @foreach (var issue in globalIssues)
                                    {
                                        <li>
                                            <span class="row-tag">Row @issue.RowNumber</span>
                                            @issue.Message
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <p class="hint-text">Fix the issues in your file and re-upload to continue.</p>
                    }

                    @* ── Pure success (no groups, no global issues) ── *@
                    @if (cards.Count == 0 && !globalIssues.Any())
                    {
                        <div class="success-banner">
                            <div class="success-banner-icon">
                                <i class="ti ti-circle-check" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="success-banner-title">Import complete</div>
                                <div class="success-banner-sub">All rows have already been processed. Nothing left to commit.</div>
                            </div>
                        </div>
                    }

                    @* ── Item cards (virtualized: only the visible ones are rendered) ── *@
                    @if (cards.Count > 0)
                    {
                        <div class="import-results">
                            @if (groupFilter != GroupFilter.ErrorOnly)
                            {
                                <Virtualize Items="displayCards" Context="card" ItemSize="72">
                                    @{
                                        var groupRows = card.Group.Rows;
                                        var first = card.First;
                                        var displayName = first == null
                                            ? "[Orphan]"
                                            : (string.IsNullOrWhiteSpace(first.CompanyItemCode) ? "[Blank Item]" : $"{first.CompanyItemCode} - {first.CompanyItemName}");
                                        var groupKey = card.Key;
                                        var isWarn = card.IsWarningOnly;
                                        var isExpanded = expandedGroups.Contains(groupKey) || groupFilter == GroupFilter.WarningOnly;
                                    }

                                    <div class="icard">
                                        <div class="ich @(isWarn ? "ich-warn" : "ich-ok") @(isExpanded ? "open" : "")" @onclick="() => ToggleExpand(groupKey)">
                                            <div class="ich-left">
                                                <div class="iicon @(isWarn ? "iicon-warn" : "iicon-ok")">
                                                    <i class="ti ti-package" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num @(isWarn ? "inv-warn" : "inv-ok")">@displayName</div>
                                                    @if (first != null)
                                                    {
                                                        <div class="inv-sub @(isWarn ? "inv-sub-warn" : "inv-sub-ok")">
                                                            <span>@first.Principal</span>
                                                            <span class="sep">·</span>
                                                            <span>@first.SubdItemCode - @first.SubdItemName</span>
                                                            <span class="sep">·</span>
                                                            <span>@groupRows.Count uom@(groupRows.Count == 1 ? "" : "s")</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="ich-right">
                                                @if (card.Group.IsSaved)
                                                {
                                                    <span class="badge badge-saved">
                                                        <i class="ti ti-circle-check" aria-hidden="true"></i>
                                                        Saved
                                                    </span>
                                                }
                                                else
                                                {
                                                    @if (isWarn)
                                                    {
                                                        <span class="badge badge-warn">
                                                            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                            Warning
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-ready">
                                                            <i class="ti ti-check" aria-hidden="true"></i>
                                                            Ready
                                                        </span>
                                                    }
                                                    <div class="chk" @onclick:stopPropagation="true">
                                                        <input type="checkbox" checked="@card.Group.Selected"
                                                               disabled="@(!card.CanSelect)"
                                                               @onchange="(e) => ToggleGroupSelectionLocal(card.Group, e.Value)"
                                                               id="chk-@groupKey" />
                                                        <label for="chk-@groupKey">Select</label>
                                                    </div>
                                                }
                                                <i class="ti ti-chevron-down chev @(isExpanded ? "open" : "")" aria-hidden="true"></i>
                                            </div>
                                        </div>

                                        @if (isExpanded && first != null)
                                        {
                                            <div class="icb">
                                                <div class="cust-meta">
                                                    <div>
                                                        <span class="cust-meta-label">Principal</span>
                                                        <strong>@first.Principal</strong>
                                                    </div>
                                                    <div>
                                                        <span class="cust-meta-label">Subdistributor Item</span>
                                                        <strong>@first.SubdItemCode - @first.SubdItemName</strong>
                                                    </div>
                                                    @if (HasMultipleSubdistributors())
                                                    {
                                                        <div style="grid-column: 1 / -1;">
                                                            <span class="cust-meta-label">Subdistributor</span>
                                                            <strong>@first.SubDistributorCode - @first.SubDistributorName</strong>
                                                        </div>
                                                    }
                                                </div>
                                                @foreach (var w in card.Warnings)
                                                {
                                                    <div class="dup-warning-banner">
                                                        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                        @w
                                                    </div>
                                                }
                                                @if (!card.Group.IsSaved)
                                                {
                                                    <div style="margin:10px 0; max-width:340px;">
                                                        <Select TItem="string"
                                                                Label="Stock UOM"
                                                                Placeholder="Choose the stock UOM…"
                                                                Items="card.Group.StockUomOptions"
                                                                ValueSelector="x => x"
                                                                TextSelector="x => x"
                                                                SelectedValue="@card.Group.StockUomName"
                                                                SelectedValueChanged="v => OnStockUomChosen(card.Group, v)"
                                                                AddOptionalText="true"
                                                                OptionalText="@StockUomHint(card.Group)" />
                                                    </div>
                                                }

                                                <div class="itbl-wrap">
                                                    <table class="itbl">
                                                        <thead>
                                                            <tr>
                                                                <th>Row</th>
                                                                <th>UOM</th>
                                                                <th class="r">Conversion</th>
                                                                <th class="r">Price</th>
                                                                <th>Stock</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in groupRows.OrderBy(r => r.RowNumber))
                                                            {
                                                                <tr>
                                                                    <td class="mono">@row.RowNumber</td>
                                                                    <td>@row.UomName</td>
                                                                    <td class="r">@(row.Conversion?.ToString("0") ?? "Not Set")</td>
                                                                    <td class="r">@row.Price?.ToString("N2")</td>
                                                                    <td>
                                                                        @if (row.IsStockUom)
                                                                        {
                                                                            <i class="ti ti-check" title="Stock UOM" aria-label="Stock UOM"></i>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </Virtualize>
                            }
                            else
                            {
                                <Virtualize Items="displayCards" Context="card" ItemSize="72">
                                    @{
                                        var first = card.First;
                                        var displayName = first == null
                                            ? "[Orphan]"
                                            : (string.IsNullOrWhiteSpace(first.CompanyItemCode) ? "[Blank Item]" : $"{first.CompanyItemCode} - {first.CompanyItemName}");
                                        var groupErrorCount = GetGroupErrorRowCount(card.Group);
                                        var grouped = GetGroupedIssues(card);
                                    }

                                    <div class="icard">
                                        <div class="ich ich-er">
                                            <div class="ich-left">
                                                <div class="iicon iicon-er">
                                                    <i class="ti ti-package-off" aria-hidden="true"></i>
                                                </div>
                                                <div>
                                                    <div class="inv-num inv-er">@displayName</div>
                                                    @if (first != null)
                                                    {
                                                        <div class="inv-sub inv-sub-er">
                                                            <span>@first.SubDistributorCode - @first.SubDistributorName</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <span class="badge badge-err">
                                                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                @((groupErrorCount == 1) ? "1 error" : $"{groupErrorCount} errors")
                                            </span>
                                        </div>

                                        @if (grouped.Any())
                                        {
                                            <div class="icb-err-rows">
                                                @foreach (var issueGroup in grouped)
                                                {
                                                    <div class="err-msg-card">
                                                        <div class="err-msg-hdr">
                                                            <i class="ti ti-alert-circle err-msg-icon" aria-hidden="true"></i>
                                                            <div>
                                                                <div class="err-msg-text">@issueGroup.Message</div>
                                                                @if (issueGroup.RowNumbers.Any())
                                                                {
                                                                    <div class="err-rows-pill">
                                                                        <i class="ti ti-row-insert-bottom" aria-hidden="true"></i>
                                                                        Row: @string.Join(" & ", issueGroup.RowNumbers)
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </Virtualize>
                            }
                        </div>
                    }
                }
            </div>

            @* ── Modal footer ── *@
            <div class="modal-footer-ent">
                @if (ImportResult != null && GetSelectedCardCount() > 0)
                {
                    <button type="button" class="btn-commit" disabled="@(!CanCommit)" @onclick="OpenCommitConfirmModal">
                        <i class="ti ti-send" aria-hidden="true"></i>
                        Commit mapped items (@GetSelectedCardCount())
                    </button>
                }
                <button type="button" class="btn-close-modal" @onclick="HandleClose">Close</button>
            </div>

        </div>
    </div>
}

@* ── Error report pop-up: all errors, or one error type, with a row count preview ── *@
@if (showDownloadModal)
{
    var downloadTypes = GetDistinctErrorMessages();
    var previewCount = (!downloadScopeAll && string.IsNullOrEmpty(downloadErrorType))
        ? 0
        : BuildReportRows(downloadScopeAll ? null : downloadErrorType).Count;
    <div class="modal-overlay" style="z-index:1100;">
        <div class="modal-box" style="max-width:460px;">
            <div class="modal-header-ent">
                <div class="mh-left">
                    <div class="mh-icon"><i class="ti ti-download" aria-hidden="true"></i></div>
                    <div>
                        <div class="mh-title">Download error report</div>
                        <div class="mh-sub">Includes every original column from your file</div>
                    </div>
                </div>
                <button type="button" class="mh-close" @onclick="CloseDownloadModal" aria-label="Close">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body-ent">
                <label style="display:block;margin-bottom:8px;">
                    <input type="radio" name="dl-scope" checked="@downloadScopeAll"
                           @onchange="() => downloadScopeAll = true" />
                    All errors
                </label>
                <label style="display:block;margin-bottom:8px;">
                    <input type="radio" name="dl-scope" checked="@(!downloadScopeAll)"
                           @onchange="() => downloadScopeAll = false" />
                    Only a specific error
                </label>
                @if (!downloadScopeAll)
                {
                    <select style="width:100%;" value="@downloadErrorType"
                            @onchange="e => downloadErrorType = e.Value?.ToString()">
                        <option value="">-- select error --</option>
                        @foreach (var t in downloadTypes)
                        {
                            <option value="@t.Message">@t.Message (@t.Count)</option>
                        }
                    </select>
                }
                <p class="hint-text" style="margin-top:12px;">@previewCount row(s) will be exported.</p>
            </div>
            <div class="modal-footer-ent">
                <button type="button" class="btn-commit"
                        disabled="@((!downloadScopeAll && string.IsNullOrEmpty(downloadErrorType)) || previewCount == 0)"
                        @onclick="ConfirmDownload">
                    <i class="ti ti-download" aria-hidden="true"></i> Download
                </button>
                <button type="button" class="btn-close-modal" @onclick="CloseDownloadModal">Cancel</button>
            </div>
        </div>
    </div>
}

<ConfirmModal Show="showCommitConfirmModal" Title="Commit Selected Items"
              Message="@($"Commit {GetSelectedCardCount()} selected item(s)?")"
              OnYes="ConfirmCommit" OnNo="CancelCommit" CloseOnOverlayClick="true" />

@code {
    [Parameter] public EventCallback<List<ImportMapItemRowResult>> OnDownloadErrorReport { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public ImportMapItemResult? ImportResult { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public HashSet<string> SelectedGroupKeys { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private bool showCommitConfirmModal;
    private bool wasShown;
    private bool isCommitting;
    private bool hasCommitted;
    private int commitSavedCount;
    private int commitFailedCount;
    private string? commitError;

    private GroupFilter groupFilter = GroupFilter.SuccessOnly;
    private string? selectedErrorFilter;
    private string? selectedWarningFilter;
    private HashSet<string> expandedGroups = new(StringComparer.OrdinalIgnoreCase);
    private string searchTerm = string.Empty;
    private ItemSortMode sortMode = ItemSortMode.RowAscending;

    private bool showDownloadModal;
    private bool downloadScopeAll = true;
    private string? downloadErrorType;

    private enum GroupFilter { SuccessOnly, WarningOnly, ErrorOnly }
    private enum ItemSortMode { RowAscending, CompanyItem, SubdItem }

    // Everything the list needs about one item is worked out once and kept here,
    // so rendering and searching never have to rebuild strings or lists per card.
    private sealed record GroupCardViewModel(
        PreparedItemGroup Group,
        ImportMapItemRowResult? First,
        string Key,
        List<string> Warnings,
        string SearchBlob,
        int SortRow)
    {
        public bool HasErrors => (Group.Issues?.Count ?? 0) > 0 || Group.Rows.Any(r => r.Issues.Count > 0);
        public bool IsWarningOnly => !HasErrors && Warnings.Count > 0;
        public bool CanSelect => First != null && !HasErrors && !Group.IsSaved && Group.HasStockUom;
    }

    private sealed record GroupedIssue(string? Message, List<int> RowNumbers);

    protected override void OnParametersSet()
    {
        if (Show && !wasShown)
        {
            wasShown = true;
            hasCommitted = false;
            commitError = null;
            selectedErrorFilter = null;
            selectedWarningFilter = null;
            searchTerm = string.Empty;
            sortMode = ItemSortMode.RowAscending;
            showDownloadModal = false;
            InvalidateCaches();

            if (ImportResult != null)
            {
                // Nothing is selected when the modal opens; the user picks what to commit.
                SelectedGroupKeys.Clear();
                foreach (var g in ImportResult.PreparedGroups.Where(g => !g.IsSaved))
                    g.Selected = false;

                var anyValid = ImportResult.PreparedGroups.Any(g => !GroupHasErrors(g) && !g.Rows.Any(r => r.Warnings.Count > 0));
                var anyWarning = ImportResult.PreparedGroups.Any(g => !GroupHasErrors(g) && g.Rows.Any(r => r.Warnings.Count > 0));
                groupFilter = anyValid ? GroupFilter.SuccessOnly
                            : anyWarning ? GroupFilter.WarningOnly
                            : GroupFilter.ErrorOnly;
            }
        }
        else if (!Show) { wasShown = false; }
    }

    private static bool GroupHasErrors(PreparedItemGroup g) =>
        (g.Issues?.Count ?? 0) > 0 || g.Rows.Any(r => r.Issues.Count > 0);

    private bool CanCommit => ImportResult != null && GetSelectedCardCount() > 0;

    // ── Caches ────────────────────────────────────────────────────────────
    // The card list is only rebuilt when ImportResult changes (or after a commit).
    // The filtered / searched / sorted list is only rebuilt when the tab, filters,
    // search text or sort mode change. Keeping the same list instance also stops
    // <Virtualize> from refreshing (and jumping) on every render.
    private ImportMapItemResult? _cachedForResult;
    private bool _cacheReady;
    private List<GroupCardViewModel>? _cachedCards;
    private List<GroupCardViewModel>? _cachedFilteredCards;
    private string? _cachedFilterKey;
    private List<(string Message, int Count)>? _cachedErrorTypes;
    private List<(string Message, int Count)>? _cachedWarningTypes;
    private List<ImportMapItemIssue>? _cachedGlobalIssues;
    private bool? _cachedHasMultipleSubds;
    private bool _countsReady;
    private (int Valid, int Warning, int Error) _counts;

    private void InvalidateCaches() => _cacheReady = false;

    private void EnsureCache()
    {
        if (_cacheReady && ReferenceEquals(_cachedForResult, ImportResult)) return;

        _cachedCards = null;
        _cachedFilteredCards = null;
        _cachedFilterKey = null;
        _cachedErrorTypes = null;
        _cachedWarningTypes = null;
        _cachedGlobalIssues = null;
        _cachedHasMultipleSubds = null;
        _countsReady = false;

        _cachedForResult = ImportResult;
        _cacheReady = true;
    }

    // Must stay identical to GroupKey in ImportMapItems.razor (the page that commits).
    private static string BuildGroupKey(ImportMapItemRowResult row)
    {
        static string NormalizePart(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();
        return string.Join("|",
            NormalizePart(row.SubDistributorCode),
            NormalizePart(row.CompanyItemCode),
            NormalizePart(row.CompanyItemName),
            NormalizePart(row.SubdItemCode),
            NormalizePart(row.SubdItemName));
    }

    // Everything a user might type into the search box: the parsed fields, every raw value
    // from the Excel row, and any warning / error text.
    private static string BuildSearchBlob(PreparedItemGroup g)
    {
        var parts = new List<string>();
        void Add(string? s)
        {
            if (!string.IsNullOrWhiteSpace(s)) parts.Add(s);
        }

        foreach (var r in g.Rows)
        {
            Add(r.CompanyItemCode);
            Add(r.CompanyItemName);
            Add(r.SubdItemCode);
            Add(r.SubdItemName);
            Add(r.Principal);
            Add(r.SubDistributorCode);
            Add(r.SubDistributorName);
            Add(r.UomName);

            foreach (var v in r.RawValues.Values) Add(v);
            foreach (var w in r.Warnings) Add(w);
            foreach (var i in r.Issues) Add(i);
        }

        foreach (var issue in g.Issues) Add(issue.Message);

        return string.Join("\n", parts);
    }

    private static GroupCardViewModel BuildCard(PreparedItemGroup g, int index)
    {
        var first = g.Rows.FirstOrDefault();
        return new GroupCardViewModel(
            g,
            first,
            first != null ? BuildGroupKey(first) : $"orphan-{index}",
            g.Rows.SelectMany(r => r.Warnings).Distinct().ToList(),
            BuildSearchBlob(g),
            g.Rows.Count > 0 ? g.Rows.Min(r => r.RowNumber) : int.MaxValue);
    }

    private List<GroupCardViewModel> GetCards()
    {
        EnsureCache();
        if (_cachedCards != null) return _cachedCards;

        _cachedCards = (ImportResult?.PreparedGroups ?? new List<PreparedItemGroup>())
            .Select(BuildCard)
            .OrderBy(c => c.SortRow)
            .ToList();

        return _cachedCards;
    }

    private (int Valid, int Warning, int Error) GetCounts(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        if (_countsReady) return _counts;

        int valid = 0, warning = 0, error = 0;
        foreach (var c in cards)
        {
            if (c.HasErrors) error++;
            else if (c.IsWarningOnly) warning++;
            else valid++;
        }

        _counts = (valid, warning, error);
        _countsReady = true;
        return _counts;
    }

    // Tab + filter selection.
    private List<GroupCardViewModel> GetFilteredCards(List<GroupCardViewModel> cards) => groupFilter switch
    {
        GroupFilter.WarningOnly => cards.Where(c => c.IsWarningOnly
                && (string.IsNullOrWhiteSpace(selectedWarningFilter)
                    || c.Warnings.Any(w => NormalizeWarningMessageType(w) == selectedWarningFilter))).ToList(),
        GroupFilter.ErrorOnly => !string.IsNullOrWhiteSpace(selectedErrorFilter)
            ? cards.Where(c => c.HasErrors && GroupContainsError(c.Group, selectedErrorFilter)).ToList()
            : cards.Where(c => c.HasErrors).ToList(),
        _ => cards.Where(c => !c.HasErrors && !c.IsWarningOnly).ToList()
    };

    // Tab filter + search + sort, cached until one of them changes.
    private List<GroupCardViewModel> GetFilteredAndSortedCards(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        var key = $"{groupFilter}|{selectedErrorFilter}|{selectedWarningFilter}|{searchTerm}|{sortMode}";
        if (_cachedFilterKey == key && _cachedFilteredCards != null)
            return _cachedFilteredCards;

        var filtered = GetFilteredCards(cards);

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            var termIsRowNumber = int.TryParse(term, out var rowNum);
            filtered = filtered.Where(c => CardMatchesSearch(c, term, termIsRowNumber, rowNum)).ToList();
        }

        _cachedFilteredCards = ApplySort(filtered);
        _cachedFilterKey = key;
        return _cachedFilteredCards;
    }

    private static bool CardMatchesSearch(GroupCardViewModel card, string term, bool termIsRowNumber, int rowNum)
    {
        if (card.SearchBlob.Contains(term, StringComparison.OrdinalIgnoreCase))
            return true;

        return termIsRowNumber && card.Group.Rows.Any(r => r.RowNumber == rowNum);
    }

    private List<GroupCardViewModel> ApplySort(List<GroupCardViewModel> cards)
    {
        return sortMode switch
        {
            ItemSortMode.CompanyItem => cards
                .OrderBy(c => c.First?.CompanyItemCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(c => c.SortRow)
                .ToList(),
            ItemSortMode.SubdItem => cards
                .OrderBy(c => c.First?.SubdItemCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(c => c.SortRow)
                .ToList(),
            _ => cards.OrderBy(c => c.SortRow).ToList()
        };
    }

    private void OnSearchInput(ChangeEventArgs e) => searchTerm = e.Value?.ToString() ?? string.Empty;

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ItemSortMode>(e.Value?.ToString(), out var mode))
            sortMode = mode;
    }

    // Whether more than one distinct subdistributor appears in this import.
    // Drives both the modal subtitle and whether the per-card Subdistributor
    // row needs to be shown at all.
    private bool HasMultipleSubdistributors()
    {
        EnsureCache();
        if (_cachedHasMultipleSubds.HasValue) return _cachedHasMultipleSubds.Value;

        var distinctCount = (ImportResult?.Rows ?? new List<ImportMapItemRowResult>())
            .Where(r => !string.IsNullOrWhiteSpace(r.SubDistributorCode))
            .Select(r => r.SubDistributorCode.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        _cachedHasMultipleSubds = distinctCount > 1;
        return _cachedHasMultipleSubds.Value;
    }

    private string GetHeaderSubtitle()
    {
        if (!HasMultipleSubdistributors())
        {
            var first = (ImportResult?.Rows ?? new List<ImportMapItemRowResult>())
                .FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.SubDistributorCode));

            if (first != null)
            {
                return string.IsNullOrWhiteSpace(first.SubDistributorName)
                    ? first.SubDistributorCode
                    : $"{first.SubDistributorCode} - {first.SubDistributorName}";
            }
        }

        return "Subdistributor Item mapping";
    }

    private void ToggleExpand(string key)
    {
        if (!expandedGroups.Remove(key))
            expandedGroups.Add(key);
    }

    private string GetTabClass(GroupFilter filter) => groupFilter == filter
        ? filter switch
        {
            GroupFilter.SuccessOnly => "tab act-ok",
            GroupFilter.WarningOnly => "tab act-warn",
            GroupFilter.ErrorOnly => "tab act-er",
            _ => "tab"
        }
        : "tab";

    private void SetTab(GroupFilter filter)
    {
        groupFilter = filter;
        selectedErrorFilter = null;
        selectedWarningFilter = null;
    }

    // If the selected tab no longer has any items, move to one that does.
    private void EnsureValidTab(bool hasSuccess, bool hasWarning, bool hasError)
    {
        var target = groupFilter;

        if (groupFilter == GroupFilter.SuccessOnly && !hasSuccess)
            target = hasWarning ? GroupFilter.WarningOnly : (hasError ? GroupFilter.ErrorOnly : groupFilter);
        else if (groupFilter == GroupFilter.WarningOnly && !hasWarning)
            target = hasSuccess ? GroupFilter.SuccessOnly : (hasError ? GroupFilter.ErrorOnly : groupFilter);
        else if (groupFilter == GroupFilter.ErrorOnly && !hasError)
            target = hasSuccess ? GroupFilter.SuccessOnly : (hasWarning ? GroupFilter.WarningOnly : groupFilter);

        if (target != groupFilter)
            SetTab(target);
    }

    private List<ImportMapItemIssue> GetGlobalIssues()
    {
        EnsureCache();
        if (_cachedGlobalIssues != null) return _cachedGlobalIssues;

        if (ImportResult == null)
        {
            _cachedGlobalIssues = new List<ImportMapItemIssue>();
            return _cachedGlobalIssues;
        }

        var headerIssues = ImportResult.Issues.Where(i => i.RowNumber == 0).ToList();

        var rowHeaderIssues = ImportResult.Rows
            .Where(row => row.RowNumber == 0)
            .SelectMany(row => row.Issues.Select(issue => new ImportMapItemIssue(row.RowNumber, row.SubdItemCode, issue)))
            .ToList();

        var preparedHeaderIssues = ImportResult.PreparedGroups
            .SelectMany(g => g.Issues)
            .Where(i => i.RowNumber == 0)
            .ToList();

        _cachedGlobalIssues = headerIssues
            .Concat(rowHeaderIssues)
            .Concat(preparedHeaderIssues)
            .GroupBy(i => new { i.RowNumber, i.SubdItemCode, i.Message })
            .Select(g => g.First())
            .ToList();

        return _cachedGlobalIssues;
    }

    private List<(string Message, int Count)> GetDistinctErrorMessages()
    {
        EnsureCache();
        if (_cachedErrorTypes != null) return _cachedErrorTypes;

        var cards = GetCards();
        var messageTypes = new HashSet<string>();

        foreach (var c in cards)
        {
            foreach (var i in c.Group.Issues)
            {
                var t = NormalizeMessageType(i.Message);
                if (!string.IsNullOrWhiteSpace(t)) messageTypes.Add(t);
            }
            foreach (var r in c.Group.Rows)
                foreach (var i in r.Issues)
                {
                    var t = NormalizeMessageType(i);
                    if (!string.IsNullOrWhiteSpace(t)) messageTypes.Add(t);
                }
        }

        _cachedErrorTypes = messageTypes
            .Select(type => (Message: type, Count: cards.Count(c => GroupContainsError(c.Group, type))))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();

        return _cachedErrorTypes;
    }

    private static string NormalizeMessage(string? m) => (m ?? string.Empty).Trim();

    private static string NormalizeMessageType(string? m)
    {
        var msg = NormalizeMessage(m).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.StartsWith("stock uom")) return "Stock UOM";

        if (msg.StartsWith("save failed")) return "Save Failed";
        if (msg.Contains("duplicate") && msg.Contains("uom")) return "Duplicate UOM";
        if (msg.Contains("duplicate") && msg.Contains("conversion")) return "Duplicate Conversion";
        if (msg.Contains("already exist") && msg.Contains("subd")) return "SubdItem Already Exists In Excel";
        if (msg.Contains("duplicat") && (msg.Contains("uploaded") || msg.Contains("excel")) && (msg.Contains("subd") || msg.Contains("subditem") || msg.Contains("subdistributor")))
            return "SubdItem Duplicated In Excel";
        if (msg.Contains("already mapped") || (msg.Contains("already") && msg.Contains("mapped"))) return "Already Mapped";
        if (msg.Contains("uom not found") || (msg.Contains("not found") && msg.Contains("uom"))) return "UOM Not Found";
        if (msg.Contains("invalid uom") || (msg.Contains("invalid") && msg.Contains("uom"))) return "Invalid UOM";
        if (msg.Contains("conversion mismatch") || (msg.Contains("mismatch") && msg.Contains("conversion"))) return "Conversion Mismatch";
        if (msg.Contains("uom is required") || msg.Contains("uom is missing")) return "UOM Required";
        if (msg.Contains("price is required") || msg.Contains("price missing")) return "Price Required";
        if (msg.Contains("conversion is required")) return "Conversion Required";
        if (msg.Contains("company item") && msg.Contains("not found")) return "Company Item Not Found";
        if (msg.Contains("duplicate map item")) return "Duplicate Map Item";
        if (msg.Contains("subdistributor") && msg.Contains("not found")) return "SubDistributor Not Found";
        if (msg.Contains("has no price")) return "Price Not Found";
        return NormalizeMessage(m);
    }

    private void OnErrorFilterChanged(ChangeEventArgs e) => selectedErrorFilter = e?.Value?.ToString();
    private void ClearErrorFilter() => selectedErrorFilter = null;

    private bool GroupContainsError(PreparedItemGroup group, string? message)
    {
        if (string.IsNullOrWhiteSpace(message)) return false;
        var norm = NormalizeMessageType(message);
        if (group.Issues != null && group.Issues.Any(i => NormalizeMessageType(i.Message) == norm)) return true;
        if (group.Rows != null && group.Rows.Any(r => r.Issues.Any(i => NormalizeMessageType(i) == norm))) return true;
        return false;
    }

    // The messages shown on an error card (grouped by message, with the rows they apply to).
    private List<GroupedIssue> GetGroupedIssues(GroupCardViewModel card)
    {
        var group = card.Group;
        var groupRows = group.Rows;

        var visibleIssues = (group.Issues ?? new List<ImportMapItemIssue>())
            .Concat(groupRows.SelectMany(r => r.Issues.Select(i => new ImportMapItemIssue(r.RowNumber, r.SubdItemCode, i))));

        if (!string.IsNullOrWhiteSpace(selectedErrorFilter))
        {
            if (selectedErrorFilter == "SubdItem Duplicated In Excel")
            {
                var matching = visibleIssues.Where(i => NormalizeMessageType(i.Message) == selectedErrorFilter).ToList();
                var dupCodes = groupRows.Select(r => r.SubdItemCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                var extras = new List<ImportMapItemIssue>();
                var allRows = ImportResult?.Rows ?? new List<ImportMapItemRowResult>();
                foreach (var code in dupCodes)
                {
                    var others = allRows.Where(rr => rr.RowNumber > 0 && !string.IsNullOrWhiteSpace(rr.SubdItemCode) && string.Equals(rr.SubdItemCode, code, StringComparison.OrdinalIgnoreCase)).ToList();
                    foreach (var other in others)
                    {
                        if (!groupRows.Any(r => r.RowNumber == other.RowNumber))
                        {
                            var msg = $"SubdItem code '{other.SubdItemCode}' is duplicated within the uploaded Excel for SubDistributor '{other.SubDistributorCode}'.";
                            extras.Add(new ImportMapItemIssue(other.RowNumber, other.SubdItemCode, msg));
                        }
                    }
                }
                visibleIssues = matching.Concat(extras);
            }
            else
            {
                visibleIssues = visibleIssues.Where(i => NormalizeMessageType(i.Message) == selectedErrorFilter);
            }
        }

        return visibleIssues
            .GroupBy(i => i.Message)
            .Select(g => new GroupedIssue(g.Key, g.Select(x => x.RowNumber).Where(r => r > 0).Distinct().OrderBy(r => r).ToList()))
            .OrderBy(g => g.RowNumbers.FirstOrDefault())
            .ToList();
    }

    // ── Stock UOM ─────────────────────────────────────────────────────────
    private void OnStockUomChosen(PreparedItemGroup group, string? uomName)
    {
        if (string.IsNullOrWhiteSpace(uomName)) return;

        group.ChooseStockUom(uomName);
        InvalidateCaches();   // the card may move tabs (a warning went away)
    }

    private static string StockUomHint(PreparedItemGroup group) => group.StockUomSource switch
    {
        StockUomSource.Explicit => "(From your file)",
        StockUomSource.Suggested => string.IsNullOrWhiteSpace(group.StockUomReason)
            ? "(Suggested. Select this item to confirm, or pick another)"
            : $"(Suggested: {group.StockUomReason}. Select this item to confirm, or pick another)",
        StockUomSource.Chosen => "(Chosen by you)",
        _ => "(Required. Pick one to be able to commit this item)"
    };

    // ── Selection ─────────────────────────────────────────────────────────
    private void SetSelected(GroupCardViewModel card, bool isChecked)
    {
        card.Group.Selected = isChecked;
        if (isChecked) SelectedGroupKeys.Add(card.Key); else SelectedGroupKeys.Remove(card.Key);
    }

    private void ToggleGroupSelectionLocal(PreparedItemGroup? prepared, object? checkedValue)
    {
        if (prepared == null || checkedValue is not bool isChecked) return;

        var card = GetCards().FirstOrDefault(c => ReferenceEquals(c.Group, prepared));
        if (card == null) return;

        SetSelected(card, isChecked);
    }

    // "Select all valid" only ticks valid items, never the ones with warnings.
    private void ToggleSelectAllCards(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        foreach (var c in GetCards().Where(c => c.CanSelect && !c.IsWarningOnly))
            SetSelected(c, isChecked);
    }

    // "Select all with warnings" only ticks items that have warnings.
    private void ToggleSelectAllWarningCards(object? checkedValue)
    {
        if (checkedValue is not bool isChecked || ImportResult == null) return;

        foreach (var c in GetCards().Where(c => c.CanSelect && c.IsWarningOnly))
            SetSelected(c, isChecked);
    }

    private int GetSelectedCardCount() =>
        GetCards().Count(c => c.CanSelect && SelectedGroupKeys.Contains(c.Key));

    // ── Commit ────────────────────────────────────────────────────────────
    private void OpenCommitConfirmModal() => showCommitConfirmModal = true;
    private void CancelCommit() => showCommitConfirmModal = false;

    private async Task ConfirmCommit()
    {
        showCommitConfirmModal = false;
        commitError = null;

        var toCommit = GetCards()
            .Where(c => c.CanSelect && c.Group.Selected && SelectedGroupKeys.Contains(c.Key))
            .Select(c => c.Group)
            .ToList();

        try
        {
            isCommitting = true;
            StateHasChanged();
            await Task.Yield(); // let the loading overlay paint before the commit starts

            if (OnCommit.HasDelegate) await OnCommit.InvokeAsync(null);

            // Anything that was not saved needs a visible reason, so it moves to the Errors tab.
            // (The service already adds one when a save fails; this covers "never processed".)
            foreach (var g in toCommit.Where(g => !g.IsSaved))
            {
                if (!GroupHasErrors(g))
                {
                    var first = g.Rows.FirstOrDefault();
                    g.Issues.Add(new ImportMapItemIssue(
                        first?.RowNumber ?? 0,
                        first?.SubdItemCode ?? string.Empty,
                        "Save failed: this item was not processed by the commit."));
                }
            }

            // Saved / failed status changed, so the cards, counts and lists must be rebuilt.
            InvalidateCaches();

            commitSavedCount = toCommit.Count(g => g.IsSaved);
            commitFailedCount = toCommit.Count - commitSavedCount;
            hasCommitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            commitError = $"Commit failed: {ex.Message}";
            InvalidateCaches();
        }
        finally
        {
            isCommitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync(null);
    }

    // ── Warnings ──────────────────────────────────────────────────────────
    private void OnWarningFilterChanged(ChangeEventArgs e) => selectedWarningFilter = e?.Value?.ToString();
    private void ClearWarningFilter() => selectedWarningFilter = null;

    // Warning text mostly embeds per-row detail (row numbers, UOM, price), so
    // bucket into categories the same way NormalizeMessageType does for errors.
    private static string NormalizeWarningMessageType(string? m)
    {
        var msg = (m ?? string.Empty).Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        if (msg.StartsWith("stock uom suggested")) return "Stock UOM Suggested";
        if (msg.StartsWith("stock uom not set")) return "Stock UOM Not Set";
        if (msg.StartsWith("stock uom")) return "Stock UOM Doesn't Match";

        if (msg.Contains("duplicate map item")) return "Duplicate Map Item";
        if (msg.Contains("has no conversion")) return "No Conversion (Price Only)";
        if (msg.Contains("has a price of 0")) return "Zero Price";
        return (m ?? string.Empty).Trim();
    }

    private List<(string Message, int Count)> GetDistinctWarningMessages(List<GroupCardViewModel> cards)
    {
        EnsureCache();
        if (_cachedWarningTypes != null) return _cachedWarningTypes;

        var warningCards = cards.Where(c => c.IsWarningOnly).ToList();
        var messageTypes = new HashSet<string>();

        foreach (var c in warningCards)
            foreach (var r in c.Group.Rows)
                foreach (var w in r.Warnings)
                {
                    var t = NormalizeWarningMessageType(w);
                    if (!string.IsNullOrWhiteSpace(t)) messageTypes.Add(t);
                }

        _cachedWarningTypes = messageTypes
            .Select(type => (Message: type, Count: warningCards.Sum(c => GetGroupWarningRowCount(c.Group, type))))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Message)
            .ToList();

        return _cachedWarningTypes;
    }

    private static int GetGroupWarningRowCount(PreparedItemGroup group, string? filterMessageType)
    {
        var affectedRows = new HashSet<int>();
        foreach (var row in group.Rows.Where(r => r.Warnings.Count > 0))
        {
            if (string.IsNullOrWhiteSpace(filterMessageType)) affectedRows.Add(row.RowNumber);
            else if (row.Warnings.Any(w => NormalizeWarningMessageType(w) == filterMessageType)) affectedRows.Add(row.RowNumber);
        }
        return affectedRows.Count;
    }

    private int GetTotalWarningCount(List<GroupCardViewModel> cards) =>
        cards.Where(c => c.IsWarningOnly).Sum(c => GetGroupWarningRowCount(c.Group, null));

    // ── Error counts ──────────────────────────────────────────────────────
    private int GetGroupErrorRowCount(PreparedItemGroup group) => GetGroupErrorRowCount(group, selectedErrorFilter);

    private static int GetGroupErrorRowCount(PreparedItemGroup group, string? filterMessageType)
    {
        var affectedRows = new HashSet<int>();

        foreach (var row in group.Rows.Where(r => r.Issues.Count > 0))
        {
            if (string.IsNullOrWhiteSpace(filterMessageType)) affectedRows.Add(row.RowNumber);
            else if (row.Issues.Any(i => NormalizeMessageType(i) == filterMessageType)) affectedRows.Add(row.RowNumber);
        }

        if (group.Issues != null)
        {
            foreach (var issue in group.Issues)
            {
                if (issue.RowNumber > 0)
                {
                    if (string.IsNullOrWhiteSpace(filterMessageType) || NormalizeMessageType(issue.Message) == filterMessageType)
                        affectedRows.Add(issue.RowNumber);
                }
            }

            if (group.Issues.Any(issue => issue.RowNumber == 0 && (string.IsNullOrWhiteSpace(filterMessageType) || NormalizeMessageType(issue.Message) == filterMessageType)))
                return affectedRows.Count + 1;
        }

        return affectedRows.Count;
    }

    // ── Error report pop-up ───────────────────────────────────────────────
    private void OpenDownloadModal()
    {
        // Pre-select whatever error the user is already filtering by.
        downloadErrorType = selectedErrorFilter;
        downloadScopeAll = string.IsNullOrWhiteSpace(selectedErrorFilter);
        showDownloadModal = true;
    }

    private void CloseDownloadModal() => showDownloadModal = false;

    private List<ImportMapItemRowResult> BuildReportRows(string? errorType)
    {
        if (ImportResult == null) return new List<ImportMapItemRowResult>();

        var errorRows = ImportResult.Rows.Where(r => r.Issues.Count > 0).ToList();

        if (string.IsNullOrWhiteSpace(errorType))
            return errorRows;

        return errorRows
            .Where(r => r.Issues.Any(i => NormalizeMessageType(i) == errorType))
            .ToList();
    }

    private async Task ConfirmDownload()
    {
        var rows = BuildReportRows(downloadScopeAll ? null : downloadErrorType);
        showDownloadModal = false;
        if (OnDownloadErrorReport.HasDelegate && rows.Count > 0)
            await OnDownloadErrorReport.InvokeAsync(rows);
    }
