@page "/not-found"
@layout EmptyLayout

@using STTproject.Services
@using STTproject.Shared.Layout.Admin
@using STTproject.Shared.Layout.User

@inject IUserContextService UserContext
@inject IUserService UserService

@if (isLoading)
{
    <div class="not-found-loading">
        Loading...
    </div>
}
else
{
    <LayoutView Layout="@currentLayout">
        <div class="not-found-container">
            <h1>404</h1>
            <h3>Page Not Found</h3>
            <p>
                Sorry, the page you're looking for doesn't exist
                or may have been moved.
            </p>
        </div>
    </LayoutView>
}

@code {
    private bool isLoading = true;

    private Type currentLayout = typeof(UserSideBar);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (UserContext.UserId is int userId)
            {
                bool isAdmin = await UserService.IsAdminAsync(userId);

                currentLayout = isAdmin
                    ? typeof(AdminSideBar)
                    : typeof(UserSideBar);
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}